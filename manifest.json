{
  "id": "./rapier.html",
  "name": "Rapier",
  "short_name": "Rapier",
  "description": "A fast, offline Markdown, text, and code editor. Single file. No server or login.",
  "start_url": "./rapier.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "handle_links": "preferred",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/*",
            "application/json",
            "application/xml",
            "application/javascript",
            "application/x-yaml",
            ".adoc",
            ".asciidoc",
            ".bash",
            ".c",
            ".cc",
            ".cfg",
            ".cjs",
            ".clj",
            ".cljs",
            ".conf",
            ".cpp",
            ".cs",
            ".css",
            ".csv",
            ".cxx",
            ".dart",
            ".diff",
            ".dockerfile",
            ".editorconfig",
            ".env",
            ".erl",
            ".ex",
            ".exs",
            ".fish",
            ".fs",
            ".fsx",
            ".gitattributes",
            ".gitignore",
            ".go",
            ".gql",
            ".gradle",
            ".graphql",
            ".groovy",
            ".h",
            ".hcl",
            ".hh",
            ".hpp",
            ".hrl",
            ".htm",
            ".html",
            ".ini",
            ".java",
            ".js",
            ".json",
            ".jsonc",
            ".jsx",
            ".kt",
            ".less",
            ".log",
            ".lua",
            ".m",
            ".markdown",
            ".md",
            ".mdown",
            ".mjs",
            ".mm",
            ".nim",
            ".npmrc",
            ".nvmrc",
            ".patch",
            ".php",
            ".pl",
            ".pm",
            ".prettierrc",
            ".properties",
            ".proto",
            ".ps1",
            ".psd1",
            ".psm1",
            ".py",
            ".r",
            ".rb",
            ".rs",
            ".rst",
            ".sass",
            ".scala",
            ".scss",
            ".sh",
            ".sol",
            ".sql",
            ".styl",
            ".svelte",
            ".svg",
            ".swift",
            ".tex",
            ".tf",
            ".tfvars",
            ".toml",
            ".ts",
            ".tsv",
            ".tsx",
            ".txt",
            ".vb",
            ".vue",
            ".xhtml",
            ".xml",
            ".yaml",
            ".yml",
            ".zig",
            ".zsh"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./rapier.html",
      "accept": {
        "text/markdown": [
          ".md",
          ".markdown",
          ".mdown"
        ],
        "application/javascript": [
          ".js",
          ".mjs",
          ".cjs"
        ],
        "text/typescript": [
          ".ts",
          ".tsx"
        ],
        "application/json": [
          ".json",
          ".jsonc",
          ".prettierrc"
        ],
        "text/html": [
          ".html",
          ".htm",
          ".xhtml"
        ],
        "application/xml": [
          ".xml",
          ".svg"
        ],
        "text/css": [
          ".css"
        ],
        "application/x-yaml": [
          ".yml",
          ".yaml"
        ],
        "text/csv": [
          ".csv"
        ],
        "text/tab-separated-values": [
          ".tsv"
        ],
        "text/x-diff": [
          ".diff",
          ".patch"
        ],
        "text/plain": [
          ".adoc",
          ".asciidoc",
          ".bash",
          ".c",
          ".cc",
          ".cfg",
          ".clj",
          ".cljs",
          ".conf",
          ".cpp",
          ".cs",
          ".cxx",
          ".dart",
          ".dockerfile",
          ".editorconfig",
          ".env",
          ".erl",
          ".ex",
          ".exs",
          ".fish",
          ".fs",
          ".fsx",
          ".gitattributes",
          ".gitignore",
          ".go",
          ".gql",
          ".gradle",
          ".graphql",
          ".groovy",
          ".h",
          ".hcl",
          ".hh",
          ".hpp",
          ".hrl",
          ".ini",
          ".java",
          ".jsx",
          ".kt",
          ".less",
          ".log",
          ".lua",
          ".m",
          ".mm",
          ".nim",
          ".npmrc",
          ".nvmrc",
          ".php",
          ".pl",
          ".pm",
          ".properties",
          ".proto",
          ".ps1",
          ".psd1",
          ".psm1",
          ".py",
          ".r",
          ".rb",
          ".rs",
          ".rst",
          ".sass",
          ".scala",
          ".scss",
          ".sh",
          ".sol",
          ".sql",
          ".styl",
          ".svelte",
          ".swift",
          ".tex",
          ".tf",
          ".tfvars",
          ".toml",
          ".txt",
          ".vb",
          ".vue",
          ".zig",
          ".zsh"
        ]
      },
      "launch_type": "single-client",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "shortcuts": [
    {
      "name": "New document",
      "short_name": "New",
      "description": "Start a new blank document",
      "url": "./rapier.html?new=1",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Welcome guide",
      "short_name": "Welcome",
      "description": "Open the Rapier welcome / user guide",
      "url": "./rapier.html?welcome=1",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+rapier",
      "url": "./rapier.html?share-url=%s"
    }
  ]
}
