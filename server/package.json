{
  "name": "rapier-server",
  "version": "1.1.89",
  "description": "Serve, search, edit and export Markdown from your own folder or S3-compatible bucket, with the Rapier agent door for AI agents over MCP. No account, and nothing downloaded at run time.",
  "keywords": [
    "markdown",
    "server",
    "self-hosted",
    "search",
    "export",
    "pdf",
    "docx",
    "s3",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "rapier"
  ],
  "author": "Jack Skipworth",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "bin": {
    "rapier-server": "./dist/server/cli.mjs"
  },
  "exports": {
    ".": "./dist/server/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "BUILD.json"
  ],
  "scripts": {
    "test": "node ./dist/server/test/run.mjs"
  }
}
