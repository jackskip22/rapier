{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
	"slug": "jxl",
	"publisher": "did:web:pds.rapier.website",
	"name": "JPEG XL Image Optimizer",
	"description": "Makes images smaller with JPEG XL. Photos shrink about 75% with the same look, text stays sharp. Originals kept for incompatible browsers.",
	"keywords": ["images", "jpeg xl", "media", "storage"],
	"license": "MIT",
	"author": { "name": "Rapier", "url": "https://rapier.website" },
	"security": { "email": "hello@rapier.website" },
	"sections": {
		"description": { "file": "./docs/description.md" },
		"installation": { "file": "./docs/installation.md" },
		"faq": { "file": "./docs/faq.md" },
		"security": { "file": "./docs/security.md" }
	},
	// This companion renders setup instructions without reading site data.
	"capabilities": [],
	"allowedHosts": [],
	"storage": {},
	"admin": { "pages": [{ "path": "/jpeg-xl", "label": "JPEG XL Image Optimizer", "icon": "image" }] },
	"release": {
		"requires": { "env:emdash": ">=1.4.0 <2.0.0" },
		"artifacts": {
			"icon": { "file": "./images/icon.png" },
			"screenshots": [
				{ "file": "./images/optimizer-1440x1000-light.png", "lang": "en" },
				{ "file": "./images/optimizer-390x844-light.png", "lang": "en" },
				{ "file": "./images/recent-menu-1440x1000-light.png", "lang": "en" },
				{ "file": "./images/optimizer-1440x1000-dark.png", "lang": "en" },
				{ "file": "./images/optimizer-390x844-dark.png", "lang": "en" }
			]
		}
	}
}

