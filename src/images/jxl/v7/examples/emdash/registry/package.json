{
	"name": "jxl",
	"version": "0.1.3",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.9.0",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc",
		"README.md",
		"docs",
		"images"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test:unit": "node --experimental-strip-types --test tests/*.node.mjs",
		"test": "npm run test:unit && emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup",
		"prebuild": "node scripts/sync-words.mjs",
		"prevalidate": "node scripts/sync-words.mjs"
	},
	"peerDependencies": {
		"emdash": ">=1.4.0 <2.0.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.5",
		"@emdash-cms/plugin-test": "0.2.11",
		"emdash": "1.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.12"
	}
}
