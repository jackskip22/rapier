            (br_if $d8Row (i32.lt_u (local.get $v) (i32.const 8))))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (br_if $d8Ch (i32.lt_u (local.get $c) (i32.const 3))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $d8Blocks (i32.lt_u (local.get $i) (local.get $n))))
