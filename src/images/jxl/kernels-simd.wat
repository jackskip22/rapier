                  (else
                    (call $scatterDense (local.get $symbols) (local.get $indices) (local.get $total)
                      (local.get $kinds) (local.get $stride) (i32.add (local.get $parent) (local.get $offset))
                      (i32.const 0) (i32.const -1))))
