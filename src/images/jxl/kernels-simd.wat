                (local.set $rawTotals (v128.load offset=16 (local.get $stats)))
                (local.set $symPtr (i32.add (i32.add (local.get $workDense) (i32.shl (local.get $from) (i32.const 4))) (local.get $c)))
                (local.set $i (local.get $from))
