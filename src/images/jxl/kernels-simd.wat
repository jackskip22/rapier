  ;; Carbon lexer-refine: packet ensemble and exact tree decoder. This fragment is appended inside kernels-simd.wat.
  ;; Host validation fixes D=32/O=16, H1/H2 <=64 and an ensemble output bound <=2^20. Thus all rectangle scores fit i32.
  ;; Whole-picture sums use i64. Scratch for $intMlp is 512 bytes, with H2 immediately following H1.
  (func $refineEnsemble (export "refineEnsemble")
    (param $packets i32) (param $packetCount i32) (param $inputs i32) (param $cells i32)
    (param $out i32) (param $temporary i32) (param $scratch i32)
    (local $p i32) (local $i i32) (local $bytes i32)
    (local.set $bytes (i32.shl (local.get $cells) (i32.const 6)))
    (memory.fill (local.get $out) (i32.const 0) (local.get $bytes))
    (block $done (loop $packet
      (br_if $done (i32.ge_u (local.get $p) (local.get $packetCount)))
      (call $intMlp (i32.load (i32.add (local.get $packets) (i32.shl (local.get $p) (i32.const 2))))
        (local.get $inputs) (local.get $cells) (local.get $temporary) (local.get $scratch))
      (local.set $i (i32.const 0))
      (block $sumDone (loop $sum
        (br_if $sumDone (i32.ge_u (local.get $i) (local.get $bytes)))
        (i32.store (i32.add (local.get $out) (local.get $i))
          (i32.add (i32.load (i32.add (local.get $out) (local.get $i)))
            (i32.load (i32.add (local.get $temporary) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 4)))
        (br $sum)))
      (local.set $p (i32.add (local.get $p) (i32.const 1)))
      (br $packet))))

  (func $refineTreeMax (param $a i32) (param $b i32) (result i32)
    (select (local.get $a) (local.get $b) (i32.gt_s (local.get $a) (local.get $b))))

  ;; Sum a fitted rectangle's chosen class plus its bias and negative worst-cell merge veto.
  (func $refineTreeScore (param $logits i32) (param $stride i32) (param $x i32) (param $y i32)
    (param $w i32) (param $h i32) (param $class i32) (param $bias i32) (param $weight i32) (result i32)
    (local $dx i32) (local $dy i32) (local $at i32) (local $v i32) (local $delta i32) (local $worst i32)
    (local.set $worst (i32.const 32767))
    (block $done (loop $row
      (br_if $done (i32.ge_u (local.get $dy) (local.get $h)))
      (local.set $dx (i32.const 0))
      (block $rowDone (loop $cell
        (br_if $rowDone (i32.ge_u (local.get $dx) (local.get $w)))
        (local.set $at (i32.add (local.get $logits) (i32.shl
          (i32.add (i32.mul (i32.add (local.get $y) (local.get $dy)) (local.get $stride))
            (i32.add (local.get $x) (local.get $dx))) (i32.const 6))))
        (local.set $v (i32.load (i32.add (local.get $at) (i32.shl (local.get $class) (i32.const 2)))))
        (local.set $bias (i32.add (local.get $bias) (local.get $v)))
        (local.set $delta (i32.sub (local.get $v) (i32.load (local.get $at))))
        (if (i32.lt_s (local.get $delta) (local.get $worst)) (then (local.set $worst (local.get $delta))))
        (local.set $dx (i32.add (local.get $dx) (i32.const 1)))
        (br $cell)))
      (local.set $dy (i32.add (local.get $dy) (i32.const 1)))
      (br $row)))
    (i32.add (local.get $bias)
      (select (i32.mul (local.get $worst) (local.get $weight)) (i32.const 0) (i32.lt_s (local.get $worst) (i32.const 0)))))

  ;; Heads are a row-major i32 grid. -1 marks covered cells; every non-negative entry is a block head.
  (func $refineTreePut (param $heads i32) (param $stride i32) (param $x i32) (param $y i32)
    (param $w i32) (param $h i32) (param $id i32)
    (local $dy i32)
    (block $done (loop $row
      (br_if $done (i32.ge_u (local.get $dy) (local.get $h)))
      (memory.fill (i32.add (local.get $heads) (i32.shl
        (i32.add (i32.mul (i32.add (local.get $y) (local.get $dy)) (local.get $stride)) (local.get $x)) (i32.const 2)))
        (i32.const 255) (i32.shl (local.get $w) (i32.const 2)))
      (local.set $dy (i32.add (local.get $dy) (i32.const 1)))
      (br $row)))
    (i32.store (i32.add (local.get $heads) (i32.shl
      (i32.add (i32.mul (local.get $y) (local.get $stride)) (local.get $x)) (i32.const 2))) (local.get $id)))

  (func $refineTreeQuad (param $logits i32) (param $heads i32) (param $stride i32) (param $rows i32)
    (param $x i32) (param $y i32) (param $merge i32) (result i32)
    (local $w i32) (local $h i32) (local $s16 i32) (local $v0 i32) (local $v1 i32) (local $v00 i32) (local $v10 i32)
    (local $h0 i32) (local $h1 i32) (local $h00 i32) (local $h10 i32) (local $sv i32) (local $sh i32)
    (if (i32.or (i32.ge_u (local.get $x) (local.get $stride)) (i32.ge_u (local.get $y) (local.get $rows)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.gt_u (i32.add (local.get $x) (i32.const 2)) (local.get $stride))
                (i32.gt_u (i32.add (local.get $y) (i32.const 2)) (local.get $rows)))
      (then
        (local.set $w (select (i32.const 2) (i32.const 1) (i32.lt_u (i32.add (local.get $x) (i32.const 1)) (local.get $stride))))
        (local.set $h (select (i32.const 2) (i32.const 1) (i32.lt_u (i32.add (local.get $y) (i32.const 1)) (local.get $rows))))
        (return (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (local.get $y)
          (local.get $w) (local.get $h) (i32.const 0) (i32.const 0) (i32.const 0)))))
    (local.set $s16 (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (local.get $y)
      (i32.const 2) (i32.const 2) (i32.const 1) (i32.mul (local.get $merge) (i32.const 4)) (i32.const 2)))
    (local.set $v0 (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (local.get $y)
      (i32.const 1) (i32.const 2) (i32.const 3) (i32.mul (local.get $merge) (i32.const 2)) (i32.const 1)))
    (local.set $v1 (call $refineTreeScore (local.get $logits) (local.get $stride) (i32.add (local.get $x) (i32.const 1)) (local.get $y)
      (i32.const 1) (i32.const 2) (i32.const 3) (i32.mul (local.get $merge) (i32.const 2)) (i32.const 1)))
    (local.set $v00 (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (local.get $y)
      (i32.const 1) (i32.const 2) (i32.const 0) (i32.const 0) (i32.const 0)))
    (local.set $v10 (call $refineTreeScore (local.get $logits) (local.get $stride) (i32.add (local.get $x) (i32.const 1)) (local.get $y)
      (i32.const 1) (i32.const 2) (i32.const 0) (i32.const 0) (i32.const 0)))
    (local.set $h0 (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (local.get $y)
      (i32.const 2) (i32.const 1) (i32.const 4) (i32.mul (local.get $merge) (i32.const 2)) (i32.const 1)))
    (local.set $h1 (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (i32.add (local.get $y) (i32.const 1))
      (i32.const 2) (i32.const 1) (i32.const 4) (i32.mul (local.get $merge) (i32.const 2)) (i32.const 1)))
    (local.set $h00 (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (local.get $y)
      (i32.const 2) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 0)))
    (local.set $h10 (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (i32.add (local.get $y) (i32.const 1))
      (i32.const 2) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 0)))
    (local.set $sv (i32.add (call $refineTreeMax (local.get $v0) (local.get $v00)) (call $refineTreeMax (local.get $v1) (local.get $v10))))
    (local.set $sh (i32.add (call $refineTreeMax (local.get $h0) (local.get $h00)) (call $refineTreeMax (local.get $h1) (local.get $h10))))
    (if (i32.and (i32.ge_s (local.get $s16) (local.get $sv)) (i32.ge_s (local.get $s16) (local.get $sh)))
      (then
        (call $refineTreePut (local.get $heads) (local.get $stride) (local.get $x) (local.get $y) (i32.const 2) (i32.const 2) (i32.const 4))
        (return (local.get $s16))))
    (if (i32.ge_s (local.get $sv) (local.get $sh))
      (then
        (if (i32.gt_s (local.get $v0) (local.get $v00))
          (then (call $refineTreePut (local.get $heads) (local.get $stride) (local.get $x) (local.get $y) (i32.const 1) (i32.const 2) (i32.const 6))))
        (if (i32.gt_s (local.get $v1) (local.get $v10))
          (then (call $refineTreePut (local.get $heads) (local.get $stride) (i32.add (local.get $x) (i32.const 1)) (local.get $y) (i32.const 1) (i32.const 2) (i32.const 6))))
        (return (local.get $sv))))
    (if (i32.gt_s (local.get $h0) (local.get $h00))
      (then (call $refineTreePut (local.get $heads) (local.get $stride) (local.get $x) (local.get $y) (i32.const 2) (i32.const 1) (i32.const 7))))
    (if (i32.gt_s (local.get $h1) (local.get $h10))
      (then (call $refineTreePut (local.get $heads) (local.get $stride) (local.get $x) (i32.add (local.get $y) (i32.const 1)) (i32.const 2) (i32.const 1) (i32.const 7))))
    (local.get $sh))

  (func $refineDecode (export "refineDecode")
    (param $logits i32) (param $stride i32) (param $rows i32) (param $gap i32) (param $slope i32)
    (param $qBias i32) (param $merge i32) (param $dzBias i32) (param $protect i32) (param $couple i32)
    (param $heads i32) (param $deadzone i32) (param $meta i32)
    (local $cells i32) (local $i i32) (local $at i32) (local $k i32) (local $best i32) (local $value i32) (local $v i32)
    (local $x i32) (local $y i32) (local $q00 i32) (local $q10 i32) (local $q01 i32) (local $q11 i32)
    (local $s32 i32) (local $l i32) (local $r i32) (local $t i32) (local $b i32) (local $l0 i32) (local $r0 i32) (local $t0 i32) (local $b0 i32)
    (local $sv i32) (local $sh i32) (local $delta i32)
    (local $dq i64) (local $epf0 i64) (local $epf1 i64) (local $epf2 i64) (local $dzNet i64) (local $cells32 i64)
    (local $count i64) (local $gapQ i64) (local $dzComp i64)
    (local.set $cells (i32.mul (local.get $stride) (local.get $rows)))
    (local.set $count (i64.extend_i32_u (local.get $cells)))
    (memory.fill (local.get $heads) (i32.const 0) (i32.shl (local.get $cells) (i32.const 2)))
    (block $cellsDone (loop $cell
      (br_if $cellsDone (i32.ge_u (local.get $i) (local.get $cells)))
      (local.set $at (i32.add (local.get $logits) (i32.shl (local.get $i) (i32.const 6))))
      (local.set $best (i32.const 0))
      (local.set $value (i32.load offset=28 (local.get $at)))
      (local.set $k (i32.const 1))
      (block $dzDone (loop $dz
        (br_if $dzDone (i32.ge_u (local.get $k) (i32.const 5)))
        (local.set $v (i32.add
          (i32.load (i32.add (local.get $at) (i32.shl (i32.add (local.get $k) (i32.const 7)) (i32.const 2))))
          (select (local.get $protect)
            (select (i32.sub (i32.const 0) (local.get $dzBias)) (i32.sub (i32.const 0) (i32.shl (local.get $dzBias) (i32.const 1)))
              (i32.eq (local.get $k) (i32.const 3))) (i32.le_u (local.get $k) (i32.const 2)))))
        (if (i32.gt_s (local.get $v) (local.get $value))
          (then (local.set $value (local.get $v)) (local.set $best (local.get $k))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $dz)))
      (f64.store (i32.add (local.get $deadzone) (i32.shl (local.get $i) (i32.const 3)))
        (select (f64.const 1)
          (select (f64.const 0.72)
            (select (f64.const 0.82)
              (select (f64.const 1.22) (f64.const 1.44) (i32.eq (local.get $best) (i32.const 3)))
              (i32.eq (local.get $best) (i32.const 2)))
            (i32.eq (local.get $best) (i32.const 1)))
          (i32.eqz (local.get $best))))
      (local.set $dzNet (i64.add (local.get $dzNet)
        (i64.extend_i32_s (select (i32.const 0)
          (select (i32.sub (local.get $best) (i32.const 3)) (i32.sub (local.get $best) (i32.const 2))
            (i32.le_u (local.get $best) (i32.const 2))) (i32.eqz (local.get $best))))))
      (local.set $epf0 (i64.add (local.get $epf0) (i64.extend_i32_s (i32.load offset=48 (local.get $at)))))
      (local.set $epf1 (i64.add (local.get $epf1) (i64.extend_i32_s (i32.load offset=52 (local.get $at)))))
      (local.set $epf2 (i64.add (local.get $epf2) (i64.extend_i32_s (i32.load offset=56 (local.get $at)))))
      (local.set $dq (i64.add (local.get $dq) (i64.extend_i32_s (i32.load offset=60 (local.get $at)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cell)))
    (block $rowsDone (loop $row
      (br_if $rowsDone (i32.ge_u (local.get $y) (local.get $rows)))
      (local.set $x (i32.const 0))
      (block $rowDone (loop $region
        (br_if $rowDone (i32.ge_u (local.get $x) (local.get $stride)))
        (local.set $q00 (call $refineTreeQuad (local.get $logits) (local.get $heads) (local.get $stride) (local.get $rows) (local.get $x) (local.get $y) (local.get $merge)))
        (local.set $q10 (call $refineTreeQuad (local.get $logits) (local.get $heads) (local.get $stride) (local.get $rows) (i32.add (local.get $x) (i32.const 2)) (local.get $y) (local.get $merge)))
        (local.set $q01 (call $refineTreeQuad (local.get $logits) (local.get $heads) (local.get $stride) (local.get $rows) (local.get $x) (i32.add (local.get $y) (i32.const 2)) (local.get $merge)))
        (local.set $q11 (call $refineTreeQuad (local.get $logits) (local.get $heads) (local.get $stride) (local.get $rows) (i32.add (local.get $x) (i32.const 2)) (i32.add (local.get $y) (i32.const 2)) (local.get $merge)))
        (if (i32.and (i32.le_u (i32.add (local.get $x) (i32.const 4)) (local.get $stride))
                     (i32.le_u (i32.add (local.get $y) (i32.const 4)) (local.get $rows)))
          (then
            (local.set $s32 (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (local.get $y)
              (i32.const 4) (i32.const 4) (i32.const 2) (i32.mul (local.get $merge) (i32.const 20)) (i32.const 6)))
            (local.set $l (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (local.get $y)
              (i32.const 2) (i32.const 4) (i32.const 5) (i32.mul (local.get $merge) (i32.const 9)) (i32.const 3)))
            (local.set $r (call $refineTreeScore (local.get $logits) (local.get $stride) (i32.add (local.get $x) (i32.const 2)) (local.get $y)
              (i32.const 2) (i32.const 4) (i32.const 5) (i32.mul (local.get $merge) (i32.const 9)) (i32.const 3)))
            (local.set $t (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (local.get $y)
              (i32.const 4) (i32.const 2) (i32.const 6) (i32.mul (local.get $merge) (i32.const 9)) (i32.const 3)))
            (local.set $b (call $refineTreeScore (local.get $logits) (local.get $stride) (local.get $x) (i32.add (local.get $y) (i32.const 2))
              (i32.const 4) (i32.const 2) (i32.const 6) (i32.mul (local.get $merge) (i32.const 9)) (i32.const 3)))
            (local.set $l0 (i32.add (local.get $q00) (local.get $q01)))
            (local.set $r0 (i32.add (local.get $q10) (local.get $q11)))
            (local.set $t0 (i32.add (local.get $q00) (local.get $q10)))
            (local.set $b0 (i32.add (local.get $q01) (local.get $q11)))
            (local.set $sv (i32.add (call $refineTreeMax (local.get $l) (local.get $l0)) (call $refineTreeMax (local.get $r) (local.get $r0))))
            (local.set $sh (i32.add (call $refineTreeMax (local.get $t) (local.get $t0)) (call $refineTreeMax (local.get $b) (local.get $b0))))
            (if (i32.and (i32.ge_s (local.get $s32) (local.get $sv)) (i32.ge_s (local.get $s32) (local.get $sh)))
              (then
                (call $refineTreePut (local.get $heads) (local.get $stride) (local.get $x) (local.get $y) (i32.const 4) (i32.const 4) (i32.const 5))
                (local.set $cells32 (i64.add (local.get $cells32) (i64.const 16))))
              (else
                (if (i32.ge_s (local.get $sv) (local.get $sh))
                  (then
                    (if (i32.gt_s (local.get $l) (local.get $l0)) (then
                      (call $refineTreePut (local.get $heads) (local.get $stride) (local.get $x) (local.get $y) (i32.const 2) (i32.const 4) (i32.const 10))))
                    (if (i32.gt_s (local.get $r) (local.get $r0)) (then
                      (call $refineTreePut (local.get $heads) (local.get $stride) (i32.add (local.get $x) (i32.const 2)) (local.get $y) (i32.const 2) (i32.const 4) (i32.const 10)))))
                  (else
                    (if (i32.gt_s (local.get $t) (local.get $t0)) (then
                      (call $refineTreePut (local.get $heads) (local.get $stride) (local.get $x) (local.get $y) (i32.const 4) (i32.const 2) (i32.const 11))))
                    (if (i32.gt_s (local.get $b) (local.get $b0)) (then
                      (call $refineTreePut (local.get $heads) (local.get $stride) (local.get $x) (i32.add (local.get $y) (i32.const 2)) (i32.const 4) (i32.const 2) (i32.const 11))))))))))
        (local.set $x (i32.add (local.get $x) (i32.const 4)))
        (br $region)))
      (local.set $y (i32.add (local.get $y) (i32.const 4)))
      (br $row)))
    (i32.store (local.get $meta)
      (select (i32.const 1)
        (select (i32.const 2) (i32.const 0) (i32.and (i64.gt_s (local.get $epf2) (local.get $epf0)) (i64.gt_s (local.get $epf2) (local.get $epf1))))
        (i32.and (i64.gt_s (local.get $epf1) (local.get $epf0)) (i64.ge_s (local.get $epf1) (local.get $epf2)))))
    (local.set $gapQ (i64.div_s (i64.shl (i64.extend_i32_s (call $refineTreeMax (local.get $gap) (i32.const 0))) (i64.const 6))
      (i64.extend_i32_s (call $refineTreeMax (local.get $slope) (i32.const 90)))))
    (if (local.get $couple) (then
      (local.set $dzComp (i64.div_s
        (i64.add (i64.mul (local.get $dzNet) (i64.const 44))
          (i64.mul (i64.sub (local.get $cells32) (i64.shr_u (local.get $count) (i64.const 2))) (i64.const 20)))
        (local.get $count)))))
    (local.set $dq (i64.add (i64.add (i64.sub (i64.div_s (local.get $dq) (local.get $count)) (local.get $gapQ)) (local.get $dzComp))
      (i64.extend_i32_s (local.get $qBias))))
    (local.set $delta (i32.wrap_i64
      (select (i64.const -512) (select (i64.const 448) (local.get $dq) (i64.gt_s (local.get $dq) (i64.const 448)))
        (i64.lt_s (local.get $dq) (i64.const -512)))))
    (i32.store offset=4 (local.get $meta) (local.get $delta)))
  ;; Integer spatial, gradient, curvature and cross-channel correlation features for learned encoder search steering.
  ;; Zero floating point and zero relaxed SIMD: 4-pixel i32x4 SIMD128 inner loop with i64 frame accumulators.
  (func $med4 (param $a v128) (param $b v128) (param $c v128) (result v128)
    (i32x4.min_s
      (i32x4.max_s
        (i32x4.sub (i32x4.add (local.get $a) (local.get $b)) (local.get $c))
        (i32x4.min_s (local.get $a) (local.get $b)))
      (i32x4.max_s (local.get $a) (local.get $b))))
  (func $hsum4s (param $v v128) (result i64)
    (i64.extend_i32_s
      (i32.add
        (i32.add (i32x4.extract_lane 0 (local.get $v)) (i32x4.extract_lane 1 (local.get $v)))
        (i32.add (i32x4.extract_lane 2 (local.get $v)) (i32x4.extract_lane 3 (local.get $v))))))
  (func $med1s (param $a i32) (param $b i32) (param $c i32) (result i32)
    (local $mn i32) (local $mx i32) (local $p i32)
    (local.set $mn (select (local.get $a) (local.get $b) (i32.lt_s (local.get $a) (local.get $b))))
    (local.set $mx (select (local.get $a) (local.get $b) (i32.gt_s (local.get $a) (local.get $b))))
    (local.set $p (i32.sub (i32.add (local.get $a) (local.get $b)) (local.get $c)))
    (select (local.get $mn) (select (local.get $mx) (local.get $p) (i32.gt_s (local.get $p) (local.get $mx))) (i32.lt_s (local.get $p) (local.get $mn))))
  (func $abs1s (param $x i32) (result i32)
    (select (i32.sub (i32.const 0) (local.get $x)) (local.get $x) (i32.lt_s (local.get $x) (i32.const 0))))
  (func $qScaleClamp (param $num i64) (param $mul i64) (param $cnt i64) (result i32)
    (local $v i64)
    (local.set $v (i64.div_s (i64.mul (local.get $num) (local.get $mul)) (local.get $cnt)))
    (if (i64.lt_s (local.get $v) (i64.const -32767)) (then (return (i32.const -32767))))
    (if (i64.gt_s (local.get $v) (i64.const 32767)) (then (return (i32.const 32767))))
    (i32.wrap_i64 (local.get $v)))
  (func $decisionStats
    (export "decisionStats")
    (param $rgba i32) (param $stride i32) (param $x0 i32) (param $y0 i32)
    (param $w i32) (param $h i32) (param $stepY i32) (param $out i32)
    (local $y i32) (local $x i32) (local $row i32) (local $prev i32) (local $p i32) (local $pw i32) (local $pn i32) (local $pnw i32)
    (local $flat i64) (local $smooth i64) (local $hard i64) (local $medt i64) (local $noise i64)
    (local $sGH i64) (local $sGV i64) (local $sCl i64) (local $sAv i64) (local $sLp i64)
    (local $sCo i64) (local $sCg i64) (local $sRG i64) (local $sBG i64) (local $sCP i64) (local $sCM i64) (local $cnt i64)
    (local $vMaskRGB v128) (local $v255 v128)
    (local $vFlat v128) (local $vSmooth v128) (local $vHard v128) (local $vMedt v128) (local $vNoise v128)
    (local $vGH v128) (local $vGV v128) (local $vCl v128) (local $vAv v128) (local $vLp v128)
    (local $vCo v128) (local $vCg v128) (local $vRG v128) (local $vBG v128) (local $vCP v128) (local $vCM v128)
    (local $vC v128) (local $vW v128) (local $vN v128) (local $vNW v128)
    (local $r v128) (local $g v128) (local $b v128)
    (local $rw v128) (local $gw v128) (local $bw v128)
    (local $rn v128) (local $gn v128) (local $bn v128)
    (local $rnw v128) (local $gnw v128) (local $bnw v128)
    (local $co v128) (local $cg v128) (local $yy v128)
    (local $cow v128) (local $cgw v128) (local $yw v128)
    (local $con v128) (local $cgn v128) (local $yn v128)
    (local $conw v128) (local $cgnw v128) (local $ynw v128)
    (local $dh v128) (local $dv v128) (local $mx v128) (local $lap v128) (local $dCo v128) (local $dCg v128)
    (local $sr i32) (local $sg i32) (local $sb i32) (local $srw i32) (local $sgw i32) (local $sbw i32)
    (local $srn i32) (local $sgn i32) (local $sbn i32) (local $srnw i32) (local $sgnw i32) (local $sbnw i32)
    (local $sco i32) (local $scg i32) (local $syy i32) (local $scow i32) (local $scgw i32) (local $syw i32)
    (local $scon i32) (local $scgn i32) (local $syn i32) (local $sconw i32) (local $scgnw i32) (local $synw i32)
    (local $sdh i32) (local $sdv i32) (local $smx i32) (local $slap i32) (local $sdCo i32) (local $sdCg i32)
    (memory.fill (local.get $out) (i32.const 0) (i32.const 64))
    (if (i32.or (i32.lt_s (local.get $w) (i32.const 2)) (i32.lt_s (local.get $h) (i32.const 2))) (then (return)))
    (if (i32.lt_s (local.get $stepY) (i32.const 1)) (then (local.set $stepY (i32.const 1))))
    (local.set $vMaskRGB (i32x4.splat (i32.const 0x00ffffff)))
    (local.set $v255 (i32x4.splat (i32.const 255)))
    (local.set $y (i32.const 1))
    (block $yDone
      (loop $yLoop
        (br_if $yDone (i32.ge_s (local.get $y) (local.get $h)))
        (local.set $row (i32.add (local.get $rgba) (i32.shl (i32.add (i32.mul (i32.add (local.get $y0) (local.get $y)) (local.get $stride)) (local.get $x0)) (i32.const 2))))
        (local.set $prev (i32.sub (local.get $row) (i32.shl (local.get $stride) (i32.const 2))))
        (local.set $vFlat (i32x4.splat (i32.const 0)))
        (local.set $vSmooth (i32x4.splat (i32.const 0)))
        (local.set $vHard (i32x4.splat (i32.const 0)))
        (local.set $vMedt (i32x4.splat (i32.const 0)))
        (local.set $vNoise (i32x4.splat (i32.const 0)))
        (local.set $vGH (i32x4.splat (i32.const 0)))
        (local.set $vGV (i32x4.splat (i32.const 0)))
        (local.set $vCl (i32x4.splat (i32.const 0)))
        (local.set $vAv (i32x4.splat (i32.const 0)))
        (local.set $vLp (i32x4.splat (i32.const 0)))
        (local.set $vCo (i32x4.splat (i32.const 0)))
        (local.set $vCg (i32x4.splat (i32.const 0)))
        (local.set $vRG (i32x4.splat (i32.const 0)))
        (local.set $vBG (i32x4.splat (i32.const 0)))
        (local.set $vCP (i32x4.splat (i32.const 0)))
        (local.set $vCM (i32x4.splat (i32.const 0)))
        (local.set $x (i32.const 1))
        (block $xSimdDone
          (loop $xSimd
            (br_if $xSimdDone (i32.gt_s (i32.add (local.get $x) (i32.const 4)) (local.get $w)))
            (local.set $p (i32.add (local.get $row) (i32.shl (local.get $x) (i32.const 2))))
            (local.set $pn (i32.add (local.get $prev) (i32.shl (local.get $x) (i32.const 2))))
            (local.set $vC (v128.load align=1 (local.get $p)))
            (local.set $vW (v128.load align=1 (i32.sub (local.get $p) (i32.const 4))))
            (local.set $vN (v128.load align=1 (local.get $pn)))
            (local.set $vNW (v128.load align=1 (i32.sub (local.get $pn) (i32.const 4))))
            (local.set $vFlat (i32x4.sub (local.get $vFlat)
              (v128.and
                (i32x4.eq (v128.and (local.get $vC) (local.get $vMaskRGB)) (v128.and (local.get $vW) (local.get $vMaskRGB)))
                (i32x4.eq (v128.and (local.get $vC) (local.get $vMaskRGB)) (v128.and (local.get $vN) (local.get $vMaskRGB))))))
            (local.set $r (v128.and (local.get $vC) (local.get $v255)))
            (local.set $g (v128.and (i32x4.shr_u (local.get $vC) (i32.const 8)) (local.get $v255)))
            (local.set $b (v128.and (i32x4.shr_u (local.get $vC) (i32.const 16)) (local.get $v255)))
            (local.set $rw (v128.and (local.get $vW) (local.get $v255)))
            (local.set $gw (v128.and (i32x4.shr_u (local.get $vW) (i32.const 8)) (local.get $v255)))
            (local.set $bw (v128.and (i32x4.shr_u (local.get $vW) (i32.const 16)) (local.get $v255)))
            (local.set $rn (v128.and (local.get $vN) (local.get $v255)))
            (local.set $gn (v128.and (i32x4.shr_u (local.get $vN) (i32.const 8)) (local.get $v255)))
            (local.set $bn (v128.and (i32x4.shr_u (local.get $vN) (i32.const 16)) (local.get $v255)))
            (local.set $rnw (v128.and (local.get $vNW) (local.get $v255)))
            (local.set $gnw (v128.and (i32x4.shr_u (local.get $vNW) (i32.const 8)) (local.get $v255)))
            (local.set $bnw (v128.and (i32x4.shr_u (local.get $vNW) (i32.const 16)) (local.get $v255)))

            (local.set $co (i32x4.sub (local.get $r) (local.get $b)))
            (local.set $yy (i32x4.add (local.get $b) (i32x4.shr_s (local.get $co) (i32.const 1))))
            (local.set $cg (i32x4.sub (local.get $g) (local.get $yy)))
            (local.set $yy (i32x4.add (local.get $yy) (i32x4.shr_s (local.get $cg) (i32.const 1))))

            (local.set $cow (i32x4.sub (local.get $rw) (local.get $bw)))
            (local.set $yw (i32x4.add (local.get $bw) (i32x4.shr_s (local.get $cow) (i32.const 1))))
            (local.set $cgw (i32x4.sub (local.get $gw) (local.get $yw)))
            (local.set $yw (i32x4.add (local.get $yw) (i32x4.shr_s (local.get $cgw) (i32.const 1))))

            (local.set $con (i32x4.sub (local.get $rn) (local.get $bn)))
            (local.set $yn (i32x4.add (local.get $bn) (i32x4.shr_s (local.get $con) (i32.const 1))))
            (local.set $cgn (i32x4.sub (local.get $gn) (local.get $yn)))
            (local.set $yn (i32x4.add (local.get $yn) (i32x4.shr_s (local.get $cgn) (i32.const 1))))

            (local.set $conw (i32x4.sub (local.get $rnw) (local.get $bnw)))
            (local.set $ynw (i32x4.add (local.get $bnw) (i32x4.shr_s (local.get $conw) (i32.const 1))))
            (local.set $cgnw (i32x4.sub (local.get $gnw) (local.get $ynw)))
            (local.set $ynw (i32x4.add (local.get $ynw) (i32x4.shr_s (local.get $cgnw) (i32.const 1))))

            (local.set $dh (i32x4.abs (i32x4.sub (local.get $yy) (local.get $yw))))
            (local.set $dv (i32x4.abs (i32x4.sub (local.get $yy) (local.get $yn))))
            (local.set $mx (i32x4.max_s (local.get $dh) (local.get $dv)))
            (local.set $vSmooth (i32x4.sub (local.get $vSmooth) (i32x4.le_s (i32x4.add (local.get $dh) (local.get $dv)) (i32x4.splat (i32.const 2)))))
            (local.set $vHard (i32x4.sub (local.get $vHard) (i32x4.ge_s (local.get $mx) (i32x4.splat (i32.const 32)))))
            (local.set $vMedt (i32x4.sub (local.get $vMedt)
              (v128.and (i32x4.ge_s (local.get $mx) (i32x4.splat (i32.const 4))) (i32x4.lt_s (local.get $mx) (i32x4.splat (i32.const 32))))))
            (local.set $lap (i32x4.abs (i32x4.sub (i32x4.add (local.get $yy) (local.get $ynw)) (i32x4.add (local.get $yw) (local.get $yn)))))
            (local.set $vNoise (i32x4.sub (local.get $vNoise)
              (v128.and
                (v128.and (i32x4.ge_s (local.get $lap) (i32x4.splat (i32.const 1))) (i32x4.le_s (local.get $lap) (i32x4.splat (i32.const 6))))
                (i32x4.lt_s (local.get $mx) (i32x4.splat (i32.const 12))))))

            (local.set $vGH (i32x4.add (local.get $vGH) (local.get $dh)))
            (local.set $vGV (i32x4.add (local.get $vGV) (local.get $dv)))
            (local.set $vCl (i32x4.add (local.get $vCl) (i32x4.abs (i32x4.sub (local.get $yy) (call $med4 (local.get $yw) (local.get $yn) (local.get $ynw))))))
            (local.set $vAv (i32x4.add (local.get $vAv) (i32x4.abs (i32x4.sub (local.get $yy) (i32x4.shr_s (i32x4.add (local.get $yw) (local.get $yn)) (i32.const 1))))))
            (local.set $vLp (i32x4.add (local.get $vLp) (local.get $lap)))

            (local.set $dCo (i32x4.sub (local.get $co) (call $med4 (local.get $cow) (local.get $con) (local.get $conw))))
            (local.set $dCg (i32x4.sub (local.get $cg) (call $med4 (local.get $cgw) (local.get $cgn) (local.get $cgnw))))
            (local.set $vCo (i32x4.add (local.get $vCo) (i32x4.abs (local.get $dCo))))
            (local.set $vCg (i32x4.add (local.get $vCg) (i32x4.abs (local.get $dCg))))
            (local.set $vCP (i32x4.add (local.get $vCP) (i32x4.abs (i32x4.add (local.get $dCo) (local.get $dCg)))))
            (local.set $vCM (i32x4.add (local.get $vCM) (i32x4.abs (i32x4.sub (local.get $dCo) (local.get $dCg)))))

            (local.set $vRG (i32x4.add (local.get $vRG) (i32x4.abs (i32x4.sub (i32x4.sub (local.get $r) (local.get $g))
              (call $med4 (i32x4.sub (local.get $rw) (local.get $gw)) (i32x4.sub (local.get $rn) (local.get $gn)) (i32x4.sub (local.get $rnw) (local.get $gnw)))))))
            (local.set $vBG (i32x4.add (local.get $vBG) (i32x4.abs (i32x4.sub (i32x4.sub (local.get $b) (local.get $g))
              (call $med4 (i32x4.sub (local.get $bw) (local.get $gw)) (i32x4.sub (local.get $bn) (local.get $gn)) (i32x4.sub (local.get $bnw) (local.get $gnw)))))))

            (local.set $cnt (i64.add (local.get $cnt) (i64.const 4)))
            (local.set $x (i32.add (local.get $x) (i32.const 4)))
            (br $xSimd)))

        (local.set $flat (i64.add (local.get $flat) (call $hsum4s (local.get $vFlat))))
        (local.set $smooth (i64.add (local.get $smooth) (call $hsum4s (local.get $vSmooth))))
        (local.set $hard (i64.add (local.get $hard) (call $hsum4s (local.get $vHard))))
        (local.set $medt (i64.add (local.get $medt) (call $hsum4s (local.get $vMedt))))
        (local.set $noise (i64.add (local.get $noise) (call $hsum4s (local.get $vNoise))))
        (local.set $sGH (i64.add (local.get $sGH) (call $hsum4s (local.get $vGH))))
        (local.set $sGV (i64.add (local.get $sGV) (call $hsum4s (local.get $vGV))))
        (local.set $sCl (i64.add (local.get $sCl) (call $hsum4s (local.get $vCl))))
        (local.set $sAv (i64.add (local.get $sAv) (call $hsum4s (local.get $vAv))))
        (local.set $sLp (i64.add (local.get $sLp) (call $hsum4s (local.get $vLp))))
        (local.set $sCo (i64.add (local.get $sCo) (call $hsum4s (local.get $vCo))))
        (local.set $sCg (i64.add (local.get $sCg) (call $hsum4s (local.get $vCg))))
        (local.set $sRG (i64.add (local.get $sRG) (call $hsum4s (local.get $vRG))))
        (local.set $sBG (i64.add (local.get $sBG) (call $hsum4s (local.get $vBG))))
        (local.set $sCP (i64.add (local.get $sCP) (call $hsum4s (local.get $vCP))))
        (local.set $sCM (i64.add (local.get $sCM) (call $hsum4s (local.get $vCM))))

        (block $xTailDone
          (loop $xTail
            (br_if $xTailDone (i32.ge_s (local.get $x) (local.get $w)))
            (local.set $p (i32.add (local.get $row) (i32.shl (local.get $x) (i32.const 2))))
            (local.set $pw (i32.sub (local.get $p) (i32.const 4)))
            (local.set $pn (i32.add (local.get $prev) (i32.shl (local.get $x) (i32.const 2))))
            (local.set $pnw (i32.sub (local.get $pn) (i32.const 4)))

            (local.set $sr (i32.load8_u (local.get $p)))
            (local.set $sg (i32.load8_u offset=1 (local.get $p)))
            (local.set $sb (i32.load8_u offset=2 (local.get $p)))
            (local.set $srw (i32.load8_u (local.get $pw)))
            (local.set $sgw (i32.load8_u offset=1 (local.get $pw)))
            (local.set $sbw (i32.load8_u offset=2 (local.get $pw)))
            (local.set $srn (i32.load8_u (local.get $pn)))
            (local.set $sgn (i32.load8_u offset=1 (local.get $pn)))
            (local.set $sbn (i32.load8_u offset=2 (local.get $pn)))
            (local.set $srnw (i32.load8_u (local.get $pnw)))
            (local.set $sgnw (i32.load8_u offset=1 (local.get $pnw)))
            (local.set $sbnw (i32.load8_u offset=2 (local.get $pnw)))

            (local.set $cnt (i64.add (local.get $cnt) (i64.const 1)))
            (if (i32.and
                  (i32.and (i32.eq (local.get $sr) (local.get $srw)) (i32.and (i32.eq (local.get $sg) (local.get $sgw)) (i32.eq (local.get $sb) (local.get $sbw))))
                  (i32.and (i32.eq (local.get $sr) (local.get $srn)) (i32.and (i32.eq (local.get $sg) (local.get $sgn)) (i32.eq (local.get $sb) (local.get $sbn)))))
              (then (local.set $flat (i64.add (local.get $flat) (i64.const 1)))))

            (local.set $sco (i32.sub (local.get $sr) (local.get $sb)))
            (local.set $syy (i32.add (local.get $sb) (i32.shr_s (local.get $sco) (i32.const 1))))
            (local.set $scg (i32.sub (local.get $sg) (local.get $syy)))
            (local.set $syy (i32.add (local.get $syy) (i32.shr_s (local.get $scg) (i32.const 1))))

            (local.set $scow (i32.sub (local.get $srw) (local.get $sbw)))
            (local.set $syw (i32.add (local.get $sbw) (i32.shr_s (local.get $scow) (i32.const 1))))
            (local.set $scgw (i32.sub (local.get $sgw) (local.get $syw)))
            (local.set $syw (i32.add (local.get $syw) (i32.shr_s (local.get $scgw) (i32.const 1))))

            (local.set $scon (i32.sub (local.get $srn) (local.get $sbn)))
            (local.set $syn (i32.add (local.get $sbn) (i32.shr_s (local.get $scon) (i32.const 1))))
            (local.set $scgn (i32.sub (local.get $sgn) (local.get $syn)))
            (local.set $syn (i32.add (local.get $syn) (i32.shr_s (local.get $scgn) (i32.const 1))))

            (local.set $sconw (i32.sub (local.get $srnw) (local.get $sbnw)))
            (local.set $synw (i32.add (local.get $sbnw) (i32.shr_s (local.get $sconw) (i32.const 1))))
            (local.set $scgnw (i32.sub (local.get $sgnw) (local.get $synw)))
            (local.set $synw (i32.add (local.get $synw) (i32.shr_s (local.get $scgnw) (i32.const 1))))

            (local.set $sdh (call $abs1s (i32.sub (local.get $syy) (local.get $syw))))
            (local.set $sdv (call $abs1s (i32.sub (local.get $syy) (local.get $syn))))
            (local.set $smx (select (local.get $sdh) (local.get $sdv) (i32.gt_s (local.get $sdh) (local.get $sdv))))
            (if (i32.le_s (i32.add (local.get $sdh) (local.get $sdv)) (i32.const 2)) (then (local.set $smooth (i64.add (local.get $smooth) (i64.const 1)))))
            (if (i32.ge_s (local.get $smx) (i32.const 32))
              (then (local.set $hard (i64.add (local.get $hard) (i64.const 1))))
              (else (if (i32.ge_s (local.get $smx) (i32.const 4)) (then (local.set $medt (i64.add (local.get $medt) (i64.const 1)))))))

            (local.set $slap (call $abs1s (i32.sub (i32.add (local.get $syy) (local.get $synw)) (i32.add (local.get $syw) (local.get $syn)))))
            (if (i32.and (i32.and (i32.ge_s (local.get $slap) (i32.const 1)) (i32.le_s (local.get $slap) (i32.const 6))) (i32.lt_s (local.get $smx) (i32.const 12)))
              (then (local.set $noise (i64.add (local.get $noise) (i64.const 1)))))

            (local.set $sGH (i64.add (local.get $sGH) (i64.extend_i32_s (local.get $sdh))))
            (local.set $sGV (i64.add (local.get $sGV) (i64.extend_i32_s (local.get $sdv))))
            (local.set $sCl (i64.add (local.get $sCl) (i64.extend_i32_s (call $abs1s (i32.sub (local.get $syy) (call $med1s (local.get $syw) (local.get $syn) (local.get $synw)))))))
            (local.set $sAv (i64.add (local.get $sAv) (i64.extend_i32_s (call $abs1s (i32.sub (local.get $syy) (i32.shr_s (i32.add (local.get $syw) (local.get $syn)) (i32.const 1)))))))
            (local.set $sLp (i64.add (local.get $sLp) (i64.extend_i32_s (local.get $slap))))

            (local.set $sdCo (i32.sub (local.get $sco) (call $med1s (local.get $scow) (local.get $scon) (local.get $sconw))))
            (local.set $sdCg (i32.sub (local.get $scg) (call $med1s (local.get $scgw) (local.get $scgn) (local.get $scgnw))))
            (local.set $sCo (i64.add (local.get $sCo) (i64.extend_i32_s (call $abs1s (local.get $sdCo)))))
            (local.set $sCg (i64.add (local.get $sCg) (i64.extend_i32_s (call $abs1s (local.get $sdCg)))))
            (local.set $sCP (i64.add (local.get $sCP) (i64.extend_i32_s (call $abs1s (i32.add (local.get $sdCo) (local.get $sdCg))))))
            (local.set $sCM (i64.add (local.get $sCM) (i64.extend_i32_s (call $abs1s (i32.sub (local.get $sdCo) (local.get $sdCg))))))

            (local.set $sRG (i64.add (local.get $sRG) (i64.extend_i32_s (call $abs1s (i32.sub (i32.sub (local.get $sr) (local.get $sg))
              (call $med1s (i32.sub (local.get $srw) (local.get $sgw)) (i32.sub (local.get $srn) (local.get $sgn)) (i32.sub (local.get $srnw) (local.get $sgnw))))))))
            (local.set $sBG (i64.add (local.get $sBG) (i64.extend_i32_s (call $abs1s (i32.sub (i32.sub (local.get $sb) (local.get $sg))
              (call $med1s (i32.sub (local.get $sbw) (local.get $sgw)) (i32.sub (local.get $sbn) (local.get $sgn)) (i32.sub (local.get $sbnw) (local.get $sgnw))))))))

            (local.set $x (i32.add (local.get $x) (i32.const 1)))
            (br $xTail)))

        (local.set $y (i32.add (local.get $y) (local.get $stepY)))
        (br $yLoop)))

    (if (i64.eqz (local.get $cnt)) (then (return)))
    (i32.store (local.get $out) (i32.wrap_i64 (i64.div_u (i64.shl (local.get $flat) (i64.const 14)) (local.get $cnt))))
    (i32.store offset=4 (local.get $out) (i32.wrap_i64 (i64.div_u (i64.shl (local.get $smooth) (i64.const 14)) (local.get $cnt))))
    (i32.store offset=8 (local.get $out) (i32.wrap_i64 (i64.div_u (i64.shl (local.get $hard) (i64.const 14)) (local.get $cnt))))
    (i32.store offset=12 (local.get $out) (i32.wrap_i64 (i64.div_u (i64.shl (local.get $medt) (i64.const 14)) (local.get $cnt))))
    (i32.store offset=16 (local.get $out) (i32.wrap_i64 (i64.div_u (i64.shl (local.get $noise) (i64.const 14)) (local.get $cnt))))
    (i32.store offset=20 (local.get $out) (call $qScaleClamp (local.get $sCl) (i64.const 256) (local.get $cnt)))
    (i32.store offset=24 (local.get $out) (call $qScaleClamp (i64.sub (local.get $sAv) (local.get $sCl)) (i64.const 512) (local.get $cnt)))
    (i32.store offset=28 (local.get $out) (call $qScaleClamp (i64.sub (local.get $sGH) (local.get $sGV)) (i64.const 512) (local.get $cnt)))
    (i32.store offset=32 (local.get $out) (call $qScaleClamp (local.get $sLp) (i64.const 256) (local.get $cnt)))
    (i32.store offset=36 (local.get $out) (call $qScaleClamp (local.get $sCo) (i64.const 256) (local.get $cnt)))
    (i32.store offset=40 (local.get $out) (call $qScaleClamp (local.get $sCg) (i64.const 256) (local.get $cnt)))
    (i32.store offset=44 (local.get $out) (call $qScaleClamp (i64.sub (local.get $sCo) (local.get $sCg)) (i64.const 512) (local.get $cnt)))
    (i32.store offset=48 (local.get $out) (call $qScaleClamp (i64.sub (local.get $sRG) (local.get $sBG)) (i64.const 512) (local.get $cnt)))
    (i32.store offset=52 (local.get $out) (call $qScaleClamp (i64.sub (local.get $sCP) (local.get $sCM)) (i64.const 256) (local.get $cnt)))
    (i32.store offset=56 (local.get $out) (call $qScaleClamp (i64.add (local.get $sCl) (i64.add (local.get $sCo) (local.get $sCg))) (i64.const 128) (local.get $cnt)))
    (i32.store offset=60 (local.get $out)
      (i32.wrap_i64
        (select (i64.const 16384)
          (i64.shr_u (i64.shl (local.get $cnt) (i64.const 14)) (i64.const 20))
          (i64.gt_u (local.get $cnt) (i64.const 1048576))))))


  ;; Pure IEEE binary32 s^0.62763363 for SSIMULACRA 2 finalCurve with no host math dependency and no relaxed SIMD.
  (func $coeffLookPow (export "coeffLookPow") (param $s f32) (result f32)
    (local $u i32) (local $e i32) (local $ki i32)
    (local $m f32) (local $t f32) (local $t2 f32) (local $lgm f32) (local $lg f32) (local $fl f32) (local $f f32) (local $p f32)
    (if (f32.le (local.get $s) (f32.const 0.00000000000000000001)) (then (return (f32.const 0))))
    (local.set $u (i32.reinterpret_f32 (local.get $s)))
    (local.set $e (i32.sub (i32.and (i32.shr_u (local.get $u) (i32.const 23)) (i32.const 255)) (i32.const 127)))
    (local.set $m (f32.reinterpret_i32 (i32.or (i32.and (local.get $u) (i32.const 0x7fffff)) (i32.const 0x3f800000))))
    (local.set $t (f32.div (f32.sub (local.get $m) (f32.const 1)) (f32.add (local.get $m) (f32.const 1))))
    (local.set $t2 (f32.mul (local.get $t) (local.get $t)))
    (local.set $lgm (f32.mul (f32.mul (f32.const 2.88539004) (local.get $t))
      (f32.add (f32.const 1) (f32.mul (local.get $t2)
        (f32.add (f32.const 0.33333334) (f32.mul (local.get $t2)
          (f32.add (f32.const 0.2) (f32.mul (local.get $t2) (f32.const 0.1445)))))))))
    (local.set $lg (f32.mul (f32.add (f32.convert_i32_s (local.get $e)) (local.get $lgm)) (f32.const 0.62763363)))
    (local.set $fl (f32.floor (local.get $lg)))
    (local.set $ki (i32.trunc_f32_s (local.get $fl)))
    (local.set $f (f32.sub (local.get $lg) (local.get $fl)))
    (local.set $p (f32.add (f32.const 1) (f32.mul (local.get $f)
      (f32.add (f32.const 0.6931472) (f32.mul (local.get $f)
        (f32.add (f32.const 0.2402265) (f32.mul (local.get $f)
          (f32.add (f32.const 0.05550411) (f32.mul (local.get $f) (f32.const 0.01095149))))))))))
    (f32.reinterpret_i32 (i32.add (i32.reinterpret_f32 (local.get $p)) (i32.shl (local.get $ki) (i32.const 23)))))

  ;; Gather one 64x64 VarDCT tile into `tile` (up to 64 8x8 blocks x 3 f32 channels) and write its CfL factors at `cflOut`.
  (func (export "coeffGatherTile")
    (param $planes i32) (param $plane1 i32) (param $plane2 i32) (param $Wc i32)
    (param $rowOff i32) (param $colOff i32) (param $bw i32) (param $bh i32)
    (param $tile i32) (param $scale i32) (param $c84 f64) (param $cflOut i32)
    (local $count i32) (local $n i32) (local $k i32) (local $at i32)
    (local $yy f64) (local $xy f64) (local $bs f64) (local $ly f64)
    (call $fgGather (local.get $planes) (local.get $plane1) (local.get $plane2) (local.get $Wc)
      (local.get $rowOff) (local.get $colOff) (i32.const 0) (local.get $bw) (local.get $bh)
      (local.get $tile) (local.get $scale) (i32.sub (local.get $tile) (i32.const 256)))
    (local.set $count (i32.mul (local.get $bw) (local.get $bh)))
    (local.set $n (i32.const 0))
    (block $bDone (loop $bLoop
      (br_if $bDone (i32.ge_u (local.get $n) (local.get $count)))
      (local.set $at (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 768)) (i32.const 4))))
      (local.set $k (i32.const 1))
      (loop $kLoop
        (local.set $ly (f64.promote_f32 (f32.load offset=256 (local.get $at))))
        (local.set $yy (f64.add (local.get $yy) (f64.mul (local.get $ly) (local.get $ly))))
        (local.set $xy (f64.add (local.get $xy) (f64.mul (f64.promote_f32 (f32.load (local.get $at))) (local.get $ly))))
        (local.set $bs (f64.add (local.get $bs) (f64.mul (f64.promote_f32 (f32.load offset=512 (local.get $at))) (local.get $ly))))
        (local.set $at (i32.add (local.get $at) (i32.const 4)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br_if $kLoop (i32.lt_u (local.get $k) (i32.const 64))))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br $bLoop)))
    (i32.store (local.get $cflOut) (call $cflFactor (local.get $c84) (local.get $xy) (local.get $yy)))
    (i32.store offset=4 (local.get $cflOut) (call $cflFactor (local.get $c84) (local.get $bs) (local.get $yy))))

  ;; Quantize one coefficient in IEEE binary32 half-away-from-zero with deadzone `th` and Int16 clamp.
  (func $fquant1 (param $val f32) (param $st f32) (param $ist f32) (param $th f32) (result f32)
    (local $v f32) (local $fl f32)
    (local.set $v (f32.mul (local.get $val) (local.get $st)))
    (if (f32.lt (f32.abs (local.get $v)) (local.get $th)) (then (return (f32.const 0))))
    (local.set $fl (f32.floor (local.get $v)))
    (if (f32.ge (f32.sub (local.get $v) (local.get $fl)) (f32.const 0.5))
      (then (local.set $fl (f32.add (local.get $fl) (f32.const 1)))))
    (if (f32.gt (local.get $fl) (f32.const 32767)) (then (local.set $fl (f32.const 32767)))
      (else (if (f32.lt (local.get $fl) (f32.const -32768)) (then (local.set $fl (f32.const -32768))))))
    (f32.mul (local.get $fl) (local.get $ist)))

  ;; Accumulate one SSIM + detail-loss + artifact shell (mean and 4-norm sums) into `accAt` (6 x f64 = 48 bytes).
  (func $accumShell6 (param $accAt i32) (param $sO f32) (param $sH f32) (param $sE f32) (param $cross f32) (param $acO f32) (param $c2Term f32) (param $medge f32)
    (local $ssim f32) (local $aO f32) (local $aH f32) (local $edDen f32) (local $diff f32) (local $loss f32) (local $artf f32)
    (local $s2 f32) (local $l2 f32) (local $a2 f32)
    (local.set $ssim (f32.div (local.get $sE) (f32.add (f32.add (f32.add (local.get $sO) (local.get $sH)) (f32.mul (local.get $cross) (local.get $acO))) (local.get $c2Term))))
    (local.set $aO (f32.sqrt (local.get $sO)))
    (local.set $aH (f32.sqrt (local.get $sH)))
    (local.set $edDen (f32.add (local.get $medge) (local.get $aO)))
    (local.set $diff (f32.sub (local.get $aO) (local.get $aH)))
    (if (f32.gt (local.get $diff) (f32.const 0))
      (then (local.set $loss (f32.div (local.get $diff) (local.get $edDen))))
      (else (if (f32.lt (local.get $diff) (f32.const 0))
        (then (local.set $artf (f32.div (f32.neg (local.get $diff)) (local.get $edDen)))))))
    (local.set $s2 (f32.mul (local.get $ssim) (local.get $ssim)))
    (local.set $l2 (f32.mul (local.get $loss) (local.get $loss)))
    (local.set $a2 (f32.mul (local.get $artf) (local.get $artf)))
    (f64.store (local.get $accAt) (f64.add (f64.load (local.get $accAt)) (f64.promote_f32 (local.get $ssim))))
    (f64.store offset=8 (local.get $accAt) (f64.add (f64.load offset=8 (local.get $accAt)) (f64.promote_f32 (f32.mul (local.get $s2) (local.get $s2)))))
    (f64.store offset=16 (local.get $accAt) (f64.add (f64.load offset=16 (local.get $accAt)) (f64.promote_f32 (local.get $loss))))
    (f64.store offset=24 (local.get $accAt) (f64.add (f64.load offset=24 (local.get $accAt)) (f64.promote_f32 (f32.mul (local.get $l2) (local.get $l2)))))
    (f64.store offset=32 (local.get $accAt) (f64.add (f64.load offset=32 (local.get $accAt)) (f64.promote_f32 (local.get $artf))))
    (f64.store offset=40 (local.get $accAt) (f64.add (f64.load offset=40 (local.get $accAt)) (f64.promote_f32 (f32.mul (local.get $a2) (local.get $a2))))))

  ;; Accumulate fine 8x8 radial-band (10 bands x 3 XYB channels) and coarse 2x2 & 4x4 block-pooled statistics
  ;; for one tile at one candidate quantization table in plain IEEE binary32.
  ;; Scratch layout (`scratch`, 40,960 bytes):
  ;;   0..7679:     bSig (64 * 30 f32)
  ;;   7680..15359: bHat (64 * 30 f32)
  ;;   15360..23039: bZro (64 * 30 f32)
  ;;   23040..30719: bRnd (64 * 30 f32)
  ;;   30720..38399: bCfl (64 * 30 f32)
  ;;   38400..39167: bAcOrig (192 f32)
  ;;   39168..39935: dcOrig  (192 f32)
  ;;   39936..40703: dcHat   (192 f32)
  ;;   40704..40959: yHatArr (64 f32)
  ;;   40960..41919: g2DcOrig, g2DcHat, g2LowOrig, g2LowHat, g2LowErr (5 * 48 f32 = 960 B)
  ;; Acc layout (`acc`, 393 f64 = 3,144 bytes):
  ;;   0..29:   rawSig,  30..59:  bZro1,  60..89:  bZro4,  90..119: bRnd1, 120..149: bRnd4,
  ;;   150..179: bTot1, 180..209: bTot4, 210..239: bNoc1, 240..269: bNoc4, 270..299: uRnd4,
  ;;   300..353: blkMetrics (54), 354..371: c2Metrics (18), 372..389: c4Metrics (18),
  ;;   390: nBlocks, 391: n2x2, 392: n4x4.
  (func (export "coeffLookTile")
    (param $tile i32) (param $bw i32) (param $bh i32) (param $fx i32) (param $fb i32)
    (param $steps i32) (param $invSteps i32) (param $thr i32) (param $bandMap i32)
    (param $scratch i32) (param $acc i32)
    (local $count i32) (local $n i32) (local $c i32) (local $ci i32) (local $k i32) (local $b i32)
    (local $base i32) (local $yOff i32) (local $cOff i32) (local $n30 i32) (local $m i32) (local $idx i32) (local $aPtr i32)
    (local $stPtr i32) (local $istPtr i32) (local $thPtr i32)
    (local $bSig i32) (local $bHat i32) (local $bZro i32) (local $bRnd i32) (local $bCfl i32)
    (local $bAcO i32) (local $dcO i32) (local $dcH i32) (local $yHat i32)
    (local $g2O i32) (local $g2H i32) (local $g2LO i32) (local $g2LH i32) (local $g2LE i32)
