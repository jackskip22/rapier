    (if (i32.lt_s (local.get $h) (i32.const 0)) (then (call $vbSmall (local.get $pix) (local.get $stride) (i32.sub (i32.const 0) (local.get $h)) (local.get $bt) (local.get $by) (local.get $tmp) (local.get $out)) (return)))
