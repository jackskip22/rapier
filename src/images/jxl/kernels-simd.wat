    (local.set $p (call $nFma (f64.load offset=32 (local.get $t)) (local.get $x) (f64.load offset=24 (local.get $t))))
    (local.set $p (call $nFma (local.get $p) (local.get $x) (f64.load offset=16 (local.get $t))))
    (local.set $p (call $nFma (local.get $p) (local.get $x) (f64.load offset=8 (local.get $t))))
    (local.set $p (call $nFma (local.get $p) (local.get $x) (f64.load (local.get $t))))
    (local.set $q (call $nFma (f64.load offset=72 (local.get $t)) (local.get $x) (f64.load offset=64 (local.get $t))))
    (local.set $q (call $nFma (local.get $q) (local.get $x) (f64.load offset=56 (local.get $t))))
    (local.set $q (call $nFma (local.get $q) (local.get $x) (f64.load offset=48 (local.get $t))))
    (local.set $q (call $nFma (local.get $q) (local.get $x) (f64.load offset=40 (local.get $t))))
