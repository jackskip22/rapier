                (local.set $r (f64.add (local.get $r) (f64.convert_i32_u (f64.ge (f64.sub (local.get $lo) (local.get $r)) (f64.const 0.5)))))
                (local.set $q (f64.floor (local.get $hi)))
                (local.set $q (f64.add (local.get $q) (f64.convert_i32_u (f64.ge (f64.sub (local.get $hi) (local.get $q)) (f64.const 0.5)))))
                (if (f64.eq (local.get $r) (local.get $q)) (then (local.set $byte (local.get $r))))))
            (i32.store8 offset=0 (local.get $o) (if (result i32) (f64.ge (local.get $byte) (f64.const 0))
              (then (i32.trunc_f64_s (local.get $byte)))
