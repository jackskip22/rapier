      (local.set $u12 (f64x2.add (local.get $t6) (local.get $t7)))
      (local.set $z5 (f64x2.mul (f64x2.sub (local.get $u10) (local.get $u12)) (f64x2.splat (f64.const 0.3826834333650898))))
      (local.set $z2 (f64x2.add (f64x2.mul (f64x2.splat (f64.const 0.5411961001461969)) (local.get $u10)) (local.get $z5)))
      (local.set $z4 (f64x2.add (f64x2.mul (f64x2.splat (f64.const 1.3065629648763766)) (local.get $u12)) (local.get $z5)))
      (local.set $z3 (f64x2.mul (local.get $u11) (f64x2.splat (f64.const 0.7071067811865476))))
      (local.set $z11 (f64x2.add (local.get $t7) (local.get $z3)))
      (local.set $z13 (f64x2.sub (local.get $t7) (local.get $z3)))
      (v128.store offset=320 (local.get $p) (f64x2.add (local.get $z13) (local.get $z2)))
      (v128.store offset=192 (local.get $p) (f64x2.sub (local.get $z13) (local.get $z2)))
      (v128.store offset=64 (local.get $p) (f64x2.add (local.get $z11) (local.get $z4)))
      (v128.store offset=448 (local.get $p) (f64x2.sub (local.get $z11) (local.get $z4)))
      (local.set $i (i32.add (local.get $i) (i32.const 2)))
      (br_if $dctCols (i32.lt_u (local.get $i) (i32.const 8))))
    (local.set $k (i32.const 0))
    (loop $dctScale
      (v128.store (i32.add (local.get $o) (local.get $k)) (f64x2.mul (v128.load (i32.add (local.get $o) (local.get $k))) (v128.load (i32.add (local.get $scale) (local.get $k)))))
      (local.set $k (i32.add (local.get $k) (i32.const 16)))
      (br_if $dctScale (i32.lt_u (local.get $k) (i32.const 512))))
    (local.set $c (i32.add (local.get $c) (i32.const 1)))
    (br_if $dctChannels (i32.lt_u (local.get $c) (i32.const 3))))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (br_if $dctBlocks (i32.lt_u (local.get $n) (local.get $count))))
  ;; The tile's CfL sums over every block's AC coefficients, blocks then k from 1, each from zero.
  (local.set $n (i32.const 0))
  (loop $sumBlocks
    (local.set $k (i32.const 1))
    (loop $sumCoefficients
      (local.set $p (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 1536)) (i32.shl (local.get $k) (i32.const 3)))))
      (local.set $luma (f64.load offset=512 (local.get $p)))
      (local.set $yy (f64.add (local.get $yy) (f64.mul (local.get $luma) (local.get $luma))))
      (local.set $xy (f64.add (local.get $xy) (f64.mul (f64.load (local.get $p)) (local.get $luma))))
      (local.set $bySum (f64.add (local.get $bySum) (f64.mul (f64.load offset=1024 (local.get $p)) (local.get $luma))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br_if $sumCoefficients (i32.lt_u (local.get $k) (i32.const 64))))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (br_if $sumBlocks (i32.lt_u (local.get $n) (local.get $count))))
  (f64.store (local.get $sums) (local.get $yy))
  (f64.store offset=8 (local.get $sums) (local.get $xy))
  (f64.store offset=16 (local.get $sums) (local.get $bySum)))

;; quantFastTile: channel c's levels as Int16 at out + ((c * count + n) * 64 + k) * 2 and its nonzero AC count at
;; counts + c * count + n. Luma (c 1) subtracts nothing (x - 0 * luma is x); chroma subtracts its ratio times luma.
(func (export "quantTile") (param $tile i32) (param $count i32) (param $scale i32) (param $limits i32)
  (param $xRatio f64) (param $bRatio f64) (param $out i32) (param $counts i32)
  (local $c i32) (local $n i32) (local $k i32) (local $p i32) (local $q i32) (local $nonzero i32) (local $sc i32) (local $lim i32)
  (local $value f64) (local $ratio f64) (local $dst i32) (local $luma i32)
  (local $v v128) (local $f v128) (local $r v128) (local $qs v128) (local $ratios v128)
  (loop $channels
    (local.set $sc (i32.add (local.get $scale) (i32.mul (local.get $c) (i32.const 512))))
    (local.set $lim (i32.add (local.get $limits) (i32.mul (local.get $c) (i32.const 512))))
    (local.set $ratio (select (local.get $xRatio) (local.get $bRatio) (i32.eqz (local.get $c))))
    (local.set $ratios (f64x2.splat (local.get $ratio)))
    (local.set $n (i32.const 0))
    (loop $blocks
      (local.set $p (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 1536)) (i32.mul (local.get $c) (i32.const 512)))))
      (local.set $luma (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 1536)) (i32.const 512))))
      (local.set $dst (i32.add (local.get $out) (i32.shl (i32.add (i32.mul (local.get $c) (local.get $count)) (local.get $n)) (i32.const 7))))
      ;; DC: Math.round unless below one half.
      (local.set $value (f64.mul (f64.load (local.get $p)) (f64.load (local.get $sc))))
      (local.set $value (select (f64.const 0)
        (f64.add (f64.floor (local.get $value)) (select (f64.const 1) (f64.const 0) (f64.ge (f64.sub (local.get $value) (f64.floor (local.get $value))) (f64.const 0.5))))
        (f64.lt (f64.abs (local.get $value)) (f64.const 0.5))))
      (i32.store16 (local.get $dst) (i32.trunc_sat_f64_s (local.get $value)))
      (local.set $nonzero (i32.const 0))
      ;; AC two at a time from k = 0 (lane 0 of the first pair, the DC, is discarded): each lane the scalar expression.
      (local.set $k (i32.const 0))
      (loop $pairs
        (local.set $v (if (result v128) (i32.eq (local.get $c) (i32.const 1))
          (then (f64x2.mul (v128.load (i32.add (local.get $p) (local.get $k))) (v128.load (i32.add (local.get $sc) (local.get $k)))))
          (else (f64x2.mul (f64x2.sub (v128.load (i32.add (local.get $p) (local.get $k)))
              (f64x2.mul (local.get $ratios) (v128.load (i32.add (local.get $luma) (local.get $k)))))
            (v128.load (i32.add (local.get $sc) (local.get $k)))))))
        (local.set $f (f64x2.floor (local.get $v)))
        (local.set $r (v128.bitselect (f64x2.add (local.get $f) (f64x2.splat (f64.const 1))) (local.get $f)
          (f64x2.ge (f64x2.sub (local.get $v) (local.get $f)) (f64x2.splat (f64.const 0.5)))))
        (local.set $qs (i32x4.trunc_sat_f64x2_s_zero (v128.andnot (local.get $r) (f64x2.lt (f64x2.abs (local.get $v)) (v128.load (i32.add (local.get $lim) (local.get $k)))))))
        (if (local.get $k)
          (then
            (local.set $q (i32x4.extract_lane 0 (local.get $qs)))
            (i32.store16 (i32.add (local.get $dst) (i32.shr_u (local.get $k) (i32.const 2))) (local.get $q))
            (local.set $nonzero (i32.add (local.get $nonzero) (i32.ne (local.get $q) (i32.const 0))))))
        (local.set $q (i32x4.extract_lane 1 (local.get $qs)))
        (i32.store16 offset=2 (i32.add (local.get $dst) (i32.shr_u (local.get $k) (i32.const 2))) (local.get $q))
        (local.set $nonzero (i32.add (local.get $nonzero) (i32.ne (local.get $q) (i32.const 0))))
        (local.set $k (i32.add (local.get $k) (i32.const 16)))
        (br_if $pairs (i32.lt_u (local.get $k) (i32.const 512))))
      (i32.store8 (i32.add (local.get $counts) (i32.add (i32.mul (local.get $c) (local.get $count)) (local.get $n))) (local.get $nonzero))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br_if $blocks (i32.lt_u (local.get $n) (local.get $count))))
    (local.set $c (i32.add (local.get $c) (i32.const 1)))
    (br_if $channels (i32.lt_u (local.get $c) (i32.const 3)))))

;; One AC group of a plain DCT8 picture (vardct.mjs walkACGroup without varblocks, passes, authored orders,
;; subsampling or grey), counted or written (JS1). The walk, contexts and values are walkACGroup's; counting adds
;; values below 64 to a histogram (each first touch listed) and lists larger ones in order; writing codes each token
;; with its histogram's hybrid configuration and prefix code, continuing a BitWriter's pending bits.
;; Fields at $args (i32): 0 coeffs, 4 channel stride (bytes), 8 bw, 12 bh, 16 nonzero counts, 20 buckets,
;; 24 block contexts, 28 numDc, 32 numCtxs, 36 orders, 40 zero-density table, 44 nzeros scratch, 48 mode (0 count,
;; 1 write); counting: 52 histogram, 56 touched list, 60 overflow pairs, 64 touched count, 68 overflow count; writing:
;; 72 context map, 76 configs (splitToken, split, msb, lsb), 80 codes (length, code), 84 alphabet, 88 out, 92 acc,
;; 96 pending, 100 bytes written; collecting (mode 2): 72 context map, 104 values (u32), 108 histogram ids (u8), 112 count.
(global $acMode (mut i32) (i32.const 0))
(global $acHist (mut i32) (i32.const 0))
(global $acTouched (mut i32) (i32.const 0))
(global $acTouchedCount (mut i32) (i32.const 0))
(global $acOverflow (mut i32) (i32.const 0))
(global $acOverflowCount (mut i32) (i32.const 0))
(global $acMap (mut i32) (i32.const 0))
(global $acConfigs (mut i32) (i32.const 0))
(global $acCodes (mut i32) (i32.const 0))
(global $acAlphabet (mut i32) (i32.const 0))
(global $acOut (mut i32) (i32.const 0))
(global $acAcc (mut i64) (i64.const 0))
(global $acPending (mut i32) (i32.const 0))
;; Collecting (mode 2): each token's value and its histogram id (the context map's entry), for ansFlush.
(global $acTokens (mut i32) (i32.const 0))
(global $acTokenIds (mut i32) (i32.const 0))
(global $acTokenCount (mut i32) (i32.const 0))
(func $acBits (param $n i32) (param $v i32)
  (global.set $acAcc (i64.or (global.get $acAcc) (i64.shl (i64.extend_i32_u (local.get $v)) (i64.extend_i32_u (global.get $acPending)))))
  (global.set $acPending (i32.add (global.get $acPending) (local.get $n)))
  (block $done
    (loop $bytes
      (br_if $done (i32.lt_u (global.get $acPending) (i32.const 8)))
      (i32.store8 (global.get $acOut) (i32.wrap_i64 (global.get $acAcc)))
      (global.set $acOut (i32.add (global.get $acOut) (i32.const 1)))
      (global.set $acAcc (i64.shr_u (global.get $acAcc) (i64.const 8)))
      (global.set $acPending (i32.sub (global.get $acPending) (i32.const 8)))
      (br $bytes))))
(func $acEmit (param $ctx i32) (param $value i32)
  (local $at i32) (local $n i32) (local $h i32) (local $cfg i32) (local $symbol i32) (local $nbits i32) (local $extra i32)
  (local $below i32) (local $split i32) (local $msb i32) (local $lsb i32)
  ;; hybridToken under the context's histogram configuration, then its code and raw bits (writeHybrid).
  (local.set $h (i32.load8_u (i32.add (global.get $acMap) (local.get $ctx))))
  (local.set $cfg (i32.add (global.get $acConfigs) (i32.shl (local.get $h) (i32.const 4))))
  (if (i32.lt_u (local.get $value) (i32.load (local.get $cfg)))
    (then (local.set $symbol (local.get $value)))
    (else
      (local.set $split (i32.load offset=4 (local.get $cfg)))
      (local.set $msb (i32.load offset=8 (local.get $cfg)))
      (local.set $lsb (i32.load offset=12 (local.get $cfg)))
      (local.set $n (i32.sub (i32.const 31) (i32.clz (local.get $value))))
      (local.set $below (i32.sub (local.get $value) (i32.shl (i32.const 1) (local.get $n))))
      (local.set $nbits (i32.sub (i32.sub (local.get $n) (local.get $msb)) (local.get $lsb)))
      (local.set $symbol (i32.add (i32.load (local.get $cfg))
        (i32.or (i32.or (i32.shl (i32.sub (local.get $n) (local.get $split)) (i32.add (local.get $msb) (local.get $lsb)))
            (i32.shl (i32.shr_u (local.get $below) (i32.sub (local.get $n) (local.get $msb))) (local.get $lsb)))
          (i32.and (local.get $below) (i32.sub (i32.shl (i32.const 1) (local.get $lsb)) (i32.const 1))))))
      (local.set $extra (i32.and (i32.shr_u (local.get $value) (local.get $lsb)) (i32.sub (i32.shl (i32.const 1) (local.get $nbits)) (i32.const 1))))))
  (local.set $at (i32.add (global.get $acCodes) (i32.shl (i32.add (i32.mul (local.get $h) (global.get $acAlphabet)) (local.get $symbol)) (i32.const 3))))
  (call $acBits (i32.load (local.get $at)) (i32.load offset=4 (local.get $at)))
  (if (local.get $nbits) (then (call $acBits (local.get $nbits) (local.get $extra)))))
(func (export "acGroup") (param $args i32)
  (local $coeffs i32) (local $cstride i32) (local $bw i32) (local $bh i32) (local $counts i32) (local $buckets i32) (local $bctx i32)
  (local $numDc i32) (local $numCtxs i32) (local $orders i32) (local $zd i32) (local $nz i32)
  (local $bx i32) (local $by i32) (local $ci i32) (local $c i32) (local $blk i32) (local $count i32) (local $row i32) (local $predicted i32)
  (local $m i32) (local $blockCtx i32) (local $offset i32) (local $prev i32) (local $left i32) (local $k i32) (local $coeff i32) (local $base i32)
  (local $mode i32) (local $ectx i32) (local $evalue i32) (local $tokAt i32) (local $idAt i32) (local $map i32) (local $hist i32) (local $touched i32)
  (local $touchedCount i32) (local $hat i32) (local $hn i32)
  (local.set $coeffs (i32.load (local.get $args))) (local.set $cstride (i32.load offset=4 (local.get $args)))
  (local.set $bw (i32.load offset=8 (local.get $args))) (local.set $bh (i32.load offset=12 (local.get $args)))
  (local.set $counts (i32.load offset=16 (local.get $args))) (local.set $buckets (i32.load offset=20 (local.get $args)))
  (local.set $bctx (i32.load offset=24 (local.get $args))) (local.set $numDc (i32.load offset=28 (local.get $args)))
  (local.set $numCtxs (i32.load offset=32 (local.get $args))) (local.set $orders (i32.load offset=36 (local.get $args)))
  (local.set $zd (i32.load offset=40 (local.get $args))) (local.set $nz (i32.load offset=44 (local.get $args)))
  (global.set $acMode (i32.load offset=48 (local.get $args)))
  (global.set $acHist (i32.load offset=52 (local.get $args))) (global.set $acTouched (i32.load offset=56 (local.get $args)))
  (global.set $acOverflow (i32.load offset=60 (local.get $args)))
  (global.set $acTouchedCount (i32.const 0)) (global.set $acOverflowCount (i32.const 0)) (global.set $acTokenCount (i32.const 0))
  (global.set $acTokens (i32.load offset=104 (local.get $args))) (global.set $acTokenIds (i32.load offset=108 (local.get $args)))
  (global.set $acMap (i32.load offset=72 (local.get $args))) (global.set $acConfigs (i32.load offset=76 (local.get $args)))
  (global.set $acCodes (i32.load offset=80 (local.get $args))) (global.set $acAlphabet (i32.load offset=84 (local.get $args)))
  (global.set $acOut (i32.load offset=88 (local.get $args)))
  (global.set $acAcc (i64.extend_i32_u (i32.load offset=92 (local.get $args)))) (global.set $acPending (i32.load offset=96 (local.get $args)))
  ;; Counting (mode 0) and collecting (mode 2) run here with their state in locals ($acEmit's same writes); a prefix
  ;; write (mode 1) calls $acEmit.
  (local.set $mode (global.get $acMode)) (local.set $map (global.get $acMap)) (local.set $hist (global.get $acHist))
  (local.set $touched (global.get $acTouched)) (local.set $tokAt (global.get $acTokens)) (local.set $idAt (global.get $acTokenIds))
  (loop $rows
    (local.set $bx (i32.const 0))
    (loop $cols
      (local.set $blk (i32.add (i32.mul (local.get $by) (local.get $bw)) (local.get $bx)))
      (local.set $ci (i32.const 0))
      (loop $channels
        ;; Luma, then X, then B.
        (local.set $c (select (i32.const 1) (select (i32.const 0) (i32.const 2) (i32.eq (local.get $ci) (i32.const 1))) (i32.eqz (local.get $ci))))
        (local.set $count (i32.load8_u (i32.add (local.get $counts) (i32.add (i32.mul (local.get $c) (i32.mul (local.get $bw) (local.get $bh))) (local.get $blk)))))
        (local.set $row (i32.add (local.get $nz) (i32.shl (local.get $c) (i32.const 12))))
        (local.set $predicted
          (if (result i32) (i32.eqz (local.get $bx))
            (then (if (result i32) (i32.eqz (local.get $by)) (then (i32.const 32))
              (else (i32.load (i32.add (local.get $row) (i32.shl (i32.mul (i32.sub (local.get $by) (i32.const 1)) (i32.const 32)) (i32.const 2)))))))
            (else (if (result i32) (i32.eqz (local.get $by))
              (then (i32.load (i32.add (local.get $row) (i32.shl (i32.sub (local.get $bx) (i32.const 1)) (i32.const 2)))))
              (else (i32.shr_s (i32.add (i32.add
                  (i32.load (i32.add (local.get $row) (i32.shl (i32.add (i32.mul (i32.sub (local.get $by) (i32.const 1)) (i32.const 32)) (local.get $bx)) (i32.const 2))))
                  (i32.load (i32.add (local.get $row) (i32.shl (i32.sub (i32.add (i32.mul (local.get $by) (i32.const 32)) (local.get $bx)) (i32.const 1)) (i32.const 2)))))
                (i32.const 1)) (i32.const 1)))))))
        (i32.store (i32.add (local.get $row) (i32.shl (i32.add (i32.mul (local.get $by) (i32.const 32)) (local.get $bx)) (i32.const 2))) (local.get $count))
        (local.set $blockCtx (i32.load (i32.add (local.get $bctx) (i32.shl (i32.add (i32.mul (local.get $c) (local.get $numDc)) (i32.load8_u (i32.add (local.get $buckets) (local.get $blk)))) (i32.const 2)))))
        (local.set $m (select (local.get $predicted) (i32.const 64) (i32.lt_s (local.get $predicted) (i32.const 64))))
        (local.set $ectx (i32.add (i32.mul (select (local.get $m) (i32.add (i32.const 4) (i32.shr_s (local.get $m) (i32.const 1))) (i32.lt_s (local.get $m) (i32.const 8))) (local.get $numCtxs)) (local.get $blockCtx)))
        (local.set $evalue (local.get $count))
        (if (i32.eq (local.get $mode) (i32.const 2))
          (then
            (i32.store (local.get $tokAt) (local.get $evalue))
            (i32.store8 (local.get $idAt) (i32.load8_u (i32.add (local.get $map) (local.get $ectx))))
            (local.set $tokAt (i32.add (local.get $tokAt) (i32.const 4)))
            (local.set $idAt (i32.add (local.get $idAt) (i32.const 1))))
          (else (if (i32.eqz (local.get $mode))
            (then (if (i32.lt_u (local.get $evalue) (i32.const 64))
              (then
                (local.set $hat (i32.add (local.get $hist) (i32.shl (i32.add (i32.shl (local.get $ectx) (i32.const 6)) (local.get $evalue)) (i32.const 2))))
                (local.set $hn (i32.load (local.get $hat)))
                (if (i32.eqz (local.get $hn))
                  (then
                    (i32.store (i32.add (local.get $touched) (i32.shl (local.get $touchedCount) (i32.const 2))) (i32.add (i32.shl (local.get $ectx) (i32.const 6)) (local.get $evalue)))
                    (local.set $touchedCount (i32.add (local.get $touchedCount) (i32.const 1)))))
                (i32.store (local.get $hat) (i32.add (local.get $hn) (i32.const 1))))
              (else
                (local.set $hat (i32.add (global.get $acOverflow) (i32.shl (global.get $acOverflowCount) (i32.const 3))))
                (i32.store (local.get $hat) (local.get $ectx))
                (i32.store offset=4 (local.get $hat) (local.get $evalue))
                (global.set $acOverflowCount (i32.add (global.get $acOverflowCount) (i32.const 1))))))
            (else (call $acEmit (local.get $ectx) (local.get $evalue))))))
        (local.set $offset (i32.add (i32.mul (local.get $numCtxs) (i32.const 37)) (i32.mul (i32.const 458) (local.get $blockCtx))))
        (local.set $prev (i32.le_u (local.get $count) (i32.const 4)))
        (local.set $left (local.get $count))
        (local.set $base (i32.add (i32.add (local.get $coeffs) (i32.mul (local.get $c) (local.get $cstride))) (i32.shl (local.get $blk) (i32.const 7))))
        (local.set $k (i32.const 1))
        (block $done
          (loop $coefficients
            (br_if $done (i32.or (i32.eqz (local.get $left)) (i32.ge_u (local.get $k) (i32.const 64))))
            (local.set $coeff (i32.load16_s (i32.add (local.get $base) (i32.shl (i32.load8_u (i32.add (local.get $orders) (i32.add (i32.shl (local.get $c) (i32.const 6)) (local.get $k)))) (i32.const 1)))))
            (local.set $ectx (i32.add (i32.add (local.get $offset) (i32.load16_u (i32.add (local.get $zd) (i32.shl (i32.add (i32.shl (local.get $left) (i32.const 6)) (local.get $k)) (i32.const 1))))) (local.get $prev)))
        (local.set $evalue (select (i32.sub (i32.mul (local.get $coeff) (i32.const -2)) (i32.const 1)) (i32.shl (local.get $coeff) (i32.const 1)) (i32.lt_s (local.get $coeff) (i32.const 0))))
