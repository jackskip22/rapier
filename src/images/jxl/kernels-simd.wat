            (local.set $tokAt (i32.add (local.get $tokAt) (i32.const 4)))
            (local.set $idAt (i32.add (local.get $idAt) (i32.const 1))))
          (else (if (i32.eqz (local.get $mode))
            (then (if (i32.lt_u (local.get $evalue) (i32.const 64))
              (then
