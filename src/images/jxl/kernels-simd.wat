          (br_if $sweepDone (i32.lt_u (i32.sub (local.get $total) (local.get $lowCount)) (i32.const 24)))
          (if (i32.ge_u (local.get $lowCount) (i32.const 24))
            (then
              (local.set $lowBase (f64.load (i32.add (local.get $table) (i32.shl (local.get $lowCount) (i32.const 3)))))
              (local.set $highBase (f64.load (i32.add (local.get $table) (i32.shl (i32.sub (local.get $total) (local.get $lowCount)) (i32.const 3)))))
              (local.set $loBits (f64.const inf)) (local.set $hiBits (f64.const inf))
              (local.set $loSelected (i32.const 0)) (local.set $hiSelected (i32.const 0))
              (local.set $c (i32.const 0))
              (loop $chooseCandidates
                (local.set $stats (i32.add (local.get $scratch) (i32.shl (local.get $c) (i32.const 5))))
                (local.set $costs (f64x2.add
                  (f64x2.sub (f64x2.replace_lane 1 (f64x2.splat (local.get $lowBase)) (local.get $highBase))
                    (v128.load (local.get $stats)))
                  (v128.load offset=16 (local.get $stats))))
                (local.set $t (f64x2.extract_lane 0 (local.get $costs)))
                (local.set $u (f64x2.extract_lane 1 (local.get $costs)))
                (if (f64.lt (local.get $t) (local.get $loBits))
                  (then (local.set $loBits (local.get $t)) (local.set $loSelected (local.get $c))))
                (if (f64.lt (local.get $u) (local.get $hiBits))
                  (then (local.set $hiBits (local.get $u)) (local.set $hiSelected (local.get $c))))
                (local.set $c (i32.add (local.get $c) (i32.const 1)))
                (br_if $chooseCandidates (i32.lt_u (local.get $c) (local.get $kinds))))
              (local.set $price (f64.add (local.get $loBits) (local.get $hiBits)))
              (if (f64.lt (local.get $price) (local.get $best))
                (then
                  (local.set $best (local.get $price)) (local.set $bestBin (local.get $b))
                  (i32.store (local.get $out) (local.get $loSelected))
                  (i32.store offset=4 (local.get $out) (local.get $hiSelected))
                  (f64.store offset=8 (local.get $out) (local.get $loBits))
                  (f64.store offset=16 (local.get $out) (local.get $hiBits))
                  (if (local.get $splitAt)
                    (then (memory.copy (local.get $splitAt) (local.get $low) (i32.shl (local.get $cells) (i32.const 2)))))))
              ;; Later cuts cannot beat this ceiling even at the favorable two-unit entropy bound.
              (br_if $sweepDone (f64.ge
                (f64.sub (local.get $loBits)
                  (f64.mul (f64.const 2) (f64.convert_i32_u (i32.sub (i32.add (local.get $lowCount) (local.get $total)) (i32.const 24)))))
                (local.get $best)))
              (br_if $sweepDone (i32.eq (i32.sub (local.get $total) (local.get $lowCount)) (i32.const 24)))
              )
            (else
              (br_if $sweepDone (i32.eq (i32.sub (local.get $total) (local.get $lowCount)) (i32.const 24))))))
        (local.set $b (i32.add (local.get $b) (i32.const 1)))
        (br_if $sweepBins (i32.lt_u (local.get $b) (local.get $sweepEnd)))))
    (local.get $bestBin))

  ;; Exact marginalCost of adding stats at $stMeta to cluster $clIdx (-1: new cluster) in IEEE-754 binary64.
  (func $writeHistStat
    (param $h1 i32) (param $h2 i32) (param $alphabet i32) (param $table i32) (param $raw i32)
    (param $meta i32) (param $nzSymAt i32) (param $nzValAt i32) (param $nzCur i32) (result i32)
    (local $s i32) (local $v i32) (local $total i32) (local $used i32) (local $at i32)
    (local $sumT f64) (local $rawSum f64) (local $bits f64)
    (local.set $s (i32.const 0))
    (loop $sym
      (local.set $v (i32.load (i32.add (local.get $h1) (i32.shl (local.get $s) (i32.const 2)))))
      (if (local.get $h2)
        (then (local.set $v (i32.add (local.get $v) (i32.load (i32.add (local.get $h2) (i32.shl (local.get $s) (i32.const 2))))))))
      (if (local.get $v)
        (then
          (local.set $total (i32.add (local.get $total) (local.get $v)))
          (local.set $sumT (f64.add (local.get $sumT)
            (f64.load (i32.add (local.get $table) (i32.shl (local.get $v) (i32.const 3))))))
          (local.set $rawSum (f64.add (local.get $rawSum)
            (f64.mul (f64.convert_i32_u (local.get $v))
              (f64.load (i32.add (local.get $raw) (i32.shl (local.get $s) (i32.const 3)))))))
          (local.set $at (i32.add (local.get $nzCur) (local.get $used)))
          (i32.store8 (i32.add (local.get $nzSymAt) (local.get $at)) (local.get $s))
          (i32.store (i32.add (local.get $nzValAt) (i32.shl (local.get $at) (i32.const 2))) (local.get $v))
          (local.set $used (i32.add (local.get $used) (i32.const 1)))))
      (local.set $s (i32.add (local.get $s) (i32.const 1)))
      (br_if $sym (i32.lt_u (local.get $s) (local.get $alphabet))))
    (local.set $bits (f64.add
      (f64.sub (f64.load (i32.add (local.get $table) (i32.shl (local.get $total) (i32.const 3)))) (local.get $sumT))
      (local.get $rawSum)))
    (f64.store (local.get $meta) (local.get $bits))
    (f64.store offset=8 (local.get $meta) (local.get $rawSum))
    (i32.store offset=16 (local.get $meta) (local.get $total))
    (i32.store offset=20 (local.get $meta) (local.get $used))
    (i32.store offset=24 (local.get $meta) (local.get $nzCur))
    (i32.store offset=28 (local.get $meta) (local.get $used))
    (i32.add (local.get $nzCur) (local.get $used)))

  (func $sampledClusterCost
    (param $clIdx i32) (param $stMeta i32) (param $clFreqAt i32) (param $clMetaAt i32)
    (param $alphabet i32) (param $table i32) (param $params i32) (param $nzSymAt i32) (param $nzValAt i32) (result f64)
    (local $cm i32) (local $cTotal i32) (local $stTotal i32) (local $stUsed i32) (local $nzOff i32) (local $nzLen i32)
    (local $freq i32) (local $j i32) (local $cur i32) (local $val i32) (local $newUsed i32)
    (local $scale f64) (local $histBase f64) (local $histSym f64) (local $dSumT f64)
    (local.set $scale (f64.load (local.get $params)))
    (local.set $histBase (f64.load offset=8 (local.get $params)))
    (local.set $histSym (f64.load offset=16 (local.get $params)))
    (local.set $stTotal (i32.load offset=16 (local.get $stMeta)))
    (local.set $stUsed (i32.load offset=20 (local.get $stMeta)))
    (if (i32.lt_s (local.get $clIdx) (i32.const 0))
      (then (return (f64.add (f64.mul (f64.load (local.get $stMeta)) (local.get $scale))
        (f64.mul (f64.add (local.get $histBase) (f64.mul (local.get $histSym) (f64.convert_i32_u (local.get $stUsed)))) (f64.const 4096))))))
    (local.set $cm (i32.add (local.get $clMetaAt) (i32.mul (local.get $clIdx) (i32.const 24))))
    (local.set $cTotal (i32.load offset=16 (local.get $cm)))
    (if (i32.eqz (local.get $cTotal))
      (then (return (f64.add (f64.mul (f64.load (local.get $stMeta)) (local.get $scale))
        (f64.mul (f64.add (local.get $histBase) (f64.mul (local.get $histSym) (f64.convert_i32_u (local.get $stUsed)))) (f64.const 4096))))))
    (local.set $freq (i32.add (local.get $clFreqAt) (i32.shl (i32.mul (local.get $clIdx) (local.get $alphabet)) (i32.const 2))))
    (local.set $nzOff (i32.load offset=24 (local.get $stMeta)))
    (local.set $nzLen (i32.load offset=28 (local.get $stMeta)))
    (local.set $dSumT (f64.const 0))
    (local.set $newUsed (i32.const 0))
    (local.set $j (i32.const 0))
    (block $nzDone (loop $nzLoop
      (br_if $nzDone (i32.ge_u (local.get $j) (local.get $nzLen)))
      (local.set $cur (i32.load (i32.add (local.get $freq)
        (i32.shl (i32.load8_u (i32.add (local.get $nzSymAt) (i32.add (local.get $nzOff) (local.get $j)))) (i32.const 2)))))
      (local.set $val (i32.load (i32.add (local.get $nzValAt) (i32.shl (i32.add (local.get $nzOff) (local.get $j)) (i32.const 2)))))
      (local.set $dSumT (f64.add (local.get $dSumT) (f64.sub
        (f64.load (i32.add (local.get $table) (i32.shl (i32.add (local.get $cur) (local.get $val)) (i32.const 3))))
        (f64.load (i32.add (local.get $table) (i32.shl (local.get $cur) (i32.const 3)))))))
      (if (i32.eqz (local.get $cur)) (then (local.set $newUsed (i32.add (local.get $newUsed) (i32.const 1)))))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $nzLoop)))
    (f64.add
      (f64.mul
        (f64.add
          (f64.sub
            (f64.sub
              (f64.load (i32.add (local.get $table) (i32.shl (i32.add (local.get $cTotal) (local.get $stTotal)) (i32.const 3))))
              (f64.add (f64.load (local.get $cm)) (local.get $dSumT)))
            (f64.load offset=8 (local.get $cm)))
          (f64.load offset=8 (local.get $stMeta)))
        (local.get $scale))
      (f64.mul (f64.mul (local.get $histSym) (f64.convert_i32_u (local.get $newUsed))) (f64.const 4096))))

  ;; Exact scoreClusterProposal evaluation (capture-trees.mjs scoreClusterProposal): kernels.mjs sampled scoreCluster.
  (func $sampledClusterEval (export "sampledClusters")
    (param $clFreqAt i32) (param $clMetaAt i32) (param $K i32) (param $g0 i32) (param $freeSlots i32)
    (param $kinds i32) (param $alphabet i32) (param $hasRem i32) (param $itemHistAt i32)
    (param $table i32) (param $params i32) (param $propMetaAt i32) (param $nzSymAt i32) (param $nzValAt i32)
    (param $out i32) (param $hiBest i32) (param $loBest i32) (param $mode i32) (result i32)
    (local $s i32) (local $v i32) (local $cur i32) (local $remFreq i32) (local $srcFreq i32) (local $srcMeta i32) (local $remMeta i32)
    (local $total i32) (local $used i32) (local $side i32) (local $step i32) (local $c i32) (local $g i32)
    (local $bestPred i32) (local $stMeta i32) (local $baseIdx i32)
    (local $hasB1 i32) (local $b1Pred i32) (local $b1Cl i32) (local $hasB2 i32) (local $b2Pred i32) (local $b2Cl i32)
    (local $hasHi1 i32) (local $hi1Pred i32) (local $hi1Cl i32) (local $hasHi2 i32) (local $hi2Pred i32) (local $hi2Cl i32)
    (local $hasLo1 i32) (local $lo1Pred i32) (local $lo1Cl i32) (local $hasLo2 i32) (local $lo2Pred i32) (local $lo2Cl i32)
    (local $hiPred i32) (local $hiCl i32) (local $loPred i32) (local $loCl i32) (local $shared i32)
    (local $hcPred i32) (local $hcCl i32) (local $lcPred i32) (local $lcCl i32) (local $hiIdx i32) (local $loIdx i32)
    (local $sumT f64) (local $scale f64) (local $maxExtra f64) (local $limit f64) (local $cost f64)
    (local $b1Cost f64) (local $b2Cost f64) (local $hi1Cost f64) (local $hi2Cost f64) (local $lo1Cost f64) (local $lo2Cost f64)
    (local $hcCost f64) (local $lcCost f64) (local $before f64) (local $bestAfter f64)
    (local.set $scale (f64.load (local.get $params)))
    (if (i32.eq (local.get $mode) (i32.const 2))
      (then
        (local.set $remFreq (i32.load offset=40 (local.get $params)))
        (local.set $srcFreq (i32.load offset=44 (local.get $params)))
        (local.set $remMeta (i32.add (local.get $srcFreq) (i32.shl (i32.mul (local.get $kinds) (local.get $alphabet)) (i32.const 2))))
        (local.set $cur (i32.load offset=48 (local.get $params)))
        (local.set $c (i32.const 0))
        (loop $buildHiStats
          (local.set $cur (call $writeHistStat
            (i32.add (local.get $remMeta) (i32.shl (i32.mul (local.get $c) (local.get $alphabet)) (i32.const 2)))
            (i32.const 0) (local.get $alphabet) (local.get $table) (local.get $remFreq)
            (i32.add (local.get $propMetaAt) (i32.shl (i32.add (i32.const 1) (local.get $c)) (i32.const 5)))
            (local.get $nzSymAt) (local.get $nzValAt) (local.get $cur)))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (br_if $buildHiStats (i32.lt_u (local.get $c) (local.get $kinds))))
        (local.set $c (i32.const 0))
        (loop $buildLoStats
          (local.set $cur (call $writeHistStat
            (i32.add (local.get $srcFreq) (i32.shl (i32.mul (local.get $c) (local.get $alphabet)) (i32.const 2)))
            (i32.const 0) (local.get $alphabet) (local.get $table) (local.get $remFreq)
            (i32.add (local.get $propMetaAt) (i32.shl (i32.add (i32.add (i32.const 1) (local.get $kinds)) (local.get $c)) (i32.const 5)))
            (local.get $nzSymAt) (local.get $nzValAt) (local.get $cur)))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (br_if $buildLoStats (i32.lt_u (local.get $c) (local.get $kinds))))
        (local.set $cur (call $writeHistStat
          (i32.add (local.get $remMeta) (i32.shl (i32.mul (local.get $hiBest) (local.get $alphabet)) (i32.const 2)))
          (i32.add (local.get $srcFreq) (i32.shl (i32.mul (local.get $loBest) (local.get $alphabet)) (i32.const 2)))
          (local.get $alphabet) (local.get $table) (local.get $remFreq)
          (i32.add (local.get $propMetaAt) (i32.shl (i32.add (i32.const 1) (i32.shl (local.get $kinds) (i32.const 1))) (i32.const 5)))
          (local.get $nzSymAt) (local.get $nzValAt) (local.get $cur)))
        (i32.store offset=44 (local.get $out) (local.get $cur))))
    (if (i32.eq (local.get $mode) (i32.const 1))
      (then
        (local.set $bestAfter (f64.load offset=8 (local.get $out)))
        (local.set $hiPred (i32.load offset=16 (local.get $out)))
        (local.set $hiCl (i32.load offset=20 (local.get $out)))
        (local.set $loPred (i32.load offset=24 (local.get $out)))
        (local.set $loCl (i32.load offset=28 (local.get $out)))
        (local.set $shared (i32.load offset=32 (local.get $out)))
        (local.set $stMeta (local.get $propMetaAt))
        (if (f64.lt (f64.mul (f64.load (local.get $stMeta)) (local.get $scale)) (local.get $bestAfter))
          (then
            (if (i32.ge_s (local.get $freeSlots) (i32.const 1))
              (then
                (local.set $cost (call $sampledClusterCost (i32.const -1) (local.get $stMeta) (local.get $clFreqAt) (local.get $clMetaAt)
                  (local.get $alphabet) (local.get $table) (local.get $params) (local.get $nzSymAt) (local.get $nzValAt)))
                (if (f64.lt (local.get $cost) (local.get $bestAfter))
                  (then (local.set $bestAfter (local.get $cost)) (local.set $hiPred (local.get $hiBest)) (local.set $hiCl (i32.const -1))
                    (local.set $loPred (local.get $loBest)) (local.set $loCl (i32.const -1)) (local.set $shared (i32.const 1))))))
            (local.set $g (i32.const 0))
            (block $sh1Done (loop $sh1Loop
              (br_if $sh1Done (i32.ge_s (local.get $g) (local.get $K)))
              (if (i32.or (i32.ne (local.get $g) (local.get $g0)) (local.get $hasRem))
                (then
                  (local.set $cost (call $sampledClusterCost (select (i32.const 255) (local.get $g) (i32.eq (local.get $g) (local.get $g0)))
                    (local.get $stMeta) (local.get $clFreqAt) (local.get $clMetaAt) (local.get $alphabet) (local.get $table)
                    (local.get $params) (local.get $nzSymAt) (local.get $nzValAt)))
                  (if (f64.lt (local.get $cost) (local.get $bestAfter))
                    (then (local.set $bestAfter (local.get $cost)) (local.set $hiPred (local.get $hiBest)) (local.set $hiCl (local.get $g))
                      (local.set $loPred (local.get $loBest)) (local.set $loCl (local.get $g)) (local.set $shared (i32.const 1))))))
              (local.set $g (i32.add (local.get $g) (i32.const 1)))
              (br $sh1Loop)))
            (f64.store offset=8 (local.get $out) (local.get $bestAfter))
            (i32.store offset=16 (local.get $out) (local.get $hiPred))
            (i32.store offset=20 (local.get $out) (local.get $hiCl))
            (i32.store offset=24 (local.get $out) (local.get $loPred))
            (i32.store offset=28 (local.get $out) (local.get $loCl))
            (i32.store offset=32 (local.get $out) (local.get $shared))))
        (return (i32.const 0))))
    (if (local.get $hasRem)
      (then
        (local.set $srcFreq (i32.add (local.get $clFreqAt) (i32.shl (i32.mul (local.get $g0) (local.get $alphabet)) (i32.const 2))))
        (local.set $remFreq (i32.add (local.get $clFreqAt) (i32.shl (i32.mul (i32.const 255) (local.get $alphabet)) (i32.const 2))))
        (memory.copy (local.get $remFreq) (local.get $srcFreq) (i32.shl (local.get $alphabet) (i32.const 2)))
        (local.set $srcMeta (i32.add (local.get $clMetaAt) (i32.mul (local.get $g0) (i32.const 24))))
        (local.set $remMeta (i32.add (local.get $clMetaAt) (i32.mul (i32.const 255) (i32.const 24))))
        (local.set $sumT (f64.load (local.get $srcMeta)))
        (local.set $total (i32.load offset=16 (local.get $srcMeta)))
        (local.set $used (i32.load offset=20 (local.get $srcMeta)))
        (local.set $s (i32.const 0))
        (loop $remLoop
          (local.set $v (i32.load (i32.add (local.get $itemHistAt) (i32.shl (local.get $s) (i32.const 2)))))
          (if (local.get $v)
            (then
              (local.set $cur (i32.load (i32.add (local.get $remFreq) (i32.shl (local.get $s) (i32.const 2)))))
              (local.set $sumT (f64.add (local.get $sumT) (f64.sub
                (f64.load (i32.add (local.get $table) (i32.shl (i32.sub (local.get $cur) (local.get $v)) (i32.const 3))))
                (f64.load (i32.add (local.get $table) (i32.shl (local.get $cur) (i32.const 3)))))))
              (i32.store (i32.add (local.get $remFreq) (i32.shl (local.get $s) (i32.const 2))) (i32.sub (local.get $cur) (local.get $v)))
              (if (i32.eq (local.get $cur) (local.get $v)) (then (local.set $used (i32.sub (local.get $used) (i32.const 1)))))
              (local.set $total (i32.sub (local.get $total) (local.get $v)))))
          (local.set $s (i32.add (local.get $s) (i32.const 1)))
          (br_if $remLoop (i32.lt_u (local.get $s) (local.get $alphabet))))
        (f64.store (local.get $remMeta) (local.get $sumT))
        (f64.store offset=8 (local.get $remMeta) (f64.sub (f64.load (i32.add (local.get $table) (i32.shl (local.get $total) (i32.const 3)))) (local.get $sumT)))
        (i32.store offset=16 (local.get $remMeta) (local.get $total))
        (i32.store offset=20 (local.get $remMeta) (local.get $used))))
    (local.set $before (call $sampledClusterCost (select (i32.const 255) (i32.const -1) (local.get $hasRem))
      (local.get $propMetaAt) (local.get $clFreqAt) (local.get $clMetaAt) (local.get $alphabet) (local.get $table)
      (local.get $params) (local.get $nzSymAt) (local.get $nzValAt)))
    (local.set $maxExtra (f64.mul (f64.add (f64.load offset=8 (local.get $params))
      (f64.mul (f64.convert_i32_u (local.get $alphabet)) (f64.load offset=16 (local.get $params)))) (f64.const 4096)))
    ;; Side 0 reads hiStats and side 1 reads loStats.
    (local.set $side (i32.const 0))
    (loop $sidesLoop
      (local.set $hasB1 (i32.const 0)) (local.set $hasB2 (i32.const 0))
      (local.set $bestPred (select (local.get $hiBest) (local.get $loBest) (i32.eqz (local.get $side))))
      (local.set $limit (f64.add (f64.mul (select (f64.load offset=24 (local.get $params)) (f64.load offset=32 (local.get $params)) (i32.eqz (local.get $side)))
        (local.get $scale)) (local.get $maxExtra)))
      (local.set $baseIdx (i32.add (i32.const 1) (i32.mul (local.get $side) (local.get $kinds))))
      (local.set $step (i32.const 0))
      (loop $stepsLoop
        (local.set $c (select (local.get $bestPred)
          (select (i32.sub (local.get $step) (i32.const 1)) (local.get $step) (i32.le_s (local.get $step) (local.get $bestPred)))
          (i32.eqz (local.get $step))))
        (local.set $stMeta (i32.add (local.get $propMetaAt) (i32.shl (i32.add (local.get $baseIdx) (local.get $c)) (i32.const 5))))
        (if (i32.eqz (f64.gt (f64.mul (f64.load (local.get $stMeta)) (local.get $scale))
              (select (f64.add (local.get $b2Cost) (f64.const 4096)) (local.get $limit) (local.get $hasB2))))
          (then
            (if (i32.ge_s (local.get $freeSlots) (i32.const 1))
              (then
                (local.set $cost (call $sampledClusterCost (i32.const -1) (local.get $stMeta) (local.get $clFreqAt) (local.get $clMetaAt)
                  (local.get $alphabet) (local.get $table) (local.get $params) (local.get $nzSymAt) (local.get $nzValAt)))
                (if (i32.or (i32.eqz (local.get $hasB1)) (f64.lt (local.get $cost) (local.get $b1Cost)))
                  (then
                    (if (i32.and (local.get $hasB1) (i32.ne (local.get $b1Cl) (i32.const -1)))
                      (then (local.set $hasB2 (i32.const 1)) (local.set $b2Pred (local.get $b1Pred)) (local.set $b2Cl (local.get $b1Cl)) (local.set $b2Cost (local.get $b1Cost))))
                    (local.set $hasB1 (i32.const 1)) (local.set $b1Pred (local.get $c)) (local.set $b1Cl (i32.const -1)) (local.set $b1Cost (local.get $cost)))
                  (else (if (i32.and (i32.ne (i32.const -1) (local.get $b1Cl)) (i32.or (i32.eqz (local.get $hasB2)) (f64.lt (local.get $cost) (local.get $b2Cost))))
                    (then (local.set $hasB2 (i32.const 1)) (local.set $b2Pred (local.get $c)) (local.set $b2Cl (i32.const -1)) (local.set $b2Cost (local.get $cost))))))))
            (local.set $g (i32.const 0))
            (block $clDone (loop $clLoop
              (br_if $clDone (i32.ge_s (local.get $g) (local.get $K)))
              (if (i32.or (i32.ne (local.get $g) (local.get $g0)) (local.get $hasRem))
                (then
                  (local.set $cost (call $sampledClusterCost (select (i32.const 255) (local.get $g) (i32.eq (local.get $g) (local.get $g0)))
                    (local.get $stMeta) (local.get $clFreqAt) (local.get $clMetaAt) (local.get $alphabet) (local.get $table)
