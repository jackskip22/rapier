    (i32.store offset=40 (local.get $out) (select (local.get $lo1Pred) (i32.const -1) (local.get $hasLo1)))
    (i32.const 0))

  (func $sampledNode (export "sampledNode")
    (param $resSym i32) (param $resIdx i32) (param $count i32) (param $members i32) (param $total i32)
    (param $kinds i32) (param $alphabet i32) (param $columns i32) (param $cutsAt i32)
    (param $hist i32) (param $table i32) (param $raw i32)
    (param $symbols i32) (param $indices i32) (param $scratch i32) (param $out i32)
    (param $parent i32) (param $sibling i32) (param $save i32) (param $splitAt i32) (param $maxPrice f64) (result i32)
    (local $derive i32) (local $c i32) (local $s i32) (local $i i32) (local $k i32) (local $m i32) (local $cuts i32)
    (local $from i32) (local $size i32) (local $offset i32) (local $targetDense i32) (local $bin i32)
    (local $initStats i32) (local $limits i32) (local $zeroRaw16 i32)
    (local $end i32) (local $p i32) (local $h i32) (local $stats i32) (local $stateBytes i32)
    (local $maxLimit i32) (local $stride i32) (local $minB i32) (local $maxB i32) (local $useSym i32) (local $useIdx i32)
    (local $bestColumn i32) (local $t f64) (local $r f64) (local $price f64) (local $best f64)
    (if (i32.eq (local.get $splitAt) (i32.const -1))
      (then
        (local.set $i (i32.const 0))
        (loop $peelSym
          (local.set $m (i32.load (i32.add (local.get $members) (i32.shl (local.get $i) (i32.const 2)))))
