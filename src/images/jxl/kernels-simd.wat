              (v128.and (f64x2.mul (local.get $rv) (v128.load (local.get $luma))) (local.get $ac))) (v128.const f64x2 0 0))
              (v128.const f64x2 256 256)) (v128.load (local.get $qt))))
            (if (local.get $fields) (then
              (local.set $vv (f64x2.mul (local.get $vv) (local.get $finev)))
              (local.set $finev (f64x2.splat (local.get $fine)))))
            (local.set $fv (f64x2.floor (local.get $vv)))
            (local.set $fv (f64x2.add (local.get $fv) (v128.and (f64x2.ge (f64x2.sub (local.get $vv) (local.get $fv)) (v128.const f64x2 0.5 0.5))
              (v128.const f64x2 1 1))))
