                  (local.set $s (i32.load8_u (i32.add (local.get $from) (i32.load (i32.add (local.get $members) (i32.shl (local.get $i) (i32.const 2)))))))
                  (i32.store8 (i32.add (local.get $indices) (local.get $i)) (local.get $s))
                  (local.set $minB (select (local.get $s) (local.get $minB) (i32.lt_u (local.get $s) (local.get $minB))))
                  (local.set $maxB (select (local.get $s) (local.get $maxB) (i32.gt_u (local.get $s) (local.get $maxB))))
                  (local.set $i (i32.add (local.get $i) (i32.const 1)))
                  (br_if $peelBins (i32.lt_u (local.get $i) (local.get $total))))
                (if (i32.eq (local.get $minB) (local.get $maxB))
                  (then
                    (local.set $p (i32.add (i32.add (local.get $parent) (local.get $offset))
                      (i32.shl (i32.mul (local.get $minB) (local.get $size)) (i32.const 2))))
