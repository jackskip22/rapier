            (f64.div (f64.convert_i32_s (local.get $fb)) (f64.const 84)) (i32.eqz (local.get $c))))
          (local.set $at (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 1536)) (i32.shl (local.get $c) (i32.const 9)))))
          (local.set $out (i32.add (i32.mul (i32.add (i32.shl (local.get $c) (i32.const 3)) (local.get $by)) (local.get $across))
            (i32.add (i32.shl (local.get $t) (i32.const 3)) (local.get $bx))))
