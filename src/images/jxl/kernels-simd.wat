          (i32.add (i32.mul (local.get $v) (local.get $w)) (local.get $u)) (local.get $tall)))
        (f64.store (i32.add (local.get $out) (i32.shl (local.get $idx) (i32.const 3))) (local.get $s))
        (local.set $u (i32.add (local.get $u) (i32.const 1)))
        (br_if $cols (i32.lt_u (local.get $u) (local.get $w))))
      (local.set $v (i32.add (local.get $v) (i32.const 1)))
      (br_if $vs (i32.lt_u (local.get $v) (local.get $h)))))

  ;; Exact smallTransform (vardct-strategies.mjs lines 117-159) for id in {3 (dct4), 12 (dct4x8), 13 (dct8x4)}.
  (func $vbSmall (param $pix i32) (param $stride i32) (param $id i32) (param $b4 i32) (param $b8 i32) (param $tmp i32) (param $out i32)
    (local $sub i32) (local $b4t i32) (local $b8t i32) (local $bx i32) (local $by i32) (local $half i32) (local $x i32) (local $y i32)
    (local $a f64) (local $b f64) (local $c f64) (local $d f64)
    (local.set $sub (i32.add (local.get $tmp) (i32.const 512)))
    (local.set $b4t (i32.add (local.get $b4) (i32.const 128)))
    (local.set $b8t (i32.add (local.get $b8) (i32.const 512)))
    (if (i32.eq (local.get $id) (i32.const 3))
      (then
        (local.set $by (i32.const 0))
        (loop $byL
          (local.set $bx (i32.const 0))
          (loop $bxL
            (call $vbSubDct
              (i32.add (local.get $pix) (i32.shl (i32.add (i32.mul (i32.shl (local.get $by) (i32.const 2)) (local.get $stride)) (i32.shl (local.get $bx) (i32.const 2))) (i32.const 3)))
              (local.get $stride) (i32.const 4) (i32.const 4) (local.get $b4t) (local.get $b4) (local.get $tmp) (local.get $sub))
            (local.set $y (i32.const 0))
            (loop $sy
              (local.set $x (i32.const 0))
              (loop $sx
                (f64.store
                  (i32.add (local.get $out) (i32.shl (i32.add (i32.shl (i32.add (local.get $by) (i32.shl (local.get $y) (i32.const 1))) (i32.const 3)) (i32.add (local.get $bx) (i32.shl (local.get $x) (i32.const 1)))) (i32.const 3)))
                  (f64.load (i32.add (local.get $sub) (i32.shl (i32.add (i32.shl (local.get $y) (i32.const 2)) (local.get $x)) (i32.const 3)))))
                (local.set $x (i32.add (local.get $x) (i32.const 1)))
                (br_if $sx (i32.lt_u (local.get $x) (i32.const 4))))
              (local.set $y (i32.add (local.get $y) (i32.const 1)))
              (br_if $sy (i32.lt_u (local.get $y) (i32.const 4))))
            (local.set $bx (i32.add (local.get $bx) (i32.const 1)))
            (br_if $bxL (i32.lt_u (local.get $bx) (i32.const 2))))
          (local.set $by (i32.add (local.get $by) (i32.const 1)))
          (br_if $byL (i32.lt_u (local.get $by) (i32.const 2))))
        (local.set $a (f64.load offset=0 (local.get $out)))
        (local.set $b (f64.load offset=8 (local.get $out)))
        (local.set $c (f64.load offset=64 (local.get $out)))
        (local.set $d (f64.load offset=72 (local.get $out)))
        (f64.store offset=0 (local.get $out) (f64.mul (f64.add (f64.add (f64.add (local.get $a) (local.get $b)) (local.get $c)) (local.get $d)) (f64.const 0.25)))
        (f64.store offset=8 (local.get $out) (f64.mul (f64.sub (f64.sub (f64.add (local.get $a) (local.get $b)) (local.get $c)) (local.get $d)) (f64.const 0.25)))
        (f64.store offset=64 (local.get $out) (f64.mul (f64.sub (f64.add (f64.sub (local.get $a) (local.get $b)) (local.get $c)) (local.get $d)) (f64.const 0.25)))
        (f64.store offset=72 (local.get $out) (f64.mul (f64.add (f64.sub (f64.sub (local.get $a) (local.get $b)) (local.get $c)) (local.get $d)) (f64.const 0.25))))
      (else
