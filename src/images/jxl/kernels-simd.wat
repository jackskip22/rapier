              (then
                (local.set $lcPred (select (local.get $lo1Pred) (local.get $lo2Pred) (i32.eqz (local.get $loIdx))))
                (local.set $lcCl (select (local.get $lo1Cl) (local.get $lo2Cl) (i32.eqz (local.get $loIdx))))
                (local.set $lcCost (select (local.get $lo1Cost) (local.get $lo2Cost) (i32.eqz (local.get $loIdx))))
                (if (i32.or (i32.ne (local.get $hcCl) (local.get $lcCl))
                      (i32.and (i32.eq (local.get $hcCl) (i32.const -1)) (i32.ge_s (local.get $freeSlots) (i32.const 2))))
                  (then
                    (local.set $cost (f64.add (local.get $hcCost) (local.get $lcCost)))
