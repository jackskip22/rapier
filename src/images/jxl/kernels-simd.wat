            (local.set $loIdx (i32.add (local.get $loIdx) (i32.const 1)))
            (br_if $combLo (i32.lt_s (local.get $loIdx) (i32.const 2))))))
      (local.set $hiIdx (i32.add (local.get $hiIdx) (i32.const 1)))
      (br_if $combHi (i32.lt_s (local.get $hiIdx) (i32.const 2))))
