      (i32.store (i32.add (local.get $limits) (i32.shl (local.get $c) (i32.const 2))) (local.get $end))
      (local.set $stats (i32.add (local.get $initStats) (i32.shl (local.get $c) (i32.const 5))))
      (f64.store (local.get $stats) (f64.const 0))
      (f64.store offset=8 (local.get $stats) (local.get $t))
      (f64.store offset=16 (local.get $stats) (f64.const 0))
      (f64.store offset=24 (local.get $stats) (local.get $r))
      (local.set $c (i32.add (local.get $c) (i32.const 1)))
      (br_if $initCandNode (i32.lt_u (local.get $c) (local.get $kinds))))
    (local.set $stride (i32.and (i32.add (local.get $maxLimit) (i32.const 3)) (i32.const -4)))
    (if (i32.gt_u (local.get $stride) (local.get $alphabet)) (then (local.set $stride (local.get $alphabet))))
    (local.set $useSym (local.get $symbols))
    (if (i32.eqz (local.get $derive))
      (then
        (if (i32.eqz (local.get $members))
          (then (local.set $useSym (local.get $resSym)))
          (else
            (local.set $i (i32.const 0))
            (loop $gatherV128
              (local.set $m (i32.load (i32.add (local.get $members) (i32.shl (local.get $i) (i32.const 2)))))
              (if (i32.ge_u (local.get $m) (local.get $count)) (then (return (i32.const -2))))
              (v128.store (i32.add (local.get $symbols) (i32.shl (local.get $i) (i32.const 4)))
                (v128.load (i32.add (local.get $resSym) (i32.shl (local.get $m) (i32.const 4)))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br_if $gatherV128 (i32.lt_u (local.get $i) (local.get $total))))))))
    (local.set $bestColumn (i32.const -1))
    (local.set $best (local.get $maxPrice))
    (local.set $k (i32.const 0))
    (block $columnsDone
      (loop $eachColumn
        (br_if $columnsDone (i32.ge_u (local.get $k) (local.get $columns)))
        (local.set $cuts (i32.load (i32.add (local.get $cutsAt) (i32.shl (local.get $k) (i32.const 2)))))
        (if (local.get $cuts)
