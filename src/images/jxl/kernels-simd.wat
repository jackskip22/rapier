      (then (return (i32.add (i32.trunc_f64_s (local.get $floor)) (i32.and (i32.trunc_f64_s (local.get $floor)) (i32.const 1))))))
    (i32.trunc_f64_s (call $nRound (local.get $v))))
  (func (export "nativeRows") (param $in i32) (param $w i32) (param $h i32) (param $ox i32) (param $oy i32)
    (param $t i32) (param $low i32) (param $k i32) (param $out i32) (param $alpha i32) (param $gamma i32)
    (local $row i32) (local $col i32) (local $plane i32) (local $plane2 i32) (local $at0 i32) (local $o i32) (local $dither i32)
    (local $d0 i32) (local $d1 i32) (local $d2 i32) (local $knots i32) (local $rk i32) (local $sk i32) (local $at i32) (local $pix i32)
    (local $v f64) (local $d f64) (local $u f64) (local $lo f64) (local $hi f64) (local $r f64) (local $q f64) (local $byte f64) (local $low64 f64)
