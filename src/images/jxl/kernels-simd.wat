      (local.set $x0h (call $fquant1 (local.get $x0) (f32.load (local.get $stPtr)) (f32.load (local.get $istPtr)) (f32.load (local.get $thPtr))))
      (local.set $m (i32.shl (i32.add (i32.mul (local.get $n) (i32.const 3)) (i32.const 1)) (i32.const 2)))
