  ;; gpu-dequant.mjs kernels (coeffPlanes):
  ;;   mode 0: rcLlfFromDC(means, bw, bh) -> scaledDCT(means, bw, bh) / llfDivisors(max, min)
  ;;   mode 1: fixed-DCT8 coefficientPlanes strip (/ 2040 -> f32 planes + packed cell words)
  ;;   mode 2: variable-strategy coefficientPlanes band (AC dequant, CfL, LLF from DC, small-transform inverse, / 255 -> f32 planes + cell words)
  ;;   mode 3: epfInverseSigma (per-cell 1 / sigma in f32)
  (func $llfBlock (param $means i32) (param $bw i32) (param $bh i32) (param $bt i32) (param $by i32) (param $div i32) (param $tmp i32) (param $out i32)
    (local $area i32) (local $i i32)
    (local.set $area (i32.mul (local.get $bw) (local.get $bh)))
    (call $vbSubDct (local.get $means) (local.get $bw) (local.get $bw) (local.get $bh) (local.get $bt) (local.get $by) (local.get $tmp) (local.get $out))
    (local.set $i (i32.const 0))
    (loop $divL
      (f64.store (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 3)))
        (f64.div (f64.load (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 3))))
          (f64.load (i32.add (local.get $div) (i32.shl (local.get $i) (i32.const 3))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $divL (i32.lt_u (local.get $i) (local.get $area)))))

  (func $invIdctSub (param $coeff i32) (param $w i32) (param $h i32) (param $bx i32) (param $by i32) (param $tmp i32) (param $out i32)
    (local $v i32) (local $x i32) (local $u i32) (local $y i32) (local $tall i32) (local $idx i32)
    (local $sum f64) (local $wf f64) (local $hf f64)
