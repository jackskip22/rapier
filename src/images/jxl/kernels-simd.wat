              (local.set $bitsB (i32.sub (i32.sub (local.get $nbB) (local.get $msbB)) (local.get $lsbB)))
              (local.set $symbolB (i32.add (i32.load (local.get $cfgB))
                (i32.or (i32.or (i32.shl (i32.sub (local.get $nbB) (local.get $splitB)) (i32.add (local.get $msbB) (local.get $lsbB)))
                    (i32.shl (i32.shr_u (local.get $belowB) (i32.sub (local.get $nbB) (local.get $msbB))) (local.get $lsbB)))
                  (i32.and (local.get $belowB) (i32.sub (i32.shl (i32.const 1) (local.get $lsbB)) (i32.const 1))))))
              (local.set $rawB (i32.and (i32.shr_u (local.get $valueB) (local.get $lsbB)) (i32.sub (i32.shl (i32.const 1) (local.get $bitsB)) (i32.const 1))))))
          (local.set $atB (i32.shl (i32.add (i32.mul (local.get $idB) (local.get $alphabet)) (local.get $symbolB)) (i32.const 2)))
          (local.set $freqB (i32.load (i32.add (local.get $hcounts) (local.get $atB))))
          (local.set $startB (i32.load (i32.add (local.get $hstarts) (local.get $atB))))))
      (i32.store (i32.add (local.get $rawsB) (i32.shl (local.get $iB) (i32.const 2))) (local.get $rawB))
      (local.set $nbB (i32.ge_u (i32.shr_u (local.get $stateB) (i32.const 20)) (local.get $freqB)))
      (i32.store16 (i32.add (local.get $emittedB) (i32.shl (local.get $iB) (i32.const 1))) (local.get $stateB))
      (i32.store8 (i32.add (local.get $metaB) (local.get $iB)) (i32.or (local.get $bitsB) (i32.shl (local.get $nbB) (i32.const 6))))
      (local.set $stateB (i32.shr_u (local.get $stateB) (i32.shl (local.get $nbB) (i32.const 4))))
      ;; state / freq by its exact reciprocal (72: m' and the shift l a frequency, m = 2^32 + m' = ceil(2^(32 + l) / freq),
      ;; l = ceil(log2 freq)): ((state m' >> 32) + state) >> l is the quotient for every 32-bit state (Granlund and
      ;; Montgomery), a multiplication's latency instead of a division's.
      (local.set $rcB (i32.add (local.get $recips) (i32.shl (local.get $freqB) (i32.const 3))))
      (local.set $qB (i32.wrap_i64 (i64.shr_u (i64.add (i64.shr_u (i64.mul (i64.extend_i32_u (local.get $stateB)) (i64.extend_i32_u (i32.load (local.get $rcB))))
        (i64.const 32)) (i64.extend_i32_u (local.get $stateB))) (i64.extend_i32_u (i32.load offset=4 (local.get $rcB))))))
      (local.set $stateB (i32.add (i32.mul (local.get $qB) (i32.const 4096))
        (i32.load16_u (i32.add (local.get $rev) (i32.shl (i32.add (i32.add (i32.shl (local.get $idB) (i32.const 12)) (local.get $startB)) (i32.sub (local.get $stateB) (i32.mul (local.get $qB) (local.get $freqB)))) (i32.const 1))))))
    (br $both)))
  (local.set $stateA (call $ansBackRun (local.get $a) (local.get $iA) (local.get $stateA)))
  (local.set $stateB (call $ansBackRun (local.get $b) (local.get $iB) (local.get $stateB)))
  (call $ansForward (local.get $a) (local.get $stateA))
  (call $ansForward (local.get $b) (local.get $stateB)))

;; packLevels (UP10, kernels.mjs gabBand with `packed`): one tile row's levels as fgTiles left them ($levels: for each
;; channel c and block row by < $bh, $blocks blocks of 64 i16 at row c * 8 + by; nonzero AC counts at $counts, a byte a
;; block, the same rows) packed in channel, row and block order: each nonzero AC level's position (1 to 63) at $outAt and
;; value at $outVal, the block's first entry's index (from $base) at $starts (i32, a block), its DC at $dc (i16, a
;; block), and one more for each nonzero AC position k of channel c at $hist + 4 * (c * 64 + k). Returns the entries.
(func (export "packLevels") (param $levels i32) (param $counts i32) (param $bh i32) (param $blocks i32) (param $outAt i32)
  (param $outVal i32) (param $starts i32) (param $dc i32) (param $hist i32) (param $base i32) (param $lut i32) (result i32)
  (local $c i32) (local $by i32) (local $b i32) (local $row i32) (local $block i32) (local $v i32) (local $mask i32)
  (local $n i32) (local $slot i32) (local $h i32) (local $vec v128) (local $ne v128) (local $hv i32)
  (local.set $c (i32.const 0))
  (loop $channels
    (local.set $h (i32.add (local.get $hist) (i32.shl (local.get $c) (i32.const 8))))
    (local.set $by (i32.const 0))
    (block $rowsDone (loop $rows
      (br_if $rowsDone (i32.ge_u (local.get $by) (local.get $bh)))
      (local.set $row (i32.mul (i32.add (i32.shl (local.get $c) (i32.const 3)) (local.get $by)) (local.get $blocks)))
      (local.set $b (i32.const 0))
      (block $blocksDone (loop $blockLoop
        (br_if $blocksDone (i32.ge_u (local.get $b) (local.get $blocks)))
        (local.set $slot (i32.add (local.get $row) (local.get $b)))
        (local.set $block (i32.add (local.get $levels) (i32.shl (local.get $slot) (i32.const 7))))
        (i32.store (i32.add (local.get $starts) (i32.shl (local.get $slot) (i32.const 2))) (i32.add (local.get $base) (local.get $n)))
        (i32.store16 (i32.add (local.get $dc) (i32.shl (local.get $slot) (i32.const 1))) (i32.load16_s (local.get $block)))
        (if (i32.load8_u (i32.add (local.get $counts) (local.get $slot)))
          (then
            (local.set $v (i32.const 0))
            (loop $vectors
              ;; Eight levels at once, without a branch a level: the nonzero lanes' mask (lane 0 of the first vector is DC),
              ;; their positions and values moved to the front by the mask's table entry ($lut: 16 shuffle bytes, then 8
              ;; lane numbers, a mask), each nonzero position counted, n advanced by the mask's bits.
              (local.set $vec (v128.load (i32.add (local.get $block) (i32.shl (local.get $v) (i32.const 4)))))
              (local.set $ne (i16x8.ne (local.get $vec) (v128.const i32x4 0 0 0 0)))
              (if (i32.eqz (local.get $v)) (then (local.set $ne (v128.and (local.get $ne) (v128.const i32x4 0xffff0000 -1 -1 -1)))))
              (local.set $mask (i16x8.bitmask (local.get $ne)))
              (local.set $hv (i32.add (local.get $h) (i32.shl (local.get $v) (i32.const 5))))
              (v128.store (local.get $hv) (i32x4.sub (v128.load (local.get $hv)) (i32x4.extend_low_i16x8_s (local.get $ne))))
              (v128.store offset=16 (local.get $hv) (i32x4.sub (v128.load offset=16 (local.get $hv)) (i32x4.extend_high_i16x8_s (local.get $ne))))
              (i64.store (i32.add (local.get $outAt) (local.get $n)) (i64.add (i64.load offset=4096 (i32.add (local.get $lut) (i32.shl (local.get $mask) (i32.const 3))))
                (i64.mul (i64.extend_i32_u (i32.shl (local.get $v) (i32.const 3))) (i64.const 0x0101010101010101))))
              (v128.store (i32.add (local.get $outVal) (i32.shl (local.get $n) (i32.const 1)))
                (i8x16.swizzle (local.get $vec) (v128.load (i32.add (local.get $lut) (i32.shl (local.get $mask) (i32.const 4))))))
              (local.set $n (i32.add (local.get $n) (i32.popcnt (local.get $mask))))
              (local.set $v (i32.add (local.get $v) (i32.const 1)))
              (br_if $vectors (i32.lt_u (local.get $v) (i32.const 8))))))
        (local.set $b (i32.add (local.get $b) (i32.const 1)))
        (br $blockLoop)))
      (local.set $by (i32.add (local.get $by) (i32.const 1)))
      (br $rows)))
    (local.set $c (i32.add (local.get $c) (i32.const 1)))
    (br_if $channels (i32.lt_u (local.get $c) (i32.const 3))))
  (local.get $n))

;; opaque (UP10, kernels.mjs gabBand with `packed`): 1 when every pixel of $bytes of RGBA at $rgba has alpha 255.
(func (export "opaque") (param $rgba i32) (param $bytes i32) (result i32)
  (local $p i32) (local $end i32) (local $one i32) (local $acc v128)
  (if (i32.and (local.get $bytes) (i32.const 3)) (then
    (local.set $one (i32.load (i32.sub (local.get $rgba) (i32.const 4))))
    (local.set $p (local.get $rgba))
    (local.set $end (i32.add (local.get $rgba) (i32.and (local.get $bytes) (i32.const -4))))
    (if (i32.eq (i32.and (local.get $bytes) (i32.const 3)) (i32.const 1))
      (then
        (block $d16 (loop $l16
          (br_if $d16 (i32.ge_u (local.get $p) (local.get $end)))
          (if (i32.ne (i32.load16_u offset=6 (local.get $p)) (local.get $one)) (then (return (i32.const 0))))
          (local.set $p (i32.add (local.get $p) (i32.const 8)))
          (br $l16)))
        (return (i32.const 1)))
      (else
        (block $d32 (loop $l32
          (br_if $d32 (i32.ge_u (local.get $p) (local.get $end)))
          (if (i32.ne (i32.load offset=12 (local.get $p)) (local.get $one)) (then (return (i32.const 0))))
          (local.set $p (i32.add (local.get $p) (i32.const 16)))
          (br $l32)))
        (return (i32.const 1))))))
  (local.set $acc (v128.const i32x4 -1 -1 -1 -1))
  (local.set $p (local.get $rgba))
  (local.set $end (i32.add (local.get $rgba) (i32.and (local.get $bytes) (i32.const -16))))
  (block $done (loop $quads
    (br_if $done (i32.ge_u (local.get $p) (local.get $end)))
    (local.set $acc (v128.and (local.get $acc) (v128.load (local.get $p))))
    (local.set $p (i32.add (local.get $p) (i32.const 16)))
    (br $quads)))
  (local.set $end (i32.add (local.get $rgba) (local.get $bytes)))
  (block $tailDone (loop $tail
    (br_if $tailDone (i32.ge_u (local.get $p) (local.get $end)))
    (local.set $acc (v128.and (local.get $acc) (i32x4.splat (i32.load (local.get $p)))))
    (local.set $p (i32.add (local.get $p) (i32.const 4)))
    (br $tail)))
  (i32x4.all_true (i32x4.ge_u (local.get $acc) (v128.const i32x4 0xff000000 0xff000000 0xff000000 0xff000000))))

;; unpackGroup (UP10, kernels.mjs acGroup on a packed picture): one group's AC levels made dense where acGroup reads
;; them: for each channel c, $bw x $bh blocks of 64 i16 from $coeffs + c * $cstride (DC left zero, acGroup reads AC
;; alone), from the group's packed entries in channel, row and block order ($at positions, $val values) and its counts
;; at $counts + c * $bw * $bh.
(func (export "unpackGroup") (param $coeffs i32) (param $cstride i32) (param $bw i32) (param $bh i32) (param $counts i32)
  (param $at i32) (param $val i32)
  (local $c i32) (local $b i32) (local $blocks i32) (local $base i32) (local $p i32) (local $end i32) (local $n i32) (local $left i32)
  (local.set $blocks (i32.mul (local.get $bw) (local.get $bh)))
  (local.set $c (i32.const 0))
  (loop $channels
    (local.set $base (i32.add (local.get $coeffs) (i32.mul (local.get $c) (local.get $cstride))))
    (local.set $p (local.get $base))
    (local.set $end (i32.add (local.get $base) (i32.shl (local.get $blocks) (i32.const 7))))
    (block $zeroDone (loop $zero
      (br_if $zeroDone (i32.ge_u (local.get $p) (local.get $end)))
      (v128.store (local.get $p) (v128.const i32x4 0 0 0 0))
      (v128.store offset=16 (local.get $p) (v128.const i32x4 0 0 0 0))
      (local.set $p (i32.add (local.get $p) (i32.const 32)))
      (br $zero)))
    (local.set $b (i32.const 0))
    (block $blocksDone (loop $blockLoop
      (br_if $blocksDone (i32.ge_u (local.get $b) (local.get $blocks)))
      (local.set $left (i32.load8_u (i32.add (local.get $counts) (i32.add (i32.mul (local.get $c) (local.get $blocks)) (local.get $b)))))
      (local.set $p (i32.add (local.get $base) (i32.shl (local.get $b) (i32.const 7))))
      (block $entriesDone (loop $entries
        (br_if $entriesDone (i32.eqz (local.get $left)))
        (i32.store16 (i32.add (local.get $p) (i32.shl (i32.load8_u (i32.add (local.get $at) (local.get $n))) (i32.const 1)))
          (i32.load16_s (i32.add (local.get $val) (i32.shl (local.get $n) (i32.const 1)))))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $left (i32.sub (local.get $left) (i32.const 1)))
        (br $entries)))
      (local.set $b (i32.add (local.get $b) (i32.const 1)))
      (br $blockLoop)))
    (local.set $c (i32.add (local.get $c) (i32.const 1)))
    (br_if $channels (i32.lt_u (local.get $c) (i32.const 3)))))

;; Nonzero counts by natural position (JS1, coefficient-effort.mjs coefficientOrderSteps): for $blocks Int16 blocks of
;; 64 at $coeffs (at most 32,767), each position's count of nonzero coefficients added to the i32 at $out + 4 * position.
(func (export "nonzeroCounts") (param $coeffs i32) (param $blocks i32) (param $out i32)
  (local $p i32) (local $end i32) (local $a0 v128) (local $a1 v128) (local $a2 v128) (local $a3 v128) (local $a4 v128) (local $a5 v128) (local $a6 v128) (local $a7 v128)
  (local.set $p (local.get $coeffs))
  (local.set $end (i32.add (local.get $coeffs) (i32.shl (local.get $blocks) (i32.const 7))))
  (block $done
    (loop $next
      (br_if $done (i32.ge_u (local.get $p) (local.get $end)))
      (local.set $a0 (i16x8.sub (local.get $a0) (i16x8.ne (v128.load offset=0 (local.get $p)) (v128.const i16x8 0 0 0 0 0 0 0 0))))
      (local.set $a1 (i16x8.sub (local.get $a1) (i16x8.ne (v128.load offset=16 (local.get $p)) (v128.const i16x8 0 0 0 0 0 0 0 0))))
      (local.set $a2 (i16x8.sub (local.get $a2) (i16x8.ne (v128.load offset=32 (local.get $p)) (v128.const i16x8 0 0 0 0 0 0 0 0))))
      (local.set $a3 (i16x8.sub (local.get $a3) (i16x8.ne (v128.load offset=48 (local.get $p)) (v128.const i16x8 0 0 0 0 0 0 0 0))))
      (local.set $a4 (i16x8.sub (local.get $a4) (i16x8.ne (v128.load offset=64 (local.get $p)) (v128.const i16x8 0 0 0 0 0 0 0 0))))
      (local.set $a5 (i16x8.sub (local.get $a5) (i16x8.ne (v128.load offset=80 (local.get $p)) (v128.const i16x8 0 0 0 0 0 0 0 0))))
      (local.set $a6 (i16x8.sub (local.get $a6) (i16x8.ne (v128.load offset=96 (local.get $p)) (v128.const i16x8 0 0 0 0 0 0 0 0))))
      (local.set $a7 (i16x8.sub (local.get $a7) (i16x8.ne (v128.load offset=112 (local.get $p)) (v128.const i16x8 0 0 0 0 0 0 0 0))))
      (local.set $p (i32.add (local.get $p) (i32.const 128)))
      (br $next)))
  (v128.store offset=0 (local.get $out) (i32x4.add (v128.load offset=0 (local.get $out))
    (i32x4.extend_low_i16x8_u (local.get $a0))))
  (v128.store offset=16 (local.get $out) (i32x4.add (v128.load offset=16 (local.get $out))
    (i32x4.extend_high_i16x8_u (local.get $a0))))
  (v128.store offset=32 (local.get $out) (i32x4.add (v128.load offset=32 (local.get $out))
    (i32x4.extend_low_i16x8_u (local.get $a1))))
  (v128.store offset=48 (local.get $out) (i32x4.add (v128.load offset=48 (local.get $out))
    (i32x4.extend_high_i16x8_u (local.get $a1))))
  (v128.store offset=64 (local.get $out) (i32x4.add (v128.load offset=64 (local.get $out))
    (i32x4.extend_low_i16x8_u (local.get $a2))))
  (v128.store offset=80 (local.get $out) (i32x4.add (v128.load offset=80 (local.get $out))
    (i32x4.extend_high_i16x8_u (local.get $a2))))
  (v128.store offset=96 (local.get $out) (i32x4.add (v128.load offset=96 (local.get $out))
    (i32x4.extend_low_i16x8_u (local.get $a3))))
  (v128.store offset=112 (local.get $out) (i32x4.add (v128.load offset=112 (local.get $out))
    (i32x4.extend_high_i16x8_u (local.get $a3))))
  (v128.store offset=128 (local.get $out) (i32x4.add (v128.load offset=128 (local.get $out))
    (i32x4.extend_low_i16x8_u (local.get $a4))))
  (v128.store offset=144 (local.get $out) (i32x4.add (v128.load offset=144 (local.get $out))
    (i32x4.extend_high_i16x8_u (local.get $a4))))
  (v128.store offset=160 (local.get $out) (i32x4.add (v128.load offset=160 (local.get $out))
    (i32x4.extend_low_i16x8_u (local.get $a5))))
  (v128.store offset=176 (local.get $out) (i32x4.add (v128.load offset=176 (local.get $out))
    (i32x4.extend_high_i16x8_u (local.get $a5))))
  (v128.store offset=192 (local.get $out) (i32x4.add (v128.load offset=192 (local.get $out))
    (i32x4.extend_low_i16x8_u (local.get $a6))))
  (v128.store offset=208 (local.get $out) (i32x4.add (v128.load offset=208 (local.get $out))
    (i32x4.extend_high_i16x8_u (local.get $a6))))
  (v128.store offset=224 (local.get $out) (i32x4.add (v128.load offset=224 (local.get $out))
    (i32x4.extend_low_i16x8_u (local.get $a7))))
  (v128.store offset=240 (local.get $out) (i32x4.add (v128.load offset=240 (local.get $out))
    (i32x4.extend_high_i16x8_u (local.get $a7)))))

  ;; dst[i] = a[i] - b[i] over n u32 words (sibling subtraction: a parent's counts minus its smaller child's).
  (func $subtract (param $dst i32) (param $a i32) (param $b i32) (param $n i32)
    (local $end i32) (local $wide i32)
    (local.set $end (i32.add (local.get $dst) (i32.shl (local.get $n) (i32.const 2))))
    (local.set $wide (i32.add (local.get $dst) (i32.shl (i32.and (local.get $n) (i32.const -4)) (i32.const 2))))
    (if (i32.lt_u (local.get $dst) (local.get $wide)) (then
      (loop $quads
        (v128.store (local.get $dst) (i32x4.sub (v128.load (local.get $a)) (v128.load (local.get $b))))
        (local.set $dst (i32.add (local.get $dst) (i32.const 16)))
        (local.set $a (i32.add (local.get $a) (i32.const 16)))
        (local.set $b (i32.add (local.get $b) (i32.const 16)))
        (br_if $quads (i32.lt_u (local.get $dst) (local.get $wide))))))
    (if (i32.lt_u (local.get $dst) (local.get $end)) (then
      (loop $words
        (i32.store (local.get $dst) (i32.sub (i32.load (local.get $a)) (i32.load (local.get $b))))
        (local.set $dst (i32.add (local.get $dst) (i32.const 4)))
        (local.set $a (i32.add (local.get $a) (i32.const 4)))
        (local.set $b (i32.add (local.get $b) (i32.const 4)))
        (br_if $words (i32.lt_u (local.get $dst) (local.get $end)))))))

  ;; One step of the Gaborish inverse (photo-xyb.mjs gaborishInverse) over a plane of W x H f64 samples at `p`, its original
  ;; at `orig` and two rows of scratch at `ring`: G's row y into the ring, then row y - 1 updated by p += orig - G p; the
  ;; window repeats the edge sample past each edge. Every sum is the JavaScript's, in its order:
  ;; (mc + w1 * (((uc + dc) + ml) + mr) + w2 * (((ul + ur) + dl) + dr)) * norm. Two samples a lane pair inside the row,
  ;; the first and last samples alone. W is even and at least 4.
  (func (export "gab") (param $p i32) (param $orig i32) (param $ring i32) (param $W i32) (param $H i32)
    (param $w1 f64) (param $w2 f64) (param $norm f64)
    (local $y i32) (local $row i32) (local $u i32) (local $m i32) (local $d i32) (local $o i32) (local $x i32) (local $end i32)
    (local $at i32) (local $src i32) (local $r i32) (local $last i32)
    (local $v1 v128) (local $v2 v128) (local $vn v128)
    (local.set $row (i32.shl (local.get $W) (i32.const 3)))
    (local.set $last (i32.sub (local.get $row) (i32.const 8)))
    (local.set $v1 (f64x2.splat (local.get $w1)))
    (local.set $v2 (f64x2.splat (local.get $w2)))
    (local.set $vn (f64x2.splat (local.get $norm)))
    (local.set $y (i32.const 0))
    (loop $rows
      (local.set $m (i32.add (local.get $p) (i32.mul (local.get $y) (local.get $row))))
      (local.set $u (select (i32.sub (local.get $m) (local.get $row)) (local.get $m) (local.get $y)))
      (local.set $d (select (i32.add (local.get $m) (local.get $row)) (local.get $m)
        (i32.lt_u (local.get $y) (i32.sub (local.get $H) (i32.const 1)))))
      (local.set $o (i32.add (local.get $ring) (i32.mul (i32.and (local.get $y) (i32.const 1)) (local.get $row))))
      ;; x = 0: left is the sample itself.
      (f64.store (local.get $o) (f64.mul (f64.add (f64.add (f64.load (local.get $m))
        (f64.mul (local.get $w1) (f64.add (f64.add (f64.add (f64.load (local.get $u)) (f64.load (local.get $d))) (f64.load (local.get $m))) (f64.load offset=8 (local.get $m)))))
        (f64.mul (local.get $w2) (f64.add (f64.add (f64.add (f64.load (local.get $u)) (f64.load offset=8 (local.get $u))) (f64.load (local.get $d))) (f64.load offset=8 (local.get $d)))))
        (local.get $norm)))
      ;; 1 <= x < W - 1, two at a time.
      (local.set $x (i32.const 8))
      (loop $xs
        (v128.store (i32.add (local.get $o) (local.get $x)) (f64x2.mul (f64x2.add (f64x2.add
          (v128.load (i32.add (local.get $m) (local.get $x)))
          (f64x2.mul (local.get $v1) (f64x2.add (f64x2.add (f64x2.add
            (v128.load (i32.add (local.get $u) (local.get $x))) (v128.load (i32.add (local.get $d) (local.get $x))))
            (v128.load (i32.sub (i32.add (local.get $m) (local.get $x)) (i32.const 8))))
            (v128.load offset=8 (i32.add (local.get $m) (local.get $x))))))
          (f64x2.mul (local.get $v2) (f64x2.add (f64x2.add (f64x2.add
            (v128.load (i32.sub (i32.add (local.get $u) (local.get $x)) (i32.const 8))) (v128.load offset=8 (i32.add (local.get $u) (local.get $x))))
            (v128.load (i32.sub (i32.add (local.get $d) (local.get $x)) (i32.const 8))))
            (v128.load offset=8 (i32.add (local.get $d) (local.get $x))))))
          (local.get $vn)))
        (local.set $x (i32.add (local.get $x) (i32.const 16)))
        (br_if $xs (i32.lt_u (local.get $x) (local.get $last))))
      ;; x = W - 1: right is the sample itself.
      (local.set $at (i32.add (local.get $m) (local.get $last)))
      (f64.store (i32.add (local.get $o) (local.get $last)) (f64.mul (f64.add (f64.add (f64.load (local.get $at))
        (f64.mul (local.get $w1) (f64.add (f64.add (f64.add
          (f64.load (i32.add (local.get $u) (local.get $last))) (f64.load (i32.add (local.get $d) (local.get $last))))
          (f64.load (i32.sub (local.get $at) (i32.const 8)))) (f64.load (local.get $at)))))
        (f64.mul (local.get $w2) (f64.add (f64.add (f64.add
          (f64.load (i32.sub (i32.add (local.get $u) (local.get $last)) (i32.const 8))) (f64.load (i32.add (local.get $u) (local.get $last))))
          (f64.load (i32.sub (i32.add (local.get $d) (local.get $last)) (i32.const 8)))) (f64.load (i32.add (local.get $d) (local.get $last))))))
        (local.get $norm)))
      ;; Row y - 1 (u) is no longer read: p += orig - G p, from the other half of the ring.
      (if (local.get $y) (then
        (local.set $src (i32.add (local.get $orig) (i32.sub (local.get $u) (local.get $p))))
        (local.set $r (i32.sub (i32.add (local.get $ring) (local.get $row)) (i32.sub (local.get $o) (local.get $ring))))
        (local.set $x (i32.const 0))
        (loop $up
          (v128.store (i32.add (local.get $u) (local.get $x)) (f64x2.add (v128.load (i32.add (local.get $u) (local.get $x)))
            (f64x2.sub (v128.load (i32.add (local.get $src) (local.get $x))) (v128.load (i32.add (local.get $r) (local.get $x))))))
          (local.set $x (i32.add (local.get $x) (i32.const 16)))
          (br_if $up (i32.lt_u (local.get $x) (local.get $row))))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (local.get $H))))
    ;; The last row.
    (local.set $at (i32.add (local.get $p) (i32.mul (i32.sub (local.get $H) (i32.const 1)) (local.get $row))))
    (local.set $src (i32.add (local.get $orig) (i32.sub (local.get $at) (local.get $p))))
    (local.set $r (i32.add (local.get $ring) (i32.mul (i32.and (i32.sub (local.get $H) (i32.const 1)) (i32.const 1)) (local.get $row))))
    (local.set $x (i32.const 0))
    (loop $up
      (v128.store (i32.add (local.get $at) (local.get $x)) (f64x2.add (v128.load (i32.add (local.get $at) (local.get $x)))
        (f64x2.sub (v128.load (i32.add (local.get $src) (local.get $x))) (v128.load (i32.add (local.get $r) (local.get $x))))))
      (local.set $x (i32.add (local.get $x) (i32.const 16)))
      (br_if $up (i32.lt_u (local.get $x) (local.get $row)))))

  ;; A strategy image's AC group in vardct.mjs walkACGroup's order: for each block channel (records of 11 i32 at `recs`:
  ;; size, area, bw, bh, bx, by in the group, levels at, order at (bytes), block context, zero-density offset, channel)
  ;; the nonzero count and its context, then each coefficient's token up to the last nonzero. `tables`: 64 i32 of
  ;; COEFF_NUM_NONZERO_CONTEXT then 64 of COEFF_FREQ_CONTEXT; `nz`: three 32 x 32 i32 rows of block averages. Writes the
  ;; contexts and values (i32) at `ctxs` and `vals`; returns their count. A progressive frame's pass (`pass` of the
  ;; passes at `passes`, two i32 each: downsample and scale; 0: none) first takes each block channel's levels to that
  ;; pass's share, as vardct-progressive.mjs progressiveValue (the block's width the wider side, 8 a block).
  (func (export "sgFill") (param $recs i32) (param $count i32) (param $numCtxs i32) (param $tables i32) (param $nz i32)
    (param $ctxs i32) (param $vals i32) (param $passes i32) (param $pass i32) (result i32)
    (local $r i32) (local $rec i32) (local $size i32) (local $area i32) (local $bw i32) (local $bh i32) (local $bx i32) (local $by i32)
    (local $lv i32) (local $ord i32) (local $ctx i32) (local $zd i32) (local $row i32) (local $k i32) (local $n i32) (local $cnt i32)
    (local $pred i32) (local $avg i32) (local $x i32) (local $y i32) (local $left i32) (local $prev i32) (local $q i32) (local $cap i32)
    (local $wide i32) (local $tall i32) (local $i i32) (local $ds i32) (local $sc i32) (local $part i32) (local $made i32)
    (block $done (loop $records
      (br_if $done (i32.ge_u (local.get $r) (local.get $count)))
      (local.set $rec (i32.add (local.get $recs) (i32.mul (local.get $r) (i32.const 44))))
      (local.set $size (i32.load (local.get $rec))) (local.set $area (i32.load offset=4 (local.get $rec)))
      (local.set $bw (i32.load offset=8 (local.get $rec))) (local.set $bh (i32.load offset=12 (local.get $rec)))
      (local.set $bx (i32.load offset=16 (local.get $rec))) (local.set $by (i32.load offset=20 (local.get $rec)))
      (local.set $lv (i32.load offset=24 (local.get $rec))) (local.set $ord (i32.load offset=28 (local.get $rec)))
      (local.set $ctx (i32.load offset=32 (local.get $rec))) (local.set $zd (i32.load offset=36 (local.get $rec)))
      (local.set $row (i32.add (local.get $nz) (i32.shl (i32.load offset=40 (local.get $rec)) (i32.const 12))))
      (if (local.get $passes) (then
        (local.set $wide (i32.shl (select (local.get $bw) (local.get $bh) (i32.gt_u (local.get $bw) (local.get $bh))) (i32.const 3)))
        (local.set $tall (i32.shl (select (local.get $bh) (local.get $bw) (i32.gt_u (local.get $bw) (local.get $bh))) (i32.const 3)))
        (local.set $k (i32.const 0))
        (block $p0 (loop $p1
          (br_if $p0 (i32.ge_u (local.get $k) (local.get $size)))
          (local.set $q (i32.load (i32.add (local.get $lv) (i32.shl (local.get $k) (i32.const 2)))))
          (if (local.get $q) (then
            (local.set $x (i32.rem_u (local.get $k) (local.get $wide))) (local.set $y (i32.div_u (local.get $k) (local.get $wide)))
            (local.set $made (i32.const 0)) (local.set $i (i32.const 0))
            (block $p2 (loop $p3
              (local.set $ds (i32.load (i32.add (local.get $passes) (i32.shl (local.get $i) (i32.const 3)))))
              (local.set $sc (i32.load offset=4 (i32.add (local.get $passes) (i32.shl (local.get $i) (i32.const 3)))))
              (local.set $part (select (i32.div_s (i32.sub (local.get $q) (local.get $made)) (local.get $sc)) (i32.const 0)
                (i32.and (i32.lt_u (local.get $x) (i32.div_u (local.get $wide) (local.get $ds))) (i32.lt_u (local.get $y) (i32.div_u (local.get $tall) (local.get $ds))))))
              (br_if $p2 (i32.eq (local.get $i) (local.get $pass)))
              (local.set $made (i32.add (local.get $made) (i32.mul (local.get $part) (local.get $sc))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $p3)))
            (i32.store (i32.add (local.get $lv) (i32.shl (local.get $k) (i32.const 2))) (local.get $part))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $p1)))))
      ;; The nonzero count over positions area..size - 1 of the order.
      (local.set $cnt (i32.const 0))
      (local.set $k (local.get $area))
      (block $c0 (loop $c1
        (br_if $c0 (i32.ge_u (local.get $k) (local.get $size)))
        (if (i32.load (i32.add (local.get $lv) (i32.shl (i32.load (i32.add (local.get $ord) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 2))))
          (then (local.set $cnt (i32.add (local.get $cnt) (i32.const 1)))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $c1)))
      ;; The prediction from the block's left and upper neighbours in this group.
      (local.set $pred
        (if (result i32) (i32.eqz (local.get $bx))
          (then (if (result i32) (i32.eqz (local.get $by)) (then (i32.const 32))
            (else (i32.load (i32.add (local.get $row) (i32.shl (i32.mul (i32.sub (local.get $by) (i32.const 1)) (i32.const 32)) (i32.const 2)))))))
          (else (if (result i32) (i32.eqz (local.get $by))
            (then (i32.load (i32.add (local.get $row) (i32.shl (i32.sub (local.get $bx) (i32.const 1)) (i32.const 2)))))
            (else (i32.shr_u (i32.add (i32.add
              (i32.load (i32.add (local.get $row) (i32.shl (i32.add (i32.mul (i32.sub (local.get $by) (i32.const 1)) (i32.const 32)) (local.get $bx)) (i32.const 2))))
              (i32.load (i32.add (local.get $row) (i32.shl (i32.sub (i32.add (i32.mul (local.get $by) (i32.const 32)) (local.get $bx)) (i32.const 1)) (i32.const 2)))))
              (i32.const 1)) (i32.const 1)))))))
      (local.set $avg (i32.div_u (i32.sub (i32.add (local.get $cnt) (local.get $area)) (i32.const 1)) (local.get $area)))
      (local.set $y (i32.const 0))
      (loop $fy
        (local.set $x (i32.const 0))
        (loop $fx
          (i32.store (i32.add (local.get $row) (i32.shl (i32.add (i32.mul (i32.add (local.get $by) (local.get $y)) (i32.const 32)) (i32.add (local.get $bx) (local.get $x))) (i32.const 2))) (local.get $avg))
          (local.set $x (i32.add (local.get $x) (i32.const 1)))
          (br_if $fx (i32.lt_u (local.get $x) (local.get $bw))))
        (local.set $y (i32.add (local.get $y) (i32.const 1)))
        (br_if $fy (i32.lt_u (local.get $y) (local.get $bh))))
      (local.set $cap (select (local.get $pred) (i32.const 64) (i32.lt_s (local.get $pred) (i32.const 64))))
      (i32.store (i32.add (local.get $ctxs) (i32.shl (local.get $n) (i32.const 2)))
        (i32.add (i32.mul (select (local.get $cap) (i32.add (i32.const 4) (i32.shr_s (local.get $cap) (i32.const 1))) (i32.lt_s (local.get $cap) (i32.const 8))) (local.get $numCtxs)) (local.get $ctx)))
      (i32.store (i32.add (local.get $vals) (i32.shl (local.get $n) (i32.const 2))) (local.get $cnt))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      ;; Each coefficient up to the last nonzero: its zero-density context and packed value.
      (local.set $prev (i32.le_u (local.get $cnt) (i32.shr_u (local.get $size) (i32.const 4))))
      (local.set $left (local.get $cnt))
      (local.set $k (local.get $area))
      (block $t0 (loop $t1
        (br_if $t0 (i32.or (i32.ge_u (local.get $k) (local.get $size)) (i32.eqz (local.get $left))))
        (local.set $q (i32.load (i32.add (local.get $lv) (i32.shl (i32.load (i32.add (local.get $ord) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 2)))))
        (i32.store (i32.add (local.get $ctxs) (i32.shl (local.get $n) (i32.const 2)))
          (i32.add (local.get $zd) (i32.add (local.get $prev) (i32.shl (i32.add
            (i32.load (i32.add (local.get $tables) (i32.shl (i32.div_u (i32.sub (i32.add (local.get $left) (local.get $area)) (i32.const 1)) (local.get $area)) (i32.const 2))))
            (i32.load offset=256 (i32.add (local.get $tables) (i32.shl (i32.div_u (local.get $k) (local.get $area)) (i32.const 2))))) (i32.const 1)))))
        (i32.store (i32.add (local.get $vals) (i32.shl (local.get $n) (i32.const 2)))
          (select (i32.shl (local.get $q) (i32.const 1)) (i32.sub (i32.mul (local.get $q) (i32.const -2)) (i32.const 1)) (i32.ge_s (local.get $q) (i32.const 0))))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $prev (i32.ne (local.get $q) (i32.const 0)))
        (local.set $left (i32.sub (local.get $left) (local.get $prev)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $t1)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $records)))
    (local.get $n))

  ;; Rows of photo-xyb.mjs xybPlanes (sRGB, no profile): each pixel's X, Y and B - Y samples by the same expressions in
  ;; the same order (linear light from `lin`, three cone mixes from `mix` (nine f64) plus `bias`, each cube root seeded
  ;; from `roots` at 4096 v and refined twice, less `rootBias`), memoized per color in a direct-mapped table (`keys`
  ;; i32 and `vals` 3 f64 a slot, 2^17 slots). `rows` rows of `width` pixels at `rgba`; each output row is W samples
  ;; (the last pixel repeated to W) at `out` + c * rows * W * 8.
  (func $xybRoot (param $roots i32) (param $v f64) (result f64)
    (local $scaled f64) (local $at i32) (local $r f64) (local $p i32)
    (local.set $scaled (f64.mul (local.get $v) (f64.const 4096)))
    ;; The seed is read at $at and $at + 1 inside the 4,113-entry table, whatever $v the caller brings.
    (local.set $at (i32.trunc_sat_f64_s (f64.floor (local.get $scaled))))
    (local.set $at (select (local.get $at) (i32.const 4111) (i32.lt_s (local.get $at) (i32.const 4111))))
    (local.set $at (select (local.get $at) (i32.const 0) (i32.gt_s (local.get $at) (i32.const 0))))
    (local.set $p (i32.add (local.get $roots) (i32.shl (local.get $at) (i32.const 3))))
    (local.set $r (f64.add (f64.load (local.get $p)) (f64.mul (f64.sub (f64.load offset=8 (local.get $p)) (f64.load (local.get $p)))
      (f64.sub (local.get $scaled) (f64.convert_i32_s (local.get $at))))))
    (local.set $r (f64.div (f64.add (f64.mul (f64.const 2) (local.get $r)) (f64.div (local.get $v) (f64.mul (local.get $r) (local.get $r)))) (f64.const 3)))
    (f64.div (f64.add (f64.mul (f64.const 2) (local.get $r)) (f64.div (local.get $v) (f64.mul (local.get $r) (local.get $r)))) (f64.const 3)))
  (func (export "xybRows") (param $rgba i32) (param $width i32) (param $rows i32) (param $W i32) (param $roots i32) (param $lin i32)
    (param $mix i32) (param $bias f64) (param $rootBias f64) (param $keys i32) (param $vals i32) (param $out i32) (param $signed i32)
    (local $y i32) (local $x i32) (local $at i32) (local $key i32) (local $slot i32) (local $v i32) (local $o i32) (local $plane i32)
    (local $mode i32) (local $wantR i32) (local $wPtr i32) (local $y0 i32) (local $y1 i32) (local $wi i32) (local $w0 i32) (local $w1 i32) (local $w2 i32)
    (local $key64 i64) (local $lift f64) (local $reading f64)
    (local $r f64) (local $g f64) (local $b f64) (local $l f64) (local $m f64) (local $s f64) (local $luma f64)
    (local.set $mode (i32.and (local.get $signed) (i32.const 7)))
    (local.set $wantR (i32.ne (i32.and (local.get $signed) (i32.const 8)) (i32.const 0)))
    (if (i32.ge_u (local.get $mode) (i32.const 2)) (then (local.set $lift (f64.load offset=72 (local.get $mix)))))
    (if (local.get $wantR) (then
      (local.set $reading (f64.load offset=80 (local.get $mix)))
      (local.set $wPtr (i32.load offset=88 (local.get $mix)))
      (local.set $y0 (i32.load offset=92 (local.get $mix)))
      (local.set $y1 (i32.load offset=96 (local.get $mix)))))
    (local.set $plane (i32.shl (i32.mul (local.get $rows) (local.get $W)) (i32.const 3)))
    (local.set $y (i32.const 0))
    (block $done (loop $ys
      (br_if $done (i32.ge_u (local.get $y) (local.get $rows)))
      (local.set $x (i32.const 0))
      (loop $xs
        (if (i32.le_u (local.get $mode) (i32.const 1))
          (then
            (local.set $at (i32.add (local.get $rgba) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 2))))
            (local.set $key (i32.or (i32.or (i32.shl (i32.load8_u (local.get $at)) (i32.const 16)) (i32.shl (i32.load8_u offset=1 (local.get $at)) (i32.const 8))) (i32.load8_u offset=2 (local.get $at))))
            (local.set $slot (i32.shr_u (i32.mul (local.get $key) (i32.const 0x9e3779b1)) (i32.const 15)))
            (local.set $v (i32.add (local.get $vals) (i32.mul (local.get $slot) (i32.const 24))))
            (if (i32.ne (i32.load (i32.add (local.get $keys) (i32.shl (local.get $slot) (i32.const 2)))) (local.get $key)) (then
              (local.set $r (f64.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (local.get $at)) (i32.const 3)))))
              (local.set $g (f64.load offset=2048 (i32.add (local.get $lin) (i32.shl (i32.load8_u offset=1 (local.get $at)) (i32.const 3)))))
              (local.set $b (f64.load offset=4096 (i32.add (local.get $lin) (i32.shl (i32.load8_u offset=2 (local.get $at)) (i32.const 3)))))
              (local.set $l (f64.add (f64.add (f64.add
                (f64.mul (f64.load (local.get $mix)) (local.get $r)) (f64.mul (f64.load offset=8 (local.get $mix)) (local.get $g)))
                (f64.mul (f64.load offset=16 (local.get $mix)) (local.get $b))) (local.get $bias)))
              (local.set $m (f64.add (f64.add (f64.add
                (f64.mul (f64.load offset=24 (local.get $mix)) (local.get $r)) (f64.mul (f64.load offset=32 (local.get $mix)) (local.get $g)))
                (f64.mul (f64.load offset=40 (local.get $mix)) (local.get $b))) (local.get $bias)))
              (local.set $s (f64.add (f64.add (f64.add
                (f64.mul (f64.load offset=48 (local.get $mix)) (local.get $r)) (f64.mul (f64.load offset=56 (local.get $mix)) (local.get $g)))
                (f64.mul (f64.load offset=64 (local.get $mix)) (local.get $b))) (local.get $bias)))
              (if (local.get $mode)
                (then
                  (local.set $l (f64.sub (call $xybSignedRoot (local.get $roots) (local.get $l)) (local.get $rootBias)))
                  (local.set $m (f64.sub (call $xybSignedRoot (local.get $roots) (local.get $m)) (local.get $rootBias)))
                  (local.set $s (f64.sub (call $xybSignedRoot (local.get $roots) (local.get $s)) (local.get $rootBias))))
                (else
                  (local.set $l (f64.sub (call $xybRoot (local.get $roots) (local.get $l)) (local.get $rootBias)))
                  (local.set $m (f64.sub (call $xybRoot (local.get $roots) (local.get $m)) (local.get $rootBias)))
                  (local.set $s (f64.sub (call $xybRoot (local.get $roots) (local.get $s)) (local.get $rootBias)))))
