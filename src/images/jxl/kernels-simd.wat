                  (local.get $cuts) (local.get $alphabet) (local.get $hist) (local.get $table) (local.get $raw)
                  (local.get $scratch) (i32.add (local.get $out) (i32.const 32)) (i32.const 1)
                  (local.get $p) (local.get $initStats) (local.get $limits) (i32.const 0) (local.get $cuts) (local.get $alphabet)
                  (local.get $splitAt) (local.get $best) (local.get $zeroRaw16))))
