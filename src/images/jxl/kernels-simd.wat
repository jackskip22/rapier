;; ansFlush2 (U11): two AC groups of one model flushed as ansFlush flushes each, their backward passes in one loop so the
;; two ANS states' chains overlap; then each group's forward pass into its own output. $a and $b: ansFlush's arguments,
;; the tables the same.
(func $ansForward (param $args i32) (param $state i32)
  (local $n i32) (local $raws i32) (local $meta i32) (local $emitted i32) (local $out i32) (local $acc i64) (local $pending i32) (local $i i32) (local $m i32)
  (local.set $n (i32.load offset=8 (local.get $args))) (local.set $raws (i32.load offset=44 (local.get $args)))
  (local.set $meta (i32.load offset=48 (local.get $args))) (local.set $emitted (i32.load offset=52 (local.get $args)))
  (local.set $out (i32.load offset=56 (local.get $args)))
  (local.set $acc (i64.extend_i32_u (i32.load offset=60 (local.get $args)))) (local.set $pending (i32.load offset=64 (local.get $args)))
  (local.set $acc (i64.or (local.get $acc) (i64.shl (i64.extend_i32_u (local.get $state)) (i64.extend_i32_u (local.get $pending)))))
  (local.set $pending (i32.add (local.get $pending) (i32.const 32)))
