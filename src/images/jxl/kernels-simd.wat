  ;; $dctPass4: one 8-point fast transform (transformDCT8BlocksFast's butterflies, f32) on four lanes at once, across the
  ;; eight vectors at `p`, 32 bytes apart, in place.
  (func $dctPass4 (param $p i32)
    (local $x0 v128) (local $x1 v128) (local $x2 v128) (local $x3 v128) (local $x4 v128) (local $x5 v128) (local $x6 v128) (local $x7 v128) (local $t0 v128) (local $t1 v128) (local $t2 v128) (local $t3 v128) (local $t4 v128) (local $t5 v128) (local $t6 v128) (local $t7 v128) (local $a0 v128) (local $a1 v128) (local $a2 v128) (local $a3 v128) (local $b0 v128) (local $b1 v128) (local $b2 v128) (local $z1 v128) (local $z2 v128) (local $z3 v128) (local $z4 v128) (local $z5 v128) (local $z11 v128) (local $z13 v128)
    (local.set $x0 (v128.load (local.get $p)))
    (local.set $x1 (v128.load offset=32 (local.get $p)))
    (local.set $x2 (v128.load offset=64 (local.get $p)))
    (local.set $x3 (v128.load offset=96 (local.get $p)))
    (local.set $x4 (v128.load offset=128 (local.get $p)))
    (local.set $x5 (v128.load offset=160 (local.get $p)))
    (local.set $x6 (v128.load offset=192 (local.get $p)))
    (local.set $x7 (v128.load offset=224 (local.get $p)))
    (local.set $t0 (f32x4.add (local.get $x0) (local.get $x7)))
    (local.set $t7 (f32x4.sub (local.get $x0) (local.get $x7)))
    (local.set $t1 (f32x4.add (local.get $x1) (local.get $x6)))
    (local.set $t6 (f32x4.sub (local.get $x1) (local.get $x6)))
    (local.set $t2 (f32x4.add (local.get $x2) (local.get $x5)))
    (local.set $t5 (f32x4.sub (local.get $x2) (local.get $x5)))
    (local.set $t3 (f32x4.add (local.get $x3) (local.get $x4)))
    (local.set $t4 (f32x4.sub (local.get $x3) (local.get $x4)))
    (local.set $a0 (f32x4.add (local.get $t0) (local.get $t3)))
    (local.set $a3 (f32x4.sub (local.get $t0) (local.get $t3)))
    (local.set $a1 (f32x4.add (local.get $t1) (local.get $t2)))
    (local.set $a2 (f32x4.sub (local.get $t1) (local.get $t2)))
    (v128.store (local.get $p) (f32x4.add (local.get $a0) (local.get $a1)))
    (v128.store offset=128 (local.get $p) (f32x4.sub (local.get $a0) (local.get $a1)))
