        (local.set $step (i32.add (local.get $step) (i32.const 1)))
        (br_if $stepsLoop (i32.lt_s (local.get $step) (local.get $kinds))))
      (if (i32.eqz (local.get $side))
        (then
          (local.set $hasHi1 (local.get $hasB1)) (local.set $hi1Pred (local.get $b1Pred)) (local.set $hi1Cl (local.get $b1Cl)) (local.set $hi1Cost (local.get $b1Cost))
          (local.set $hasHi2 (local.get $hasB2)) (local.set $hi2Pred (local.get $b2Pred)) (local.set $hi2Cl (local.get $b2Cl)) (local.set $hi2Cost (local.get $b2Cost)))
        (else
          (local.set $hasLo1 (local.get $hasB1)) (local.set $lo1Pred (local.get $b1Pred)) (local.set $lo1Cl (local.get $b1Cl)) (local.set $lo1Cost (local.get $b1Cost))
          (local.set $hasLo2 (local.get $hasB2)) (local.set $lo2Pred (local.get $b2Pred)) (local.set $lo2Cl (local.get $b2Cl)) (local.set $lo2Cost (local.get $b2Cost))))
      (local.set $side (i32.add (local.get $side) (i32.const 1)))
      (br_if $sidesLoop (i32.lt_s (local.get $side) (i32.const 2))))
    (local.set $bestAfter (f64.const inf))
    (local.set $hiPred (i32.const -1)) (local.set $hiCl (i32.const -1))
    (local.set $loPred (i32.const -1)) (local.set $loCl (i32.const -1))
    (local.set $shared (i32.const 0))
    (local.set $hiIdx (i32.const 0))
    (loop $combHi
      (if (select (local.get $hasHi1) (local.get $hasHi2) (i32.eqz (local.get $hiIdx)))
        (then
          (local.set $hcPred (select (local.get $hi1Pred) (local.get $hi2Pred) (i32.eqz (local.get $hiIdx))))
          (local.set $hcCl (select (local.get $hi1Cl) (local.get $hi2Cl) (i32.eqz (local.get $hiIdx))))
          (local.set $hcCost (select (local.get $hi1Cost) (local.get $hi2Cost) (i32.eqz (local.get $hiIdx))))
          (local.set $loIdx (i32.const 0))
          (loop $combLo
