      (br_if $done (i32.ge_u (local.get $row) (local.get $h)))
      (local.set $d0 (i32.add (local.get $dither) (i32.shl (i32.and (i32.add (local.get $oy) (local.get $row)) (i32.const 31)) (i32.const 7))))
      (local.set $d1 (i32.add (local.get $dither) (i32.shl (i32.and (i32.add (i32.add (local.get $oy) (local.get $row)) (i32.const 13)) (i32.const 31)) (i32.const 7))))
      (local.set $d2 (i32.add (local.get $dither) (i32.shl (i32.and (i32.add (i32.add (local.get $oy) (local.get $row)) (i32.const 26)) (i32.const 31)) (i32.const 7))))
      (local.set $col (i32.const 0))
