(func (export "ansFlush2") (param $a i32) (param $b i32)
  (local $small i32) (local $freqs i32) (local $starts i32) (local $rev i32) (local $configs i32) (local $hcounts i32) (local $hstarts i32)
  (local $alphabet i32) (local $recips i32)
  (local $valuesA i32) (local $idsA i32) (local $nA i32) (local $rawsA i32) (local $metaA i32) (local $emittedA i32) (local $iA i32) (local $idA i32) (local $valueA i32) (local $atA i32) (local $entryA i32) (local $bitsA i32) (local $rawA i32) (local $freqA i32) (local $startA i32) (local $stateA i32) (local $qA i32) (local $cfgA i32) (local $nbA i32) (local $belowA i32) (local $splitA i32) (local $msbA i32) (local $lsbA i32) (local $symbolA i32) (local $mA i32) (local $rcA i32)
  (local $valuesB i32) (local $idsB i32) (local $nB i32) (local $rawsB i32) (local $metaB i32) (local $emittedB i32) (local $iB i32) (local $idB i32) (local $valueB i32) (local $atB i32) (local $entryB i32) (local $bitsB i32) (local $rawB i32) (local $freqB i32) (local $startB i32) (local $stateB i32) (local $qB i32) (local $cfgB i32) (local $nbB i32) (local $belowB i32) (local $splitB i32) (local $msbB i32) (local $lsbB i32) (local $symbolB i32) (local $mB i32) (local $rcB i32)
  (local.set $small (i32.load offset=12 (local.get $a))) (local.set $freqs (i32.load offset=16 (local.get $a))) (local.set $starts (i32.load offset=20 (local.get $a)))
  (local.set $rev (i32.load offset=24 (local.get $a))) (local.set $configs (i32.load offset=28 (local.get $a))) (local.set $hcounts (i32.load offset=32 (local.get $a)))
  (local.set $hstarts (i32.load offset=36 (local.get $a))) (local.set $alphabet (i32.load offset=40 (local.get $a))) (local.set $recips (i32.load offset=72 (local.get $a)))
  (local.set $valuesA (i32.load (local.get $a))) (local.set $idsA (i32.load offset=4 (local.get $a))) (local.set $nA (i32.load offset=8 (local.get $a)))
  (local.set $rawsA (i32.load offset=44 (local.get $a))) (local.set $metaA (i32.load offset=48 (local.get $a))) (local.set $emittedA (i32.load offset=52 (local.get $a)))
  (local.set $stateA (i32.const 1245184)) (local.set $iA (local.get $nA))
  (local.set $valuesB (i32.load (local.get $b))) (local.set $idsB (i32.load offset=4 (local.get $b))) (local.set $nB (i32.load offset=8 (local.get $b)))
  (local.set $rawsB (i32.load offset=44 (local.get $b))) (local.set $metaB (i32.load offset=48 (local.get $b))) (local.set $emittedB (i32.load offset=52 (local.get $b)))
  (local.set $stateB (i32.const 1245184)) (local.set $iB (local.get $nB))
