        (f32.store (i32.add (local.get $bCfl) (local.get $m)) (local.get $e02))

        (local.set $acO (f32.const 0))
        (local.set $k (i32.const 1))
        (loop $ckLoop
          (local.set $idx (i32.shl (local.get $k) (i32.const 2)))
          (local.set $xk (f32.load (i32.add (local.get $cOff) (local.get $idx))))
          (local.set $yk (f32.load (i32.add (local.get $yOff) (local.get $idx))))
