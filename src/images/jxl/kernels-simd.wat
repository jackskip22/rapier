            (if (i32.gt_s (local.get $acc) (i32.const 1024)) (then (local.set $acc (i32.const 1024))))))
        (i32.store (i32.add (local.get $outPtr) (i32.shl (local.get $i) (i32.const 2))) (local.get $acc))
        (local.set $wOff (i32.add (local.get $wOff) (local.get $inLen)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $row))))
  (func $intMlp
    (export "intMlp")
    (param $pkt i32)
    (param $inPtr i32)
    (param $count i32)
    (param $outPtr i32)
    (param $scratch i32)
    (local $D i32)
    (local $H1 i32)
    (local $H2 i32)
    (local $O i32)
    (local $S1 i32)
    (local $S2 i32)
    (local $S1b i32)
    (local $w2Off i32)
    (local $lastH i32)
    (local $wOutOff i32)
    (local $b1Off i32)
    (local $h2Ptr i32)
    (local $b i32)
    (local.set $D (i32.load8_u offset=2 (local.get $pkt)))
    (local.set $H1 (i32.load8_u offset=3 (local.get $pkt)))
    (local.set $H2 (i32.load8_u offset=4 (local.get $pkt)))
    (local.set $O (i32.load8_u offset=5 (local.get $pkt)))
    (local.set $S1 (i32.load8_u offset=6 (local.get $pkt)))
    (local.set $S2 (i32.load8_u offset=7 (local.get $pkt)))
    ;; Byte 0: the second hidden layer's own shift (packet format 1, visual-lexer-core.mjs); 0 keeps shift 1.
    (local.set $S1b (i32.load8_u (local.get $pkt)))
    (if (i32.eqz (local.get $S1b)) (then (local.set $S1b (local.get $S1))))
    (local.set $w2Off (i32.add (i32.add (local.get $pkt) (i32.const 8)) (i32.mul (local.get $H1) (local.get $D))))
    (local.set $lastH (select (local.get $H2) (local.get $H1) (local.get $H2)))
    (local.set $wOutOff (i32.add (local.get $w2Off) (i32.mul (local.get $H2) (local.get $H1))))
    (local.set $b1Off (i32.and (i32.add (i32.add (local.get $wOutOff) (i32.mul (local.get $O) (local.get $lastH))) (i32.const 1)) (i32.const -2)))
    ;; Pack hidden layers consecutively. Existing H1/H2 <=64 callers reserve 512 bytes,
    ;; while larger packets provide proportionally larger scratch.
    (local.set $h2Ptr (i32.add (local.get $scratch) (i32.shl (local.get $H1) (i32.const 2))))
    (local.set $b (i32.const 0))
    (block $done
      (loop $batch
        (br_if $done (i32.ge_u (local.get $b) (local.get $count)))
        (call $mlpLayer (i32.add (local.get $pkt) (i32.const 8)) (local.get $b1Off)
          (i32.add (local.get $inPtr) (i32.shl (i32.mul (local.get $b) (local.get $D)) (i32.const 2)))
          (local.get $D) (local.get $scratch) (local.get $H1) (local.get $S1) (i32.const 1) (i32.const 1))
        (if (local.get $H2)
          (then
            (call $mlpLayer (local.get $w2Off) (i32.add (local.get $b1Off) (i32.shl (local.get $H1) (i32.const 1)))
              (local.get $scratch) (local.get $H1) (local.get $h2Ptr) (local.get $H2) (local.get $S1b) (i32.const 1) (i32.const 0))))
        (call $mlpLayer (local.get $wOutOff)
          (i32.add (local.get $b1Off) (i32.shl (i32.add (local.get $H1) (local.get $H2)) (i32.const 1)))
          (select (local.get $h2Ptr) (local.get $scratch) (local.get $H2))
          (local.get $lastH)
          (i32.add (local.get $outPtr) (i32.shl (i32.mul (local.get $b) (local.get $O)) (i32.const 2)))
          (local.get $O) (local.get $S2) (i32.const 0) (i32.const 0))
        (local.set $b (i32.add (local.get $b) (i32.const 1)))
        (br $batch))))
  ;; The visual lexer's rate estimate of one candidate block (visual-lexer.mjs): its luma's sequency-ordered Walsh-Hadamard
  ;; transform (butterflies of i32 sums, exact), then over every AC coefficient ilog(256 + t) - 128 (sixteenths of
  ;; log2(1 + t / 256)), t = |c| r >> 24 in i64 with r the coefficient's step reciprocal (visual-lexer.mjs reciprocals, i32
  ;; at u x h + v), so every host reads the sum tools/models/lexer/reference.mjs does.
  ;; $seqW, $seqH: each size's sequency order (i32); $buf: w x h + max(w, h) i32 of scratch.
  (func $lexerRate
    (export "lexerRate")
    (param $yPtr i32) (param $width i32) (param $height i32) (param $x0 i32) (param $y0 i32) (param $w i32) (param $h i32)
    (param $recip i32) (param $seqW i32) (param $seqH i32) (param $buf i32)
    (result i32)
    (local $x i32) (local $y i32) (local $u i32) (local $v i32) (local $yy i32) (local $xx i32) (local $line i32)
    (local $a i32) (local $b i32) (local $bits i32) (local $t i32)
    (local.set $line (i32.add (local.get $buf) (i32.shl (i32.mul (local.get $w) (local.get $h)) (i32.const 2))))
    ;; Rows: each (edge-clamped) row's transform, stored in sequency order.
    (local.set $y (i32.const 0))
    (block $rowsDone (loop $rowLoop
      (br_if $rowsDone (i32.ge_u (local.get $y) (local.get $h)))
      (local.set $yy (i32.add (local.get $y0) (local.get $y)))
      (if (i32.gt_s (local.get $yy) (i32.sub (local.get $height) (i32.const 1))) (then (local.set $yy (i32.sub (local.get $height) (i32.const 1)))))
      (local.set $yy (i32.mul (local.get $yy) (local.get $width)))
      (local.set $x (i32.const 0))
      (block $loadDone (loop $loadLoop
        (br_if $loadDone (i32.ge_u (local.get $x) (local.get $w)))
        (local.set $xx (i32.add (local.get $x0) (local.get $x)))
        (if (i32.gt_s (local.get $xx) (i32.sub (local.get $width) (i32.const 1))) (then (local.set $xx (i32.sub (local.get $width) (i32.const 1)))))
        (i32.store (i32.add (local.get $line) (i32.shl (local.get $x) (i32.const 2)))
          (i32.load (i32.add (local.get $yPtr) (i32.shl (i32.add (local.get $yy) (local.get $xx)) (i32.const 2)))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br $loadLoop)))
      (call $wht (local.get $line) (local.get $w))
      (local.set $u (i32.const 0))
      (block $storeDone (loop $storeLoop
        (br_if $storeDone (i32.ge_u (local.get $u) (local.get $w)))
        (i32.store (i32.add (local.get $buf) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $w)) (local.get $u)) (i32.const 2)))
          (i32.load (i32.add (local.get $line) (i32.shl (i32.load (i32.add (local.get $seqW) (i32.shl (local.get $u) (i32.const 2)))) (i32.const 2)))))
        (local.set $u (i32.add (local.get $u) (i32.const 1)))
        (br $storeLoop)))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $rowLoop)))
    ;; Columns: each column's transform, its coefficients read in sequency order.
    (local.set $bits (i32.const 0))
    (local.set $u (i32.const 0))
    (block $colsDone (loop $colLoop
      (br_if $colsDone (i32.ge_u (local.get $u) (local.get $w)))
      (local.set $y (i32.const 0))
      (block $cDone (loop $cLoop
        (br_if $cDone (i32.ge_u (local.get $y) (local.get $h)))
        (i32.store (i32.add (local.get $line) (i32.shl (local.get $y) (i32.const 2)))
          (i32.load (i32.add (local.get $buf) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $w)) (local.get $u)) (i32.const 2)))))
        (local.set $y (i32.add (local.get $y) (i32.const 1)))
        (br $cLoop)))
      (call $wht (local.get $line) (local.get $h))
      (local.set $v (i32.const 0))
      (block $vDone (loop $vLoop
        (br_if $vDone (i32.ge_u (local.get $v) (local.get $h)))
        (if (i32.or (local.get $u) (local.get $v)) (then
          (local.set $a (i32.load (i32.add (local.get $line) (i32.shl (i32.load (i32.add (local.get $seqH) (i32.shl (local.get $v) (i32.const 2)))) (i32.const 2)))))
          (if (i32.lt_s (local.get $a) (i32.const 0)) (then (local.set $a (i32.sub (i32.const 0) (local.get $a)))))
          (local.set $t (i32.add (i32.const 256) (i32.wrap_i64 (i64.shr_u (i64.mul (i64.extend_i32_u (local.get $a))
            (i64.extend_i32_u (i32.load (i32.add (local.get $recip) (i32.shl (i32.add (i32.mul (local.get $u) (local.get $h)) (local.get $v)) (i32.const 2))))))
            (i64.const 24)))))
          (local.set $b (i32.sub (i32.const 31) (i32.clz (local.get $t))))
          (local.set $bits (i32.add (local.get $bits)
            (i32.sub (i32.or (i32.shl (local.get $b) (i32.const 4)) (i32.and (i32.shr_u (local.get $t) (i32.sub (local.get $b) (i32.const 4))) (i32.const 15)))
              (i32.const 128))))))
        (local.set $v (i32.add (local.get $v) (i32.const 1)))
        (br $vLoop)))
      (local.set $u (i32.add (local.get $u) (i32.const 1)))
      (br $colLoop)))
    (local.get $bits))
  ;; A Walsh-Hadamard transform of n i32 in place (natural order): butterflies a + b, a - b.
  (func $wht (param $p i32) (param $n i32)
    (local $len i32) (local $i i32) (local $j i32) (local $a i32) (local $b i32) (local $pa i32) (local $pb i32)
    (local.set $len (i32.const 1))
    (block $done (loop $lenLoop
      (br_if $done (i32.ge_u (local.get $len) (local.get $n)))
      (local.set $i (i32.const 0))
      (block $iDone (loop $iLoop
        (br_if $iDone (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $j (local.get $i))
        (block $jDone (loop $jLoop
          (br_if $jDone (i32.ge_u (local.get $j) (i32.add (local.get $i) (local.get $len))))
          (local.set $pa (i32.add (local.get $p) (i32.shl (local.get $j) (i32.const 2))))
          (local.set $pb (i32.add (local.get $pa) (i32.shl (local.get $len) (i32.const 2))))
          (local.set $a (i32.load (local.get $pa)))
          (local.set $b (i32.load (local.get $pb)))
          (i32.store (local.get $pa) (i32.add (local.get $a) (local.get $b)))
          (i32.store (local.get $pb) (i32.sub (local.get $a) (local.get $b)))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br $jLoop)))
        (local.set $i (i32.add (local.get $i) (i32.shl (local.get $len) (i32.const 1))))
        (br $iLoop)))
      (local.set $len (i32.shl (local.get $len) (i32.const 1)))
      (br $lenLoop))))

  ;; Multi-scale integer visual lexer kernels: 8x8 opsin lexeme extraction and 4-scale pyramid MLP evaluation.
  (func $vlCl (param $v i32) (param $lo i32) (param $hi i32) (result i32)
    (if (i32.lt_s (local.get $v) (local.get $lo)) (then (return (local.get $lo))))
    (if (i32.gt_s (local.get $v) (local.get $hi)) (then (return (local.get $hi))))
    (local.get $v))

  (func $vlAbs (param $v i32) (result i32)
    (select (i32.sub (i32.const 0) (local.get $v)) (local.get $v) (i32.lt_s (local.get $v) (i32.const 0))))

  (func $vlSum4 (param $v v128) (result i32)
    (i32.add (i32.add (i32x4.extract_lane 0 (local.get $v)) (i32x4.extract_lane 1 (local.get $v)))
      (i32.add (i32x4.extract_lane 2 (local.get $v)) (i32x4.extract_lane 3 (local.get $v)))))

  ;; One 8x8 cell's lexemes from its opsin planes. A band of cells reads 10 picture rows (its 8 and one above and below,
  ;; clamped) of three i16 planes (Y = (3r + 8g + b) >> 2, X = r - g, B = b - ((r + g) >> 1) through the LUT, each
  ;; column clamped) at $tilePtr, one plane row (bw * 8 + 2 columns, rounded up to 8) every $rs bytes; the two rows bands
  ;; share are copied from the band above. A cell's row is one i16x8 vector. Every sum is exact in its lanes (Y in
  ;; [384, 3072], X and B within 896 of 0): the per-row steps, spreads and chroma sums in i16 (chroma's steps at most
  ;; 57,344 as u16), the luma and Laplacian sums widened to i32 a row, so the features are vlLexemes8's scalar ones.
  ;; Scratch: 30 * $rs bytes (visual-lexer-core.mjs vlLexemeScratch).
  (func $vlLexemes8
    (export "vlLexemes8")
    (param $rgbaPtr i32)
    (param $lutPtr i32)
    (param $width i32)
    (param $height i32)
    (param $bw i32)
    (param $bh i32)
    (param $qIntent i32)
    (param $outPtr i32)
    (param $tilePtr i32)
    (local $bx i32) (local $by i32) (local $x0 i32) (local $y0 i32)
    (local $r i32) (local $g i32) (local $b i32) (local $c i32) (local $px i32) (local $py i32)
    (local $rs i32) (local $cols i32) (local $pX i32) (local $pB i32) (local $row i32) (local $src i32) (local $o i32)
    (local $dy i32) (local $at i32)
    (local $sumY i32) (local $ugx i32) (local $ugy i32) (local $sgx i32) (local $sgy i32)
    (local $lap i32) (local $chAbs i32) (local $chGrad i32)
    (local $yMin i32) (local $yMax i32) (local $q0 i32) (local $q1 i32) (local $q2 i32) (local $q3 i32)
    (local $qMax i32) (local $qMin i32) (local $netS i32) (local $totG32 i32) (local $totG64 i32)
    (local $diffG i32) (local $aniso i32) (local $qClamped i32) (local $dst i32)
    (local $wm1 i32) (local $hm1 i32)
    (local $yc v128) (local $yx v128) (local $yy v128) (local $ax v128) (local $ay v128)
    (local $xc v128) (local $bc v128) (local $t v128)
    (local $aSumY v128) (local $aUgx v128) (local $aUgy v128) (local $aSgx v128) (local $aSgy v128)
    (local $aLap v128) (local $aChA v128) (local $aChG v128) (local $vMin v128) (local $vMax v128)
    (local $qTop v128) (local $qBot v128)
    (local.set $wm1 (i32.sub (local.get $width) (i32.const 1)))
    (local.set $hm1 (i32.sub (local.get $height) (i32.const 1)))
    (local.set $qClamped (call $vlCl (local.get $qIntent) (i32.const 0) (i32.const 8192)))
    (local.set $cols (i32.add (i32.shl (local.get $bw) (i32.const 3)) (i32.const 2)))
    (local.set $rs (i32.shl (i32.and (i32.add (local.get $cols) (i32.const 7)) (i32.const -8)) (i32.const 1)))
    (local.set $pX (i32.add (local.get $tilePtr) (i32.mul (local.get $rs) (i32.const 10))))
    (local.set $pB (i32.add (local.get $pX) (i32.mul (local.get $rs) (i32.const 10))))
    (local.set $by (i32.const 0))
    (block $byD (loop $byL
      (br_if $byD (i32.ge_s (local.get $by) (local.get $bh)))
      (local.set $y0 (i32.shl (local.get $by) (i32.const 3)))
      ;; The band's plane rows: rows 8 and 9 of the band above are this band's rows 0 and 1.
      (local.set $row (i32.const 0))
      (if (local.get $by) (then
        (memory.copy (local.get $tilePtr) (i32.add (local.get $tilePtr) (i32.shl (local.get $rs) (i32.const 3))) (i32.shl (local.get $rs) (i32.const 1)))
        (memory.copy (local.get $pX) (i32.add (local.get $pX) (i32.shl (local.get $rs) (i32.const 3))) (i32.shl (local.get $rs) (i32.const 1)))
        (memory.copy (local.get $pB) (i32.add (local.get $pB) (i32.shl (local.get $rs) (i32.const 3))) (i32.shl (local.get $rs) (i32.const 1)))
        (local.set $row (i32.const 2))))
      (block $rD (loop $rL
        (br_if $rD (i32.ge_s (local.get $row) (i32.const 10)))
        (local.set $py (call $vlCl (i32.sub (i32.add (local.get $y0) (local.get $row)) (i32.const 1)) (i32.const 0) (local.get $hm1)))
        (local.set $src (i32.add (local.get $rgbaPtr) (i32.shl (i32.mul (local.get $py) (local.get $width)) (i32.const 2))))
        (local.set $at (i32.mul (local.get $row) (local.get $rs)))
        (local.set $c (i32.const 0))
        (block $cD (loop $cL
          (br_if $cD (i32.ge_s (local.get $c) (local.get $cols)))
          (local.set $px (call $vlCl (i32.sub (local.get $c) (i32.const 1)) (i32.const 0) (local.get $wm1)))
          (local.set $o (i32.add (local.get $src) (i32.shl (local.get $px) (i32.const 2))))
          (local.set $r (i32.load (i32.add (local.get $lutPtr) (i32.shl (i32.load8_u (local.get $o)) (i32.const 2)))))
          (local.set $g (i32.load (i32.add (local.get $lutPtr) (i32.shl (i32.load8_u offset=1 (local.get $o)) (i32.const 2)))))
          (local.set $b (i32.load (i32.add (local.get $lutPtr) (i32.shl (i32.load8_u offset=2 (local.get $o)) (i32.const 2)))))
          (i32.store16 (i32.add (local.get $tilePtr) (local.get $at))
            (i32.shr_s (i32.add (i32.add (i32.mul (local.get $r) (i32.const 3)) (i32.shl (local.get $g) (i32.const 3))) (local.get $b)) (i32.const 2)))
          (i32.store16 (i32.add (local.get $pX) (local.get $at)) (i32.sub (local.get $r) (local.get $g)))
          (i32.store16 (i32.add (local.get $pB) (local.get $at))
            (i32.sub (local.get $b) (i32.shr_s (i32.add (local.get $r) (local.get $g)) (i32.const 1))))
          (local.set $at (i32.add (local.get $at) (i32.const 2)))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (br $cL)))
        (local.set $row (i32.add (local.get $row) (i32.const 1)))
        (br $rL)))
      (local.set $bx (i32.const 0))
      (block $bxD (loop $bxL
        (br_if $bxD (i32.ge_s (local.get $bx) (local.get $bw)))
        (local.set $x0 (i32.shl (local.get $bx) (i32.const 3)))
        (local.set $aSumY (v128.const i32x4 0 0 0 0))
        (local.set $aUgx (v128.const i32x4 0 0 0 0))
        (local.set $aUgy (v128.const i32x4 0 0 0 0))
        (local.set $aSgx (v128.const i32x4 0 0 0 0))
        (local.set $aSgy (v128.const i32x4 0 0 0 0))
        (local.set $aLap (v128.const i32x4 0 0 0 0))
        (local.set $aChA (v128.const i32x4 0 0 0 0))
        (local.set $aChG (v128.const i32x4 0 0 0 0))
        (local.set $qTop (v128.const i32x4 0 0 0 0))
        (local.set $qBot (v128.const i32x4 0 0 0 0))
        (local.set $vMin (i16x8.splat (i32.const 3072)))
        (local.set $vMax (v128.const i32x4 0 0 0 0))
        ;; $at: the cell row's first column (x0 + 1) in plane row dy + 1.
        (local.set $at (i32.add (local.get $rs) (i32.shl (i32.add (local.get $x0) (i32.const 1)) (i32.const 1))))
        (local.set $dy (i32.const 0))
        (block $dyD (loop $dyL
          (br_if $dyD (i32.ge_s (local.get $dy) (i32.const 8)))
          (local.set $o (i32.add (local.get $tilePtr) (local.get $at)))
          (local.set $yc (v128.load (local.get $o)))
          (local.set $yx (i16x8.sub (v128.load offset=2 (local.get $o)) (local.get $yc)))
          (local.set $yy (i16x8.sub (v128.load (i32.add (local.get $o) (local.get $rs))) (local.get $yc)))
          (local.set $t (i16x8.abs
            (i16x8.sub
              (i16x8.sub
                (i16x8.sub
                  (i16x8.sub (i16x8.shl (local.get $yc) (i32.const 2)) (v128.load (i32.sub (local.get $o) (i32.const 2))))
                  (v128.load offset=2 (local.get $o)))
                (v128.load (i32.sub (local.get $o) (local.get $rs))))
              (v128.load (i32.add (local.get $o) (local.get $rs))))))
          (local.set $ax (i16x8.abs (local.get $yx)))
          (local.set $ay (i16x8.abs (local.get $yy)))
          (local.set $aSumY (i32x4.add (local.get $aSumY) (i32x4.extadd_pairwise_i16x8_s (local.get $yc))))
          (local.set $aLap (i32x4.add (local.get $aLap) (i32x4.extadd_pairwise_i16x8_s (local.get $t))))
          (local.set $aUgx (i16x8.add (local.get $aUgx) (local.get $ax)))
          (local.set $aUgy (i16x8.add (local.get $aUgy) (local.get $ay)))
          (local.set $aSgx (i16x8.add (local.get $aSgx) (local.get $yx)))
          (local.set $aSgy (i16x8.add (local.get $aSgy) (local.get $yy)))
          (local.set $vMin (i16x8.min_s (local.get $vMin) (local.get $yc)))
          (local.set $vMax (i16x8.max_s (local.get $vMax) (local.get $yc)))
          (local.set $t (i16x8.add (local.get $ax) (local.get $ay)))
          (if (i32.lt_s (local.get $dy) (i32.const 4))
            (then (local.set $qTop (i16x8.add (local.get $qTop) (local.get $t))))
            (else (local.set $qBot (i16x8.add (local.get $qBot) (local.get $t)))))
          (local.set $o (i32.add (local.get $pX) (local.get $at)))
          (local.set $xc (v128.load (local.get $o)))
          (local.set $t (i16x8.add
            (i16x8.abs (i16x8.sub (v128.load offset=2 (local.get $o)) (local.get $xc)))
            (i16x8.abs (i16x8.sub (v128.load (i32.add (local.get $o) (local.get $rs))) (local.get $xc)))))
          (local.set $o (i32.add (local.get $pB) (local.get $at)))
          (local.set $bc (v128.load (local.get $o)))
          (local.set $aChG (i16x8.add (local.get $aChG) (i16x8.add (local.get $t) (i16x8.add
            (i16x8.abs (i16x8.sub (v128.load offset=2 (local.get $o)) (local.get $bc)))
            (i16x8.abs (i16x8.sub (v128.load (i32.add (local.get $o) (local.get $rs))) (local.get $bc)))))))
          (local.set $aChA (i16x8.add (local.get $aChA) (i16x8.add (i16x8.abs (local.get $xc)) (i16x8.abs (local.get $bc)))))
          (local.set $at (i32.add (local.get $at) (local.get $rs)))
          (local.set $dy (i32.add (local.get $dy) (i32.const 1)))
          (br $dyL)))
        (local.set $sumY (call $vlSum4 (local.get $aSumY)))
        (local.set $lap (call $vlSum4 (local.get $aLap)))
        (local.set $ugx (call $vlSum4 (i32x4.extadd_pairwise_i16x8_s (local.get $aUgx))))
        (local.set $ugy (call $vlSum4 (i32x4.extadd_pairwise_i16x8_s (local.get $aUgy))))
        (local.set $sgx (call $vlSum4 (i32x4.extadd_pairwise_i16x8_s (local.get $aSgx))))
        (local.set $sgy (call $vlSum4 (i32x4.extadd_pairwise_i16x8_s (local.get $aSgy))))
        (local.set $chAbs (call $vlSum4 (i32x4.extadd_pairwise_i16x8_s (local.get $aChA))))
        (local.set $chGrad (call $vlSum4 (i32x4.extadd_pairwise_i16x8_u (local.get $aChG))))
        (local.set $t (i32x4.extadd_pairwise_i16x8_s (local.get $qTop)))
        (local.set $q0 (i32.add (i32x4.extract_lane 0 (local.get $t)) (i32x4.extract_lane 1 (local.get $t))))
        (local.set $q1 (i32.add (i32x4.extract_lane 2 (local.get $t)) (i32x4.extract_lane 3 (local.get $t))))
        (local.set $t (i32x4.extadd_pairwise_i16x8_s (local.get $qBot)))
        (local.set $q2 (i32.add (i32x4.extract_lane 0 (local.get $t)) (i32x4.extract_lane 1 (local.get $t))))
        (local.set $q3 (i32.add (i32x4.extract_lane 2 (local.get $t)) (i32x4.extract_lane 3 (local.get $t))))
        ;; Lanes 0-3 against 4-7, then 0-1 against 2-3, then 0 against 1.
        (local.set $vMin (i16x8.min_s (local.get $vMin) (i8x16.shuffle 8 9 10 11 12 13 14 15 0 1 2 3 4 5 6 7 (local.get $vMin) (local.get $vMin))))
        (local.set $vMin (i16x8.min_s (local.get $vMin) (i8x16.shuffle 4 5 6 7 0 1 2 3 4 5 6 7 0 1 2 3 (local.get $vMin) (local.get $vMin))))
        (local.set $yMin (select (i16x8.extract_lane_s 0 (local.get $vMin)) (i16x8.extract_lane_s 1 (local.get $vMin))
          (i32.lt_s (i16x8.extract_lane_s 0 (local.get $vMin)) (i16x8.extract_lane_s 1 (local.get $vMin)))))
        (local.set $vMax (i16x8.max_s (local.get $vMax) (i8x16.shuffle 8 9 10 11 12 13 14 15 0 1 2 3 4 5 6 7 (local.get $vMax) (local.get $vMax))))
        (local.set $vMax (i16x8.max_s (local.get $vMax) (i8x16.shuffle 4 5 6 7 0 1 2 3 4 5 6 7 0 1 2 3 (local.get $vMax) (local.get $vMax))))
        (local.set $yMax (select (i16x8.extract_lane_s 0 (local.get $vMax)) (i16x8.extract_lane_s 1 (local.get $vMax))
          (i32.gt_s (i16x8.extract_lane_s 0 (local.get $vMax)) (i16x8.extract_lane_s 1 (local.get $vMax)))))
        (local.set $qMax (local.get $q0))
        (if (i32.gt_s (local.get $q1) (local.get $qMax)) (then (local.set $qMax (local.get $q1))))
        (if (i32.gt_s (local.get $q2) (local.get $qMax)) (then (local.set $qMax (local.get $q2))))
        (if (i32.gt_s (local.get $q3) (local.get $qMax)) (then (local.set $qMax (local.get $q3))))
        (local.set $qMin (local.get $q0))
        (if (i32.lt_s (local.get $q1) (local.get $qMin)) (then (local.set $qMin (local.get $q1))))
        (if (i32.lt_s (local.get $q2) (local.get $qMin)) (then (local.set $qMin (local.get $q2))))
        (if (i32.lt_s (local.get $q3) (local.get $qMin)) (then (local.set $qMin (local.get $q3))))
        (local.set $netS (i32.add (call $vlAbs (local.get $sgx)) (call $vlAbs (local.get $sgy))))
        (local.set $totG32 (i32.add (i32.add (local.get $ugx) (local.get $ugy)) (i32.const 32)))
        (local.set $totG64 (i32.add (i32.add (local.get $ugx) (local.get $ugy)) (i32.const 64)))
        (local.set $dst (i32.add (local.get $outPtr) (i32.mul (i32.add (i32.mul (local.get $by) (local.get $bw)) (local.get $bx)) (i32.const 48))))
        (i32.store (local.get $dst) (call $vlCl (i32.div_u (i32.add (local.get $sumY) (i32.const 12)) (i32.const 24)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=4 (local.get $dst) (call $vlCl (i32.shr_s (local.get $ugx) (i32.const 2)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=8 (local.get $dst) (call $vlCl (i32.shr_s (local.get $ugy) (i32.const 2)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=12 (local.get $dst) (call $vlCl (i32.div_u (i32.shl (local.get $netS) (i32.const 13)) (local.get $totG32)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=16 (local.get $dst) (call $vlCl (i32.shr_s (local.get $lap) (i32.const 3)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=20 (local.get $dst) (call $vlCl (i32.div_u (i32.shl (local.get $lap) (i32.const 11)) (local.get $totG64)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=24 (local.get $dst) (call $vlCl (i32.shr_s (i32.sub (local.get $qMax) (local.get $qMin)) (i32.const 1)) (i32.const 0) (i32.const 8192)))
        (local.set $diffG (i32.sub (local.get $ugx) (local.get $ugy)))
        (local.set $aniso
          (if (result i32) (i32.ge_s (local.get $diffG) (i32.const 0))
            (then (i32.div_u (i32.shl (local.get $diffG) (i32.const 12)) (local.get $totG64)))
            (else (i32.sub (i32.const 0) (i32.div_u (i32.shl (i32.sub (i32.const 0) (local.get $diffG)) (i32.const 12)) (local.get $totG64))))))
        (i32.store offset=28 (local.get $dst) (call $vlCl (i32.add (i32.const 4096) (local.get $aniso)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=32 (local.get $dst) (call $vlCl (i32.shr_s (local.get $chAbs) (i32.const 3)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=36 (local.get $dst) (call $vlCl (i32.shr_s (local.get $chGrad) (i32.const 3)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=40 (local.get $dst) (call $vlCl (i32.shl (i32.sub (local.get $yMax) (local.get $yMin)) (i32.const 1)) (i32.const 0) (i32.const 8192)))
        (i32.store offset=44 (local.get $dst) (local.get $qClamped))
        (local.set $bx (i32.add (local.get $bx) (i32.const 1)))
        (br $bxL)))
      (local.set $by (i32.add (local.get $by) (i32.const 1)))
      (br $byL))))
  (func $vlAug8 (param $featPtr i32) (param $bw i32) (param $bh i32) (param $augPtr i32)
    (local $x i32) (local $y i32) (local $dx i32) (local $dy i32)
    (local $nx i32) (local $ny i32) (local $sPtr i32) (local $dPtr i32) (local $nbPtr i32)
    (local $sumAct i32) (local $minAct i32) (local $maxRng i32) (local $act i32) (local $rng i32)
    (local.set $y (i32.const 0))
    (block $yDone (loop $yL
      (br_if $yDone (i32.ge_s (local.get $y) (local.get $bh)))
      (local.set $x (i32.const 0))
      (block $xDone (loop $xL
        (br_if $xDone (i32.ge_s (local.get $x) (local.get $bw)))
        (local.set $sPtr (i32.add (local.get $featPtr) (i32.mul (i32.add (i32.mul (local.get $y) (local.get $bw)) (local.get $x)) (i32.const 48))))
        (local.set $dPtr (i32.add (local.get $augPtr) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $bw)) (local.get $x)) (i32.const 6))))
        (v128.store (local.get $dPtr) (v128.load (local.get $sPtr)))
        (v128.store offset=16 (local.get $dPtr) (v128.load offset=16 (local.get $sPtr)))
        (v128.store offset=32 (local.get $dPtr) (v128.load offset=32 (local.get $sPtr)))
        (local.set $sumAct (i32.const 0))
        (local.set $minAct (i32.const 8192))
        (local.set $maxRng (i32.const 0))
        (local.set $dy (i32.const -1))
        (block $dyDone (loop $dyL
          (br_if $dyDone (i32.gt_s (local.get $dy) (i32.const 1)))
          (local.set $ny (call $vlCl (i32.add (local.get $y) (local.get $dy)) (i32.const 0) (i32.sub (local.get $bh) (i32.const 1))))
          (local.set $dx (i32.const -1))
          (block $dxDone (loop $dxL
            (br_if $dxDone (i32.gt_s (local.get $dx) (i32.const 1)))
            (local.set $nx (call $vlCl (i32.add (local.get $x) (local.get $dx)) (i32.const 0) (i32.sub (local.get $bw) (i32.const 1))))
            (local.set $nbPtr (i32.add (local.get $featPtr) (i32.mul (i32.add (i32.mul (local.get $ny) (local.get $bw)) (local.get $nx)) (i32.const 48))))
            (local.set $act (call $vlCl (i32.add (i32.load offset=4 (local.get $nbPtr)) (i32.load offset=8 (local.get $nbPtr))) (i32.const 0) (i32.const 8192)))
            (local.set $rng (i32.load offset=40 (local.get $nbPtr)))
            (local.set $sumAct (i32.add (local.get $sumAct) (local.get $act)))
            (if (i32.lt_s (local.get $act) (local.get $minAct)) (then (local.set $minAct (local.get $act))))
            (if (i32.gt_s (local.get $rng) (local.get $maxRng)) (then (local.set $maxRng (local.get $rng))))
            (local.set $dx (i32.add (local.get $dx) (i32.const 1)))
            (br $dxL)))
          (local.set $dy (i32.add (local.get $dy) (i32.const 1)))
          (br $dyL)))
        (i32.store offset=48 (local.get $dPtr) (i32.div_u (i32.add (local.get $sumAct) (i32.const 4)) (i32.const 9)))
        (i32.store offset=52 (local.get $dPtr) (local.get $minAct))
        (i32.store offset=56 (local.get $dPtr) (local.get $maxRng))
        (i32.store offset=60 (local.get $dPtr) (call $vlCl (i32.sub (local.get $maxRng) (local.get $minAct)) (i32.const 0) (i32.const 8192)))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br $xL)))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $yL))))

  (func $vlPool (param $childPtr i32) (param $cw i32) (param $ch i32) (param $parentPtr i32)
    (local $pw i32) (local $ph i32) (local $px i32) (local $py i32)
    (local $dx i32) (local $dy i32) (local $cx i32) (local $cy i32)
    (local $cb i32) (local $pd i32) (local $yv i32) (local $act i32) (local $rng i32)
    (local $yMin i32) (local $yMax i32) (local $aMin i32) (local $aMax i32) (local $maxRng i32)
    (local $s9 i32) (local $s11 i32) (local $sumAct i32)
    (local $v14 v128) (local $v58 v128)
    (local.set $pw (i32.shr_s (i32.add (local.get $cw) (i32.const 1)) (i32.const 1)))
    (local.set $ph (i32.shr_s (i32.add (local.get $ch) (i32.const 1)) (i32.const 1)))
    (local.set $py (i32.const 0))
    (block $pyDone (loop $pyL
      (br_if $pyDone (i32.ge_s (local.get $py) (local.get $ph)))
      (local.set $px (i32.const 0))
      (block $pxDone (loop $pxL
        (br_if $pxDone (i32.ge_s (local.get $px) (local.get $pw)))
        (local.set $yMin (i32.const 8192))
        (local.set $yMax (i32.const 0))
        (local.set $aMin (i32.const 8192))
        (local.set $aMax (i32.const 0))
        (local.set $maxRng (i32.const 0))
        (local.set $s9 (i32.const 2))
        (local.set $s11 (i32.const 2))
        (local.set $v14 (i32x4.splat (i32.const 2)))
        (local.set $v58 (i32x4.splat (i32.const 2)))
        (local.set $dy (i32.const 0))
        (block $dyDone (loop $dyL
          (br_if $dyDone (i32.ge_s (local.get $dy) (i32.const 2)))
          (local.set $cy (i32.add (i32.shl (local.get $py) (i32.const 1)) (local.get $dy)))
          (if (i32.ge_s (local.get $cy) (local.get $ch)) (then (local.set $cy (i32.sub (local.get $ch) (i32.const 1)))))
          (local.set $dx (i32.const 0))
          (block $dxDone (loop $dxL
            (br_if $dxDone (i32.ge_s (local.get $dx) (i32.const 2)))
            (local.set $cx (i32.add (i32.shl (local.get $px) (i32.const 1)) (local.get $dx)))
            (if (i32.ge_s (local.get $cx) (local.get $cw)) (then (local.set $cx (i32.sub (local.get $cw) (i32.const 1)))))
            (local.set $cb (i32.add (local.get $childPtr) (i32.shl (i32.add (i32.mul (local.get $cy) (local.get $cw)) (local.get $cx)) (i32.const 6))))
            (local.set $yv (i32.load (local.get $cb)))
            (if (i32.lt_s (local.get $yv) (local.get $yMin)) (then (local.set $yMin (local.get $yv))))
            (if (i32.gt_s (local.get $yv) (local.get $yMax)) (then (local.set $yMax (local.get $yv))))
            (local.set $v14 (i32x4.add (local.get $v14) (v128.load offset=4 (local.get $cb))))
            (local.set $v58 (i32x4.add (local.get $v58) (v128.load offset=20 (local.get $cb))))
            (local.set $s9 (i32.add (local.get $s9) (i32.load offset=36 (local.get $cb))))
            (local.set $rng (i32.load offset=40 (local.get $cb)))
            (if (i32.gt_s (local.get $rng) (local.get $maxRng)) (then (local.set $maxRng (local.get $rng))))
            (local.set $s11 (i32.add (local.get $s11) (i32.load offset=44 (local.get $cb))))
            (local.set $act (call $vlCl (i32.add (i32.load offset=4 (local.get $cb)) (i32.load offset=8 (local.get $cb))) (i32.const 0) (i32.const 8192)))
            (if (i32.lt_s (local.get $act) (local.get $aMin)) (then (local.set $aMin (local.get $act))))
            (if (i32.gt_s (local.get $act) (local.get $aMax)) (then (local.set $aMax (local.get $act))))
            (local.set $dx (i32.add (local.get $dx) (i32.const 1)))
            (br $dxL)))
          (local.set $dy (i32.add (local.get $dy) (i32.const 1)))
          (br $dyL)))
        (local.set $pd (i32.add (local.get $parentPtr) (i32.shl (i32.add (i32.mul (local.get $py) (local.get $pw)) (local.get $px)) (i32.const 6))))
        (i32.store (local.get $pd) (call $vlCl (i32.sub (local.get $yMax) (local.get $yMin)) (i32.const 0) (i32.const 8192)))
        (v128.store offset=4 (local.get $pd) (i32x4.shr_s (local.get $v14) (i32.const 2)))
        (v128.store offset=20 (local.get $pd) (i32x4.shr_s (local.get $v58) (i32.const 2)))
        (i32.store offset=36 (local.get $pd) (i32.shr_s (local.get $s9) (i32.const 2)))
        (i32.store offset=40 (local.get $pd) (local.get $maxRng))
        (i32.store offset=44 (local.get $pd) (i32.shr_s (local.get $s11) (i32.const 2)))
        (i32.store offset=48 (local.get $pd) (call $vlCl (i32.sub (local.get $aMax) (local.get $aMin)) (i32.const 0) (i32.const 8192)))
        (local.set $px (i32.add (local.get $px) (i32.const 1)))
        (br $pxL)))
      (local.set $py (i32.add (local.get $py) (i32.const 1)))
      (br $pyL)))
    (local.set $py (i32.const 0))
    (block $py2Done (loop $py2L
      (br_if $py2Done (i32.ge_s (local.get $py) (local.get $ph)))
      (local.set $px (i32.const 0))
      (block $px2Done (loop $px2L
        (br_if $px2Done (i32.ge_s (local.get $px) (local.get $pw)))
        (local.set $sumAct (i32.const 0))
        (local.set $aMin (i32.const 8192))
        (local.set $maxRng (i32.const 0))
        (local.set $dy (i32.const -1))
        (block $dy2Done (loop $dy2L
          (br_if $dy2Done (i32.gt_s (local.get $dy) (i32.const 1)))
          (local.set $cy (call $vlCl (i32.add (local.get $py) (local.get $dy)) (i32.const 0) (i32.sub (local.get $ph) (i32.const 1))))
          (local.set $dx (i32.const -1))
          (block $dx2Done (loop $dx2L
            (br_if $dx2Done (i32.gt_s (local.get $dx) (i32.const 1)))
            (local.set $cx (call $vlCl (i32.add (local.get $px) (local.get $dx)) (i32.const 0) (i32.sub (local.get $pw) (i32.const 1))))
            (local.set $cb (i32.add (local.get $parentPtr) (i32.shl (i32.add (i32.mul (local.get $cy) (local.get $pw)) (local.get $cx)) (i32.const 6))))
            (local.set $act (call $vlCl (i32.add (i32.load offset=4 (local.get $cb)) (i32.load offset=8 (local.get $cb))) (i32.const 0) (i32.const 8192)))
            (local.set $rng (i32.load offset=40 (local.get $cb)))
            (local.set $sumAct (i32.add (local.get $sumAct) (local.get $act)))
            (if (i32.lt_s (local.get $act) (local.get $aMin)) (then (local.set $aMin (local.get $act))))
            (if (i32.gt_s (local.get $rng) (local.get $maxRng)) (then (local.set $maxRng (local.get $rng))))
            (local.set $dx (i32.add (local.get $dx) (i32.const 1)))
            (br $dx2L)))
          (local.set $dy (i32.add (local.get $dy) (i32.const 1)))
          (br $dy2L)))
        (local.set $pd (i32.add (local.get $parentPtr) (i32.shl (i32.add (i32.mul (local.get $py) (local.get $pw)) (local.get $px)) (i32.const 6))))
        (i32.store offset=52 (local.get $pd) (local.get $aMin))
        (i32.store offset=56 (local.get $pd) (local.get $maxRng))
        (i32.store offset=60 (local.get $pd) (i32.div_u (i32.add (local.get $sumAct) (i32.const 4)) (i32.const 9)))
        (local.set $px (i32.add (local.get $px) (i32.const 1)))
        (br $px2L)))
      (local.set $py (i32.add (local.get $py) (i32.const 1)))
      (br $py2L))))

  (func $vlPlace (param $tGrid i32) (param $bw i32) (param $bx i32) (param $by i32) (param $tw i32) (param $th i32) (param $id i32)
    (local $dx i32) (local $dy i32)
    (local.set $dy (i32.const 0))
    (block $dyD (loop $dyL
      (br_if $dyD (i32.ge_s (local.get $dy) (local.get $th)))
      (local.set $dx (i32.const 0))
      (block $dxD (loop $dxL
        (br_if $dxD (i32.ge_s (local.get $dx) (local.get $tw)))
        (i32.store
          (i32.add (local.get $tGrid) (i32.shl (i32.add (i32.mul (i32.add (local.get $by) (local.get $dy)) (local.get $bw)) (i32.add (local.get $bx) (local.get $dx))) (i32.const 2)))
          (select (local.get $id) (i32.const -1) (i32.eqz (i32.or (local.get $dx) (local.get $dy)))))
        (local.set $dx (i32.add (local.get $dx) (i32.const 1)))
        (br $dxL)))
      (local.set $dy (i32.add (local.get $dy) (i32.const 1)))
      (br $dyL))))

  ;; One context-only octave, used by the large photograph packet above the shared block readers.
  (func $vlCtxScale
    (param $mlpOff i32) (param $lvPtr i32) (param $pw i32) (param $ph i32)
    (param $parPtr i32) (param $parW i32) (param $C i32) (param $dstPtr i32)
    (param $inpPtr i32) (param $tmpOutPtr i32) (param $mlpScratch i32)
    (local $x i32) (local $y i32) (local $i i32) (local $p i32) (local $k i32)
    (local.set $y (i32.const 0))
    (block $yD (loop $yL
      (br_if $yD (i32.ge_s (local.get $y) (local.get $ph)))
      (local.set $x (i32.const 0))
      (block $xD (loop $xL
        (br_if $xD (i32.ge_s (local.get $x) (local.get $pw)))
        (local.set $i (i32.add (i32.mul (local.get $y) (local.get $pw)) (local.get $x)))
        (local.set $p
          (if (result i32) (i32.gt_s (local.get $parW) (i32.const 0))
            (then (i32.add (i32.mul (i32.shr_s (local.get $y) (i32.const 1)) (local.get $parW)) (i32.shr_s (local.get $x) (i32.const 1))))
            (else (i32.const 0))))
        (memory.copy (local.get $inpPtr) (i32.add (local.get $lvPtr) (i32.shl (local.get $i) (i32.const 6))) (i32.const 64))
        (memory.copy (i32.add (local.get $inpPtr) (i32.const 64))
          (i32.add (local.get $parPtr) (i32.shl (i32.mul (local.get $p) (local.get $C)) (i32.const 2)))
          (i32.shl (local.get $C) (i32.const 2)))
        (call $intMlp (local.get $mlpOff) (local.get $inpPtr) (i32.const 1) (local.get $tmpOutPtr) (local.get $mlpScratch))
        (local.set $k (i32.const 0))
        (block $kD (loop $kL
          (br_if $kD (i32.ge_s (local.get $k) (local.get $C)))
          (i32.store
            (i32.add (local.get $dstPtr) (i32.shl (i32.add (i32.mul (local.get $i) (local.get $C)) (local.get $k)) (i32.const 2)))
            (call $vlCl (i32.load (i32.add (local.get $tmpOutPtr) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 0) (i32.const 1024)))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $kL)))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br $xL)))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $yL))))

  (func $visualLex
    (export "visualLex")
    (param $pkt i32)
    (param $featPtr i32)
    (param $bw i32)
    (param $bh i32)
    (param $qIntent i32)
    (param $wide i32)
    (param $outPtr i32)
    (param $scratch i32)
    (result i32)
    (local $C i32) (local $offG i32) (local $off64 i32) (local $off32 i32) (local $off16 i32) (local $off8 i32)
    (local $n8 i32) (local $pw16 i32) (local $ph16 i32) (local $n16 i32)
    (local $pw32 i32) (local $ph32 i32) (local $n32 i32) (local $pw64 i32) (local $ph64 i32) (local $n64 i32)
    (local $aug8Ptr i32) (local $lv16Ptr i32) (local $lv32Ptr i32) (local $lv64Ptr i32)
    (local $c64Ptr i32) (local $m64Ptr i32) (local $c32Ptr i32) (local $m32Ptr i32) (local $c16Ptr i32) (local $m16Ptr i32)
    (local $tGridPtr i32) (local $tmpFieldPtr i32) (local $inpPtr i32) (local $tmpOutPtr i32) (local $mlpScratch i32)
    (local $i i32) (local $k i32) (local $x i32) (local $y i32) (local $p i32) (local $p64 i32)
    (local $skyCnt i32) (local $rampCnt i32) (local $texCnt i32)
    (local $e i32) (local $sp i32) (local $a i32) (local $b i32) (local $c i32) (local $mx i32) (local $tid i32) (local $vj i32) (local $vv i32)
    (local $xm i32) (local $xp i32) (local $ym i32) (local $yp i32)
    (local $v2 i32) (local $head i32) (local $off256 i32) (local $off128 i32)
    (local $pw128 i32) (local $ph128 i32) (local $n128 i32) (local $pw256 i32) (local $ph256 i32) (local $n256 i32)
    (local $lv128Ptr i32) (local $lv256Ptr i32) (local $gCtxPtr i32) (local $c256Ptr i32) (local $c128Ptr i32)
    (local $msb i32) (local $mant8 i32) (local $sum64 i64) (local $sum256 i64)
    (if (i32.or (i32.ne (i32.load8_u (local.get $pkt)) (i32.const 0))
                (i32.or (i32.ne (i32.load8_u offset=1 (local.get $pkt)) (i32.const 0x56))
                        (i32.gt_u (i32.sub (i32.load8_u offset=2 (local.get $pkt)) (i32.const 1)) (i32.const 1))))
      (then (return (i32.const 0))))
    (local.set $C (i32.load8_u offset=3 (local.get $pkt)))
    (local.set $v2 (i32.eq (i32.load8_u offset=2 (local.get $pkt)) (i32.const 2)))
    (local.set $head (i32.add (local.get $pkt) (i32.shl (local.get $v2) (i32.const 3))))
    (if (local.get $v2) (then
      (local.set $off256 (i32.add (local.get $pkt) (i32.load offset=8 (local.get $pkt))))
      (local.set $off128 (i32.add (local.get $pkt) (i32.load offset=12 (local.get $pkt))))))
    (local.set $offG (i32.add (local.get $pkt) (i32.load offset=4 (local.get $pkt))))
    (local.set $off64 (i32.add (local.get $pkt) (i32.load offset=8 (local.get $head))))
    (local.set $off32 (i32.add (local.get $pkt) (i32.load offset=12 (local.get $head))))
    (local.set $off16 (i32.add (local.get $pkt) (i32.load offset=16 (local.get $head))))
    (local.set $off8 (i32.add (local.get $pkt) (i32.load offset=20 (local.get $head))))

    (local.set $n8 (i32.mul (local.get $bw) (local.get $bh)))
    (local.set $pw16 (i32.shr_s (i32.add (local.get $bw) (i32.const 1)) (i32.const 1)))
    (local.set $ph16 (i32.shr_s (i32.add (local.get $bh) (i32.const 1)) (i32.const 1)))
    (local.set $n16 (i32.mul (local.get $pw16) (local.get $ph16)))
    (local.set $pw32 (i32.shr_s (i32.add (local.get $pw16) (i32.const 1)) (i32.const 1)))
    (local.set $ph32 (i32.shr_s (i32.add (local.get $ph16) (i32.const 1)) (i32.const 1)))
    (local.set $n32 (i32.mul (local.get $pw32) (local.get $ph32)))
    (local.set $pw64 (i32.shr_s (i32.add (local.get $pw32) (i32.const 1)) (i32.const 1)))
    (local.set $ph64 (i32.shr_s (i32.add (local.get $ph32) (i32.const 1)) (i32.const 1)))
    (local.set $n64 (i32.mul (local.get $pw64) (local.get $ph64)))
    (if (local.get $v2) (then
      (local.set $pw128 (i32.shr_s (i32.add (local.get $pw64) (i32.const 1)) (i32.const 1)))
      (local.set $ph128 (i32.shr_s (i32.add (local.get $ph64) (i32.const 1)) (i32.const 1)))
      (local.set $n128 (i32.mul (local.get $pw128) (local.get $ph128)))
      (local.set $pw256 (i32.shr_s (i32.add (local.get $pw128) (i32.const 1)) (i32.const 1)))
      (local.set $ph256 (i32.shr_s (i32.add (local.get $ph128) (i32.const 1)) (i32.const 1)))
      (local.set $n256 (i32.mul (local.get $pw256) (local.get $ph256)))
    ))

    (local.set $aug8Ptr (local.get $scratch))
    (local.set $lv16Ptr (i32.add (local.get $aug8Ptr) (i32.shl (local.get $n8) (i32.const 6))))
    (local.set $lv32Ptr (i32.add (local.get $lv16Ptr) (i32.shl (local.get $n16) (i32.const 6))))
    (local.set $lv64Ptr (i32.add (local.get $lv32Ptr) (i32.shl (local.get $n32) (i32.const 6))))
    ;; Format 2 appends two macro scales and their context. At version 1 all added counts are zero, keeping its arena.
    (local.set $lv128Ptr (i32.add (local.get $lv64Ptr) (i32.shl (local.get $n64) (i32.const 6))))
    (local.set $lv256Ptr (i32.add (local.get $lv128Ptr) (i32.shl (local.get $n128) (i32.const 6))))
    (local.set $gCtxPtr (i32.add (local.get $lv256Ptr) (i32.shl (local.get $n256) (i32.const 6))))
    (local.set $c256Ptr (i32.add (local.get $gCtxPtr) (i32.shl (i32.mul (local.get $v2) (local.get $C)) (i32.const 2))))
    (local.set $c128Ptr (i32.add (local.get $c256Ptr) (i32.shl (i32.mul (local.get $n256) (local.get $C)) (i32.const 2))))
    (local.set $c64Ptr (i32.add (local.get $c128Ptr) (i32.shl (i32.mul (local.get $n128) (local.get $C)) (i32.const 2))))
    (local.set $m64Ptr (i32.add (local.get $c64Ptr) (i32.shl (i32.mul (local.get $n64) (local.get $C)) (i32.const 2))))
    (local.set $c32Ptr (i32.add (local.get $m64Ptr) (i32.shl (local.get $n64) (i32.const 2))))
    (local.set $m32Ptr (i32.add (local.get $c32Ptr) (i32.shl (i32.mul (local.get $n32) (local.get $C)) (i32.const 2))))
    (local.set $c16Ptr (i32.add (local.get $m32Ptr) (i32.shl (local.get $n32) (i32.const 2))))
    (local.set $m16Ptr (i32.add (local.get $c16Ptr) (i32.shl (i32.mul (local.get $n16) (local.get $C)) (i32.const 2))))
    (local.set $tGridPtr (i32.add (local.get $m16Ptr) (i32.shl (local.get $n16) (i32.const 2))))
    (local.set $tmpFieldPtr (i32.add (local.get $tGridPtr) (i32.shl (local.get $n8) (i32.const 2))))
    (local.set $inpPtr (i32.and (i32.add (i32.add (local.get $tmpFieldPtr) (i32.shl (local.get $n8) (i32.const 2))) (i32.const 15)) (i32.const -16)))
    (local.set $tmpOutPtr (i32.add (local.get $inpPtr) (i32.const 512)))
    (local.set $mlpScratch (i32.add (local.get $tmpOutPtr) (i32.const 512)))

    (call $vlAug8 (local.get $featPtr) (local.get $bw) (local.get $bh) (local.get $aug8Ptr))
    (call $vlPool (local.get $aug8Ptr) (local.get $bw) (local.get $bh) (local.get $lv16Ptr))
    (call $vlPool (local.get $lv16Ptr) (local.get $pw16) (local.get $ph16) (local.get $lv32Ptr))
    (call $vlPool (local.get $lv32Ptr) (local.get $pw32) (local.get $ph32) (local.get $lv64Ptr))
    (if (local.get $v2) (then
      (call $vlPool (local.get $lv64Ptr) (local.get $pw64) (local.get $ph64) (local.get $lv128Ptr))
      (call $vlPool (local.get $lv128Ptr) (local.get $pw128) (local.get $ph128) (local.get $lv256Ptr))))

    ;; Global sums need i64: 524288 cells at 8192 already exceed u32. The 11 sums fit in
    ;; inpPtr's reserved 512 bytes. Converting them forwards to i32 means cannot overwrite an unread sum.
    (memory.fill (local.get $inpPtr) (i32.const 0) (i32.const 88))
    (local.set $skyCnt (i32.const 0))
    (local.set $rampCnt (i32.const 0))
    (local.set $texCnt (i32.const 0))
    (local.set $i (i32.const 0))
    (block $gDone (loop $gL
      (br_if $gDone (i32.ge_s (local.get $i) (local.get $n8)))
      (local.set $p (i32.add (local.get $aug8Ptr) (i32.shl (local.get $i) (i32.const 6))))
      (local.set $k (i32.const 0))
      (block $gkDone (loop $gkL
        (br_if $gkDone (i32.gt_s (local.get $k) (i32.const 10)))
        (i64.store
          (i32.add (local.get $inpPtr) (i32.shl (local.get $k) (i32.const 3)))
          (i64.add (i64.load (i32.add (local.get $inpPtr) (i32.shl (local.get $k) (i32.const 3))))
                   (i64.extend_i32_u (i32.load (i32.add (local.get $p) (i32.shl (local.get $k) (i32.const 2)))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $gkL)))
      (local.set $e (i32.add (i32.load offset=4 (local.get $p)) (i32.load offset=8 (local.get $p))))
      (if (i32.and (i32.lt_s (local.get $e) (i32.const 180)) (i32.lt_s (i32.load offset=16 (local.get $p)) (i32.const 160)))
        (then (local.set $skyCnt (i32.add (local.get $skyCnt) (i32.const 1)))))
      (if (i32.and (i32.lt_s (local.get $e) (i32.const 600))
                   (i32.and (i32.gt_s (i32.load offset=12 (local.get $p)) (i32.const 3200))
                            (i32.lt_s (i32.load offset=16 (local.get $p)) (i32.const 300))))
        (then (local.set $rampCnt (i32.add (local.get $rampCnt) (i32.const 1)))))
      (if (i32.and (i32.gt_s (local.get $e) (i32.const 900)) (i32.gt_s (i32.load offset=20 (local.get $p)) (i32.const 1800)))
        (then (local.set $texCnt (i32.add (local.get $texCnt) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $gL)))

    (local.set $e (select (local.get $n8) (i32.const 1) (i32.gt_s (local.get $n8) (i32.const 0))))
    (local.set $k (i32.const 0))
    (block $gdDone (loop $gdL
      (br_if $gdDone (i32.gt_s (local.get $k) (i32.const 10)))
      (i32.store
        (i32.add (local.get $inpPtr) (i32.shl (local.get $k) (i32.const 2)))
        (i32.wrap_i64 (i64.div_u
          (i64.load (i32.add (local.get $inpPtr) (i32.shl (local.get $k) (i32.const 3))))
          (i64.extend_i32_u (local.get $e)))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $gdL)))
    (i32.store offset=44 (local.get $inpPtr) (i32.wrap_i64 (i64.div_u
      (i64.shl (i64.extend_i32_u (local.get $skyCnt)) (i64.const 13)) (i64.extend_i32_u (local.get $e)))))
    (i32.store offset=48 (local.get $inpPtr) (i32.wrap_i64 (i64.div_u
      (i64.shl (i64.extend_i32_u (local.get $rampCnt)) (i64.const 13)) (i64.extend_i32_u (local.get $e)))))
    (i32.store offset=52 (local.get $inpPtr) (i32.wrap_i64 (i64.div_u
      (i64.shl (i64.extend_i32_u (local.get $texCnt)) (i64.const 13)) (i64.extend_i32_u (local.get $e)))))
    (i32.store offset=56 (local.get $inpPtr) (call $vlCl (local.get $qIntent) (i32.const 0) (i32.const 8192)))
    (i32.store offset=60 (local.get $inpPtr) (select (i32.const 4096) (i32.const 0) (local.get $wide)))

    (if (local.get $v2) (then
      ;; Format 2 global slots 16..19: log2Cells, macroContrast64, macroContrast256, grainToStructure.
      (local.set $msb (i32.sub (i32.const 31) (i32.clz (local.get $e))))
      (local.set $mant8
        (if (result i32) (i32.ge_s (local.get $msb) (i32.const 8))
          (then (i32.and (i32.shr_u (local.get $e) (i32.sub (local.get $msb) (i32.const 8))) (i32.const 255)))
          (else (i32.and (i32.shl (local.get $e) (i32.sub (i32.const 8) (local.get $msb))) (i32.const 255)))))
      (i32.store offset=64 (local.get $inpPtr)
        (call $vlCl (i32.mul (i32.sub (i32.or (i32.shl (local.get $msb) (i32.const 8)) (local.get $mant8)) (i32.const 2048)) (i32.const 3)) (i32.const 0) (i32.const 8192)))

      (local.set $sum64 (i64.const 0))
      (local.set $i (i32.const 0))
      (block $s64D (loop $s64L
        (br_if $s64D (i32.ge_s (local.get $i) (local.get $n64)))
        (local.set $sum64 (i64.add (local.get $sum64) (i64.extend_i32_u (i32.load (i32.add (local.get $lv64Ptr) (i32.shl (local.get $i) (i32.const 6)))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $s64L)))
      (i32.store offset=68 (local.get $inpPtr) (i32.wrap_i64 (i64.div_u
        (local.get $sum64) (i64.extend_i32_u (select (local.get $n64) (i32.const 1) (i32.gt_s (local.get $n64) (i32.const 0)))))))

      (local.set $sum256 (i64.const 0))
      (local.set $i (i32.const 0))
      (block $s256D (loop $s256L
        (br_if $s256D (i32.ge_s (local.get $i) (local.get $n256)))
        (local.set $sum256 (i64.add (local.get $sum256) (i64.extend_i32_u (i32.load (i32.add (local.get $lv256Ptr) (i32.shl (local.get $i) (i32.const 6)))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $s256L)))
      (i32.store offset=72 (local.get $inpPtr) (i32.wrap_i64 (i64.div_u
        (local.get $sum256) (i64.extend_i32_u (select (local.get $n256) (i32.const 1) (i32.gt_s (local.get $n256) (i32.const 0)))))))

      (i32.store offset=76 (local.get $inpPtr) (call $vlCl
        (i32.div_u
          (i32.shl (i32.add (i32.load offset=4 (local.get $inpPtr)) (i32.load offset=8 (local.get $inpPtr))) (i32.const 10))
          (i32.add (i32.load offset=68 (local.get $inpPtr)) (i32.const 64)))
        (i32.const 0) (i32.const 8192)))
    ))

    (call $intMlp (local.get $offG) (local.get $inpPtr) (i32.const 1) (local.get $tmpOutPtr) (local.get $mlpScratch))
    (i32.store (local.get $outPtr) (call $vlCl (i32.load (local.get $tmpOutPtr)) (i32.const -2560) (i32.const 2048)))
    (i32.store offset=4 (local.get $outPtr) (call $vlCl (i32.load offset=4 (local.get $tmpOutPtr)) (i32.const -64) (i32.const 154)))
    (i32.store offset=8 (local.get $outPtr) (i32.load offset=8 (local.get $tmpOutPtr)))
    (i32.store offset=12 (local.get $outPtr) (i32.load offset=12 (local.get $tmpOutPtr)))
    (i32.store offset=16 (local.get $outPtr) (i32.load offset=16 (local.get $tmpOutPtr)))
    (i32.store offset=20 (local.get $outPtr) (call $vlCl (i32.load offset=20 (local.get $tmpOutPtr)) (i32.const -64) (i32.const 64)))

    ;; Both formats use the same 32 px, 16 px and leaf readers. Format 2's coarser stages carry context only.
    (if (local.get $v2)
      (then
        (local.set $k (i32.const 0))
        (block $gcD (loop $gcL
          (br_if $gcD (i32.ge_s (local.get $k) (local.get $C)))
          (i32.store
            (i32.add (local.get $gCtxPtr) (i32.shl (local.get $k) (i32.const 2)))
            (call $vlCl (i32.load (i32.add (local.get $tmpOutPtr) (i32.shl (i32.add (local.get $k) (i32.const 6)) (i32.const 2)))) (i32.const 0) (i32.const 1024)))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $gcL)))

        ;; Macro context pyramid: 256 -> 128 -> 64
        (call $vlCtxScale (local.get $off256) (local.get $lv256Ptr) (local.get $pw256) (local.get $ph256) (local.get $gCtxPtr) (i32.const 0) (local.get $C) (local.get $c256Ptr) (local.get $inpPtr) (local.get $tmpOutPtr) (local.get $mlpScratch))
        (call $vlCtxScale (local.get $off128) (local.get $lv128Ptr) (local.get $pw128) (local.get $ph128) (local.get $c256Ptr) (local.get $pw256) (local.get $C) (local.get $c128Ptr) (local.get $inpPtr) (local.get $tmpOutPtr) (local.get $mlpScratch))
        (call $vlCtxScale (local.get $off64) (local.get $lv64Ptr) (local.get $pw64) (local.get $ph64) (local.get $c128Ptr) (local.get $pw128) (local.get $C) (local.get $c64Ptr) (local.get $inpPtr) (local.get $tmpOutPtr) (local.get $mlpScratch))
        (memory.fill (local.get $m64Ptr) (i32.const 255) (i32.shl (local.get $n64) (i32.const 2))))
      (else
        ;; off64
        (local.set $y (i32.const 0))
        (block $y64D (loop $y64L
          (br_if $y64D (i32.ge_s (local.get $y) (local.get $ph64)))
          (local.set $x (i32.const 0))
          (block $x64D (loop $x64L
            (br_if $x64D (i32.ge_s (local.get $x) (local.get $pw64)))
            (local.set $i (i32.add (i32.mul (local.get $y) (local.get $pw64)) (local.get $x)))
            (call $intMlp (local.get $off64) (i32.add (local.get $lv64Ptr) (i32.shl (local.get $i) (i32.const 6))) (i32.const 1) (local.get $tmpOutPtr) (local.get $mlpScratch))
            (local.set $k (i32.const 0))
            (block $c64D (loop $c64L
              (br_if $c64D (i32.ge_s (local.get $k) (local.get $C)))
              (i32.store
                (i32.add (local.get $c64Ptr) (i32.shl (i32.add (i32.mul (local.get $i) (local.get $C)) (local.get $k)) (i32.const 2)))
                (call $vlCl (i32.load (i32.add (local.get $tmpOutPtr) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 0) (i32.const 1024)))
              (local.set $k (i32.add (local.get $k) (i32.const 1)))
              (br $c64L)))
            (local.set $tid (i32.const -1))
            (if (i32.and (i32.le_s (i32.add (i32.shl (local.get $x) (i32.const 3)) (i32.const 8)) (local.get $bw))
