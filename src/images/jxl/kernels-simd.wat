        (local.set $size (i32.mul (local.get $kinds) (local.get $alphabet)))
        (local.set $stride (i32.shl (local.get $alphabet) (i32.const 2)))
        (local.set $k (i32.const 0))
        (block $peelColsDone
          (loop $peelCol
            (br_if $peelColsDone (i32.ge_u (local.get $k) (local.get $columns)))
            (local.set $cuts (i32.load (i32.add (local.get $cutsAt) (i32.shl (local.get $k) (i32.const 2)))))
            (if (local.get $cuts)
              (then
                (local.set $from (i32.add (local.get $resIdx) (i32.mul (local.get $k) (local.get $count))))
                (local.set $i (i32.const 0))
                (local.set $minB (i32.const 255))
