        (local.set $t0 (v128.const f64x2 0 0)) (local.set $t1 (v128.const f64x2 0 0))
        (local.set $t2 (v128.const f64x2 0 0)) (local.set $t3 (v128.const f64x2 0 0))
        (local.set $x (i32.const 0))
        (local.set $b (i32.add (local.get $bt) (i32.shl (local.get $u) (i32.const 3))))
        (loop $xs
          (local.set $px (v128.load64_splat (i32.add (local.get $row) (i32.shl (local.get $x) (i32.const 3)))))
          (local.set $py (v128.load64_splat (i32.add (local.get $row1) (i32.shl (local.get $x) (i32.const 3)))))
          (local.set $b0 (v128.load (local.get $b))) (local.set $b1 (v128.load offset=16 (local.get $b)))
          (local.set $b2 (v128.load offset=32 (local.get $b))) (local.set $b3 (v128.load offset=48 (local.get $b)))
          (local.set $s0 (f64x2.add (local.get $s0) (f64x2.mul (local.get $px) (local.get $b0))))
          (local.set $s1 (f64x2.add (local.get $s1) (f64x2.mul (local.get $px) (local.get $b1))))
          (local.set $s2 (f64x2.add (local.get $s2) (f64x2.mul (local.get $px) (local.get $b2))))
          (local.set $s3 (f64x2.add (local.get $s3) (f64x2.mul (local.get $px) (local.get $b3))))
          (local.set $t0 (f64x2.add (local.get $t0) (f64x2.mul (local.get $py) (local.get $b0))))
          (local.set $t1 (f64x2.add (local.get $t1) (f64x2.mul (local.get $py) (local.get $b1))))
          (local.set $t2 (f64x2.add (local.get $t2) (f64x2.mul (local.get $py) (local.get $b2))))
          (local.set $t3 (f64x2.add (local.get $t3) (f64x2.mul (local.get $py) (local.get $b3))))
