        (br_if $cols (i32.ge_u (local.get $col) (local.get $w)))
        (local.set $v (f64.promote_f32 (f32.load (local.get $at0))))
        (local.set $d (f64.promote_f32 (f32.load (i32.add (local.get $d0) (i32.shl (i32.and (i32.add (local.get $ox) (local.get $col)) (i32.const 31)) (i32.const 2))))))
