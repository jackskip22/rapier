            (i32.store (i32.add (local.get $D) (i32.shl (local.get $i) (i32.const 2)))
              (i32.trunc_sat_f64_s (call $round (f64.div (f64.mul (f64.load (i32.add (local.get $dcTmp) (i32.shl (local.get $i) (i32.const 3)))) (f64.const 8))
                (f64.load offset=144 (i32.add (local.get $job) (i32.shl (i32.rem_u (local.get $i) (i32.const 3)) (i32.const 3))))))))
