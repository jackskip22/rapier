  ;; photo-xyb.mjs gaborishInverse's boost over n f64 samples at p, from their original at orig, in place:
  ;; p = orig + boost * (p - orig), the JavaScript's three operations, two samples a lane pair.
  (func (export "gabBoost") (param $p i32) (param $orig i32) (param $n i32) (param $boost f64)
    (local $end i32) (local $vb v128) (local $o v128)
    (local.set $vb (f64x2.splat (local.get $boost)))
    (local.set $end (i32.add (local.get $p) (i32.shl (i32.and (local.get $n) (i32.const -2)) (i32.const 3))))
    (block $pairs (loop $each
      (br_if $pairs (i32.ge_u (local.get $p) (local.get $end)))
      (local.set $o (v128.load (local.get $orig)))
      (v128.store (local.get $p) (f64x2.add (local.get $o) (f64x2.mul (local.get $vb) (f64x2.sub (v128.load (local.get $p)) (local.get $o)))))
      (local.set $p (i32.add (local.get $p) (i32.const 16)))
      (local.set $orig (i32.add (local.get $orig) (i32.const 16)))
      (br $each)))
