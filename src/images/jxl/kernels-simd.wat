        (local.set $b (f64.load offset=64 (local.get $out)))
        (f64.store offset=0 (local.get $out) (f64.mul (f64.add (local.get $a) (local.get $b)) (f64.const 0.5)))
        (f64.store offset=64 (local.get $out) (f64.mul (f64.sub (local.get $a) (local.get $b)) (f64.const 0.5))))))

  (func $vbDct (export "vbDct") (param $pix i32) (param $stride i32) (param $w i32) (param $h i32) (param $bt i32) (param $by i32) (param $tmp i32) (param $out i32)
    (local $r i32) (local $u i32) (local $x i32) (local $v i32) (local $y i32)
    (local $s0 v128) (local $s1 v128) (local $s2 v128) (local $s3 v128)
    (local $t0 v128) (local $t1 v128) (local $t2 v128) (local $t3 v128)
    (local $b0 v128) (local $b1 v128) (local $b2 v128) (local $b3 v128)
