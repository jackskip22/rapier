          (if (i32.ge_u (local.get $pending) (i32.const 32))
            (then
              (i32.store (local.get $out) (i32.wrap_i64 (local.get $acc)))
              (local.set $out (i32.add (local.get $out) (i32.const 4)))
              (local.set $acc (i64.shr_u (local.get $acc) (i64.const 32)))
              (local.set $pending (i32.sub (local.get $pending) (i32.const 32)))))))
      (local.set $acc (i64.or (local.get $acc) (i64.shl (i64.extend_i32_u (i32.load (i32.add (local.get $raws) (i32.shl (local.get $i) (i32.const 2)))))
        (i64.extend_i32_u (local.get $pending)))))
