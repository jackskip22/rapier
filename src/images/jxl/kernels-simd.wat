          (f64.load offset=24 (i32.add (local.get $ones) (i32.shl (local.get $c) (i32.const 3))))
          (f64.load (local.get $out))) (f64.const 64)) (local.get $mw))))
        (local.set $R (f64.add (f64.load offset=8 (local.get $out))
          (f64.add (local.get $rc0) (f64.mul (local.get $rc3) (f64.convert_i32_s (i32.load offset=16 (local.get $out)))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br_if $channels (i32.lt_u (local.get $k) (i32.const 3))))
      (f64.store (i32.add (local.get $drOut) (i32.shl (local.get $j) (i32.const 4))) (local.get $D))
      (f64.store offset=8 (i32.add (local.get $drOut) (i32.shl (local.get $j) (i32.const 4))) (local.get $R))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $blocks)))
