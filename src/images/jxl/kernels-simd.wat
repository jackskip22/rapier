;; A filled token list (`n` contexts at `ctxs`, values at `vals`, i32) collected for ansFlush as acGroup collects (mode 2,
;; strategyWrite's): each value at args' 104 and its histogram id, through the map at 72, at 108; the count at 112.
(func (export "acTokens") (param $args i32) (param $ctxs i32) (param $vals i32) (param $n i32)
  (local $i i32) (local $tokens i32) (local $ids i32) (local $map i32)
  (local.set $tokens (i32.load offset=104 (local.get $args))) (local.set $ids (i32.load offset=108 (local.get $args)))
  (local.set $map (i32.load offset=72 (local.get $args)))
  (block $done (loop $each
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (i32.store (i32.add (local.get $tokens) (i32.shl (local.get $i) (i32.const 2))) (i32.load (i32.add (local.get $vals) (i32.shl (local.get $i) (i32.const 2)))))
    (i32.store8 (i32.add (local.get $ids) (local.get $i))
      (i32.load8_u (i32.add (local.get $map) (i32.load (i32.add (local.get $ctxs) (i32.shl (local.get $i) (i32.const 2)))))))
