            (v128.store offset=48 (local.get $o) (local.get $t3))))
        (local.set $u (i32.add (local.get $u) (i32.const 8)))
        (br_if $cols (i32.lt_u (local.get $u) (local.get $w))))
      (local.set $v (i32.add (local.get $v) (i32.const 2)))
      (br_if $vs (i32.lt_u (local.get $v) (local.get $h)))))

  ;; The unpriced levels (vbQuant with `out` 0): two at a time, a pair whose scaled magnitudes are well under the smaller
  ;; dead zone (no division) zeroed at once; a DCT8 in natural order runs its 64 positions in place. 2: a level reached
  ;; 4096 under the extended call (`ext`); 1: one did otherwise.
  (func $vbQuantPlain (param $tr i32) (param $luma i32) (param $order i32) (param $steps i32) (param $high i32)
    (param $area i32) (param $size i32) (param $levels i32) (param $fc f64) (param $lo f64) (param $hi f64) (param $fine f64) (param $ext i32) (result i32)
    (local $k i32) (local $pos i32) (local $pos1 i32) (local $step f64) (local $coef f64) (local $val f64) (local $a f64) (local $fl f64) (local $qf f64) (local $q i32)
    (local $at i32) (local $at1 i32) (local $fastZero i32) (local $sameDz i32) (local $wide i32)
    (local $vfc v128) (local $vfine v128) (local $vscale v128) (local $vminThr v128) (local $vlo v128)
    (local $vcoef v128) (local $vstep v128) (local $vval v128) (local $va v128) (local $vthr v128)
    (local.set $lo (f64.max (local.get $lo) (f64.const 0.5)))
    (local.set $hi (f64.max (local.get $hi) (f64.const 0.5)))
    (local.set $vfc (f64x2.splat (local.get $fc)))
    (local.set $vfine (f64x2.splat (local.get $fine)))
    (local.set $sameDz (f64.eq (local.get $lo) (local.get $hi)))
    (local.set $vlo (f64x2.splat (local.get $lo)))
    (local.set $fastZero (i32.and (f64.lt (local.get $fine) (f64.const 1e100)) (f64.lt (f64.min (local.get $lo) (local.get $hi)) (f64.const 1e100))))
    (if (local.get $fastZero)
      (then
        (local.set $vscale (f64x2.splat (f64.mul (local.get $fine) (f64.const 2048))))
        (local.set $vminThr (f64x2.splat (f64.mul (f64.min (local.get $lo) (local.get $hi)) (f64.const 0.999999999999))))))
    (if (i32.and (local.get $fastZero) (i32.and (i32.eq (local.get $area) (i32.const 1)) (i32.eqz (i32.and (local.get $size) (i32.const 1)))))
      (then
        (if (i32.eqz (i32.load (local.get $order)))
          (then
            (local.set $pos (i32.const 0))
            (loop $contig
              (local.set $at (i32.shl (local.get $pos) (i32.const 3)))
              (local.set $vstep (v128.load (i32.add (local.get $steps) (local.get $at))))
              (local.set $vcoef (v128.load (i32.add (local.get $tr) (local.get $at))))
              (if (local.get $luma)
                (then (local.set $vcoef (f64x2.sub (local.get $vcoef) (f64x2.mul (local.get $vfc) (v128.load (i32.add (local.get $luma) (local.get $at))))))))
              (if (i32.eqz (local.get $pos))
                (then (local.set $vcoef (f64x2.replace_lane 0 (local.get $vcoef) (f64.const 0)))))
              (if (i64x2.all_true (f64x2.lt (f64x2.mul (f64x2.abs (local.get $vcoef)) (local.get $vscale)) (f64x2.mul (local.get $vstep) (local.get $vminThr))))
                (then (i64.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2))) (i64.const 0)))
                (else
                  (local.set $vval (f64x2.mul (f64x2.div (f64x2.mul (f64x2.mul (local.get $vcoef) (v128.const f64x2 8 8)) (v128.const f64x2 256 256)) (local.get $vstep)) (local.get $vfine)))
                  (local.set $va (f64x2.abs (local.get $vval)))
                  (local.set $vthr (if (result v128) (local.get $sameDz)
                    (then (local.get $vlo))
                    (else
                      (local.set $at1 (i32.load16_u (i32.add (local.get $high) (local.get $pos))))
                      (f64x2.replace_lane 1
                        (f64x2.splat (select (local.get $hi) (local.get $lo) (i32.and (local.get $at1) (i32.const 255))))
                        (select (local.get $hi) (local.get $lo) (i32.shr_u (local.get $at1) (i32.const 8)))))))
                  (if (i64x2.all_true (f64x2.lt (local.get $va) (local.get $vthr)))
                    (then (i64.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2))) (i64.const 0)))
                    (else
                      (local.set $vstep (f64x2.floor (local.get $va)))
                      (local.set $vcoef (v128.andnot
                        (v128.bitselect (f64x2.add (local.get $vstep) (v128.const f64x2 1 1)) (local.get $vstep)
                          (f64x2.ge (f64x2.sub (local.get $va) (local.get $vstep)) (v128.const f64x2 0.5 0.5)))
                        (f64x2.lt (local.get $va) (local.get $vthr))))
                      (if (v128.any_true (f64x2.ge (local.get $vcoef) (v128.const f64x2 4096 4096))) (then (if (i32.eqz (local.get $ext)) (then (return (i32.const 1)))) (local.set $wide (i32.const 1))))
                      (local.set $vcoef (i32x4.trunc_sat_f64x2_s_zero (local.get $vcoef)))
                      (local.set $at1 (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2))))
                      (local.set $q (i32x4.extract_lane 0 (local.get $vcoef)))
                      (i32.store (local.get $at1) (select (i32.sub (i32.const 0) (local.get $q)) (local.get $q) (f64.lt (f64x2.extract_lane 0 (local.get $vval)) (f64.const 0))))
                      (local.set $q (i32x4.extract_lane 1 (local.get $vcoef)))
                      (i32.store offset=4 (local.get $at1) (select (i32.sub (i32.const 0) (local.get $q)) (local.get $q) (f64.lt (f64x2.extract_lane 1 (local.get $vval)) (f64.const 0))))))))
              (local.set $pos (i32.add (local.get $pos) (i32.const 2)))
              (br_if $contig (i32.lt_u (local.get $pos) (local.get $size))))
            (return (select (i32.const 2) (i32.const 0) (local.get $wide)))))))
    (local.set $k (local.get $area))
    (block $pairDone
      (loop $pair
        (br_if $pairDone (i32.gt_u (i32.add (local.get $k) (i32.const 2)) (local.get $size)))
        (local.set $at (i32.add (local.get $order) (i32.shl (local.get $k) (i32.const 2))))
        (local.set $pos (i32.load (local.get $at)))
        (local.set $pos1 (i32.load offset=4 (local.get $at)))
        (local.set $at (i32.shl (local.get $pos) (i32.const 3)))
        (local.set $at1 (i32.shl (local.get $pos1) (i32.const 3)))
        (local.set $vstep (v128.load64_lane 1 (i32.add (local.get $steps) (local.get $at1)) (v128.load64_zero (i32.add (local.get $steps) (local.get $at)))))
        (local.set $vcoef (v128.load64_lane 1 (i32.add (local.get $tr) (local.get $at1)) (v128.load64_zero (i32.add (local.get $tr) (local.get $at)))))
        (if (local.get $luma)
          (then (local.set $vcoef (f64x2.sub (local.get $vcoef) (f64x2.mul (local.get $vfc)
            (v128.load64_lane 1 (i32.add (local.get $luma) (local.get $at1)) (v128.load64_zero (i32.add (local.get $luma) (local.get $at)))))))))
        (if (i32.and (local.get $fastZero) (i64x2.all_true (f64x2.lt (f64x2.mul (f64x2.abs (local.get $vcoef)) (local.get $vscale)) (f64x2.mul (local.get $vstep) (local.get $vminThr)))))
          (then
            (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2))) (i32.const 0))
            (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos1) (i32.const 2))) (i32.const 0)))
          (else
            (local.set $vval (f64x2.mul (f64x2.div (f64x2.mul (f64x2.mul (local.get $vcoef) (v128.const f64x2 8 8)) (v128.const f64x2 256 256)) (local.get $vstep)) (local.get $vfine)))
            (local.set $va (f64x2.abs (local.get $vval)))
            (local.set $vthr (if (result v128) (local.get $sameDz)
              (then (local.get $vlo))
              (else (f64x2.replace_lane 1
                (f64x2.splat (select (local.get $hi) (local.get $lo) (i32.load8_u (i32.add (local.get $high) (local.get $pos)))))
                (select (local.get $hi) (local.get $lo) (i32.load8_u (i32.add (local.get $high) (local.get $pos1))))))))
            (if (i64x2.all_true (f64x2.lt (local.get $va) (local.get $vthr)))
              (then
                (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2))) (i32.const 0))
                (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos1) (i32.const 2))) (i32.const 0)))
              (else
                (local.set $vstep (f64x2.floor (local.get $va)))
                (local.set $vcoef (v128.andnot
                  (v128.bitselect (f64x2.add (local.get $vstep) (v128.const f64x2 1 1)) (local.get $vstep)
                    (f64x2.ge (f64x2.sub (local.get $va) (local.get $vstep)) (v128.const f64x2 0.5 0.5)))
                  (f64x2.lt (local.get $va) (local.get $vthr))))
                (if (v128.any_true (f64x2.ge (local.get $vcoef) (v128.const f64x2 4096 4096))) (then (if (i32.eqz (local.get $ext)) (then (return (i32.const 1)))) (local.set $wide (i32.const 1))))
                (local.set $vcoef (i32x4.trunc_sat_f64x2_s_zero (local.get $vcoef)))
                (local.set $q (i32x4.extract_lane 0 (local.get $vcoef)))
                (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2)))
                  (select (i32.sub (i32.const 0) (local.get $q)) (local.get $q) (f64.lt (f64x2.extract_lane 0 (local.get $vval)) (f64.const 0))))
                (local.set $q (i32x4.extract_lane 1 (local.get $vcoef)))
                (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos1) (i32.const 2)))
                  (select (i32.sub (i32.const 0) (local.get $q)) (local.get $q) (f64.lt (f64x2.extract_lane 1 (local.get $vval)) (f64.const 0))))))))
        (local.set $k (i32.add (local.get $k) (i32.const 2)))
        (br $pair)))
    (if (i32.lt_u (local.get $k) (local.get $size))
      (then
        (local.set $pos (i32.load (i32.add (local.get $order) (i32.shl (local.get $k) (i32.const 2)))))
        (local.set $at (i32.shl (local.get $pos) (i32.const 3)))
        (local.set $step (f64.load (i32.add (local.get $steps) (local.get $at))))
        (local.set $coef (f64.sub (f64.load (i32.add (local.get $tr) (local.get $at)))
          (if (result f64) (local.get $luma) (then (f64.mul (local.get $fc) (f64.load (i32.add (local.get $luma) (local.get $at))))) (else (f64.const 0)))))
        (local.set $val (f64.mul (f64.div (f64.mul (f64.mul (local.get $coef) (f64.const 8)) (f64.const 256)) (local.get $step)) (local.get $fine)))
        (local.set $a (f64.abs (local.get $val)))
        (if (f64.lt (local.get $a) (select (local.get $hi) (local.get $lo) (i32.load8_u (i32.add (local.get $high) (local.get $pos)))))
          (then (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2))) (i32.const 0)))
          (else
            (local.set $fl (f64.floor (local.get $a)))
            (local.set $qf (select (f64.add (local.get $fl) (f64.const 1)) (local.get $fl) (f64.ge (f64.sub (local.get $a) (local.get $fl)) (f64.const 0.5))))
            (if (f64.ge (local.get $qf) (f64.const 4096)) (then (if (i32.eqz (local.get $ext)) (then (return (i32.const 1)))) (local.set $wide (i32.const 1))))
            (local.set $q (i32.trunc_sat_f64_s (local.get $qf)))
            (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2)))
              (select (i32.sub (i32.const 0) (local.get $q)) (local.get $q) (f64.lt (local.get $val) (f64.const 0))))))))
    (select (i32.const 2) (i32.const 0) (local.get $wide)))
  ;; One channel's priced levels (varblocks.mjs full(), the priced loop), every f64 operation the JavaScript's in its order:
  ;; positions area..size-1 in `order` (i32), the coefficient less `fc` times luma's (luma 0: the luma channel, less 0),
  ;; v = coefficient * 8 * 256 / step * fine, the dead zone lo or hi by `high` (u8), Math.round as floor plus one at a
  ;; remainder of at least one half, the error against the reconstruction (0; `one`; m - 0.145 / m), weighted by
  ;; `detail` where a level is zero (1 without masking), and R += rc1 + rc2 * log2(level) from the table at `log2`.
  ;; Writes the signed levels (i32) at `levels`, and at `out`: d, R (f64), zeros (i32, the run sums), the nonzero count.
  ;; Returns 0, or 1 when a level reaches 4096 (outside the tables; the caller prices the block itself).
  (func $vbQuant (export "vbQuant") (param $tr i32) (param $luma i32) (param $order i32) (param $steps i32) (param $high i32)
    (param $area i32) (param $size i32) (param $levels i32) (param $log2 i32) (param $fc f64) (param $lo f64) (param $hi f64)
    (param $fine f64) (param $unit f64) (param $one f64) (param $detail f64) (param $rc1 f64) (param $rc2 f64) (param $R f64) (param $out i32) (result i32)
    (local $k i32) (local $pos i32) (local $pos1 i32) (local $step f64) (local $coef f64) (local $val f64) (local $a f64) (local $fl f64) (local $q i32)
    (local $qf f64) (local $rec f64) (local $e f64) (local $term f64) (local $d f64) (local $nz i32) (local $zeros i32) (local $run i32) (local $at i32)
    (local $at1 i32) (local $ext i32) (local $weights i32) (local $wide i32)
    (local $vfc v128) (local $vfine v128) (local $vcoef v128) (local $vstep v128) (local $vval v128) (local $va v128) (local $vthr v128)
    (local $vfl v128) (local $vqf v128) (local $vq v128) (local $vunit v128) (local $vdet v128) (local $ve v128) (local $lim i32)
    (if (i32.and (local.get $size) (i32.const 0x40000000)) (then
      (local.set $ext (i32.const 1))
      (local.set $size (i32.and (local.get $size) (i32.const 0x3fffffff)))
      (if (local.get $out) (then (local.set $weights (i32.load offset=24 (local.get $out)))))))
    ;; A dead zone under one half zeroes nothing rounding does not (|v| < 1/2 rounds to 0, priced alike): from one half,
    ;; a coefficient at or past it has a level of 1 or more, and one under it is 0 with no rounding to make.
    (local.set $lo (f64.max (local.get $lo) (f64.const 0.5)))
    (local.set $hi (f64.max (local.get $hi) (f64.const 0.5)))
    (local.set $k (local.get $area))
    ;; Unpriced (`out` 0): the levels alone, two coefficients at a time. Extended (`size` bit 30): no level stops the
    ;; call, and 2 says one reached 4096; otherwise one that does returns 1.
    (if (i32.eqz (local.get $out))
      (then (return (call $vbQuantPlain (local.get $tr) (local.get $luma) (local.get $order) (local.get $steps) (local.get $high)
        (local.get $area) (local.get $size) (local.get $levels) (local.get $fc) (local.get $lo) (local.get $hi) (local.get $fine) (local.get $ext)))))
    ;; Priced: [d, R, zeros, nonzeros] to `out` (with `out` + 24 a weights table or 0, and the extended call's count of
    ;; levels from 4096 at `out` + 28, those levels from `out` + 32: their rate is the caller's).
    (local.set $vfc (f64x2.splat (local.get $fc)))
    (local.set $vfine (f64x2.splat (local.get $fine)))
    (local.set $vunit (f64x2.splat (local.get $unit)))
    (local.set $vdet (f64x2.splat (local.get $detail)))
    (block $done
      (br_if $done (i32.ge_u (local.get $k) (local.get $size)))
      (loop $ks
        ;; Two at a time while both are under the dead zone (the same terms, added in order); a pair with a level takes
        ;; the one-at-a-time body below for each.
        (local.set $lim (select (i32.add (local.get $k) (i32.const 2)) (local.get $size)
          (i32.le_u (i32.add (local.get $k) (i32.const 2)) (local.get $size))))
        (local.set $at (i32.add (local.get $order) (i32.shl (local.get $k) (i32.const 2))))
        (local.set $pos (i32.load (local.get $at)))
        ;; The final odd coefficient fills both lanes, with only the first lane priced.
        (local.set $pos1 (if (result i32) (i32.lt_u (i32.add (local.get $k) (i32.const 1)) (local.get $size))
          (then (i32.load offset=4 (local.get $at))) (else (local.get $pos))))
        (local.set $at (i32.shl (local.get $pos) (i32.const 3)))
        (local.set $at1 (i32.shl (local.get $pos1) (i32.const 3)))
        (local.set $vstep (v128.load64_lane 1 (i32.add (local.get $steps) (local.get $at1)) (v128.load64_zero (i32.add (local.get $steps) (local.get $at)))))
        (local.set $vcoef (v128.load64_lane 1 (i32.add (local.get $tr) (local.get $at1)) (v128.load64_zero (i32.add (local.get $tr) (local.get $at)))))
        (if (local.get $luma)
          (then (local.set $vcoef (f64x2.sub (local.get $vcoef) (f64x2.mul (local.get $vfc)
            (v128.load64_lane 1 (i32.add (local.get $luma) (local.get $at1)) (v128.load64_zero (i32.add (local.get $luma) (local.get $at)))))))))
        (local.set $vval (f64x2.mul (f64x2.div (f64x2.mul (f64x2.mul (local.get $vcoef) (v128.const f64x2 8 8)) (v128.const f64x2 256 256)) (local.get $vstep)) (local.get $vfine)))
        (local.set $va (f64x2.abs (local.get $vval)))
        (local.set $vthr (f64x2.replace_lane 1
          (f64x2.splat (select (local.get $hi) (local.get $lo) (i32.load8_u (i32.add (local.get $high) (local.get $pos)))))
          (select (local.get $hi) (local.get $lo) (i32.load8_u (i32.add (local.get $high) (local.get $pos1))))))
        (if (i64x2.all_true (f64x2.lt (local.get $va) (local.get $vthr)))
          (then
            (if (local.get $levels) (then
              (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2))) (i32.const 0))
              (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos1) (i32.const 2))) (i32.const 0))))
            (local.set $ve (f64x2.div (f64x2.mul (local.get $va) (local.get $vstep)) (local.get $vunit)))
            (local.set $ve (f64x2.mul (f64x2.mul (local.get $ve) (local.get $ve)) (local.get $vdet)))
            (if (local.get $weights) (then
              (local.set $ve (f64x2.mul (local.get $ve) (v128.load64_lane 1 (i32.add (local.get $weights) (local.get $at1))
                (v128.load64_zero (i32.add (local.get $weights) (local.get $at))))))))
            (local.set $d (f64.add (local.get $d) (f64x2.extract_lane 0 (local.get $ve))))
            (if (i32.eq (i32.sub (local.get $lim) (local.get $k)) (i32.const 2))
              (then (local.set $d (f64.add (local.get $d) (f64x2.extract_lane 1 (local.get $ve))))))
            (local.set $run (i32.add (local.get $run) (i32.sub (local.get $lim) (local.get $k))))
            (local.set $k (local.get $lim))
            (br_if $ks (i32.lt_u (local.get $k) (local.get $size)))
            (br $done)))
        ;; The pair's values are already evaluated. Price each lane without another load or division.
        (local.set $step (f64x2.extract_lane 0 (local.get $vstep)))
        (local.set $val (f64x2.extract_lane 0 (local.get $vval)))
        (local.set $a (f64x2.extract_lane 0 (local.get $va)))
        (loop $one
        (if (f64.lt (local.get $a) (select (local.get $hi) (local.get $lo) (i32.load8_u (i32.add (local.get $high) (local.get $pos)))))
          (then
            ;; Under the dead zone: level 0, its whole value the error (the same steps as a level 0 below).
            (if (local.get $levels) (then (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2))) (i32.const 0))))
            (local.set $e (f64.div (f64.mul (local.get $a) (local.get $step)) (local.get $unit)))
            (local.set $term (f64.mul (f64.mul (local.get $e) (local.get $e)) (local.get $detail)))
            (if (local.get $weights) (then
              (local.set $term (f64.mul (local.get $term) (f64.load (i32.add (local.get $weights) (local.get $at)))))))
            (local.set $d (f64.add (local.get $d) (local.get $term)))
            (local.set $run (i32.add (local.get $run) (i32.const 1))))
          (else
            (local.set $fl (f64.floor (local.get $a)))
            (local.set $qf (select (f64.add (local.get $fl) (f64.const 1)) (local.get $fl) (f64.ge (f64.sub (local.get $a) (local.get $fl)) (f64.const 0.5))))
            (if (i32.and (i32.eqz (local.get $ext)) (f64.ge (local.get $qf) (f64.const 4096))) (then (return (i32.const 1))))
            (local.set $q (i32.trunc_sat_f64_s (local.get $qf)))
            (if (local.get $levels) (then (i32.store (i32.add (local.get $levels) (i32.shl (local.get $pos) (i32.const 2)))
              (select (i32.sub (i32.const 0) (local.get $q)) (local.get $q) (f64.lt (local.get $val) (f64.const 0))))))
            (local.set $rec (if (result f64) (i32.le_u (local.get $q) (i32.const 1))
              (then (select (local.get $one) (f64.const 0) (local.get $q)))
              (else (f64.sub (local.get $qf) (f64.div (f64.const 0.145) (local.get $qf))))))
            (local.set $e (f64.div (f64.mul (f64.sub (local.get $a) (local.get $rec)) (local.get $step)) (local.get $unit)))
            (local.set $term (f64.mul (f64.mul (local.get $e) (local.get $e))
              (select (local.get $detail) (f64.const 1) (i32.eqz (local.get $q)))))
            (if (local.get $weights) (then
              (local.set $term (f64.mul (local.get $term) (f64.load (i32.add (local.get $weights) (local.get $at)))))))
            (local.set $d (f64.add (local.get $d) (local.get $term)))
            (if (local.get $q)
              (then
                (local.set $nz (i32.add (local.get $nz) (i32.const 1)))
                (if (i32.lt_u (local.get $q) (i32.const 4096))
                  (then
                    (local.set $R (f64.add (local.get $R) (f64.add (local.get $rc1) (f64.mul (local.get $rc2)
                      (f64.load (i32.add (local.get $log2) (i32.shl (local.get $q) (i32.const 3)))))))))
                  (else
                    (local.set $R (f64.add (local.get $R) (local.get $rc1)))
                    (i32.store (i32.add (local.get $out) (i32.add (i32.const 32) (i32.shl (local.get $wide) (i32.const 2)))) (local.get $q))
                    (local.set $wide (i32.add (local.get $wide) (i32.const 1)))))
                (local.set $zeros (i32.add (local.get $zeros) (local.get $run)))
                (local.set $run (i32.const 0)))
              (else (local.set $run (i32.add (local.get $run) (i32.const 1)))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (if (i32.lt_u (local.get $k) (local.get $lim))
          (then
            (local.set $pos (local.get $pos1))
            (local.set $at (local.get $at1))
            (local.set $step (f64x2.extract_lane 1 (local.get $vstep)))
            (local.set $val (f64x2.extract_lane 1 (local.get $vval)))
            (local.set $a (f64x2.extract_lane 1 (local.get $va)))
            (br $one))))
        (br_if $ks (i32.lt_u (local.get $k) (local.get $size)))))
    (f64.store (local.get $out) (local.get $d))
    (f64.store offset=8 (local.get $out) (local.get $R))
    (i32.store offset=16 (local.get $out) (local.get $zeros))
    (i32.store offset=20 (local.get $out) (local.get $nz))
    (if (local.get $ext) (then (i32.store offset=28 (local.get $out) (local.get $wide))))
    (i32.const 0))

  ;; Effort 3's Gaborish picture (photo-xyb.mjs photoXYBSteps' general path from Gaborish planes, kernels.mjs gabBand):
  ;; `tiles` tiles of a chunk's tile row, read from three planes of `rows` x `Wc` f64 samples at `planes` (plane c at
  ;; planes + c * rows * Wc * 8), the tile row's first sample at row `rowOff`, column `colOff`. Each tile, of `bw` x `bh`
  ;; blocks (`bw` 8 but the last tile's `bwLast`), is gathered at `tile` as blocks of three 64-sample channels, transformed
  ;; by $dct, correlated (the luma's AC products summed in block order, as photo-xyb.mjs correlate) into its CfL factors,
  ;; clamp(round(c84 * xy / (yy + 1))), and quantized as quantTile without a field: v = ((t - r * y) + 0) * 256 / q[k]
  ;; (r * y for chroma AC only, r the factor / 84), 0 under the dead zone `thr`, else round(v) within Int16. Math.round is
  ;; floor plus one when the remainder is at least one half. Levels go to `levels` as Int16 blocks, row by row of
  ;; `across` blocks a channel ((c * 8 + by) * across + bx), nonzero AC counts likewise to `counts` (u8), and each tile's
  ;; factors to `cfl` (x) and `cfl` + `tiles` (b) as i8.
  (func $round (param $v f64) (result f64)
    (local $f f64)
    (local.set $f (f64.floor (local.get $v)))
    (select (f64.add (local.get $f) (f64.const 1)) (local.get $f) (f64.ge (f64.sub (local.get $v) (local.get $f)) (f64.const 0.5))))
  (func $cflFactor (param $c84 f64) (param $sum f64) (param $yy f64) (result i32)
    (i32.trunc_sat_f64_s (f64.max (f64.const -128) (f64.min (f64.const 127)
      (call $round (f64.div (f64.mul (local.get $c84) (local.get $sum)) (f64.add (local.get $yy) (f64.const 1))))))))
  (func (export "gabTiles") (param $planes i32) (param $rows i32) (param $Wc i32) (param $rowOff i32) (param $colOff i32)
    (param $tiles i32) (param $bwLast i32) (param $bh i32) (param $tile i32) (param $basis i32) (param $paired i32) (param $scratch i32)
    (param $quant i32) (param $thr i32) (param $c84 f64) (param $levels i32) (param $counts i32) (param $cfl i32) (param $across i32)
    (param $fields i32) (param $fStride i32) (param $by0 i32) (param $bx0 i32)
    (local $t i32) (local $bw i32) (local $n i32) (local $count i32) (local $bx i32) (local $by i32) (local $y i32) (local $c i32)
    (local $k i32) (local $plane i32) (local $src i32) (local $dst i32) (local $at i32) (local $nz i32) (local $fx i32) (local $fb i32)
    (local $yy f64) (local $xy f64) (local $bs f64) (local $l f64) (local $ratio f64) (local $fine f64) (local $out i32)
    (local $luma i32) (local $qt i32) (local $th i32) (local $rv v128) (local $ac v128) (local $nzv v128) (local $vv v128) (local $fv v128) (local $finev v128)
    (local.set $plane (i32.shl (i32.mul (local.get $rows) (local.get $Wc)) (i32.const 3)))
    (local.set $t (i32.const 0))
    (loop $tilesLoop
      (local.set $bw (select (local.get $bwLast) (i32.const 8) (i32.eq (local.get $t) (i32.sub (local.get $tiles) (i32.const 1)))))
      (local.set $count (i32.mul (local.get $bw) (local.get $bh)))
      ;; Gather: block n = by * bw + bx, channel c at n * 1536 + c * 512, row y of eight samples.
      (local.set $by (i32.const 0))
      (loop $gby
        (local.set $bx (i32.const 0))
        (loop $gbx
          (local.set $c (i32.const 0))
          (loop $gc
            (local.set $y (i32.const 0))
            (loop $gy
