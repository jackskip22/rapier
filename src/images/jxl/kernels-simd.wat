        (local.set $d (f64.promote_f32 (f32.load (i32.add (local.get $d1) (i32.shl (i32.and (i32.add (i32.add (local.get $ox) (local.get $col)) (i32.const 23)) (i32.const 31)) (i32.const 2))))))
        (if (local.get $gamma)
          (then (i32.store8 offset=1 (local.get $o) (call $nByteOf (local.get $v) (local.get $d))))
          (else
            (local.set $byte (f64.const -1))
            (if (i32.and (f64.gt (local.get $v) (local.get $low64)) (f64.lt (local.get $v) (f64.const 1)))
              (then
                (local.set $at (i32.add (local.get $knots)
                  (i32.shl (i32.shr_u (i32.sub (i32.load (i32.add (local.get $at0) (local.get $plane))) (local.get $low)) (i32.const 13)) (i32.const 3))))
                (local.set $u (f64.add (f64.mul (f64.const 255) (f64.add (f64.load (i32.add (local.get $at) (local.get $rk)))
                  (f64.mul (f64.sub (local.get $v) (f64.load (local.get $at))) (f64.load (i32.add (local.get $at) (local.get $sk))))))
                  (local.get $d)))
                (local.set $lo (f64.sub (local.get $u) (f64.const 0x1p-12)))
                (local.set $lo (select (f64.const 0) (select (f64.const 255) (local.get $lo) (f64.gt (local.get $lo) (f64.const 255))) (f64.lt (local.get $lo) (f64.const 0))))
                (local.set $hi (f64.add (local.get $u) (f64.const 0x1p-12)))
                (local.set $hi (select (f64.const 0) (select (f64.const 255) (local.get $hi) (f64.gt (local.get $hi) (f64.const 255))) (f64.lt (local.get $hi) (f64.const 0))))
                (local.set $r (f64.floor (local.get $lo)))
                (local.set $r (f64.add (local.get $r) (f64.convert_i32_u (f64.ge (f64.sub (local.get $lo) (local.get $r)) (f64.const 0.5)))))
                (local.set $q (f64.floor (local.get $hi)))
                (local.set $q (f64.add (local.get $q) (f64.convert_i32_u (f64.ge (f64.sub (local.get $hi) (local.get $q)) (f64.const 0.5)))))
                (if (f64.eq (local.get $r) (local.get $q)) (then (local.set $byte (local.get $r))))))
