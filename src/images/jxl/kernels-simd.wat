            (v128.load (i32.sub (i32.add (local.get $m) (local.get $x)) (i32.const 8))))
            (v128.load offset=8 (i32.add (local.get $m) (local.get $x))))))
          (f64x2.mul (local.get $v2) (f64x2.add (f64x2.add (f64x2.add
            (v128.load (i32.sub (i32.add (local.get $u) (local.get $x)) (i32.const 8))) (v128.load offset=8 (i32.add (local.get $u) (local.get $x))))
            (v128.load (i32.sub (i32.add (local.get $d) (local.get $x)) (i32.const 8))))
            (v128.load offset=8 (i32.add (local.get $d) (local.get $x))))))
          (local.get $vn)))
        (local.set $x (i32.add (local.get $x) (i32.const 16)))
        (br_if $xs (i32.lt_u (local.get $x) (local.get $last))))
      ;; x = W - 1: right is the sample itself.
      (local.set $at (i32.add (local.get $m) (local.get $last)))
      (f64.store (i32.add (local.get $o) (local.get $last)) (f64.mul (f64.add (f64.add (f64.load (local.get $at))
        (f64.mul (local.get $w1) (f64.add (f64.add (f64.add
          (f64.load (i32.add (local.get $u) (local.get $last))) (f64.load (i32.add (local.get $d) (local.get $last))))
          (f64.load (i32.sub (local.get $at) (i32.const 8)))) (f64.load (local.get $at)))))
        (f64.mul (local.get $w2) (f64.add (f64.add (f64.add
          (f64.load (i32.sub (i32.add (local.get $u) (local.get $last)) (i32.const 8))) (f64.load (i32.add (local.get $u) (local.get $last))))
          (f64.load (i32.sub (i32.add (local.get $d) (local.get $last)) (i32.const 8)))) (f64.load (i32.add (local.get $d) (local.get $last))))))
        (local.get $norm)))
      ;; Row y - 1 (u) is no longer read: p += orig - G p, from the other half of the ring.
      (if (local.get $y) (then
        (local.set $src (i32.add (local.get $orig) (i32.sub (local.get $u) (local.get $p))))
        (local.set $r (i32.sub (i32.add (local.get $ring) (local.get $row)) (i32.sub (local.get $o) (local.get $ring))))
        (local.set $x (i32.const 0))
        (loop $up
          (v128.store (i32.add (local.get $u) (local.get $x)) (f64x2.add (v128.load (i32.add (local.get $u) (local.get $x)))
            (f64x2.sub (v128.load (i32.add (local.get $src) (local.get $x))) (v128.load (i32.add (local.get $r) (local.get $x))))))
          (local.set $x (i32.add (local.get $x) (i32.const 16)))
          (br_if $up (i32.lt_u (local.get $x) (local.get $row))))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (local.get $H))))
    ;; The last row.
    (local.set $at (i32.add (local.get $p) (i32.mul (i32.sub (local.get $H) (i32.const 1)) (local.get $row))))
    (local.set $src (i32.add (local.get $orig) (i32.sub (local.get $at) (local.get $p))))
    (local.set $r (i32.add (local.get $ring) (i32.mul (i32.and (i32.sub (local.get $H) (i32.const 1)) (i32.const 1)) (local.get $row))))
    (local.set $x (i32.const 0))
    (loop $up
      (v128.store (i32.add (local.get $at) (local.get $x)) (f64x2.add (v128.load (i32.add (local.get $at) (local.get $x)))
        (f64x2.sub (v128.load (i32.add (local.get $src) (local.get $x))) (v128.load (i32.add (local.get $r) (local.get $x))))))
      (local.set $x (i32.add (local.get $x) (i32.const 16)))
      (br_if $up (i32.lt_u (local.get $x) (local.get $row)))))

  ;; A strategy image's AC group in vardct.mjs walkACGroup's order: for each block channel (records of 11 i32 at `recs`:
  ;; size, area, bw, bh, bx, by in the group, levels at, order at (bytes), block context, zero-density offset, channel)
  ;; the nonzero count and its context, then each coefficient's token up to the last nonzero. `tables`: 64 i32 of
  ;; COEFF_NUM_NONZERO_CONTEXT then 64 of COEFF_FREQ_CONTEXT; `nz`: three 32 x 32 i32 rows of block averages. Writes the
  ;; contexts and values (i32) at `ctxs` and `vals`; returns their count.
  (func (export "sgFill") (param $recs i32) (param $count i32) (param $numCtxs i32) (param $tables i32) (param $nz i32)
    (param $ctxs i32) (param $vals i32) (result i32)
    (local $r i32) (local $rec i32) (local $size i32) (local $area i32) (local $bw i32) (local $bh i32) (local $bx i32) (local $by i32)
    (local $lv i32) (local $ord i32) (local $ctx i32) (local $zd i32) (local $row i32) (local $k i32) (local $n i32) (local $cnt i32)
    (local $pred i32) (local $avg i32) (local $x i32) (local $y i32) (local $left i32) (local $prev i32) (local $q i32) (local $cap i32)
    (block $done (loop $records
      (br_if $done (i32.ge_u (local.get $r) (local.get $count)))
      (local.set $rec (i32.add (local.get $recs) (i32.mul (local.get $r) (i32.const 44))))
      (local.set $size (i32.load (local.get $rec))) (local.set $area (i32.load offset=4 (local.get $rec)))
      (local.set $bw (i32.load offset=8 (local.get $rec))) (local.set $bh (i32.load offset=12 (local.get $rec)))
      (local.set $bx (i32.load offset=16 (local.get $rec))) (local.set $by (i32.load offset=20 (local.get $rec)))
      (local.set $lv (i32.load offset=24 (local.get $rec))) (local.set $ord (i32.load offset=28 (local.get $rec)))
      (local.set $ctx (i32.load offset=32 (local.get $rec))) (local.set $zd (i32.load offset=36 (local.get $rec)))
      (local.set $row (i32.add (local.get $nz) (i32.shl (i32.load offset=40 (local.get $rec)) (i32.const 12))))
      ;; The nonzero count over positions area..size - 1 of the order.
      (local.set $cnt (i32.const 0))
      (local.set $k (local.get $area))
      (block $c0 (loop $c1
        (br_if $c0 (i32.ge_u (local.get $k) (local.get $size)))
        (if (i32.load (i32.add (local.get $lv) (i32.shl (i32.load (i32.add (local.get $ord) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 2))))
          (then (local.set $cnt (i32.add (local.get $cnt) (i32.const 1)))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $c1)))
      ;; The prediction from the block's left and upper neighbours in this group.
      (local.set $pred
        (if (result i32) (i32.eqz (local.get $bx))
          (then (if (result i32) (i32.eqz (local.get $by)) (then (i32.const 32))
            (else (i32.load (i32.add (local.get $row) (i32.shl (i32.mul (i32.sub (local.get $by) (i32.const 1)) (i32.const 32)) (i32.const 2)))))))
          (else (if (result i32) (i32.eqz (local.get $by))
            (then (i32.load (i32.add (local.get $row) (i32.shl (i32.sub (local.get $bx) (i32.const 1)) (i32.const 2)))))
            (else (i32.shr_u (i32.add (i32.add
              (i32.load (i32.add (local.get $row) (i32.shl (i32.add (i32.mul (i32.sub (local.get $by) (i32.const 1)) (i32.const 32)) (local.get $bx)) (i32.const 2))))
              (i32.load (i32.add (local.get $row) (i32.shl (i32.sub (i32.add (i32.mul (local.get $by) (i32.const 32)) (local.get $bx)) (i32.const 1)) (i32.const 2)))))
              (i32.const 1)) (i32.const 1)))))))
      (local.set $avg (i32.div_u (i32.sub (i32.add (local.get $cnt) (local.get $area)) (i32.const 1)) (local.get $area)))
      (local.set $y (i32.const 0))
      (loop $fy
        (local.set $x (i32.const 0))
        (loop $fx
          (i32.store (i32.add (local.get $row) (i32.shl (i32.add (i32.mul (i32.add (local.get $by) (local.get $y)) (i32.const 32)) (i32.add (local.get $bx) (local.get $x))) (i32.const 2))) (local.get $avg))
          (local.set $x (i32.add (local.get $x) (i32.const 1)))
          (br_if $fx (i32.lt_u (local.get $x) (local.get $bw))))
        (local.set $y (i32.add (local.get $y) (i32.const 1)))
        (br_if $fy (i32.lt_u (local.get $y) (local.get $bh))))
      (local.set $cap (select (local.get $pred) (i32.const 64) (i32.lt_s (local.get $pred) (i32.const 64))))
      (i32.store (i32.add (local.get $ctxs) (i32.shl (local.get $n) (i32.const 2)))
        (i32.add (i32.mul (select (local.get $cap) (i32.add (i32.const 4) (i32.shr_s (local.get $cap) (i32.const 1))) (i32.lt_s (local.get $cap) (i32.const 8))) (local.get $numCtxs)) (local.get $ctx)))
      (i32.store (i32.add (local.get $vals) (i32.shl (local.get $n) (i32.const 2))) (local.get $cnt))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      ;; Each coefficient up to the last nonzero: its zero-density context and packed value.
      (local.set $prev (i32.le_u (local.get $cnt) (i32.shr_u (local.get $size) (i32.const 4))))
      (local.set $left (local.get $cnt))
      (local.set $k (local.get $area))
      (block $t0 (loop $t1
        (br_if $t0 (i32.or (i32.ge_u (local.get $k) (local.get $size)) (i32.eqz (local.get $left))))
        (local.set $q (i32.load (i32.add (local.get $lv) (i32.shl (i32.load (i32.add (local.get $ord) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 2)))))
        (i32.store (i32.add (local.get $ctxs) (i32.shl (local.get $n) (i32.const 2)))
          (i32.add (local.get $zd) (i32.add (local.get $prev) (i32.shl (i32.add
            (i32.load (i32.add (local.get $tables) (i32.shl (i32.div_u (i32.sub (i32.add (local.get $left) (local.get $area)) (i32.const 1)) (local.get $area)) (i32.const 2))))
            (i32.load offset=256 (i32.add (local.get $tables) (i32.shl (i32.div_u (local.get $k) (local.get $area)) (i32.const 2))))) (i32.const 1)))))
        (i32.store (i32.add (local.get $vals) (i32.shl (local.get $n) (i32.const 2)))
          (select (i32.shl (local.get $q) (i32.const 1)) (i32.sub (i32.mul (local.get $q) (i32.const -2)) (i32.const 1)) (i32.ge_s (local.get $q) (i32.const 0))))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $prev (i32.ne (local.get $q) (i32.const 0)))
        (local.set $left (i32.sub (local.get $left) (local.get $prev)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $t1)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $records)))
    (local.get $n))

  ;; Rows of photo-xyb.mjs xybPlanes (sRGB, no profile): each pixel's X, Y and B - Y samples by the same expressions in
  ;; the same order (linear light from `lin`, three cone mixes from `mix` (nine f64) plus `bias`, each cube root seeded
  ;; from `roots` at 4096 v and refined twice, less `rootBias`), memoized per color in a direct-mapped table (`keys`
  ;; i32 and `vals` 3 f64 a slot, 2^17 slots). `rows` rows of `width` pixels at `rgba`; each output row is W samples
  ;; (the last pixel repeated to W) at `out` + c * rows * W * 8.
  (func $xybRoot (param $roots i32) (param $v f64) (result f64)
    (local $scaled f64) (local $at i32) (local $r f64) (local $p i32)
    (local.set $scaled (f64.mul (local.get $v) (f64.const 4096)))
    (local.set $at (i32.trunc_f64_s (f64.floor (local.get $scaled))))
    (local.set $p (i32.add (local.get $roots) (i32.shl (local.get $at) (i32.const 3))))
    (local.set $r (f64.add (f64.load (local.get $p)) (f64.mul (f64.sub (f64.load offset=8 (local.get $p)) (f64.load (local.get $p)))
      (f64.sub (local.get $scaled) (f64.convert_i32_s (local.get $at))))))
    (local.set $r (f64.div (f64.add (f64.mul (f64.const 2) (local.get $r)) (f64.div (local.get $v) (f64.mul (local.get $r) (local.get $r)))) (f64.const 3)))
    (f64.div (f64.add (f64.mul (f64.const 2) (local.get $r)) (f64.div (local.get $v) (f64.mul (local.get $r) (local.get $r)))) (f64.const 3)))
  (func (export "xybRows") (param $rgba i32) (param $width i32) (param $rows i32) (param $W i32) (param $roots i32) (param $lin i32)
    (param $mix i32) (param $bias f64) (param $rootBias f64) (param $keys i32) (param $vals i32) (param $out i32)
    (local $y i32) (local $x i32) (local $at i32) (local $key i32) (local $slot i32) (local $v i32) (local $o i32) (local $plane i32)
    (local $r f64) (local $g f64) (local $b f64) (local $l f64) (local $m f64) (local $s f64) (local $luma f64)
    (local.set $plane (i32.shl (i32.mul (local.get $rows) (local.get $W)) (i32.const 3)))
    (local.set $y (i32.const 0))
    (block $done (loop $ys
      (br_if $done (i32.ge_u (local.get $y) (local.get $rows)))
      (local.set $x (i32.const 0))
      (loop $xs
        (local.set $at (i32.add (local.get $rgba) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 2))))
        (local.set $key (i32.or (i32.or (i32.shl (i32.load8_u (local.get $at)) (i32.const 16)) (i32.shl (i32.load8_u offset=1 (local.get $at)) (i32.const 8))) (i32.load8_u offset=2 (local.get $at))))
        (local.set $slot (i32.shr_u (i32.mul (local.get $key) (i32.const 0x9e3779b1)) (i32.const 15)))
        (local.set $v (i32.add (local.get $vals) (i32.mul (local.get $slot) (i32.const 24))))
        (if (i32.ne (i32.load (i32.add (local.get $keys) (i32.shl (local.get $slot) (i32.const 2)))) (local.get $key)) (then
          (local.set $r (f64.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (local.get $at)) (i32.const 3)))))
          (local.set $g (f64.load (i32.add (local.get $lin) (i32.shl (i32.load8_u offset=1 (local.get $at)) (i32.const 3)))))
          (local.set $b (f64.load (i32.add (local.get $lin) (i32.shl (i32.load8_u offset=2 (local.get $at)) (i32.const 3)))))
          (local.set $l (f64.sub (call $xybRoot (local.get $roots) (f64.add (f64.add (f64.add
            (f64.mul (f64.load (local.get $mix)) (local.get $r)) (f64.mul (f64.load offset=8 (local.get $mix)) (local.get $g)))
            (f64.mul (f64.load offset=16 (local.get $mix)) (local.get $b))) (local.get $bias))) (local.get $rootBias)))
          (local.set $m (f64.sub (call $xybRoot (local.get $roots) (f64.add (f64.add (f64.add
            (f64.mul (f64.load offset=24 (local.get $mix)) (local.get $r)) (f64.mul (f64.load offset=32 (local.get $mix)) (local.get $g)))
            (f64.mul (f64.load offset=40 (local.get $mix)) (local.get $b))) (local.get $bias))) (local.get $rootBias)))
          (local.set $s (f64.sub (call $xybRoot (local.get $roots) (f64.add (f64.add (f64.add
            (f64.mul (f64.load offset=48 (local.get $mix)) (local.get $r)) (f64.mul (f64.load offset=56 (local.get $mix)) (local.get $g)))
            (f64.mul (f64.load offset=64 (local.get $mix)) (local.get $b))) (local.get $bias))) (local.get $rootBias)))
          (local.set $luma (f64.mul (f64.add (local.get $l) (local.get $m)) (f64.const 127.5)))
          (i32.store (i32.add (local.get $keys) (i32.shl (local.get $slot) (i32.const 2))) (local.get $key))
          (f64.store (local.get $v) (f64.mul (f64.sub (local.get $l) (local.get $m)) (f64.const 127.5)))
          (f64.store offset=8 (local.get $v) (local.get $luma))
          (f64.store offset=16 (local.get $v) (f64.sub (f64.mul (local.get $s) (f64.const 255)) (local.get $luma)))))
        (local.set $o (i32.add (local.get $out) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $W)) (local.get $x)) (i32.const 3))))
        (f64.store (local.get $o) (f64.load (local.get $v)))
        (f64.store (i32.add (local.get $o) (local.get $plane)) (f64.load offset=8 (local.get $v)))
        (f64.store (i32.add (local.get $o) (i32.shl (local.get $plane) (i32.const 1))) (f64.load offset=16 (local.get $v)))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $xs (i32.lt_u (local.get $x) (local.get $width))))
      ;; The row's padding repeats its last sample.
      (local.set $o (i32.add (local.get $out) (i32.shl (i32.sub (i32.add (i32.mul (local.get $y) (local.get $W)) (local.get $width)) (i32.const 1)) (i32.const 3))))
      (local.set $x (local.get $width))
      (block $pd (loop $pads
        (br_if $pd (i32.ge_u (local.get $x) (local.get $W)))
        (f64.store (i32.add (local.get $o) (i32.shl (i32.sub (local.get $x) (i32.sub (local.get $width) (i32.const 1))) (i32.const 3))) (f64.load (local.get $o)))
        (f64.store (i32.add (i32.add (local.get $o) (local.get $plane)) (i32.shl (i32.sub (local.get $x) (i32.sub (local.get $width) (i32.const 1))) (i32.const 3))) (f64.load (i32.add (local.get $o) (local.get $plane))))
        (f64.store (i32.add (i32.add (local.get $o) (i32.shl (local.get $plane) (i32.const 1))) (i32.shl (i32.sub (local.get $x) (i32.sub (local.get $width) (i32.const 1))) (i32.const 3))) (f64.load (i32.add (local.get $o) (i32.shl (local.get $plane) (i32.const 1)))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br $pads)))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $ys))))

;; Effort 3's fast Gaborish picture (photo-xyb.mjs fastGaborish, kernels.mjs gabBand with `fast`): planes of f32 samples.
  ;; fgXyb: the X, Y and B - Y samples in f32, four pixels a lane quad: linear light from `lin` (256 f32), the cone mixes
  ;; (`mix`, 9 f32), the cube roots, X = (l - m) * 127.5, Y = (l + m) * 127.5, B = s * 255 - Y. A row's last quad
  ;; reads its pixels up to the row's last and stores lanes up to W: the padding repeats the last sample. Output as
  ;; xybRows, four bytes a sample.
  ;; The cube roots: each seeded by the bit trick (bits / 3 + 0x2a5137a0, the division in f32) and refined three times,
  ;; r = (2r + v / (r r)) * (1/3), every operation f32; L, M and S step by step together, so their divisions overlap.
  (func (export "fgXyb") (param $rgba i32) (param $width i32) (param $rows i32) (param $W i32) (param $lin i32)
    (param $mix i32) (param $bias f32) (param $rootBias f32) (param $out i32)
    (local $y i32) (local $x i32) (local $row i32) (local $p0 i32) (local $p1 i32) (local $p2 i32) (local $p3 i32) (local $o i32) (local $plane i32)
    (local $last i32) (local $R v128) (local $G v128) (local $B v128) (local $L v128) (local $M v128) (local $S v128) (local $luma v128)
    (local $vb v128) (local $vr v128) (local $vL v128) (local $vM v128) (local $vS v128)
    (local.set $plane (i32.shl (i32.mul (local.get $rows) (local.get $W)) (i32.const 2)))
    (local.set $vb (f32x4.splat (local.get $bias))) (local.set $vr (f32x4.splat (local.get $rootBias)))
    (local.set $y (i32.const 0))
    (block $done (loop $ys
      (br_if $done (i32.ge_u (local.get $y) (local.get $rows)))
      (local.set $row (i32.add (local.get $rgba) (i32.shl (i32.mul (local.get $y) (local.get $width)) (i32.const 2))))
      (local.set $last (i32.add (local.get $row) (i32.shl (i32.sub (local.get $width) (i32.const 1)) (i32.const 2))))
      (local.set $x (i32.const 0))
      (block $xsDone (loop $xs
        (br_if $xsDone (i32.ge_u (local.get $x) (local.get $W)))
        (local.set $p0 (i32.add (local.get $row) (i32.shl (local.get $x) (i32.const 2))))
        (local.set $p0 (select (local.get $p0) (local.get $last) (i32.le_u (local.get $p0) (local.get $last))))
        (local.set $p1 (select (i32.add (local.get $p0) (i32.const 4)) (local.get $last) (i32.lt_u (local.get $p0) (local.get $last))))
        (local.set $p2 (select (i32.add (local.get $p1) (i32.const 4)) (local.get $last) (i32.lt_u (local.get $p1) (local.get $last))))
        (local.set $p3 (select (i32.add (local.get $p2) (i32.const 4)) (local.get $last) (i32.lt_u (local.get $p2) (local.get $last))))
        (local.set $R (f32x4.replace_lane 3 (f32x4.replace_lane 2 (f32x4.replace_lane 1 (v128.load32_splat (i32.add (local.get $lin) (i32.shl (i32.load8_u (local.get $p0)) (i32.const 2)))) (f32.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (local.get $p1)) (i32.const 2))))) (f32.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (local.get $p2)) (i32.const 2))))) (f32.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (local.get $p3)) (i32.const 2))))))
        (local.set $G (f32x4.replace_lane 3 (f32x4.replace_lane 2 (f32x4.replace_lane 1 (v128.load32_splat (i32.add (local.get $lin) (i32.shl (i32.load8_u (i32.add (local.get $p0) (i32.const 1))) (i32.const 2)))) (f32.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (i32.add (local.get $p1) (i32.const 1))) (i32.const 2))))) (f32.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (i32.add (local.get $p2) (i32.const 1))) (i32.const 2))))) (f32.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (i32.add (local.get $p3) (i32.const 1))) (i32.const 2))))))
        (local.set $B (f32x4.replace_lane 3 (f32x4.replace_lane 2 (f32x4.replace_lane 1 (v128.load32_splat (i32.add (local.get $lin) (i32.shl (i32.load8_u (i32.add (local.get $p0) (i32.const 2))) (i32.const 2)))) (f32.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (i32.add (local.get $p1) (i32.const 2))) (i32.const 2))))) (f32.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (i32.add (local.get $p2) (i32.const 2))) (i32.const 2))))) (f32.load (i32.add (local.get $lin) (i32.shl (i32.load8_u (i32.add (local.get $p3) (i32.const 2))) (i32.const 2))))))
        (local.set $vL (f32x4.add (f32x4.add (f32x4.add (f32x4.mul (v128.load32_splat (i32.add (local.get $mix) (i32.const 0))) (local.get $R)) (f32x4.mul (v128.load32_splat offset=4 (i32.add (local.get $mix) (i32.const 0))) (local.get $G))) (f32x4.mul (v128.load32_splat offset=8 (i32.add (local.get $mix) (i32.const 0))) (local.get $B))) (local.get $vb)))
        (local.set $vM (f32x4.add (f32x4.add (f32x4.add (f32x4.mul (v128.load32_splat (i32.add (local.get $mix) (i32.const 12))) (local.get $R)) (f32x4.mul (v128.load32_splat offset=4 (i32.add (local.get $mix) (i32.const 12))) (local.get $G))) (f32x4.mul (v128.load32_splat offset=8 (i32.add (local.get $mix) (i32.const 12))) (local.get $B))) (local.get $vb)))
        (local.set $vS (f32x4.add (f32x4.add (f32x4.add (f32x4.mul (v128.load32_splat (i32.add (local.get $mix) (i32.const 24))) (local.get $R)) (f32x4.mul (v128.load32_splat offset=4 (i32.add (local.get $mix) (i32.const 24))) (local.get $G))) (f32x4.mul (v128.load32_splat offset=8 (i32.add (local.get $mix) (i32.const 24))) (local.get $B))) (local.get $vb)))
        (local.set $L (i32x4.add (i32x4.trunc_sat_f32x4_s (f32x4.mul (f32x4.convert_i32x4_s (local.get $vL)) (v128.const f32x4 0.33333334 0.33333334 0.33333334 0.33333334))) (v128.const i32x4 0x2a5137a0 0x2a5137a0 0x2a5137a0 0x2a5137a0)))
        (local.set $M (i32x4.add (i32x4.trunc_sat_f32x4_s (f32x4.mul (f32x4.convert_i32x4_s (local.get $vM)) (v128.const f32x4 0.33333334 0.33333334 0.33333334 0.33333334))) (v128.const i32x4 0x2a5137a0 0x2a5137a0 0x2a5137a0 0x2a5137a0)))
        (local.set $S (i32x4.add (i32x4.trunc_sat_f32x4_s (f32x4.mul (f32x4.convert_i32x4_s (local.get $vS)) (v128.const f32x4 0.33333334 0.33333334 0.33333334 0.33333334))) (v128.const i32x4 0x2a5137a0 0x2a5137a0 0x2a5137a0 0x2a5137a0)))
        (local.set $L (f32x4.mul (f32x4.add (f32x4.add (local.get $L) (local.get $L)) (f32x4.div (local.get $vL) (f32x4.mul (local.get $L) (local.get $L)))) (v128.const f32x4 0.33333334 0.33333334 0.33333334 0.33333334)))
