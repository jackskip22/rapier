    (v128.store offset=224 (local.get $p) (f32x4.sub (local.get $z11) (local.get $z4))))
  ;; $transpose8: the 8 x 8 f32 block at `b` transposed into `d` (4 x 4 quarters by lane shuffles; d may not be b).
  (func $transpose8 (param $b i32) (param $d i32)
    (local $s i32) (local $t i32) (local $r0 v128) (local $r1 v128) (local $r2 v128) (local $r3 v128) (local $q0 v128) (local $q1 v128) (local $q2 v128) (local $q3 v128)
