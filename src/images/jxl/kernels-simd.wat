    (local.set $plane (i32.shl (i32.mul (local.get $w) (local.get $h)) (i32.const 2)))
    (local.set $plane2 (i32.shl (local.get $plane) (i32.const 1)))
    (local.set $dither (i32.add (local.get $t) (i32.const 96)))
    (local.set $knots (i32.add (local.get $t) (i32.const 4192)))
    (local.set $rk (i32.shl (local.get $k) (i32.const 3)))
    (local.set $sk (i32.shl (local.get $k) (i32.const 4)))
    (local.set $low64 (f64.load offset=80 (local.get $t)))
