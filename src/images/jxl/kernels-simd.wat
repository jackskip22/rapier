                (local.set $v (select (local.get $bh) (local.get $bw) (i32.ge_u (local.get $bw) (local.get $bh))))
                (local.set $sx (i32.add (local.get $jobs) (i32.load offset=48 (local.get $job))))
                (local.set $sy (i32.add (local.get $sx) (i32.shl (local.get $u) (i32.const 3))))
