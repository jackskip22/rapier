  ;; Price-only run of `n` DCT8 blocks from (x, y) (varblock-core.mjs fillPriceRow8): `params` holds 5 f64s per block
  ;; (fcX, fcB, fine, unit, blockMW); `ones` holds 7 f64s (VB_ONE[0..2], norm[0..2], detail); `drOut` receives 2 f64s
  ;; per block (D, R) matching kernelBlock's exact binary64 accumulation order.
  (func (export "vbPriceRow8") (param $pix i32) (param $plane i32) (param $W i32) (param $n i32) (param $bt i32) (param $bb i32)
    (param $tmp i32) (param $tr i32) (param $order i32) (param $steps i32) (param $high i32) (param $log2 i32) (param $params i32)
    (param $dead i32) (param $ones i32) (param $rc0 f64) (param $rc1 f64) (param $rc2 f64) (param $rc3 f64) (param $out i32) (param $drOut i32) (result i32)
    (local $j i32) (local $c i32) (local $k i32) (local $p i32) (local $fc f64) (local $D f64) (local $R f64) (local $mw f64) (local $det f64)
    (local.set $det (f64.load offset=48 (local.get $ones)))
