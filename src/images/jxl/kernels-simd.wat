;; A row's blocks' levels packed as photo-packed-picture.mjs packPlane packs them: `n` blocks from `levels` (i32), block
  ;; b's `sizes`[b] levels a channel, three channels; each channel its nonzero count, then each nonzero's gap from the
  ;; last and its zigzag value, all LEB128. Block b's bytes end at `ends`[b] (from `out`). Returns the bytes written.
  (func $leb (param $at i32) (param $v i32) (result i32)
    (block $done (loop $more
      (br_if $done (i32.lt_u (local.get $v) (i32.const 0x80)))
      (i32.store8 (local.get $at) (i32.or (i32.and (local.get $v) (i32.const 0x7f)) (i32.const 0x80)))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      (local.set $v (i32.shr_u (local.get $v) (i32.const 7)))
      (br $more)))
    (i32.store8 (local.get $at) (local.get $v))
    (i32.add (local.get $at) (i32.const 1)))
  (func (export "vbPack") (param $levels i32) (param $sizes i32) (param $n i32) (param $out i32) (param $ends i32) (result i32)
    (local $b i32) (local $c i32) (local $size i32) (local $p i32) (local $end i32) (local $k i32) (local $q i32) (local $count i32)
    (local $at i32) (local $last i32) (local $v i32) (local $vec v128)
    (local.set $at (local.get $out))
    (block $blocks (loop $each
      (br_if $blocks (i32.ge_u (local.get $b) (local.get $n)))
      (local.set $size (i32.load (i32.add (local.get $sizes) (i32.shl (local.get $b) (i32.const 2)))))
      (local.set $c (i32.const 0))
      (loop $channels
        (local.set $end (i32.add (local.get $levels) (i32.shl (local.get $size) (i32.const 2))))
