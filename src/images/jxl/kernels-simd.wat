  ;; photo-output.mjs encoded: the transfer of one binary32 sample, a binary32 value.
  (func $nEncoded (param $v f64) (param $t i32) (result f64) (local $x f64) (local $p f64) (local $q f64)
    (if (i32.eqz (f64.gt (local.get $v) (f64.const 0))) (then (return (f64.const 0))))
    (if (f64.ge (local.get $v) (f64.const 1)) (then (return (f64.const 1))))
