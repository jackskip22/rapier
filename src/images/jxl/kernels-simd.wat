      (local.set $inv2040 (v128.const f64x2 2040 2040))
      (local.set $i (i32.const 0))
      (loop $d8Blocks
        (local.set $x (i32.rem_u (local.get $i) (local.get $bw)))
        (local.set $y (i32.div_u (local.get $i) (local.get $bw)))
