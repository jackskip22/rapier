                            (local.set $sym (i32.add (local.get $s) (i32.ctz (local.get $mask))))
                            (local.set $mask (i32.and (local.get $mask) (i32.sub (local.get $mask) (i32.const 1))))
                            (local.set $p (i32.shl (local.get $sym) (i32.const 2)))
                            (local.set $v (i32.load (i32.add (local.get $row) (local.get $p))))
                            (local.set $l (i32.load (i32.add (local.get $lo) (local.get $p))))
                            (local.set $h (i32.sub (i32.load (i32.add (local.get $hi) (local.get $p))) (local.get $l)))
                            (local.set $delta (f64x2.add (local.get $delta) (f64x2.sub
