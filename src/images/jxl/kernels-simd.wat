      (f64.store (local.get $o) (f64.mul (f64.add (f64.add (f64.load (local.get $m))
        (f64.mul (local.get $w1) (f64.add (f64.add (f64.add (f64.load (local.get $u)) (f64.load (local.get $d))) (f64.load (local.get $m))) (f64.load offset=8 (local.get $m)))))
        (f64.mul (local.get $w2) (f64.add (f64.add (f64.add (f64.load (local.get $u)) (f64.load offset=8 (local.get $u))) (f64.load (local.get $d))) (f64.load offset=8 (local.get $d)))))
