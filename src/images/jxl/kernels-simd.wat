        (local.set $L (f32x4.mul (f32x4.sub (local.get $L) (local.get $M)) (v128.const f32x4 127.5 127.5 127.5 127.5)))
        (local.set $S (f32x4.sub (f32x4.mul (local.get $S) (v128.const f32x4 255 255 255 255)) (local.get $luma)))
        (local.set $o (i32.add (local.get $out) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $W)) (local.get $x)) (i32.const 2))))
