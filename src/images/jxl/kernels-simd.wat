        (local.set $c2dc (local.get $c2blk))
        (local.set $medge (select (f32.const 145.7) (f32.const 2040.0) (i32.eqz (local.get $c))))
        (local.set $hiO (f32.const 0)) (local.set $hiH (f32.const 0)) (local.set $hiE (f32.const 0))
        (local.set $midO (f32.const 0)) (local.set $midH (f32.const 0)) (local.set $midE (f32.const 0))
