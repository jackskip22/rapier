;; SPDX-License-Identifier: MIT
;; Bounded integer kernels. kernels.mjs checks pointers and lengths.
;; Tiny arithmetic helpers are explicitly inlined: Node 22 does not inline WAT calls
;; by default. i64 multiplication followed by arithmetic >>24 is floor, not truncation.
;; SIMD averages add one to negative sums before >>1, matching JavaScript's /2 |0.
(module
  (import "env" "memory" (memory 1 640))
  (func $residual
    (export "residual")
    (param $p i32)
    (param $w i32)
    (param $h i32)
    (param $pred i32)
    (param $offset i32)
    (param $out i32)
    (local $L v128)
    (local $T v128)
    (local $NW v128)
    (local $V v128)
    (local $S v128)
    (local $x i32)
    (local $y i32)
    (local $row i32)
    (local $left i32)
    (local $top i32)
    (local $nw i32)
    (local $g i32)
    (local $v i32)
    (local.set $row (i32.shl (local.get $w) (i32.const 2)))
    (loop $ys
      (local.set $x (i32.const 0))
      (loop $xs
        (block $next
          (if
            (i32.and
              (i32.and (i32.ne (local.get $y) (i32.const 0)) (i32.ne (local.get $x) (i32.const 0)))
              (i32.and
                (i32.le_u (i32.add (local.get $x) (i32.const 4)) (local.get $w))
                (i32.or (i32.eq (local.get $pred) (i32.const 3)) (i32.eq (local.get $pred) (i32.const 5)))))
            (then
              (local.set $L (v128.load (i32.sub (local.get $p) (i32.const 4))))
              (local.set $T (v128.load (i32.sub (local.get $p) (local.get $row))))
              (local.set $S (i32x4.add (local.get $L) (local.get $T)))
              (if
                (i32.eq (local.get $pred) (i32.const 3))
                (then
                  (local.set $V
                    (i32x4.shr_s
                      (i32x4.add
                        (local.get $S)
                        (v128.and (i32x4.shr_s (local.get $S) (i32.const 31)) (i32x4.splat (i32.const 1))))
                      (i32.const 1))))
                (else
                  (local.set $NW (v128.load (i32.sub (i32.sub (local.get $p) (local.get $row)) (i32.const 4))))
                  (local.set $V
                    (i32x4.max_s
                      (i32x4.min_s (local.get $L) (local.get $T))
                      (i32x4.min_s
                        (i32x4.max_s (local.get $L) (local.get $T))
                        (i32x4.sub (local.get $S) (local.get $NW)))))))
              (local.set $V
                (i32x4.sub
                  (i32x4.sub (v128.load (local.get $p)) (local.get $V))
                  (i32x4.splat (local.get $offset))))
              (v128.store
                (local.get $out)
                (v128.xor (i32x4.shl (local.get $V) (i32.const 1)) (i32x4.shr_s (local.get $V) (i32.const 31))))
              (local.set $p (i32.add (local.get $p) (i32.const 16)))
              (local.set $out (i32.add (local.get $out) (i32.const 16)))
              (local.set $x (i32.add (local.get $x) (i32.const 4)))
              (br $next)))
          (local.set $v (i32.const 0))
          (if
            (local.get $pred)
            (then
              (local.set $left
                (if
                  (result i32)
                  (local.get $x)
                  (then (i32.load (i32.sub (local.get $p) (i32.const 4))))
                  (else
                    (if
                      (result i32)
                      (local.get $y)
                      (then (i32.load (i32.sub (local.get $p) (local.get $row))))
                      (else (i32.const 0))))))
              (local.set $top
                (if
                  (result i32)
                  (local.get $y)
                  (then (i32.load (i32.sub (local.get $p) (local.get $row))))
                  (else (local.get $left))))
              (local.set $nw
                (if
                  (result i32)
                  (i32.and (i32.ne (local.get $x) (i32.const 0)) (i32.ne (local.get $y) (i32.const 0)))
                  (then (i32.load (i32.sub (i32.sub (local.get $p) (local.get $row)) (i32.const 4))))
                  (else (local.get $left))))
              (local.set $g (i32.sub (i32.add (local.get $left) (local.get $top)) (local.get $nw)))
              (if (i32.eq (local.get $pred) (i32.const 1)) (then (local.set $v (local.get $left))))
              (if (i32.eq (local.get $pred) (i32.const 2)) (then (local.set $v (local.get $top))))
              (if
                (i32.eq (local.get $pred) (i32.const 3))
                (then (local.set $v (i32.div_s (i32.add (local.get $left) (local.get $top)) (i32.const 2)))))
              (if
                (i32.eq (local.get $pred) (i32.const 4))
                (then
                  (local.set $v
                    (select
                      (local.get $left)
                      (local.get $top)
                      (i32.lt_s
                        (i32.sub
                          (i32.xor
                            (i32.sub (local.get $g) (local.get $left))
                            (i32.shr_s (i32.sub (local.get $g) (local.get $left)) (i32.const 31)))
                          (i32.shr_s (i32.sub (local.get $g) (local.get $left)) (i32.const 31)))
                        (i32.sub
                          (i32.xor
                            (i32.sub (local.get $g) (local.get $top))
                            (i32.shr_s (i32.sub (local.get $g) (local.get $top)) (i32.const 31)))
                          (i32.shr_s (i32.sub (local.get $g) (local.get $top)) (i32.const 31))))))))
              (if
                (i32.eq (local.get $pred) (i32.const 5))
                (then
                  (local.set $v
                    (select
                      (select (local.get $left) (local.get $top) (i32.lt_s (local.get $left) (local.get $top)))
                      (select
                        (select (local.get $left) (local.get $top) (i32.gt_s (local.get $left) (local.get $top)))
                        (local.get $g)
                        (i32.lt_s
                          (select
                            (local.get $left)
                            (local.get $top)
                            (i32.gt_s (local.get $left) (local.get $top)))
                          (local.get $g)))
                      (i32.gt_s
                        (select (local.get $left) (local.get $top) (i32.lt_s (local.get $left) (local.get $top)))
                        (select
                          (select
                            (local.get $left)
                            (local.get $top)
                            (i32.gt_s (local.get $left) (local.get $top)))
                          (local.get $g)
                          (i32.lt_s
                            (select
                              (local.get $left)
                              (local.get $top)
                              (i32.gt_s (local.get $left) (local.get $top)))
                            (local.get $g))))))))))
          (i32.store
            (local.get $out)
            (i32.xor
              (i32.shl
                (i32.sub (i32.sub (i32.load (local.get $p)) (local.get $v)) (local.get $offset))
                (i32.const 1))
              (i32.shr_s
                (i32.sub (i32.sub (i32.load (local.get $p)) (local.get $v)) (local.get $offset))
                (i32.const 31))))
          (local.set $out (i32.add (local.get $out) (i32.const 4)))
          (local.set $p (i32.add (local.get $p) (i32.const 4)))
          (local.set $x (i32.add (local.get $x) (i32.const 1))))
        (br_if $xs (i32.lt_u (local.get $x) (local.get $w))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $ys (i32.lt_u (local.get $y) (local.get $h)))))
  (func $fill
    (export "fill")
    (param $src i32)
    (param $n i32)
    (param $channels i32)
    (param $p0 i32)
    (param $p1 i32)
    (param $p2 i32)
    (param $p3 i32)
    (local $V v128)
    (local $R v128)
    (local $G v128)
    (local $B v128)
    (local $Co v128)
    (local $Cg v128)
    (local $Tmp v128)
    (local $v i32)
    (local $r i32)
    (local $g i32)
    (local $b i32)
    (local $co i32)
    (local $cg i32)
    (local $tmp i32)
    (local $i i32)
    (block $vectorsDone
      (loop $vectors
        (br_if $vectorsDone (i32.gt_u (i32.add (local.get $i) (i32.const 4)) (local.get $n)))
        (local.set $V (v128.load (local.get $src)))
        (local.set $R (v128.and (local.get $V) (i32x4.splat (i32.const 255))))
        (if
          (i32.ge_u (local.get $channels) (i32.const 3))
          (then
            (local.set $G (v128.and (i32x4.shr_u (local.get $V) (i32.const 8)) (i32x4.splat (i32.const 255))))
            (local.set $B (v128.and (i32x4.shr_u (local.get $V) (i32.const 16)) (i32x4.splat (i32.const 255))))
            (local.set $Co (i32x4.sub (local.get $R) (local.get $B)))
            (local.set $Tmp (i32x4.add (local.get $B) (i32x4.shr_s (local.get $Co) (i32.const 1))))
            (local.set $Cg (i32x4.sub (local.get $G) (local.get $Tmp)))
            (v128.store (local.get $p0) (i32x4.add (local.get $Tmp) (i32x4.shr_s (local.get $Cg) (i32.const 1))))
            (v128.store (local.get $p1) (local.get $Co))
            (v128.store (local.get $p2) (local.get $Cg))
            (if
              (i32.eq (local.get $channels) (i32.const 4))
              (then (v128.store (local.get $p3) (i32x4.shr_u (local.get $V) (i32.const 24))))))
          (else
            (v128.store (local.get $p0) (local.get $R))
            (if
              (i32.eq (local.get $channels) (i32.const 2))
              (then (v128.store (local.get $p1) (i32x4.shr_u (local.get $V) (i32.const 24)))))))
        (local.set $p0 (i32.add (local.get $p0) (i32.const 16)))
        (local.set $p1 (i32.add (local.get $p1) (i32.const 16)))
        (local.set $p2 (i32.add (local.get $p2) (i32.const 16)))
        (local.set $p3 (i32.add (local.get $p3) (i32.const 16)))
        (local.set $src (i32.add (local.get $src) (i32.const 16)))
        (local.set $i (i32.add (local.get $i) (i32.const 4)))
        (br $vectors)))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $v (i32.load (local.get $src)))
        (local.set $r (i32.and (local.get $v) (i32.const 255)))
        (if
          (i32.ge_u (local.get $channels) (i32.const 3))
          (then
            (local.set $g (i32.and (i32.shr_u (local.get $v) (i32.const 8)) (i32.const 255)))
            (local.set $b (i32.and (i32.shr_u (local.get $v) (i32.const 16)) (i32.const 255)))
            (local.set $co (i32.sub (local.get $r) (local.get $b)))
            (local.set $tmp (i32.add (local.get $b) (i32.shr_s (local.get $co) (i32.const 1))))
            (local.set $cg (i32.sub (local.get $g) (local.get $tmp)))
            (i32.store (local.get $p0) (i32.add (local.get $tmp) (i32.shr_s (local.get $cg) (i32.const 1))))
            (i32.store (local.get $p1) (local.get $co))
            (i32.store (local.get $p2) (local.get $cg))
            (if
              (i32.eq (local.get $channels) (i32.const 4))
              (then (i32.store (local.get $p3) (i32.shr_u (local.get $v) (i32.const 24))))))
          (else
            (i32.store (local.get $p0) (local.get $r))
            (if
              (i32.eq (local.get $channels) (i32.const 2))
              (then (i32.store (local.get $p1) (i32.shr_u (local.get $v) (i32.const 24)))))))
        (local.set $p0 (i32.add (local.get $p0) (i32.const 4)))
        (local.set $p1 (i32.add (local.get $p1) (i32.const 4)))
        (local.set $p2 (i32.add (local.get $p2) (i32.const 4)))
        (local.set $p3 (i32.add (local.get $p3) (i32.const 4)))
        (local.set $src (i32.add (local.get $src) (i32.const 4)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $next (i32.lt_u (local.get $i) (local.get $n))))))
  ;; A palette's indices for `n` RGBA pixels at `src` (lossless.mjs planeFill): each pixel's key (paletteKey: R, G, B and,
  ;; with `alpha`, A; grey: R and A) looked up in `table`, `mask` + 1 slots of [key, index + 1] (0: empty), hashed by the
  ;; key times 0x9e3779b1 shifted right by `shift`, probed in order; a key the palette lacks takes index 0. Indices into
  ;; `out` as i32.
  (func (export "paletteFill")
    (param $src i32) (param $n i32) (param $grey i32) (param $alpha i32) (param $table i32) (param $mask i32) (param $shift i32) (param $out i32)
    (local $i i32) (local $v i32) (local $key i32) (local $slot i32) (local $entry i32) (local $index i32)
    (block $done
      (loop $pixels
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $v (i32.load (local.get $src)))
        (local.set $key
          (if (result i32) (local.get $grey)
            (then (if (result i32) (local.get $alpha)
              (then (i32.or (i32.and (local.get $v) (i32.const 255)) (i32.shl (i32.shr_u (local.get $v) (i32.const 24)) (i32.const 8))))
              (else (i32.and (local.get $v) (i32.const 255)))))
            (else (if (result i32) (local.get $alpha) (then (local.get $v)) (else (i32.and (local.get $v) (i32.const 0xffffff)))))))
        (local.set $slot (i32.shr_u (i32.mul (local.get $key) (i32.const 0x9e3779b1)) (local.get $shift)))
        (local.set $index (i32.const 0))
        (block $found
          (loop $probe
            (local.set $entry (i32.add (local.get $table) (i32.shl (local.get $slot) (i32.const 3))))
            (br_if $found (i32.eqz (i32.load offset=4 (local.get $entry))))
            (if (i32.eq (i32.load (local.get $entry)) (local.get $key))
              (then (local.set $index (i32.sub (i32.load offset=4 (local.get $entry)) (i32.const 1))) (br $found)))
            (local.set $slot (i32.and (i32.add (local.get $slot) (i32.const 1)) (local.get $mask)))
            (br $probe)))
        (i32.store (local.get $out) (local.get $index))
        (local.set $src (i32.add (local.get $src) (i32.const 4)))
        (local.set $out (i32.add (local.get $out) (i32.const 4)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $pixels))))
  ;; A native palette's indices (lossless.mjs nativePlaneFill): each pixel's `k` samples (1 to 4 i32 planes from `p0`,
  ;; `stride` bytes apart) looked up in `table`, `mask` + 1 slots of five words (the samples, then index + 1; 0: empty),
  ;; hashed FNV-1a over the samples; a tuple the palette lacks takes index 0. Indices into `out` as i32.
  (func (export "tupleIndex") (param $p0 i32) (param $stride i32) (param $n i32) (param $k i32) (param $table i32) (param $mask i32) (param $out i32)
    (local $i i32) (local $c i32) (local $h i32) (local $slot i32) (local $entry i32) (local $index i32) (local $same i32) (local $at i32)
    (block $done
      (loop $pixels
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $h (i32.const 2166136261))
        (local.set $c (i32.const 0))
        (loop $hash
          (local.set $h (i32.mul (i32.xor (local.get $h)
            (i32.load (i32.add (i32.add (local.get $p0) (i32.mul (local.get $c) (local.get $stride))) (i32.shl (local.get $i) (i32.const 2)))))
            (i32.const 16777619)))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (br_if $hash (i32.lt_u (local.get $c) (local.get $k))))
        (local.set $slot (i32.and (local.get $h) (local.get $mask)))
        (local.set $index (i32.const 0))
        (block $found
          (loop $probe
            (local.set $entry (i32.add (local.get $table) (i32.mul (local.get $slot) (i32.const 20))))
            (br_if $found (i32.eqz (i32.load offset=16 (local.get $entry))))
            (local.set $same (i32.const 1))
            (local.set $c (i32.const 0))
            (loop $compare
              (local.set $at (i32.add (i32.add (local.get $p0) (i32.mul (local.get $c) (local.get $stride))) (i32.shl (local.get $i) (i32.const 2))))
              (if (i32.ne (i32.load (local.get $at)) (i32.load (i32.add (local.get $entry) (i32.shl (local.get $c) (i32.const 2)))))
                (then (local.set $same (i32.const 0))))
              (local.set $c (i32.add (local.get $c) (i32.const 1)))
              (br_if $compare (i32.lt_u (local.get $c) (local.get $k))))
            (if (local.get $same) (then (local.set $index (i32.sub (i32.load offset=16 (local.get $entry)) (i32.const 1))) (br $found)))
            (local.set $slot (i32.and (i32.add (local.get $slot) (i32.const 1)) (local.get $mask)))
            (br $probe)))
        (i32.store (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 2))) (local.get $index))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $pixels))))
  ;; One progressive pass's AC levels (vardct-progressive.mjs progressiveValue) for `n` coefficients of DCT8 blocks at
  ;; `src` (i16): passes 0 to `pass` from `passes` (i32 pairs: downsample, shift), a coefficient inside a pass's
  ;; downsampled square taking (what earlier passes left) / 2^shift, truncated; others 0. DC (rank 0) is copied. To
  ;; `out` (i16).
  (func (export "passLevels") (param $src i32) (param $n i32) (param $passes i32) (param $pass i32) (param $out i32)
    (local $j i32) (local $c i32) (local $k i32) (local $x i32) (local $y i32) (local $i i32) (local $rec i32) (local $part i32)
    (local $bound i32) (local $shift i32) (local $p i32)
    (block $done
      (loop $coefficients
        (br_if $done (i32.ge_u (local.get $j) (local.get $n)))
        (local.set $c (i32.load16_s (i32.add (local.get $src) (i32.shl (local.get $j) (i32.const 1)))))
        (local.set $k (i32.and (local.get $j) (i32.const 63)))
        (if (i32.and (i32.ne (local.get $k) (i32.const 0)) (i32.ne (local.get $c) (i32.const 0)))
          (then
            (local.set $x (i32.and (local.get $k) (i32.const 7)))
            (local.set $y (i32.shr_u (local.get $k) (i32.const 3)))
            (local.set $rec (i32.const 0))
            (local.set $i (i32.const 0))
            (local.set $p (local.get $passes))
            (block $passed
              (loop $each
                (local.set $bound (i32.div_u (i32.const 8) (i32.load (local.get $p))))
                (local.set $shift (i32.load offset=4 (local.get $p)))
                (local.set $part
                  (if (result i32) (i32.and (i32.lt_u (local.get $x) (local.get $bound)) (i32.lt_u (local.get $y) (local.get $bound)))
                    (then (i32.div_s (i32.sub (local.get $c) (local.get $rec)) (i32.shl (i32.const 1) (local.get $shift))))
                    (else (i32.const 0))))
                (br_if $passed (i32.eq (local.get $i) (local.get $pass)))
                (local.set $rec (i32.add (local.get $rec) (i32.shl (local.get $part) (local.get $shift))))
                (local.set $p (i32.add (local.get $p) (i32.const 8)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $each)))
            (local.set $c (local.get $part))))
        (i32.store16 (i32.add (local.get $out) (i32.shl (local.get $j) (i32.const 1))) (local.get $c))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $coefficients))))
    ;; One of the 42 reversible colour transforms for `n` pixels at `src` (rct-search.mjs colourTransform): bytes, or with
  ;; `wide` signed 16-bit samples (native-modular.mjs's packed palette indices); channels `a`, `b`, `c` in that order;
  ;; `custom` 6 YCoCg, else the second less the first (custom >> 1 = 1) or the mean of the first and third (2), the third
  ;; less the first (custom odd); the fourth sample to `p3` with four channels. Planes as i32.
  (func $rctSample (param $src i32) (param $k i32) (param $wide i32) (result i32)
    (if (result i32) (local.get $wide)
      (then (i32.load16_s (i32.add (local.get $src) (i32.shl (local.get $k) (i32.const 1)))))
      (else (i32.load8_u (i32.add (local.get $src) (local.get $k))))))
  (func (export "rctFill")
    (param $src i32) (param $n i32) (param $a i32) (param $b i32) (param $c i32) (param $custom i32) (param $channels i32)
    (param $wide i32) (param $p0 i32) (param $p1 i32) (param $p2 i32) (param $p3 i32)
    (local $i i32) (local $first i32) (local $second i32) (local $third i32) (local $co i32) (local $tmp i32) (local $cg i32) (local $half i32)
    (local $step i32)
    (local.set $half (i32.shr_u (local.get $custom) (i32.const 1)))
    (local.set $step (i32.shl (i32.const 4) (local.get $wide)))
    (block $done
      (loop $pixels
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $first (call $rctSample (local.get $src) (local.get $a) (local.get $wide)))
        (local.set $second (call $rctSample (local.get $src) (local.get $b) (local.get $wide)))
        (local.set $third (call $rctSample (local.get $src) (local.get $c) (local.get $wide)))
        (if (i32.eq (local.get $custom) (i32.const 6))
          (then
            (local.set $co (i32.sub (local.get $first) (local.get $third)))
