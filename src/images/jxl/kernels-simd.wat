          (local.set $l (f64.load offset=512 (local.get $at)))
          (local.set $yy (f64.add (local.get $yy) (f64.mul (local.get $l) (local.get $l))))
          (local.set $xy (f64.add (local.get $xy) (f64.mul (f64.load (local.get $at)) (local.get $l))))
          (local.set $bs (f64.add (local.get $bs) (f64.mul (f64.load offset=1024 (local.get $at)) (local.get $l))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br_if $sumK (i32.lt_u (local.get $k) (i32.const 64))))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (br_if $sumBlocks (i32.lt_u (local.get $n) (local.get $count))))
      (local.set $fx (call $cflFactor (local.get $c84) (local.get $xy) (local.get $yy)))
      (local.set $fb (call $cflFactor (local.get $c84) (local.get $bs) (local.get $yy)))
      (i32.store8 (i32.add (local.get $cfl) (local.get $t)) (local.get $fx))
      (i32.store8 (i32.add (i32.add (local.get $cfl) (local.get $tiles)) (local.get $t)) (local.get $fb))
      ;; Levels, block by block, channel by channel.
