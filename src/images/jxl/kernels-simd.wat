        (call $vbDct (i32.add (i32.add (local.get $pix) (i32.mul (local.get $c) (local.get $plane))) (i32.shl (local.get $j) (i32.const 6)))
          (local.get $W) (i32.const 8) (i32.const 8) (local.get $bt) (local.get $bb) (local.get $tmp)
          (i32.add (local.get $tr) (i32.shl (local.get $c) (i32.const 13))))
        (local.set $c (i32.add (local.get $c) (i32.const 1)))
        (br_if $dcts (i32.lt_u (local.get $c) (i32.const 3))))
