            (local.set $pos (i32.add (local.get $src) (i32.shl (local.get $v) (i32.const 6))))
            (local.set $k (i32.add (local.get $dst) (i32.shl (i32.mul (local.get $v) (local.get $W)) (i32.const 2))))
            (v128.store64_lane offset=0 0 (local.get $k) (f32x4.demote_f64x2_zero (f64x2.div (v128.load offset=0 (local.get $pos)) (local.get $inv2040))))
