      (f32.store (i32.add (local.get $bAcO) (i32.shl (i32.add (i32.mul (local.get $n) (i32.const 3)) (i32.const 1)) (i32.const 2))) (local.get $acO))

      ;; Channels 0 (X) and 2 (B)
      (local.set $ci (i32.const 0))
      (loop $cLoop
        (local.set $c (select (i32.const 0) (i32.const 2) (i32.eqz (local.get $ci))))
