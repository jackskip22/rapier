          (local.set $s2 (f64x2.add (local.get $s2) (f64x2.mul (local.get $b2) (local.get $px))))
          (local.set $s3 (f64x2.add (local.get $s3) (f64x2.mul (local.get $b3) (local.get $px))))
          (local.set $t0 (f64x2.add (local.get $t0) (f64x2.mul (local.get $b0) (local.get $py))))
          (local.set $t1 (f64x2.add (local.get $t1) (f64x2.mul (local.get $b1) (local.get $py))))
          (local.set $t2 (f64x2.add (local.get $t2) (f64x2.mul (local.get $b2) (local.get $py))))
          (local.set $t3 (f64x2.add (local.get $t3) (f64x2.mul (local.get $b3) (local.get $py))))
