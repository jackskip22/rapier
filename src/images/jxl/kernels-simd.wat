      (local.set $q (i32.wrap_i64 (i64.shr_u (i64.add (i64.shr_u (i64.mul (i64.extend_i32_u (local.get $state)) (i64.extend_i32_u (i32.load (local.get $rc))))
        (i64.const 32)) (i64.extend_i32_u (local.get $state))) (i64.extend_i32_u (i32.load offset=4 (local.get $rc))))))
      (local.set $state (i32.add (i32.mul (local.get $q) (i32.const 4096))
        (i32.load16_u (i32.add (local.get $rev) (i32.shl (i32.add (i32.add (i32.shl (local.get $id) (i32.const 12)) (local.get $start)) (i32.sub (local.get $state) (i32.mul (local.get $q) (local.get $freq)))) (i32.const 1))))))
