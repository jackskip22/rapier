        (local.set $c (select (i32.const 1) (select (i32.const 0) (i32.const 2) (i32.eq (local.get $k) (i32.const 1))) (i32.eqz (local.get $k))))
        (local.set $fc (if (result f64) (i32.eq (local.get $c) (i32.const 1)) (then (f64.const 0))
          (else (f64.load (i32.add (local.get $p) (i32.shl (i32.shr_u (local.get $c) (i32.const 1)) (i32.const 3)))))))
        (if (call $vbQuant (i32.add (local.get $tr) (i32.shl (local.get $c) (i32.const 13)))
              (select (i32.const 0) (i32.add (local.get $tr) (i32.const 8192)) (i32.eq (local.get $c) (i32.const 1)))
              (local.get $order) (i32.add (local.get $steps) (i32.shl (local.get $c) (i32.const 9))) (local.get $high)
              (i32.const 1) (i32.const 64) (i32.const 0) (local.get $log2) (local.get $fc)
              (f64.load (i32.add (local.get $dead) (i32.shl (local.get $c) (i32.const 4))))
              (f64.load offset=8 (i32.add (local.get $dead) (i32.shl (local.get $c) (i32.const 4))))
              (f64.load offset=16 (local.get $p)) (f64.load offset=24 (local.get $p))
              (f64.load (i32.add (local.get $ones) (i32.shl (local.get $c) (i32.const 3))))
              (local.get $det) (local.get $rc1) (local.get $rc2) (local.get $R) (local.get $out))
          (then (return (local.get $j))))
