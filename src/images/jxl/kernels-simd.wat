        (local.set $x0h (call $fquant1 (local.get $x0) (f32.load (local.get $stPtr)) (f32.load (local.get $istPtr)) (f32.load (local.get $thPtr))))
        (local.set $m (i32.shl (i32.add (i32.mul (local.get $n) (i32.const 3)) (local.get $c)) (i32.const 2)))
        (f32.store (i32.add (local.get $dcO) (local.get $m)) (local.get $x0))
        (f32.store (i32.add (local.get $dcH) (local.get $m)) (local.get $x0h))
        (local.set $e0 (f32.sub (local.get $x0h) (local.get $x0)))
        (local.set $e02 (f32.mul (local.get $e0) (local.get $e0)))
        (local.set $m (i32.add (local.get $n30) (i32.mul (local.get $c) (i32.const 40))))
