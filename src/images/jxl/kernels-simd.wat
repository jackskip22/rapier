                (i32.add (local.get $out) (i32.shl (i32.add (i32.shl (i32.add (local.get $half) (i32.shl (local.get $y) (i32.const 1))) (i32.const 3)) (local.get $x)) (i32.const 3)))
                (f64.load (i32.add (local.get $sub) (i32.shl (i32.add (i32.shl (local.get $y) (i32.const 3)) (local.get $x)) (i32.const 3)))))
              (local.set $x (i32.add (local.get $x) (i32.const 1)))
              (br_if $hx (i32.lt_u (local.get $x) (i32.const 8))))
            (local.set $y (i32.add (local.get $y) (i32.const 1)))
            (br_if $hy (i32.lt_u (local.get $y) (i32.const 4))))
          (local.set $half (i32.add (local.get $half) (i32.const 1)))
          (br_if $hL (i32.lt_u (local.get $half) (i32.const 2))))
