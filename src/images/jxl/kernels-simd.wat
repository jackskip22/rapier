;; ansGroupWriter's flush for one group's collected tokens (JS1): the reverse pass sets each token's raw bits and, where
;; the state renormalizes, its 16 emitted bits, then the state, emitted words and raw bits are written forward,
;; continuing a BitWriter. Fields at $args (i32): 0 values (u32), 4 histogram ids (u8), 8 count, 12 small entries
;; (id * 64 + v: raw-bit count << 6 | raw bits), 16 their frequencies, 20 their starts, 24 reverse tables (u16, 4096 per
;; id), 28 configurations (splitToken, split, msb, lsb), 32 counts (i32, id * alphabet + symbol), 36 starts (likewise),
;; 40 alphabet, 44 raw bits per token (u32), 48 bit counts and flags per token (u8, 64 = emitted), 52 emitted (u16),
;; 56 out, 60 acc, 64 pending, 68 bytes written, 72 reciprocals (two i32 a frequency up to 4096).
(func (export "ansFlush") (param $args i32)
  (call $ansForward (local.get $args) (call $ansBackRun (local.get $args) (i32.load offset=8 (local.get $args)) (i32.const 1245184))))

(func $ansBackRun (param $args i32) (param $i i32) (param $state i32) (result i32)
  (local $values i32) (local $ids i32) (local $small i32) (local $freqs i32) (local $starts i32) (local $rev i32)
  (local $configs i32) (local $hcounts i32) (local $hstarts i32) (local $alphabet i32) (local $raws i32) (local $meta i32) (local $emitted i32)
  (local $id i32) (local $value i32) (local $at i32) (local $entry i32) (local $bits i32) (local $raw i32) (local $freq i32)
  (local $start i32) (local $q i32) (local $cfg i32) (local $nb i32) (local $below i32) (local $split i32) (local $msb i32)
  (local $lsb i32) (local $symbol i32) (local $m i32) (local $recips i32) (local $rc i32)
  (local.set $recips (i32.load offset=72 (local.get $args)))
  (local.set $values (i32.load (local.get $args))) (local.set $ids (i32.load offset=4 (local.get $args)))
  (local.set $small (i32.load offset=12 (local.get $args)))
  (local.set $freqs (i32.load offset=16 (local.get $args))) (local.set $starts (i32.load offset=20 (local.get $args)))
  (local.set $rev (i32.load offset=24 (local.get $args))) (local.set $configs (i32.load offset=28 (local.get $args)))
  (local.set $hcounts (i32.load offset=32 (local.get $args))) (local.set $hstarts (i32.load offset=36 (local.get $args)))
  (local.set $alphabet (i32.load offset=40 (local.get $args))) (local.set $raws (i32.load offset=44 (local.get $args)))
  (local.set $meta (i32.load offset=48 (local.get $args))) (local.set $emitted (i32.load offset=52 (local.get $args)))
  (block $reverseDone
    (loop $reverse
      (br_if $reverseDone (i32.eqz (local.get $i)))
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (local.set $id (i32.load8_u (i32.add (local.get $ids) (local.get $i))))
      (local.set $value (i32.load (i32.add (local.get $values) (i32.shl (local.get $i) (i32.const 2)))))
      (if (i32.lt_u (local.get $value) (i32.const 64))
        (then
          (local.set $at (i32.shl (i32.add (i32.shl (local.get $id) (i32.const 6)) (local.get $value)) (i32.const 2)))
          (local.set $entry (i32.load (i32.add (local.get $small) (local.get $at))))
          (local.set $bits (i32.shr_s (local.get $entry) (i32.const 6)))
          (local.set $raw (i32.and (local.get $entry) (i32.const 63)))
          (local.set $freq (i32.load (i32.add (local.get $freqs) (local.get $at))))
          (local.set $start (i32.load (i32.add (local.get $starts) (local.get $at)))))
