    (local.set $derive (i32.ne (local.get $parent) (i32.const 0)))
    (local.set $initStats (i32.add (local.get $out) (i32.const 64)))
    (local.set $limits (i32.add (local.get $initStats) (i32.shl (local.get $kinds) (i32.const 5))))
    (local.set $size (i32.mul (local.get $kinds) (local.get $alphabet)))
    (local.set $stateBytes (i32.add (i32.shl (local.get $kinds) (i32.const 5))
      (i32.and (i32.add (i32.shl (local.get $size) (i32.const 2)) (i32.const 15)) (i32.const -16))))
    (local.set $zeroRaw16 (i32.const 1))
    (local.set $s (i32.const 0))
    (local.set $end (select (local.get $alphabet) (i32.const 16) (i32.lt_u (local.get $alphabet) (i32.const 16))))
    (if (i32.lt_u (local.get $s) (local.get $end))
