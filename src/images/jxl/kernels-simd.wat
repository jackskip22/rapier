                        (then (local.set $hasB2 (i32.const 1)) (local.set $b2Pred (local.get $b1Pred)) (local.set $b2Cl (local.get $b1Cl)) (local.set $b2Cost (local.get $b1Cost))))
                      (local.set $hasB1 (i32.const 1)) (local.set $b1Pred (local.get $c)) (local.set $b1Cl (local.get $g)) (local.set $b1Cost (local.get $cost)))
                    (else (if (i32.and (i32.ne (local.get $g) (local.get $b1Cl)) (i32.or (i32.eqz (local.get $hasB2)) (f64.lt (local.get $cost) (local.get $b2Cost))))
                      (then (local.set $hasB2 (i32.const 1)) (local.set $b2Pred (local.get $c)) (local.set $b2Cl (local.get $g)) (local.set $b2Cost (local.get $cost))))))))
              (local.set $g (i32.add (local.get $g) (i32.const 1)))
