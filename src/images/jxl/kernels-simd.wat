                (local.set $lo (select (f64.const 0) (select (f64.const 255) (local.get $lo) (f64.gt (local.get $lo) (f64.const 255))) (f64.lt (local.get $lo) (f64.const 0))))
                (local.set $hi (f64.add (local.get $u) (f64.const 0x1p-12)))
                (local.set $hi (select (f64.const 0) (select (f64.const 255) (local.get $hi) (f64.gt (local.get $hi) (f64.const 255))) (f64.lt (local.get $hi) (f64.const 0))))
