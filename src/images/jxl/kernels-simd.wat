        (local.set $d (f64.promote_f32 (f32.load (i32.add (local.get $d2) (i32.shl (i32.and (i32.add (i32.add (local.get $ox) (local.get $col)) (i32.const 14)) (i32.const 31)) (i32.const 2))))))
        (if (local.get $gamma)
          (then (i32.store8 offset=2 (local.get $o) (call $nByteOf (local.get $v) (local.get $d))))
          (else
            (local.set $byte (f64.const -1))
            (if (i32.and (f64.gt (local.get $v) (local.get $low64)) (f64.lt (local.get $v) (f64.const 1)))
              (then
                (local.set $at (i32.add (local.get $knots)
                  (i32.shl (i32.shr_u (i32.sub (i32.load (i32.add (local.get $at0) (local.get $plane2))) (local.get $low)) (i32.const 13)) (i32.const 3))))
                (local.set $u (f64.add (f64.mul (f64.const 255) (f64.add (f64.load (i32.add (local.get $at) (local.get $rk)))
                  (f64.mul (f64.sub (local.get $v) (f64.load (local.get $at))) (f64.load (i32.add (local.get $at) (local.get $sk))))))
