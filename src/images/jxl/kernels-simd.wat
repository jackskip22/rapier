      (loop $qBlocks
        (local.set $by (i32.div_u (local.get $n) (local.get $bw)))
        (local.set $bx (i32.rem_u (local.get $n) (local.get $bw)))
        (if (local.get $fields) (then
          (local.set $fine (f64.div (f64.convert_i32_s (i32.load (i32.add (local.get $fields) (i32.shl (i32.add
            (i32.mul (i32.add (local.get $by0) (local.get $by)) (local.get $fStride))
            (i32.add (local.get $bx0) (i32.add (i32.shl (local.get $t) (i32.const 3)) (local.get $bx)))) (i32.const 2))))) (f64.const 64)))))
        (local.set $c (i32.const 0))
