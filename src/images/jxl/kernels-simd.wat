          (local.set $sum (f64.add (local.get $sum) (f64.mul
            (f64.load (i32.add (local.get $part) (i32.shl (local.get $k) (i32.const 3))))
            (f64.load (i32.add (local.get $afv) (i32.shl (i32.add (i32.shl (local.get $i) (i32.const 4)) (local.get $k)) (i32.const 3)))))))
