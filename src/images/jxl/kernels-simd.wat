    (if (i32.or (i32.or (i32.eqz (f64.ne (local.get $residual) (f64.const 0))) (i32.and (f64.ne (local.get $residual) (local.get $residual)) (i32.const 1)))
          (i32.or (f64.eq (local.get $sum) (local.get $rounded)) (i32.eqz (f64.eq (f64.sub (local.get $rounded) (local.get $rounded)) (f64.const 0)))))
