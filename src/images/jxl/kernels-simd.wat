          (local.set $split (i32.load offset=4 (local.get $cfg))) (local.set $msb (i32.load offset=8 (local.get $cfg))) (local.set $lsb (i32.load offset=12 (local.get $cfg)))
          (if (i32.lt_u (local.get $value) (i32.load (local.get $cfg)))
            (then (local.set $symbol (local.get $value)) (local.set $bits (i32.const 0)) (local.set $raw (i32.const 0)))
            (else
              (local.set $nb (i32.sub (i32.const 31) (i32.clz (local.get $value))))
              (local.set $below (i32.sub (local.get $value) (i32.shl (i32.const 1) (local.get $nb))))
              (local.set $bits (i32.sub (i32.sub (local.get $nb) (local.get $msb)) (local.get $lsb)))
              (local.set $symbol (i32.add (i32.load (local.get $cfg))
                (i32.or (i32.or (i32.shl (i32.sub (local.get $nb) (local.get $split)) (i32.add (local.get $msb) (local.get $lsb)))
                    (i32.shl (i32.shr_u (local.get $below) (i32.sub (local.get $nb) (local.get $msb))) (local.get $lsb)))
                  (i32.and (local.get $below) (i32.sub (i32.shl (i32.const 1) (local.get $lsb)) (i32.const 1))))))
              (local.set $raw (i32.and (i32.shr_u (local.get $value) (local.get $lsb)) (i32.sub (i32.shl (i32.const 1) (local.get $bits)) (i32.const 1))))))
          (local.set $at (i32.shl (i32.add (i32.mul (local.get $id) (local.get $alphabet)) (local.get $symbol)) (i32.const 2)))
          (local.set $freq (i32.load (i32.add (local.get $hcounts) (local.get $at))))
          (local.set $start (i32.load (i32.add (local.get $hstarts) (local.get $at))))))
