    (local.set $iA (i32.sub (local.get $iA) (i32.const 1)))
    (local.set $iB (i32.sub (local.get $iB) (i32.const 1)))
(local.set $idA (i32.load8_u (i32.add (local.get $idsA) (local.get $iA))))
      (local.set $valueA (i32.load (i32.add (local.get $valuesA) (i32.shl (local.get $iA) (i32.const 2)))))
      (if (i32.lt_u (local.get $valueA) (i32.const 64))
        (then
          (local.set $atA (i32.shl (i32.add (i32.shl (local.get $idA) (i32.const 6)) (local.get $valueA)) (i32.const 2)))
          (local.set $entryA (i32.load (i32.add (local.get $small) (local.get $atA))))
          (local.set $bitsA (i32.shr_s (local.get $entryA) (i32.const 6)))
          (local.set $rawA (i32.and (local.get $entryA) (i32.const 63)))
          (local.set $freqA (i32.load (i32.add (local.get $freqs) (local.get $atA))))
          (local.set $startA (i32.load (i32.add (local.get $starts) (local.get $atA)))))
        (else
          ;; hybridToken under this histogram's configuration.
          (local.set $cfgA (i32.add (local.get $configs) (i32.shl (local.get $idA) (i32.const 4))))
          (local.set $splitA (i32.load offset=4 (local.get $cfgA))) (local.set $msbA (i32.load offset=8 (local.get $cfgA))) (local.set $lsbA (i32.load offset=12 (local.get $cfgA)))
          (if (i32.lt_u (local.get $valueA) (i32.load (local.get $cfgA)))
            (then (local.set $symbolA (local.get $valueA)) (local.set $bitsA (i32.const 0)) (local.set $rawA (i32.const 0)))
            (else
              (local.set $nbA (i32.sub (i32.const 31) (i32.clz (local.get $valueA))))
              (local.set $belowA (i32.sub (local.get $valueA) (i32.shl (i32.const 1) (local.get $nbA))))
              (local.set $bitsA (i32.sub (i32.sub (local.get $nbA) (local.get $msbA)) (local.get $lsbA)))
              (local.set $symbolA (i32.add (i32.load (local.get $cfgA))
                (i32.or (i32.or (i32.shl (i32.sub (local.get $nbA) (local.get $splitA)) (i32.add (local.get $msbA) (local.get $lsbA)))
                    (i32.shl (i32.shr_u (local.get $belowA) (i32.sub (local.get $nbA) (local.get $msbA))) (local.get $lsbA)))
                  (i32.and (local.get $belowA) (i32.sub (i32.shl (i32.const 1) (local.get $lsbA)) (i32.const 1))))))
              (local.set $rawA (i32.and (i32.shr_u (local.get $valueA) (local.get $lsbA)) (i32.sub (i32.shl (i32.const 1) (local.get $bitsA)) (i32.const 1))))))
          (local.set $atA (i32.shl (i32.add (i32.mul (local.get $idA) (local.get $alphabet)) (local.get $symbolA)) (i32.const 2)))
          (local.set $freqA (i32.load (i32.add (local.get $hcounts) (local.get $atA))))
          (local.set $startA (i32.load (i32.add (local.get $hstarts) (local.get $atA))))))
      (i32.store (i32.add (local.get $rawsA) (i32.shl (local.get $iA) (i32.const 2))) (local.get $rawA))
      (local.set $mA (local.get $bitsA))
      (if (i32.ge_u (i32.shr_u (local.get $stateA) (i32.const 20)) (local.get $freqA))
        (then
          (i32.store16 (i32.add (local.get $emittedA) (i32.shl (local.get $iA) (i32.const 1))) (local.get $stateA))
          (local.set $mA (i32.or (local.get $mA) (i32.const 64)))
          (local.set $stateA (i32.shr_u (local.get $stateA) (i32.const 16)))))
      (i32.store8 (i32.add (local.get $metaA) (local.get $iA)) (local.get $mA))
      ;; state / freq by its exact reciprocal (72: m' and the shift l a frequency, m = 2^32 + m' = ceil(2^(32 + l) / freq),
      ;; l = ceil(log2 freq)): ((state m' >> 32) + state) >> l is the quotient for every 32-bit state (Granlund and
      ;; Montgomery), a multiplication's latency instead of a division's.
      (local.set $rcA (i32.add (local.get $recips) (i32.shl (local.get $freqA) (i32.const 3))))
      (local.set $qA (i32.wrap_i64 (i64.shr_u (i64.add (i64.shr_u (i64.mul (i64.extend_i32_u (local.get $stateA)) (i64.extend_i32_u (i32.load (local.get $rcA))))
        (i64.const 32)) (i64.extend_i32_u (local.get $stateA))) (i64.extend_i32_u (i32.load offset=4 (local.get $rcA))))))
      (local.set $stateA (i32.add (i32.mul (local.get $qA) (i32.const 4096))
        (i32.load16_u (i32.add (local.get $rev) (i32.shl (i32.add (i32.add (i32.shl (local.get $idA) (i32.const 12)) (local.get $startA)) (i32.sub (local.get $stateA) (i32.mul (local.get $qA) (local.get $freqA)))) (i32.const 1))))))
(local.set $idB (i32.load8_u (i32.add (local.get $idsB) (local.get $iB))))
      (local.set $valueB (i32.load (i32.add (local.get $valuesB) (i32.shl (local.get $iB) (i32.const 2)))))
      (if (i32.lt_u (local.get $valueB) (i32.const 64))
        (then
          (local.set $atB (i32.shl (i32.add (i32.shl (local.get $idB) (i32.const 6)) (local.get $valueB)) (i32.const 2)))
          (local.set $entryB (i32.load (i32.add (local.get $small) (local.get $atB))))
          (local.set $bitsB (i32.shr_s (local.get $entryB) (i32.const 6)))
          (local.set $rawB (i32.and (local.get $entryB) (i32.const 63)))
          (local.set $freqB (i32.load (i32.add (local.get $freqs) (local.get $atB))))
          (local.set $startB (i32.load (i32.add (local.get $starts) (local.get $atB)))))
        (else
          ;; hybridToken under this histogram's configuration.
          (local.set $cfgB (i32.add (local.get $configs) (i32.shl (local.get $idB) (i32.const 4))))
          (local.set $splitB (i32.load offset=4 (local.get $cfgB))) (local.set $msbB (i32.load offset=8 (local.get $cfgB))) (local.set $lsbB (i32.load offset=12 (local.get $cfgB)))
          (if (i32.lt_u (local.get $valueB) (i32.load (local.get $cfgB)))
            (then (local.set $symbolB (local.get $valueB)) (local.set $bitsB (i32.const 0)) (local.set $rawB (i32.const 0)))
            (else
              (local.set $nbB (i32.sub (i32.const 31) (i32.clz (local.get $valueB))))
              (local.set $belowB (i32.sub (local.get $valueB) (i32.shl (i32.const 1) (local.get $nbB))))
              (local.set $bitsB (i32.sub (i32.sub (local.get $nbB) (local.get $msbB)) (local.get $lsbB)))
              (local.set $symbolB (i32.add (i32.load (local.get $cfgB))
                (i32.or (i32.or (i32.shl (i32.sub (local.get $nbB) (local.get $splitB)) (i32.add (local.get $msbB) (local.get $lsbB)))
                    (i32.shl (i32.shr_u (local.get $belowB) (i32.sub (local.get $nbB) (local.get $msbB))) (local.get $lsbB)))
                  (i32.and (local.get $belowB) (i32.sub (i32.shl (i32.const 1) (local.get $lsbB)) (i32.const 1))))))
              (local.set $rawB (i32.and (i32.shr_u (local.get $valueB) (local.get $lsbB)) (i32.sub (i32.shl (i32.const 1) (local.get $bitsB)) (i32.const 1))))))
          (local.set $atB (i32.shl (i32.add (i32.mul (local.get $idB) (local.get $alphabet)) (local.get $symbolB)) (i32.const 2)))
          (local.set $freqB (i32.load (i32.add (local.get $hcounts) (local.get $atB))))
          (local.set $startB (i32.load (i32.add (local.get $hstarts) (local.get $atB))))))
      (i32.store (i32.add (local.get $rawsB) (i32.shl (local.get $iB) (i32.const 2))) (local.get $rawB))
      (local.set $mB (local.get $bitsB))
      (if (i32.ge_u (i32.shr_u (local.get $stateB) (i32.const 20)) (local.get $freqB))
        (then
          (i32.store16 (i32.add (local.get $emittedB) (i32.shl (local.get $iB) (i32.const 1))) (local.get $stateB))
          (local.set $mB (i32.or (local.get $mB) (i32.const 64)))
          (local.set $stateB (i32.shr_u (local.get $stateB) (i32.const 16)))))
      (i32.store8 (i32.add (local.get $metaB) (local.get $iB)) (local.get $mB))
      ;; state / freq by its exact reciprocal (72: m' and the shift l a frequency, m = 2^32 + m' = ceil(2^(32 + l) / freq),
      ;; l = ceil(log2 freq)): ((state m' >> 32) + state) >> l is the quotient for every 32-bit state (Granlund and
      ;; Montgomery), a multiplication's latency instead of a division's.
      (local.set $rcB (i32.add (local.get $recips) (i32.shl (local.get $freqB) (i32.const 3))))
      (local.set $qB (i32.wrap_i64 (i64.shr_u (i64.add (i64.shr_u (i64.mul (i64.extend_i32_u (local.get $stateB)) (i64.extend_i32_u (i32.load (local.get $rcB))))
        (i64.const 32)) (i64.extend_i32_u (local.get $stateB))) (i64.extend_i32_u (i32.load offset=4 (local.get $rcB))))))
      (local.set $stateB (i32.add (i32.mul (local.get $qB) (i32.const 4096))
        (i32.load16_u (i32.add (local.get $rev) (i32.shl (i32.add (i32.add (i32.shl (local.get $idB) (i32.const 12)) (local.get $startB)) (i32.sub (local.get $stateB) (i32.mul (local.get $qB) (local.get $freqB)))) (i32.const 1))))))
    (br $both)))
  (local.set $stateA (call $ansBackRun (local.get $a) (local.get $iA) (local.get $stateA)))
  (local.set $stateB (call $ansBackRun (local.get $b) (local.get $iB) (local.get $stateB)))
  (call $ansForward (local.get $a) (local.get $stateA))
  (call $ansForward (local.get $b) (local.get $stateB)))

;; packLevels (UP10, kernels.mjs gabBand with `packed`): one tile row's levels as fgTiles left them ($levels: for each
;; channel c and block row by < $bh, $blocks blocks of 64 i16 at row c * 8 + by; nonzero AC counts at $counts, a byte a
;; block, the same rows) packed in channel, row and block order: each nonzero AC level's position (1 to 63) at $outAt and
;; value at $outVal, the block's first entry's index (from $base) at $starts (i32, a block), its DC at $dc (i16, a
;; block), and one more for each nonzero AC position k of channel c at $hist + 4 * (c * 64 + k). Returns the entries.
(func (export "packLevels") (param $levels i32) (param $counts i32) (param $bh i32) (param $blocks i32) (param $outAt i32)
  (param $outVal i32) (param $starts i32) (param $dc i32) (param $hist i32) (param $base i32) (param $lut i32) (result i32)
  (local $c i32) (local $by i32) (local $b i32) (local $row i32) (local $block i32) (local $v i32) (local $mask i32)
  (local $n i32) (local $slot i32) (local $h i32) (local $vec v128) (local $ne v128) (local $hv i32)
  (local.set $c (i32.const 0))
  (loop $channels
    (local.set $h (i32.add (local.get $hist) (i32.shl (local.get $c) (i32.const 8))))
    (local.set $by (i32.const 0))
    (block $rowsDone (loop $rows
      (br_if $rowsDone (i32.ge_u (local.get $by) (local.get $bh)))
      (local.set $row (i32.mul (i32.add (i32.shl (local.get $c) (i32.const 3)) (local.get $by)) (local.get $blocks)))
      (local.set $b (i32.const 0))
      (block $blocksDone (loop $blockLoop
        (br_if $blocksDone (i32.ge_u (local.get $b) (local.get $blocks)))
        (local.set $slot (i32.add (local.get $row) (local.get $b)))
        (local.set $block (i32.add (local.get $levels) (i32.shl (local.get $slot) (i32.const 7))))
        (i32.store (i32.add (local.get $starts) (i32.shl (local.get $slot) (i32.const 2))) (i32.add (local.get $base) (local.get $n)))
        (i32.store16 (i32.add (local.get $dc) (i32.shl (local.get $slot) (i32.const 1))) (i32.load16_s (local.get $block)))
        (if (i32.load8_u (i32.add (local.get $counts) (local.get $slot)))
          (then
            (local.set $v (i32.const 0))
            (loop $vectors
              ;; Eight levels at once, without a branch a level: the nonzero lanes' mask (lane 0 of the first vector is DC),
              ;; their positions and values moved to the front by the mask's table entry ($lut: 16 shuffle bytes, then 8
              ;; lane numbers, a mask), each nonzero position counted, n advanced by the mask's bits.
              (local.set $vec (v128.load (i32.add (local.get $block) (i32.shl (local.get $v) (i32.const 4)))))
              (local.set $ne (i16x8.ne (local.get $vec) (v128.const i32x4 0 0 0 0)))
              (if (i32.eqz (local.get $v)) (then (local.set $ne (v128.and (local.get $ne) (v128.const i32x4 0xffff0000 -1 -1 -1)))))
              (local.set $mask (i16x8.bitmask (local.get $ne)))
              (local.set $hv (i32.add (local.get $h) (i32.shl (local.get $v) (i32.const 5))))
              (v128.store (local.get $hv) (i32x4.sub (v128.load (local.get $hv)) (i32x4.extend_low_i16x8_s (local.get $ne))))
              (v128.store offset=16 (local.get $hv) (i32x4.sub (v128.load offset=16 (local.get $hv)) (i32x4.extend_high_i16x8_s (local.get $ne))))
              (i64.store (i32.add (local.get $outAt) (local.get $n)) (i64.add (i64.load offset=4096 (i32.add (local.get $lut) (i32.shl (local.get $mask) (i32.const 3))))
                (i64.mul (i64.extend_i32_u (i32.shl (local.get $v) (i32.const 3))) (i64.const 0x0101010101010101))))
              (v128.store (i32.add (local.get $outVal) (i32.shl (local.get $n) (i32.const 1)))
                (i8x16.swizzle (local.get $vec) (v128.load (i32.add (local.get $lut) (i32.shl (local.get $mask) (i32.const 4))))))
              (local.set $n (i32.add (local.get $n) (i32.popcnt (local.get $mask))))
              (local.set $v (i32.add (local.get $v) (i32.const 1)))
              (br_if $vectors (i32.lt_u (local.get $v) (i32.const 8))))))
        (local.set $b (i32.add (local.get $b) (i32.const 1)))
        (br $blockLoop)))
      (local.set $by (i32.add (local.get $by) (i32.const 1)))
      (br $rows)))
    (local.set $c (i32.add (local.get $c) (i32.const 1)))
    (br_if $channels (i32.lt_u (local.get $c) (i32.const 3))))
  (local.get $n))

;; wpTokens (UP10, sampled.mjs sampledPlanes.fixed): sampleTokenize for a tree on the weighted error property (15) alone,
;; every leaf the weighted predictor: each sample's leaf by the flat tree at $flat (four i32 a node: property, split,
;; left and right indices; a leaf -1 and its slot), its value the weighted residual at $weighted, zeros run-length coded
;; as the JavaScript emits them (eight or more: the first zero, then a copy of the rest). Tags (symbol | raw bits << 9 |
;; leaf << 16) at $tags, raw values at $extra, one more at $freqs + 4 * (leaf * $alphabet + symbol) a token; $runs holds
;; eight leaves. Returns the tokens.
(global $wpUsed (mut i32) (i32.const 0))
(func $wpEmit (param $tags i32) (param $extra i32) (param $freqs i32) (param $alphabet i32) (param $ctx i32) (param $value i32) (param $copy i32)
  (local $n i32) (local $symbol i32) (local $nbits i32) (local $payload i32) (local $f i32)
  (if (i32.and (local.get $copy) (i32.lt_u (local.get $value) (i32.const 16)))
    (then (local.set $symbol (i32.add (i32.const 224) (local.get $value))))
    (else
      (local.set $n (i32.sub (i32.const 31) (i32.clz (local.get $value))))
      (local.set $symbol (select (i32.add (i32.const 236) (local.get $n)) (i32.add (local.get $n) (i32.const 1)) (local.get $copy)))
      (if (i32.ge_s (local.get $n) (i32.const 0))
        (then (local.set $nbits (local.get $n)) (local.set $payload (i32.sub (local.get $value) (i32.shl (i32.const 1) (local.get $n))))))))
  (local.set $f (i32.add (local.get $freqs) (i32.shl (i32.add (i32.mul (local.get $ctx) (local.get $alphabet)) (local.get $symbol)) (i32.const 2))))
  (i32.store (local.get $f) (i32.add (i32.load (local.get $f)) (i32.const 1)))
  (i32.store (i32.add (local.get $extra) (i32.shl (global.get $wpUsed) (i32.const 2))) (local.get $payload))
  (i32.store (i32.add (local.get $tags) (i32.shl (global.get $wpUsed) (i32.const 2)))
    (i32.or (i32.or (local.get $symbol) (i32.shl (local.get $nbits) (i32.const 9))) (i32.shl (local.get $ctx) (i32.const 16))))
  (global.set $wpUsed (i32.add (global.get $wpUsed) (i32.const 1))))
(func $wpFlush (param $tags i32) (param $extra i32) (param $freqs i32) (param $alphabet i32) (param $runs i32) (param $run i32)
  (local $k i32)
  (if (i32.ge_u (local.get $run) (i32.const 8))
    (then
      (call $wpEmit (local.get $tags) (local.get $extra) (local.get $freqs) (local.get $alphabet) (i32.load (local.get $runs)) (i32.const 0) (i32.const 0))
      (call $wpEmit (local.get $tags) (local.get $extra) (local.get $freqs) (local.get $alphabet) (i32.load offset=4 (local.get $runs)) (i32.sub (local.get $run) (i32.const 8)) (i32.const 1)))
    (else
      (block $done (loop $zeros
        (br_if $done (i32.ge_u (local.get $k) (local.get $run)))
        (call $wpEmit (local.get $tags) (local.get $extra) (local.get $freqs) (local.get $alphabet) (i32.load (i32.add (local.get $runs) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 0) (i32.const 0))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $zeros))))))
(func (export "wpTokens") (param $flat i32) (param $errors i32) (param $weighted i32) (param $n i32) (param $tags i32) (param $extra i32)
  (param $freqs i32) (param $alphabet i32) (param $runs i32) (result i32)
  (local $i i32) (local $at i32) (local $ctx i32) (local $value i32) (local $run i32) (local $error i32) (local $node i32) (local $symbol i32) (local $f i32)
  (global.set $wpUsed (i32.const 0))
  (block $done (loop $samples
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $error (i32.load (i32.add (local.get $errors) (i32.shl (local.get $i) (i32.const 2)))))
    (local.set $node (local.get $flat))
    (block $leaf (loop $walk
      (br_if $leaf (i32.lt_s (i32.load (local.get $node)) (i32.const 0)))
      (local.set $node (i32.add (local.get $flat) (i32.shl
        (select (i32.load offset=8 (local.get $node)) (i32.load offset=12 (local.get $node)) (i32.gt_s (local.get $error) (i32.load offset=4 (local.get $node))))
        (i32.const 2))))
      (br $walk)))
    (local.set $ctx (i32.load offset=4 (local.get $node)))
    (local.set $value (i32.load (i32.add (local.get $weighted) (i32.shl (local.get $i) (i32.const 2)))))
    (if (i32.eqz (local.get $value))
      (then
        (if (i32.lt_u (local.get $run) (i32.const 8)) (then (i32.store (i32.add (local.get $runs) (i32.shl (local.get $run) (i32.const 2))) (local.get $ctx))))
        (local.set $run (i32.add (local.get $run) (i32.const 1))))
      (else
        (if (local.get $run) (then
          (call $wpFlush (local.get $tags) (local.get $extra) (local.get $freqs) (local.get $alphabet) (local.get $runs) (local.get $run))
          (local.set $run (i32.const 0))))
        (local.set $symbol (i32.sub (i32.const 32) (i32.clz (local.get $value))))
        (local.set $f (i32.add (local.get $freqs) (i32.shl (i32.add (i32.mul (local.get $ctx) (local.get $alphabet)) (local.get $symbol)) (i32.const 2))))
        (i32.store (local.get $f) (i32.add (i32.load (local.get $f)) (i32.const 1)))
        (i32.store (i32.add (local.get $extra) (i32.shl (global.get $wpUsed) (i32.const 2))) (i32.sub (local.get $value) (i32.shl (i32.const 1) (i32.sub (local.get $symbol) (i32.const 1)))))
        (i32.store (i32.add (local.get $tags) (i32.shl (global.get $wpUsed) (i32.const 2)))
          (i32.or (i32.or (local.get $symbol) (i32.shl (i32.sub (local.get $symbol) (i32.const 1)) (i32.const 9))) (i32.shl (local.get $ctx) (i32.const 16))))
        (global.set $wpUsed (i32.add (global.get $wpUsed) (i32.const 1)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $samples)))
  (call $wpFlush (local.get $tags) (local.get $extra) (local.get $freqs) (local.get $alphabet) (local.get $runs) (local.get $run))
  (global.get $wpUsed))

;; opaque (UP10, kernels.mjs gabBand with `packed`): 1 when every pixel of $bytes of RGBA at $rgba has alpha 255.
(func (export "opaque") (param $rgba i32) (param $bytes i32) (result i32)
  (local $p i32) (local $end i32) (local $acc v128)
  (local.set $acc (v128.const i32x4 -1 -1 -1 -1))
  (local.set $p (local.get $rgba))
  (local.set $end (i32.add (local.get $rgba) (i32.and (local.get $bytes) (i32.const -16))))
  (block $done (loop $quads
    (br_if $done (i32.ge_u (local.get $p) (local.get $end)))
    (local.set $acc (v128.and (local.get $acc) (v128.load (local.get $p))))
    (local.set $p (i32.add (local.get $p) (i32.const 16)))
    (br $quads)))
  (local.set $end (i32.add (local.get $rgba) (local.get $bytes)))
  (block $tailDone (loop $tail
    (br_if $tailDone (i32.ge_u (local.get $p) (local.get $end)))
    (local.set $acc (v128.and (local.get $acc) (i32x4.splat (i32.load (local.get $p)))))
    (local.set $p (i32.add (local.get $p) (i32.const 4)))
    (br $tail)))
  (i32x4.all_true (i32x4.ge_u (local.get $acc) (v128.const i32x4 0xff000000 0xff000000 0xff000000 0xff000000))))

;; unpackGroup (UP10, kernels.mjs acGroup on a packed picture): one group's AC levels made dense where acGroup reads
;; them: for each channel c, $bw x $bh blocks of 64 i16 from $coeffs + c * $cstride (DC left zero, acGroup reads AC
;; alone), from the group's packed entries in channel, row and block order ($at positions, $val values) and its counts
;; at $counts + c * $bw * $bh.
(func (export "unpackGroup") (param $coeffs i32) (param $cstride i32) (param $bw i32) (param $bh i32) (param $counts i32)
  (param $at i32) (param $val i32)
  (local $c i32) (local $b i32) (local $blocks i32) (local $base i32) (local $p i32) (local $end i32) (local $n i32) (local $left i32)
  (local.set $blocks (i32.mul (local.get $bw) (local.get $bh)))
  (local.set $c (i32.const 0))
  (loop $channels
    (local.set $base (i32.add (local.get $coeffs) (i32.mul (local.get $c) (local.get $cstride))))
    (local.set $p (local.get $base))
    (local.set $end (i32.add (local.get $base) (i32.shl (local.get $blocks) (i32.const 7))))
    (block $zeroDone (loop $zero
      (br_if $zeroDone (i32.ge_u (local.get $p) (local.get $end)))
      (v128.store (local.get $p) (v128.const i32x4 0 0 0 0))
      (v128.store offset=16 (local.get $p) (v128.const i32x4 0 0 0 0))
      (local.set $p (i32.add (local.get $p) (i32.const 32)))
      (br $zero)))
