          (local.set $out (i32.add (local.get $out) (i32.const 4)))
          (local.set $acc (i64.shr_u (local.get $acc) (i64.const 32)))
          (local.set $pending (i32.sub (local.get $pending) (i32.const 32)))))
      (br_if $forwardDone (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $m (i32.load8_u (i32.add (local.get $meta) (local.get $i))))
      (if (i32.and (local.get $m) (i32.const 64))
        (then
          (local.set $acc (i64.or (local.get $acc) (i64.shl (i64.extend_i32_u (i32.load16_u (i32.add (local.get $emitted) (i32.shl (local.get $i) (i32.const 1)))))
            (i64.extend_i32_u (local.get $pending)))))
