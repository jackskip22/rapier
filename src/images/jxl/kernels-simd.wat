        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $xL2 (i32.lt_u (local.get $x) (local.get $w))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $yL (i32.lt_u (local.get $y) (local.get $h)))))

  (func $invCombine (param $s i32) (param $size i32)
    (local $half i32) (local $x i32) (local $y i32) (local $p i32) (local $sc i32)
