          (local.set $bw (i32.load offset=20 (local.get $job))) (local.set $bh (i32.load offset=24 (local.get $job)))
          (local.set $order (i32.load offset=28 (local.get $job))) (local.set $size (i32.load offset=40 (local.get $job)))
