          (local.set $luma (i32.add (i32.sub (local.get $at) (i32.shl (local.get $c) (i32.const 9))) (i32.const 512)))
          (local.set $qt (i32.add (local.get $quant) (i32.shl (local.get $c) (i32.const 9))))
          (local.set $th (i32.add (local.get $thr) (i32.shl (local.get $c) (i32.const 9))))
          (local.set $dst (i32.add (local.get $levels) (i32.shl (local.get $out) (i32.const 7))))
          (local.set $nzv (v128.const i64x2 0 0))
          (local.set $ac (v128.const i64x2 0 -1))
          (local.set $finev (f64x2.replace_lane 1 (v128.const f64x2 1 1) (local.get $fine)))
          (local.set $k (i32.const 0))
