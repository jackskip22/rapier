      (f32.store (i32.add (local.get $dcH) (local.get $m)) (local.get $x0h))
      (local.set $e0 (f32.sub (local.get $x0h) (local.get $x0)))
      (local.set $e02 (f32.mul (local.get $e0) (local.get $e0)))
      (local.set $m (i32.add (local.get $n30) (i32.const 40)))
      (if (i32.and (f32.eq (local.get $x0h) (f32.const 0)) (f32.ne (local.get $x0) (f32.const 0)))
        (then (f32.store (i32.add (local.get $bZro) (local.get $m)) (local.get $e02)))
        (else (f32.store (i32.add (local.get $bRnd) (local.get $m)) (local.get $e02))))
      (f32.store (i32.add (local.get $bCfl) (local.get $m)) (local.get $e02))

      (local.set $acO (f32.const 0))
      (local.set $k (i32.const 1))
      (loop $yLoop
        (local.set $idx (i32.shl (local.get $k) (i32.const 2)))
        (local.set $yk (f32.load (i32.add (local.get $yOff) (local.get $idx))))
        (local.set $yk2 (f32.mul (local.get $yk) (local.get $yk)))
        (local.set $m (i32.add (local.get $n30) (i32.shl (i32.add (i32.const 10) (i32.load8_u (i32.add (local.get $bandMap) (local.get $k)))) (i32.const 2))))
        (f32.store (i32.add (local.get $bSig) (local.get $m)) (f32.add (f32.load (i32.add (local.get $bSig) (local.get $m))) (local.get $yk2)))
