  (func $coeffPlanes (export "coeffPlanes") (param $mode i32) (param $a i32)
    (local $n i32) (local $i i32) (local $c i32) (local $o i32) (local $u i32) (local $v i32) (local $x i32) (local $y i32) (local $k i32)
    (local $bx i32) (local $by i32) (local $bw i32) (local $bh i32) (local $w i32) (local $h i32) (local $area i32) (local $size i32)
    (local $stride i32) (local $W i32) (local $bandY0 i32) (local $cflWidth i32) (local $dc0 i32) (local $dcStride i32)
    (local $fields i32) (local $cflX i32) (local $cflB i32) (local $one i32) (local $cells i32) (local $tables i32)
    (local $tr i32) (local $lumaAC i32) (local $lumaNz i32) (local $means i32) (local $llfTmp i32) (local $llfOut i32)
    (local $smallPx i32) (local $smallDct i32) (local $smallScratch i32)
    (local $blocks i32) (local $rec i32) (local $id i32) (local $order i32) (local $steps i32) (local $q i32)
    (local $tall i32) (local $L i32) (local $packed i32) (local $nNz i32) (local $pos i32) (local $out i32) (local $src i32) (local $dst i32)
    (local $lgW i32) (local $lgH i32) (local $lgL i32) (local $lgS i32)
    (local $qs f64) (local $base f64) (local $div f64) (local $kx f64) (local $kb f64) (local $k3 f64) (local $r1 f64)
    (local $dcStepC f64) (local $dcStep1 f64) (local $dcVal f64) (local $mul f64) (local $shift f64)
    (local $inv2040 v128)

    ;; Mode 0: rcLlfFromDC
    (if (i32.eqz (local.get $mode)) (then
      (call $llfBlock
        (i32.load offset=0 (local.get $a)) (i32.load offset=4 (local.get $a)) (i32.load offset=8 (local.get $a))
        (i32.load offset=12 (local.get $a)) (i32.load offset=16 (local.get $a)) (i32.load offset=20 (local.get $a))
        (i32.load offset=24 (local.get $a)) (i32.load offset=28 (local.get $a)))
      (return)))

    ;; Mode 1: Fixed-DCT8 strip
    (if (i32.eq (local.get $mode) (i32.const 1)) (then
      (local.set $dc0 (i32.load offset=0 (local.get $a)))
      (local.set $dcStride (i32.load offset=4 (local.get $a)))
      (local.set $bx (i32.load offset=8 (local.get $a)))
      (local.set $by (i32.load offset=12 (local.get $a)))
      (local.set $bw (i32.load offset=16 (local.get $a)))
      (local.set $bh (i32.load offset=20 (local.get $a)))
      (local.set $out (i32.load offset=24 (local.get $a)))
      (local.set $cells (i32.load offset=28 (local.get $a)))
