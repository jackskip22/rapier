                      (local.get $cuts) (local.get $alphabet) (local.get $hist) (local.get $table) (local.get $raw)
                      (local.get $scratch) (i32.add (local.get $out) (i32.const 32)) (i32.const 0)
                      (local.get $targetDense) (local.get $initStats) (local.get $limits)
                      (local.get $minB) (local.get $maxB) (local.get $stride)
                      (local.get $splitAt) (local.get $best) (local.get $zeroRaw16)))))))
            (local.set $offset (i32.add (local.get $offset) (i32.shl (local.get $size) (i32.const 2))))
            (if (i32.ge_s (local.get $bin) (i32.const 0))
              (then
                (local.set $price (f64.add (f64.load offset=40 (local.get $out)) (f64.load offset=48 (local.get $out))))
                (if (f64.lt (local.get $price) (local.get $best))
                  (then
