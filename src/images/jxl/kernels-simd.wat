        (br_if $qBlocks (i32.lt_u (local.get $n) (local.get $count))))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br_if $tilesLoop (i32.lt_u (local.get $t) (local.get $tiles)))))
;; gradEvents' plan outputs (vardct.mjs planModularChannel's tags, raw values and symbol frequencies), 0: none.
(global $geWide (mut i32) (i32.const 0))
(global $geHash (mut i32) (i32.const 0))
(global $geTags (mut i32) (i32.const 0))
(global $geExtra (mut i32) (i32.const 0))
(global $geFreq (mut i32) (i32.const 0))
(global $geUsed (mut i32) (i32.const 0))
;; One event of the plan: its tag (symbol | raw-bit count << 9) and raw value, and its symbol counted.
(func $gePut (param $symbol i32) (param $bits i32) (param $raw i32)
  (local $at i32)
  (i32.store (i32.add (global.get $geTags) (i32.shl (global.get $geUsed) (i32.const 2))) (i32.or (local.get $symbol) (i32.shl (local.get $bits) (i32.const 9))))
  (i32.store (i32.add (global.get $geExtra) (i32.shl (global.get $geUsed) (i32.const 2))) (local.get $raw))
  (global.set $geUsed (i32.add (global.get $geUsed) (i32.const 1)))
  (local.set $at (i32.add (global.get $geFreq) (i32.shl (local.get $symbol) (i32.const 2))))
  (i32.store (local.get $at) (i32.add (i32.load (local.get $at)) (i32.const 1))))
;; gradEvents (U11, lf-coding.mjs plainOrFixedLfCoder): the events vardct.mjs planModularChannel makes of an i16 plane
;; ($w x $h at $plane) under the gradient predictor, counted: each literal's packed residual v (below 2^17) at
;; $counts + 4v, the first time a value is seen also listed at $touched; each run token (RUN_CONFIG, a run of 8 or more
;; zeros: a literal zero, then the token of run - 8) at $counts + 4 (131072 + token). $stats: the events, the run tokens'
;; raw bits, the touched values.
;; A packed value of 2^17 or more (a plane past 16 bits, gradEvents' $wide) is counted in the open-addressed table at
;; $geHash: 2^17 slots of (value, count), the value 0 marking a free slot.
(func $geSlot (param $v i32) (result i32)
  (local $s i32) (local $at i32)
  (local.set $s (i32.shr_u (i32.mul (local.get $v) (i32.const 0x9e3779b1)) (i32.const 15)))
  (block $found (loop $probe
    (local.set $at (i32.add (global.get $geHash) (i32.shl (local.get $s) (i32.const 3))))
    (br_if $found (i32.eq (i32.load (local.get $at)) (local.get $v)))
    (if (i32.eqz (i32.load (local.get $at))) (then (i32.store (local.get $at) (local.get $v)) (br $found)))
    (local.set $s (i32.and (i32.add (local.get $s) (i32.const 1)) (i32.const 131071)))
    (br $probe)))
  (i32.add (local.get $at) (i32.const 4)))
(func $geAt (param $p i32) (result i32)
  (if (result i32) (global.get $geWide) (then (i32.load (local.get $p))) (else (i32.load16_s (local.get $p)))))
(func $geLit (param $counts i32) (param $touched i32) (param $stats i32) (param $v i32)
  (local $at i32) (local $c i32)
  (local.set $at (if (result i32) (i32.lt_u (local.get $v) (i32.const 131072))
    (then (i32.add (local.get $counts) (i32.shl (local.get $v) (i32.const 2)))) (else (call $geSlot (local.get $v)))))
  (local.set $c (i32.load (local.get $at)))
  (if (i32.eqz (local.get $c)) (then
    (i32.store (i32.add (local.get $touched) (i32.shl (i32.load offset=8 (local.get $stats)) (i32.const 2))) (local.get $v))
    (i32.store offset=8 (local.get $stats) (i32.add (i32.load offset=8 (local.get $stats)) (i32.const 1)))))
  (i32.store (local.get $at) (i32.add (local.get $c) (i32.const 1)))
  (i32.store (local.get $stats) (i32.add (i32.load (local.get $stats)) (i32.const 1)))
  ;; The plan's literal: 0 as symbol 0, else symbol e + 1 with the e bits under its top bit.
  (if (global.get $geTags) (then
    (if (local.get $v)
      (then
        (local.set $c (i32.sub (i32.const 31) (i32.clz (local.get $v))))
        (call $gePut (i32.add (local.get $c) (i32.const 1)) (local.get $c) (i32.sub (local.get $v) (i32.shl (i32.const 1) (local.get $c)))))
      (else (call $gePut (i32.const 0) (i32.const 0) (i32.const 0)))))))
(func $geFlush (param $counts i32) (param $touched i32) (param $stats i32) (param $run i32)
  (local $v i32) (local $n i32) (local $at i32)
  (if (i32.ge_u (local.get $run) (i32.const 8))
    (then
      (call $geLit (local.get $counts) (local.get $touched) (local.get $stats) (i32.const 0))
      (local.set $v (i32.sub (local.get $run) (i32.const 8)))
      (if (i32.lt_u (local.get $v) (i32.const 16))
        (then (local.set $at (local.get $v)))
        (else
          (local.set $n (i32.sub (i32.const 31) (i32.clz (local.get $v))))
          (local.set $at (i32.add (local.get $n) (i32.const 12)))
          (i32.store offset=4 (local.get $stats) (i32.add (i32.load offset=4 (local.get $stats)) (local.get $n)))))
      ;; The plan's run token (MIN_RUN_SYMBOL + token, RUN_CONFIG's raw bits).
      (if (global.get $geTags) (then
        (call $gePut (i32.add (local.get $at) (i32.const 224)) (local.get $n)
          (select (i32.sub (local.get $v) (i32.shl (i32.const 1) (local.get $n))) (i32.const 0) (local.get $n)))))
      (local.set $at (i32.add (local.get $counts) (i32.shl (i32.add (local.get $at) (i32.const 131072)) (i32.const 2))))
      (i32.store (local.get $at) (i32.add (i32.load (local.get $at)) (i32.const 1)))
      (i32.store (local.get $stats) (i32.add (i32.load (local.get $stats)) (i32.const 1))))
    (else
      (block $done (loop $zeros
        (br_if $done (i32.eqz (local.get $run)))
        (call $geLit (local.get $counts) (local.get $touched) (local.get $stats) (i32.const 0))
        (local.set $run (i32.sub (local.get $run) (i32.const 1)))
        (br $zeros))))))
(func (export "gradEvents") (param $plane i32) (param $w i32) (param $h i32) (param $counts i32) (param $touched i32) (param $stats i32)
  (param $tags i32) (param $extra i32) (param $freq i32) (param $wide i32) (param $hash i32)
  (local $x i32) (local $y i32) (local $p i32) (local $row i32) (local $left i32) (local $top i32) (local $nw i32) (local $grad i32)
  (local $lo i32) (local $hi i32) (local $pred i32) (local $r i32) (local $run i32) (local $es i32)
  ;; $wide: the plane's samples are i32 (else i16), its large packed values counted at $hash (geSlot). Residuals wrap to
  ;; 32 bits, as the plan's u32 tags and raw values keep them.
  (global.set $geWide (local.get $wide)) (global.set $geHash (local.get $hash))
  (local.set $es (select (i32.const 4) (i32.const 2) (local.get $wide)))
  (i64.store (local.get $stats) (i64.const 0)) (i32.store offset=8 (local.get $stats) (i32.const 0))
  ;; With $tags (not 0), the plan too: tags and raw values from $tags and $extra, symbol counts added at $freq; the count
  ;; of events at $stats + 12.
  (global.set $geTags (local.get $tags)) (global.set $geExtra (local.get $extra)) (global.set $geFreq (local.get $freq)) (global.set $geUsed (i32.const 0))
  (local.set $row (i32.mul (local.get $w) (local.get $es)))
  (local.set $p (local.get $plane))
  (local.set $y (i32.const 0))
  (block $rowsDone (loop $rows
    (br_if $rowsDone (i32.ge_u (local.get $y) (local.get $h)))
    (local.set $x (i32.const 0))
    (block $colsDone (loop $cols
      (br_if $colsDone (i32.ge_u (local.get $x) (local.get $w)))
      (local.set $pred (i32.const 0))
      (if (i32.or (local.get $x) (local.get $y)) (then
        (local.set $left (if (result i32) (local.get $x) (then (call $geAt (i32.sub (local.get $p) (local.get $es))))
          (else (call $geAt (i32.sub (local.get $p) (local.get $row))))))
        (local.set $top (if (result i32) (local.get $y) (then (call $geAt (i32.sub (local.get $p) (local.get $row)))) (else (local.get $left))))
        (local.set $nw (if (result i32) (i32.and (i32.ne (local.get $x) (i32.const 0)) (i32.ne (local.get $y) (i32.const 0)))
          (then (call $geAt (i32.sub (i32.sub (local.get $p) (local.get $row)) (local.get $es)))) (else (local.get $left))))
        (local.set $grad (i32.sub (i32.add (local.get $left) (local.get $top)) (local.get $nw)))
        (local.set $lo (select (local.get $left) (local.get $top) (i32.lt_s (local.get $left) (local.get $top))))
        (local.set $hi (select (local.get $top) (local.get $left) (i32.lt_s (local.get $left) (local.get $top))))
        (local.set $pred (select (local.get $lo) (select (local.get $hi) (local.get $grad) (i32.gt_s (local.get $grad) (local.get $hi)))
          (i32.lt_s (local.get $grad) (local.get $lo))))))
      (local.set $r (i32.sub (call $geAt (local.get $p)) (local.get $pred)))
      (if (i32.eqz (local.get $r))
        (then (local.set $run (i32.add (local.get $run) (i32.const 1))))
        (else
          (call $geFlush (local.get $counts) (local.get $touched) (local.get $stats) (local.get $run))
          (local.set $run (i32.const 0))
          (call $geLit (local.get $counts) (local.get $touched) (local.get $stats)
            (select (i32.add (local.get $r) (local.get $r)) (i32.sub (i32.sub (i32.const 0) (i32.add (local.get $r) (local.get $r))) (i32.const 1))
              (i32.ge_s (local.get $r) (i32.const 0))))))
      (local.set $p (i32.add (local.get $p) (local.get $es)))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br $cols)))
    (local.set $y (i32.add (local.get $y) (i32.const 1)))
    (br $rows)))
  (call $geFlush (local.get $counts) (local.get $touched) (local.get $stats) (local.get $run))
