            (then (local.set $zeroRaw16 (i32.const 0))))
          (local.set $s (i32.add (local.get $s) (i32.const 1)))
          (br_if $chkRaw16 (i32.lt_u (local.get $s) (local.get $end))))))
    (local.set $maxLimit (i32.const 1))
    (local.set $c (i32.const 0))
