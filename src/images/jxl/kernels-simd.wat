    (local.set $w8 (i32.shl (local.get $w) (i32.const 3)))
    (local.set $h8 (i32.shl (local.get $h) (i32.const 3)))
    (local.set $str8 (i32.shl (local.get $stride) (i32.const 3)))
    (local.set $r (i32.const 0))
    (loop $rows
      (local.set $row (i32.add (local.get $pix) (i32.mul (local.get $r) (local.get $str8))))
      (local.set $row1 (i32.add (local.get $row) (local.get $str8)))
