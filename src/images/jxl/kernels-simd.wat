                    (local.set $c (i32.add (local.get $c) (i32.const 1)))
                    (br_if $rem8 (i32.lt_u (local.get $c) (local.get $kinds)))))))))
        (else
          (local.set $c (i32.const 0))
          (loop $rem0
            (local.set $p (i32.add (local.get $row) (i32.shl (i32.load8_u (i32.add (local.get $symPtr) (local.get $c))) (i32.const 2))))
            (i32.store (local.get $p) (i32.add (i32.load (local.get $p)) (local.get $delta)))
            (local.set $row (i32.add (local.get $row) (local.get $strideBytes)))
            (local.set $c (i32.add (local.get $c) (i32.const 1)))
            (br_if $rem0 (i32.lt_u (local.get $c) (local.get $kinds))))))
      (br_if $samples (i32.lt_u (local.get $i) (local.get $total)))))

  ;; Exact sampled-tree count and sweep with zero-raw fast path for symbols < 16, provable forward monotonicity
  ;; cutoff, and adaptive coarse-interval lower-bound skipping that never changes the chosen split.
  (func $sampled
    (param $symbols i32) (param $total i32) (param $kinds i32)
    (param $indices i32) (param $cuts i32) (param $alphabet i32)
    (param $hist i32) (param $table i32) (param $raw i32)
    (param $scratch i32) (param $out i32) (param $given i32)
    (param $targetDense i32) (param $initStats i32) (param $limits i32)
    (param $minB i32) (param $maxB i32) (param $stride i32)
    (param $splitAt i32) (param $nodeBest f64)
    (param $zeroRaw16 i32) (result i32)
    (local $bins i32) (local $baseB i32) (local $tableBins i32) (local $activeBins i32) (local $sweepEnd i32)
    (local $rowStride i32) (local $strideBytes i32) (local $binStrideBytes i32) (local $denseBytes i32)
    (local $cells i32) (local $lowBytes i32) (local $stateBytes i32) (local $maxDenseBytes i32)
    (local $low i32)
    (local $dense i32) (local $workDense i32) (local $start i32) (local $next i32)
    (local $useDense i32) (local $c i32) (local $s i32) (local $i i32)
    (local $b i32) (local $relB i32) (local $j i32) (local $v i32) (local $l i32) (local $h i32)
    (local $p i32) (local $lo i32) (local $hi i32) (local $symPtr i32)
    (local $stats i32) (local $row i32) (local $from i32) (local $end i32)
    (local $moved i32) (local $lowCount i32) (local $mask i32) (local $sym i32)
    (local $loSelected i32) (local $hiSelected i32) (local $bestBin i32)
    (local $t f64) (local $u f64) (local $r f64)
    (local $delta v128) (local $totals v128) (local $rawTotals v128) (local $costs v128)
    (local $lowBase f64) (local $highBase f64)
    (local $loBits f64) (local $hiBits f64) (local $price f64) (local $best f64)
    (if (i32.or (i32.lt_u (local.get $total) (i32.const 64))
          (i32.or (i32.eqz (local.get $cuts))
            (i32.or (i32.eqz (local.get $kinds)) (i32.eqz (local.get $alphabet)))))
      (then (return (i32.const -1))))
    (local.set $bins (i32.add (local.get $cuts) (i32.const 1)))
    (local.set $cells (i32.mul (local.get $kinds) (local.get $alphabet)))
    (local.set $lowBytes (i32.and (i32.add (i32.shl (local.get $cells) (i32.const 2)) (i32.const 15)) (i32.const -16)))
    (local.set $stateBytes (i32.add (i32.shl (local.get $kinds) (i32.const 5)) (local.get $lowBytes)))
    (local.set $maxDenseBytes (i32.and (i32.add (i32.shl (i32.mul (local.get $bins) (local.get $cells)) (i32.const 2)) (i32.const 15)) (i32.const -16)))
    (if (local.get $given)
      (then
        (local.set $minB (i32.const 0))
        (local.set $maxB (local.get $cuts))
        (local.set $baseB (i32.const 0))
        (local.set $tableBins (local.get $bins))
        (local.set $activeBins (local.get $bins))
        (local.set $sweepEnd (local.get $cuts))
        (local.set $rowStride (local.get $alphabet)))
      (else
        (if (i32.ge_u (local.get $minB) (local.get $maxB))
          (then
            (if (local.get $targetDense)
              (then
                (memory.fill (local.get $targetDense) (i32.const 0) (i32.shl (i32.mul (local.get $bins) (local.get $cells)) (i32.const 2)))
                (if (i32.lt_u (local.get $minB) (local.get $bins))
                  (then
                    (memory.copy
                      (i32.add (local.get $targetDense) (i32.shl (i32.mul (local.get $minB) (local.get $cells)) (i32.const 2)))
                      (local.get $hist)
                      (i32.shl (local.get $cells) (i32.const 2)))))))
            (return (i32.const -1))))
        (local.set $activeBins (i32.add (i32.sub (local.get $maxB) (local.get $minB)) (i32.const 1)))
        (local.set $sweepEnd (select (local.get $maxB) (local.get $cuts) (i32.lt_u (local.get $maxB) (local.get $cuts))))
        (if (local.get $targetDense)
          (then
            (local.set $baseB (i32.const 0))
            (local.set $tableBins (local.get $bins))
            (local.set $rowStride (local.get $alphabet)))
          (else
            (local.set $baseB (local.get $minB))
            (local.set $tableBins (local.get $activeBins))
            (local.set $rowStride (local.get $stride))))))
    (local.set $strideBytes (i32.shl (local.get $rowStride) (i32.const 2)))
    (local.set $binStrideBytes (i32.mul (local.get $kinds) (local.get $strideBytes)))
    (local.set $denseBytes (i32.mul (local.get $tableBins) (local.get $binStrideBytes)))
    (local.set $low (i32.add (local.get $scratch) (i32.shl (local.get $kinds) (i32.const 5))))
    (local.set $workDense (i32.add (local.get $scratch) (local.get $stateBytes)))
    (local.set $dense (select (local.get $targetDense) (local.get $workDense) (local.get $targetDense)))
    (local.set $start (i32.add (local.get $workDense) (local.get $maxDenseBytes)))
    (local.set $next (i32.add (local.get $start) (i32.shl (i32.add (local.get $bins) (i32.const 1)) (i32.const 2))))
    (local.set $useDense (i32.or (i32.or (local.get $given) (i32.ne (local.get $targetDense) (i32.const 0)))
      (i32.gt_u (i32.shl (local.get $total) (i32.const 2))
