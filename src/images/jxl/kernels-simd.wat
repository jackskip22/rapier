                (i32.shl (i32.add (i32.mul (i32.add (local.get $rowOff) (i32.add (i32.shl (local.get $by) (i32.const 3)) (local.get $y))) (local.get $Wc))
                  (i32.add (local.get $colOff) (i32.add (i32.shl (local.get $t) (i32.const 6)) (i32.shl (local.get $bx) (i32.const 3))))) (i32.const 3))))
              (local.set $dst (i32.add (local.get $tile) (i32.add (i32.add (i32.mul (i32.add (i32.mul (local.get $by) (local.get $bw)) (local.get $bx)) (i32.const 1536))
                (i32.shl (local.get $c) (i32.const 9))) (i32.shl (local.get $y) (i32.const 6)))))
              (v128.store (local.get $dst) (v128.load (local.get $src)))
              (v128.store offset=16 (local.get $dst) (v128.load offset=16 (local.get $src)))
              (v128.store offset=32 (local.get $dst) (v128.load offset=32 (local.get $src)))
              (v128.store offset=48 (local.get $dst) (v128.load offset=48 (local.get $src)))
              (local.set $y (i32.add (local.get $y) (i32.const 1)))
              (br_if $gy (i32.lt_u (local.get $y) (i32.const 8))))
            (local.set $c (i32.add (local.get $c) (i32.const 1)))
            (br_if $gc (i32.lt_u (local.get $c) (i32.const 3))))
          (local.set $bx (i32.add (local.get $bx) (i32.const 1)))
          (br_if $gbx (i32.lt_u (local.get $bx) (local.get $bw))))
        (local.set $by (i32.add (local.get $by) (i32.const 1)))
        (br_if $gby (i32.lt_u (local.get $by) (local.get $bh))))
      (call $dct (local.get $tile) (local.get $count) (local.get $basis) (local.get $paired) (local.get $scratch))
      ;; The tile's CfL sums, in block order, then k from 1.
