      (local.set $z2 (f64x2.add (f64x2.mul (f64x2.splat (f64.const 0.5411961001461969)) (local.get $u10)) (local.get $z5)))
      (local.set $z4 (f64x2.add (f64x2.mul (f64x2.splat (f64.const 1.3065629648763766)) (local.get $u12)) (local.get $z5)))
      (local.set $z3 (f64x2.mul (local.get $u11) (f64x2.splat (f64.const 0.7071067811865476))))
      (local.set $z11 (f64x2.add (local.get $t7) (local.get $z3)))
      (local.set $z13 (f64x2.sub (local.get $t7) (local.get $z3)))
      (v128.store offset=320 (local.get $p) (f64x2.add (local.get $z13) (local.get $z2)))
      (v128.store offset=192 (local.get $p) (f64x2.sub (local.get $z13) (local.get $z2)))
      (v128.store offset=64 (local.get $p) (f64x2.add (local.get $z11) (local.get $z4)))
      (v128.store offset=448 (local.get $p) (f64x2.sub (local.get $z11) (local.get $z4)))
      (local.set $i (i32.add (local.get $i) (i32.const 2)))
      (br_if $dctCols (i32.lt_u (local.get $i) (i32.const 8))))
    (local.set $k (i32.const 0))
    (loop $dctScale
      (v128.store (i32.add (local.get $o) (local.get $k)) (f64x2.mul (v128.load (i32.add (local.get $o) (local.get $k))) (v128.load (i32.add (local.get $scale) (local.get $k)))))
      (local.set $k (i32.add (local.get $k) (i32.const 16)))
      (br_if $dctScale (i32.lt_u (local.get $k) (i32.const 512))))
    (local.set $c (i32.add (local.get $c) (i32.const 1)))
    (br_if $dctChannels (i32.lt_u (local.get $c) (i32.const 3))))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (br_if $dctBlocks (i32.lt_u (local.get $n) (local.get $count))))
  (if (local.get $sums) (then
    (local.set $n (i32.const 0))
    (loop $sumBlocks
      (local.set $k (i32.const 1))
      (loop $sumCoefficients
        (local.set $p (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 1536)) (i32.shl (local.get $k) (i32.const 3)))))
        (local.set $luma (f64.load offset=512 (local.get $p)))
        (local.set $yy (f64.add (local.get $yy) (f64.mul (local.get $luma) (local.get $luma))))
        (local.set $xy (f64.add (local.get $xy) (f64.mul (f64.load (local.get $p)) (local.get $luma))))
        (local.set $bySum (f64.add (local.get $bySum) (f64.mul (f64.load offset=1024 (local.get $p)) (local.get $luma))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br_if $sumCoefficients (i32.lt_u (local.get $k) (i32.const 64))))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br_if $sumBlocks (i32.lt_u (local.get $n) (local.get $count))))
    (f64.store (local.get $sums) (local.get $yy))
    (f64.store offset=8 (local.get $sums) (local.get $xy))
    (f64.store offset=16 (local.get $sums) (local.get $bySum)))))

;; quantFastTile: channel c's levels as Int16 at out + ((c * count + n) * 64 + k) * 2 and its nonzero AC count at
;; counts + c * count + n. With $strict set, returns 1 on Int16 overflow (FAST_RANGE).
(func (export "quantTile") (param $tile i32) (param $count i32) (param $scale i32) (param $limits i32)
  (param $xRatio f64) (param $bRatio f64) (param $out i32) (param $counts i32) (param $strict i32) (result i32)
  (local $c i32) (local $n i32) (local $k i32) (local $p i32) (local $q i32) (local $nonzero i32) (local $sc i32) (local $lim i32)
  (local $value f64) (local $ratio f64) (local $dst i32) (local $luma i32)
  (local $v v128) (local $f v128) (local $r v128) (local $qv v128) (local $qs v128) (local $ratios v128)
  (loop $channels
    (local.set $sc (i32.add (local.get $scale) (i32.mul (local.get $c) (i32.const 512))))
    (local.set $lim (i32.add (local.get $limits) (i32.mul (local.get $c) (i32.const 512))))
    (local.set $ratio (select (local.get $xRatio) (local.get $bRatio) (i32.eqz (local.get $c))))
    (local.set $ratios (f64x2.splat (local.get $ratio)))
    (local.set $n (i32.const 0))
    (loop $blocks
      (local.set $p (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 1536)) (i32.mul (local.get $c) (i32.const 512)))))
      (local.set $luma (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 1536)) (i32.const 512))))
      (local.set $dst (i32.add (local.get $out) (i32.shl (i32.add (i32.mul (local.get $c) (local.get $count)) (local.get $n)) (i32.const 7))))
      (local.set $value (f64.mul (f64.load (local.get $p)) (f64.load (local.get $sc))))
      (if (i32.and (local.get $strict) (f64.ge (f64.abs (local.get $value)) (f64.const 32767.5)))
        (then (return (i32.const 1))))
      (local.set $value (select (f64.const 0)
        (f64.add (f64.floor (local.get $value)) (select (f64.const 1) (f64.const 0) (f64.ge (f64.sub (local.get $value) (f64.floor (local.get $value))) (f64.const 0.5))))
        (f64.lt (f64.abs (local.get $value)) (f64.const 0.5))))
      (i32.store16 (local.get $dst) (i32.trunc_sat_f64_s (local.get $value)))
      (local.set $nonzero (i32.const 0))
      (local.set $k (i32.const 0))
      (loop $pairs
        (local.set $v (if (result v128) (i32.eq (local.get $c) (i32.const 1))
          (then (f64x2.mul (v128.load (i32.add (local.get $p) (local.get $k))) (v128.load (i32.add (local.get $sc) (local.get $k)))))
          (else (f64x2.mul (f64x2.sub (v128.load (i32.add (local.get $p) (local.get $k)))
              (f64x2.mul (local.get $ratios) (v128.load (i32.add (local.get $luma) (local.get $k)))))
            (v128.load (i32.add (local.get $sc) (local.get $k)))))))
        (local.set $f (f64x2.floor (local.get $v)))
        (local.set $r (v128.bitselect (f64x2.add (local.get $f) (f64x2.splat (f64.const 1))) (local.get $f)
          (f64x2.ge (f64x2.sub (local.get $v) (local.get $f)) (f64x2.splat (f64.const 0.5)))))
        (local.set $qv (v128.andnot (local.get $r) (f64x2.lt (f64x2.abs (local.get $v)) (v128.load (i32.add (local.get $lim) (local.get $k))))))
        (if (local.get $strict) (then
          (if (local.get $k)
            (then (if (v128.any_true (f64x2.gt (f64x2.abs (local.get $qv)) (v128.const f64x2 32767 32767))) (then (return (i32.const 1)))))
            (else (if (f64.gt (f64.abs (f64x2.extract_lane 1 (local.get $qv))) (f64.const 32767)) (then (return (i32.const 1))))))))
        (local.set $qs (i32x4.trunc_sat_f64x2_s_zero (local.get $qv)))
        (if (local.get $k)
          (then
            (local.set $q (i32x4.extract_lane 0 (local.get $qs)))
            (i32.store16 (i32.add (local.get $dst) (i32.shr_u (local.get $k) (i32.const 2))) (local.get $q))
            (local.set $nonzero (i32.add (local.get $nonzero) (i32.ne (local.get $q) (i32.const 0))))))
        (local.set $q (i32x4.extract_lane 1 (local.get $qs)))
        (i32.store16 offset=2 (i32.add (local.get $dst) (i32.shr_u (local.get $k) (i32.const 2))) (local.get $q))
        (local.set $nonzero (i32.add (local.get $nonzero) (i32.ne (local.get $q) (i32.const 0))))
        (local.set $k (i32.add (local.get $k) (i32.const 16)))
        (br_if $pairs (i32.lt_u (local.get $k) (i32.const 512))))
      (i32.store8 (i32.add (local.get $counts) (i32.add (i32.mul (local.get $c) (local.get $count)) (local.get $n))) (local.get $nonzero))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br_if $blocks (i32.lt_u (local.get $n) (local.get $count))))
    (local.set $c (i32.add (local.get $c) (i32.const 1)))
    (br_if $channels (i32.lt_u (local.get $c) (i32.const 3))))
  (i32.const 0))

;; The RGB page frame's tiles (photo-dct.mjs rgbCoefficientSteps; capture-patched.mjs), every f64 operation the
;; JavaScript's in the same order. rgbTile: up to 8 x 8 blocks of one tile ($bw x $bh, block n = by * bw + bx at
;; $tile + n * 1536, planes R, G, B 512 bytes apart) filled with the raw samples (eight pixel rows a block row, $rowBytes
;; apart, edges already repeated), $dct, then G quantized with each block's table (its address at $tabs + n * 4: steps at
;; 0, dead zones at 1536 bytes) and held decoded (level times step over $qs) in place; then the tile's chroma-from-luma
;; sums over k 1..63 block by block (R - G) G, (B - G) G and G G, scalar in the JavaScript's order, at $sums. Levels land
;; plane by plane at $out, $count blocks a plane (rgbQuant writes R and B).
(func (export "rgbTile") (param $src i32) (param $rowBytes i32) (param $bw i32) (param $bh i32) (param $tile i32) (param $basis i32)
  (param $paired i32) (param $scratch i32) (param $tabs i32) (param $out i32) (param $qs f64) (param $sums i32)
  (local $n i32) (local $count i32) (local $y i32) (local $x i32) (local $px i32) (local $k i32) (local $p i32) (local $t i32) (local $o i32)
  (local $rg f64) (local $bg f64) (local $gg f64) (local $g f64) (local $at i32)
  (local $v v128) (local $f v128) (local $q v128) (local $qsv v128)
  (local.set $count (i32.mul (local.get $bw) (local.get $bh)))
  (loop $blocks
    (local.set $y (i32.const 0))
    (loop $rows
      (local.set $px (i32.add (local.get $src) (i32.add
        (i32.mul (i32.add (i32.shl (i32.div_u (local.get $n) (local.get $bw)) (i32.const 3)) (local.get $y)) (local.get $rowBytes))
        (i32.shl (i32.rem_u (local.get $n) (local.get $bw)) (i32.const 5)))))
      (local.set $k (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 1536)) (i32.shl (local.get $y) (i32.const 6)))))
      (local.set $x (i32.const 0))
      (loop $cols
        (v128.store (local.get $k) (f64x2.replace_lane 1 (f64x2.splat (f64.convert_i32_u (i32.load8_u (local.get $px)))) (f64.convert_i32_u (i32.load8_u offset=4 (local.get $px)))))
        (v128.store offset=512 (local.get $k) (f64x2.replace_lane 1 (f64x2.splat (f64.convert_i32_u (i32.load8_u offset=1 (local.get $px)))) (f64.convert_i32_u (i32.load8_u offset=5 (local.get $px)))))
        (v128.store offset=1024 (local.get $k) (f64x2.replace_lane 1 (f64x2.splat (f64.convert_i32_u (i32.load8_u offset=2 (local.get $px)))) (f64.convert_i32_u (i32.load8_u offset=6 (local.get $px)))))
        (local.set $px (i32.add (local.get $px) (i32.const 8)))
        (local.set $k (i32.add (local.get $k) (i32.const 16)))
        (local.set $x (i32.add (local.get $x) (i32.const 2)))
        (br_if $cols (i32.lt_u (local.get $x) (i32.const 8))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (i32.const 8))))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (br_if $blocks (i32.lt_u (local.get $n) (local.get $count))))
  (call $dctButterfly (local.get $tile) (local.get $count) (local.get $basis))
  (local.set $qsv (f64x2.splat (local.get $qs)))
  (local.set $n (i32.const 0))
  (loop $quantize
    (local.set $t (i32.load (i32.add (local.get $tabs) (i32.shl (local.get $n) (i32.const 2)))))
    (local.set $p (i32.add (local.get $tile) (i32.add (i32.mul (local.get $n) (i32.const 1536)) (i32.const 512))))
    (local.set $o (i32.add (local.get $out) (i32.shl (i32.add (local.get $count) (local.get $n)) (i32.const 7))))
    (local.set $k (i32.const 0))
    (loop $pairs
      ;; v = sum * qs / step; 0 inside the dead zone, else Math.round; held = level * step / qs.
      (local.set $v (f64x2.div (f64x2.mul (v128.load (i32.add (local.get $p) (local.get $k))) (local.get $qsv))
        (v128.load offset=512 (i32.add (local.get $t) (local.get $k)))))
      (local.set $f (f64x2.floor (local.get $v)))
      (local.set $q (v128.andnot
        (v128.bitselect (f64x2.add (local.get $f) (f64x2.splat (f64.const 1))) (local.get $f)
          (f64x2.ge (f64x2.sub (local.get $v) (local.get $f)) (f64x2.splat (f64.const 0.5))))
        (f64x2.lt (f64x2.abs (local.get $v)) (v128.load offset=2048 (i32.add (local.get $t) (local.get $k))))))
      (local.set $at (i32.trunc_sat_f64_s (f64x2.extract_lane 0 (local.get $q))))
      (i32.store16 (i32.add (local.get $o) (i32.shr_u (local.get $k) (i32.const 2))) (local.get $at))
      (local.set $at (i32.trunc_sat_f64_s (f64x2.extract_lane 1 (local.get $q))))
      (i32.store16 offset=2 (i32.add (local.get $o) (i32.shr_u (local.get $k) (i32.const 2))) (local.get $at))
      (v128.store (i32.add (local.get $p) (local.get $k))
        (f64x2.div (f64x2.mul (local.get $q) (v128.load offset=512 (i32.add (local.get $t) (local.get $k)))) (local.get $qsv)))
      (local.set $k (i32.add (local.get $k) (i32.const 16)))
      (br_if $pairs (i32.lt_u (local.get $k) (i32.const 512))))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (br_if $quantize (i32.lt_u (local.get $n) (local.get $count))))
  (local.set $n (i32.const 0))
  (loop $tileSums
    (local.set $p (i32.add (local.get $tile) (i32.mul (local.get $n) (i32.const 1536))))
    (local.set $k (i32.const 8))
    (loop $terms
      (local.set $at (i32.add (local.get $p) (local.get $k)))
      (local.set $g (f64.load offset=512 (local.get $at)))
      (local.set $rg (f64.add (local.get $rg) (f64.mul (f64.sub (f64.load (local.get $at)) (local.get $g)) (local.get $g))))
      (local.set $bg (f64.add (local.get $bg) (f64.mul (f64.sub (f64.load offset=1024 (local.get $at)) (local.get $g)) (local.get $g))))
      (local.set $gg (f64.add (local.get $gg) (f64.mul (local.get $g) (local.get $g))))
      (local.set $k (i32.add (local.get $k) (i32.const 8)))
      (br_if $terms (i32.lt_u (local.get $k) (i32.const 512))))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (br_if $tileSums (i32.lt_u (local.get $n) (local.get $count))))
  (f64.store (local.get $sums) (local.get $rg))
  (f64.store offset=8 (local.get $sums) (local.get $bg))
  (f64.store offset=16 (local.get $sums) (local.get $gg)))

;; rgbTile's R and B levels: each (sample - a G) qs / step, a 1 at DC and $ax ($ab for B) elsewhere, with each block's
;; table (R steps at 0, B at 1024, their dead zones at 1536 and 2560 bytes), rounded as G; R at $out, B two planes on.
(func (export "rgbQuant") (param $tile i32) (param $count i32) (param $tabs i32) (param $ax f64) (param $ab f64) (param $out i32) (param $qs f64)
  (local $n i32) (local $k i32) (local $p i32) (local $t i32) (local $o i32) (local $c i32)
  (local $v v128) (local $f v128) (local $qsv v128) (local $a v128) (local $first v128) (local $rest v128) (local $q0 v128) (local $q1 v128) (local $q2 v128) (local $q3 v128)
  (local.set $qsv (f64x2.splat (local.get $qs)))
  (loop $planes
    (local.set $rest (f64x2.splat (select (local.get $ax) (local.get $ab) (i32.eqz (local.get $c)))))
    (local.set $first (f64x2.replace_lane 0 (local.get $rest) (f64.const 1)))
    (local.set $n (i32.const 0))
    (loop $blocks
      (local.set $t (i32.add (i32.load (i32.add (local.get $tabs) (i32.shl (local.get $n) (i32.const 2)))) (i32.shl (local.get $c) (i32.const 9))))
      (local.set $p (i32.add (local.get $tile) (i32.mul (local.get $n) (i32.const 1536))))
      (local.set $o (i32.add (local.get $out) (i32.shl (i32.add (i32.mul (local.get $c) (local.get $count)) (local.get $n)) (i32.const 7))))
      (local.set $k (i32.const 0))
      (loop $eights
        (local.set $a (select (result v128) (local.get $rest) (local.get $first) (local.get $k)))
        (local.set $v (f64x2.div (f64x2.mul (f64x2.sub (v128.load offset=0 (i32.add (i32.add (local.get $p) (i32.shl (local.get $c) (i32.const 9))) (local.get $k)))
            (f64x2.mul (local.get $a) (v128.load offset=512 (i32.add (local.get $p) (local.get $k))))) (local.get $qsv))
          (v128.load offset=0 (i32.add (local.get $t) (local.get $k)))))
        (local.set $f (f64x2.floor (local.get $v)))
        (local.set $q0 (i32x4.trunc_sat_f64x2_s_zero (v128.andnot
          (v128.bitselect (f64x2.add (local.get $f) (f64x2.splat (f64.const 1))) (local.get $f)
            (f64x2.ge (f64x2.sub (local.get $v) (local.get $f)) (f64x2.splat (f64.const 0.5))))
          (f64x2.lt (f64x2.abs (local.get $v)) (v128.load offset=1536 (i32.add (local.get $t) (local.get $k)))))))
        (local.set $a (local.get $rest))
        (local.set $v (f64x2.div (f64x2.mul (f64x2.sub (v128.load offset=16 (i32.add (i32.add (local.get $p) (i32.shl (local.get $c) (i32.const 9))) (local.get $k)))
            (f64x2.mul (local.get $a) (v128.load offset=528 (i32.add (local.get $p) (local.get $k))))) (local.get $qsv))
          (v128.load offset=16 (i32.add (local.get $t) (local.get $k)))))
        (local.set $f (f64x2.floor (local.get $v)))
        (local.set $q1 (i32x4.trunc_sat_f64x2_s_zero (v128.andnot
          (v128.bitselect (f64x2.add (local.get $f) (f64x2.splat (f64.const 1))) (local.get $f)
            (f64x2.ge (f64x2.sub (local.get $v) (local.get $f)) (f64x2.splat (f64.const 0.5))))
          (f64x2.lt (f64x2.abs (local.get $v)) (v128.load offset=1552 (i32.add (local.get $t) (local.get $k)))))))
        (local.set $a (local.get $rest))
        (local.set $v (f64x2.div (f64x2.mul (f64x2.sub (v128.load offset=32 (i32.add (i32.add (local.get $p) (i32.shl (local.get $c) (i32.const 9))) (local.get $k)))
            (f64x2.mul (local.get $a) (v128.load offset=544 (i32.add (local.get $p) (local.get $k))))) (local.get $qsv))
          (v128.load offset=32 (i32.add (local.get $t) (local.get $k)))))
        (local.set $f (f64x2.floor (local.get $v)))
        (local.set $q2 (i32x4.trunc_sat_f64x2_s_zero (v128.andnot
          (v128.bitselect (f64x2.add (local.get $f) (f64x2.splat (f64.const 1))) (local.get $f)
            (f64x2.ge (f64x2.sub (local.get $v) (local.get $f)) (f64x2.splat (f64.const 0.5))))
          (f64x2.lt (f64x2.abs (local.get $v)) (v128.load offset=1568 (i32.add (local.get $t) (local.get $k)))))))
        (local.set $a (local.get $rest))
        (local.set $v (f64x2.div (f64x2.mul (f64x2.sub (v128.load offset=48 (i32.add (i32.add (local.get $p) (i32.shl (local.get $c) (i32.const 9))) (local.get $k)))
            (f64x2.mul (local.get $a) (v128.load offset=560 (i32.add (local.get $p) (local.get $k))))) (local.get $qsv))
          (v128.load offset=48 (i32.add (local.get $t) (local.get $k)))))
        (local.set $f (f64x2.floor (local.get $v)))
        (local.set $q3 (i32x4.trunc_sat_f64x2_s_zero (v128.andnot
          (v128.bitselect (f64x2.add (local.get $f) (f64x2.splat (f64.const 1))) (local.get $f)
            (f64x2.ge (f64x2.sub (local.get $v) (local.get $f)) (f64x2.splat (f64.const 0.5))))
