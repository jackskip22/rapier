      (local.set $sumWN (i32.add (local.get $teN) (local.get $teW)))
      (local.set $p0 (i32.sub (i32.add (local.get $W) (local.get $NE)) (local.get $N)))
      (local.set $p1 (i32.sub (local.get $N) (i32.shr_s (i32.mul (i32.add (local.get $sumWN) (local.get $teNE)) (i32.const 16)) (i32.const 5))))
      (local.set $p2 (i32.sub (local.get $W) (i32.shr_s (i32.mul (i32.add (local.get $sumWN) (local.get $teNW)) (i32.const 10)) (i32.const 5))))
      (local.set $p3 (i32.sub (local.get $N) (i32.shr_s (i32.mul (i32.add (i32.add (local.get $teNW) (local.get $teN)) (local.get $teNE)) (i32.const 7)) (i32.const 5))))
      (local.set $shift (i32.sub (i32.const 27) (i32.clz (i32.add (i32.add (local.get $w0) (local.get $w1)) (i32.add (local.get $w2) (local.get $w3))))))
      (local.set $w0 (i32.shr_s (local.get $w0) (local.get $shift))) (local.set $w1 (i32.shr_s (local.get $w1) (local.get $shift)))
      (local.set $w2 (i32.shr_s (local.get $w2) (local.get $shift))) (local.set $w3 (i32.shr_s (local.get $w3) (local.get $shift)))
      (local.set $sum (i32.add (i32.add (local.get $w0) (local.get $w1)) (i32.add (local.get $w2) (local.get $w3))))
      (local.set $pred (i32.wrap_i64 (i64.shr_s (i64.mul
        (i64.add (i64.extend_i32_s (i32.sub (i32.shr_s (local.get $sum) (i32.const 1)) (i32.const 1)))
          (i64.add (i64.add (i64.mul (i64.extend_i32_s (local.get $p0)) (i64.extend_i32_s (local.get $w0))) (i64.mul (i64.extend_i32_s (local.get $p1)) (i64.extend_i32_s (local.get $w1))))
            (i64.add (i64.mul (i64.extend_i32_s (local.get $p2)) (i64.extend_i32_s (local.get $w2))) (i64.mul (i64.extend_i32_s (local.get $p3)) (i64.extend_i32_s (local.get $w3))))))
        (i64.extend_i32_s (i32.load (i32.add (local.get $div) (i32.shl (i32.sub (local.get $sum) (i32.const 1)) (i32.const 2)))))) (i64.const 24))))
      ;; Clamped to W, NE and N where the errors agree in sign, without a branch: lo and hi are the three's minimum and
      ;; maximum (N below lo lowers lo, else N above hi raises hi).
      (local.set $lo (select (local.get $W) (local.get $NE) (i32.lt_s (local.get $W) (local.get $NE))))
      (local.set $hi (select (local.get $NE) (local.get $W) (i32.lt_s (local.get $W) (local.get $NE))))
      (local.set $lo (select (local.get $N) (local.get $lo) (i32.lt_s (local.get $N) (local.get $lo))))
      (local.set $hi (select (local.get $N) (local.get $hi) (i32.gt_s (local.get $N) (local.get $hi))))
      (local.set $pred (select
        (select (local.get $lo) (select (local.get $hi) (local.get $pred) (i32.gt_s (local.get $pred) (local.get $hi))) (i32.lt_s (local.get $pred) (local.get $lo)))
        (local.get $pred)
        (i32.le_s (i32.or (i32.xor (local.get $teN) (local.get $teW)) (i32.xor (local.get $teN) (local.get $teNW))) (i32.const 0))))
      (local.set $value (i32.load (local.get $p)))
      (local.set $r (i32.sub (local.get $value) (i32.shr_s (i32.add (local.get $pred) (i32.const 3)) (i32.const 3))))
      (i32.store (local.get $out) (i32.xor (i32.shl (local.get $r) (i32.const 1)) (i32.shr_s (local.get $r) (i32.const 31))))
      (local.set $v (i32.shl (local.get $value) (i32.const 3)))
      (local.set $t (i32.sub (local.get $p0) (local.get $v)))
      (local.set $e0 (i32.shr_s (i32.add (select (local.get $t) (i32.sub (i32.const 0) (local.get $t)) (i32.ge_s (local.get $t) (i32.const 0))) (i32.const 3)) (i32.const 3)))
      (i32.store (i32.add (i32.add (local.get $E0) (local.get $cur)) (i32.shl (local.get $x) (i32.const 2))) (local.get $e0))
      (local.set $eWW0 (local.get $eW0)) (local.set $eW0 (local.get $e0))
      (local.set $t (i32.sub (local.get $p1) (local.get $v)))
      (local.set $e1 (i32.shr_s (i32.add (select (local.get $t) (i32.sub (i32.const 0) (local.get $t)) (i32.ge_s (local.get $t) (i32.const 0))) (i32.const 3)) (i32.const 3)))
      (i32.store (i32.add (i32.add (local.get $E1) (local.get $cur)) (i32.shl (local.get $x) (i32.const 2))) (local.get $e1))
      (local.set $eWW1 (local.get $eW1)) (local.set $eW1 (local.get $e1))
      (local.set $t (i32.sub (local.get $p2) (local.get $v)))
      (local.set $e2 (i32.shr_s (i32.add (select (local.get $t) (i32.sub (i32.const 0) (local.get $t)) (i32.ge_s (local.get $t) (i32.const 0))) (i32.const 3)) (i32.const 3)))
      (i32.store (i32.add (i32.add (local.get $E2) (local.get $cur)) (i32.shl (local.get $x) (i32.const 2))) (local.get $e2))
      (local.set $eWW2 (local.get $eW2)) (local.set $eW2 (local.get $e2))
      (local.set $t (i32.sub (local.get $p3) (local.get $v)))
      (local.set $e3 (i32.shr_s (i32.add (select (local.get $t) (i32.sub (i32.const 0) (local.get $t)) (i32.ge_s (local.get $t) (i32.const 0))) (i32.const 3)) (i32.const 3)))
      (i32.store (i32.add (i32.add (local.get $E3) (local.get $cur)) (i32.shl (local.get $x) (i32.const 2))) (local.get $e3))
      (local.set $eWW3 (local.get $eW3)) (local.set $eW3 (local.get $e3))
      (local.set $teW (i32.sub (local.get $pred) (local.get $v)))
      (i32.store (i32.add (i32.add (local.get $T) (local.get $cur)) (i32.shl (local.get $x) (i32.const 2))) (local.get $teW))
      (local.set $W (local.get $v))
      (local.set $N (select (local.get $NE) (local.get $v) (local.get $y)))
      (local.set $teNW (local.get $teN)) (local.set $teN (local.get $teNE))
      (local.set $p (i32.add (local.get $p) (i32.const 4)))
      (local.set $out (i32.add (local.get $out) (i32.const 4)))
      (local.set $properties (i32.add (local.get $properties) (i32.const 4)))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br $xs)))
    (local.set $y (i32.add (local.get $y) (i32.const 1)))
    (br $ys))))
;; ctxIds (U11, kernels.mjs acGroup with kept tokens): each kept token's histogram id, the context map's entry (u8) for its
;; context (u16): $n of them from $ctxs to $ids.
(func (export "ctxIds") (param $ctxs i32) (param $ids i32) (param $n i32) (param $map i32)
  (local $i i32)
  (block $done (loop $tokens
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (i32.store8 (i32.add (local.get $ids) (local.get $i))
      (i32.load8_u (i32.add (local.get $map) (i32.load16_u (i32.add (local.get $ctxs) (i32.shl (local.get $i) (i32.const 1)))))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $tokens))))

;; Raw RGBA orientation. Pixel words are copied, never decoded as floating-point values.
(func (export "orientRGBA") (param $in i32) (param $w i32) (param $h i32) (param $bytes i32) (param $o i32) (param $out i32)
  (local $x i32) (local $y i32) (local $dx i32) (local $dy i32) (local $stride i32)
  (local.set $stride (select (local.get $h) (local.get $w) (i32.ge_u (local.get $o) (i32.const 5))))
  (loop $rows
    (local.set $x (i32.const 0))
    (loop $columns
      (local.set $dx (local.get $x)) (local.set $dy (local.get $y))
      (block $placed
        (br_if $placed (i32.eq (local.get $o) (i32.const 1)))
        (if (i32.eq (local.get $o) (i32.const 2)) (then
          (local.set $dx (i32.sub (i32.sub (local.get $w) (i32.const 1)) (local.get $x))) (br $placed)))
        (if (i32.eq (local.get $o) (i32.const 3)) (then
          (local.set $dx (i32.sub (i32.sub (local.get $w) (i32.const 1)) (local.get $x)))
          (local.set $dy (i32.sub (i32.sub (local.get $h) (i32.const 1)) (local.get $y))) (br $placed)))
        (if (i32.eq (local.get $o) (i32.const 4)) (then
          (local.set $dy (i32.sub (i32.sub (local.get $h) (i32.const 1)) (local.get $y))) (br $placed)))
        (if (i32.eq (local.get $o) (i32.const 5)) (then
          (local.set $dx (local.get $y)) (local.set $dy (local.get $x)) (br $placed)))
        (if (i32.eq (local.get $o) (i32.const 6)) (then
          (local.set $dx (i32.sub (i32.sub (local.get $h) (i32.const 1)) (local.get $y)))
          (local.set $dy (local.get $x)) (br $placed)))
        (if (i32.eq (local.get $o) (i32.const 7)) (then
          (local.set $dx (i32.sub (i32.sub (local.get $h) (i32.const 1)) (local.get $y)))
          (local.set $dy (i32.sub (i32.sub (local.get $w) (i32.const 1)) (local.get $x))) (br $placed)))
        (local.set $dx (local.get $y))
        (local.set $dy (i32.sub (i32.sub (local.get $w) (i32.const 1)) (local.get $x))))
      (memory.copy
        (i32.add (local.get $out) (i32.mul (i32.add (i32.mul (local.get $dy) (local.get $stride)) (local.get $dx)) (local.get $bytes)))
        (i32.add (local.get $in) (i32.mul (i32.add (i32.mul (local.get $y) (local.get $w)) (local.get $x)) (local.get $bytes)))
        (local.get $bytes))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br_if $columns (i32.lt_u (local.get $x) (local.get $w))))
    (local.set $y (i32.add (local.get $y) (i32.const 1)))
    (br_if $rows (i32.lt_u (local.get $y) (local.get $h)))))

;; Compact photographic writer's strided sample gather. Type0 unsigned8 (alpha),1 signed16 (DC),2 signed8 (CfL),
;; 3 nonzero AC count from a 64-coefficient block into one byte. No source samples are changed.
(func (export "captureSelect") (param $src i32) (param $dst i32) (param $n i32) (param $step i32) (param $type i32)
  (local $i i32) (local $k i32) (local $value i32)
  (if (i32.eqz (local.get $n)) (then (return)))
  (loop $values
    (if (i32.eq (local.get $type) (i32.const 3))
      (then
        (local.set $value (i32.const 0)) (local.set $k (i32.const 1))
        (loop $ac
          (local.set $value (i32.add (local.get $value) (i32.ne (i32.load16_s (i32.add (local.get $src) (i32.shl (local.get $k) (i32.const 1)))) (i32.const 0))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br_if $ac (i32.lt_u (local.get $k) (i32.const 64))))
        (i32.store8 (local.get $dst) (local.get $value))
        (local.set $dst (i32.add (local.get $dst) (i32.const 1))))
      (else
        (if (i32.eq (local.get $type) (i32.const 1))
          (then (local.set $value (i32.load16_s (local.get $src))))
          (else (if (i32.eqz (local.get $type))
            (then (local.set $value (i32.load8_u (local.get $src))))
            (else (local.set $value (i32.load8_s (local.get $src)))))))
        (i32.store16 (local.get $dst) (local.get $value))
        (local.set $dst (i32.add (local.get $dst) (i32.const 2)))))
    (local.set $src (i32.add (local.get $src) (local.get $step)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br_if $values (i32.lt_u (local.get $i) (local.get $n)))))

  ;; A run of `n` DCT8 blocks of a fixed layout side by side (varblock-core.mjs kernelBlock, unpriced): each block's three
  ;; channels transformed ($vbDct, from `pix` and `pix` + `plane` x c, 64 bytes a block apart, rows `W` samples), then in
  ;; the order Y, X, B its first coefficient to `dc` (f64, three a block) and its levels ($vbQuant: area 1, size 64, no
  ;; mask weight) to `levels` (i32, 64 a channel, 192 a block), the low-frequency position zero. `params`: per block the
  ;; X and B correlation factors, the field and the unit (f64); `dead`: each channel's low and high dead zones; `ones`:
  ;; each channel's reconstruction of one; `steps`: the table's three channels. Returns the blocks made: n, or the
  ;; first whose level reaches 4096 (its caller makes it and the rest). `rates` (0: none): each block's rate under the
  ;; simple model (f64 a block), as the rated layout's JavaScript adds it: channels Y, X, B, each its levels' rc1 + rc2 x
  ;; log2(level) and then rc0 + rc3 x its zero runs.
  (func $vbRow8 (export "vbRow8") (param $pix i32) (param $plane i32) (param $W i32) (param $n i32) (param $bt i32) (param $bb i32)
    (param $tmp i32) (param $tr i32) (param $order i32) (param $steps i32) (param $high i32) (param $log2 i32) (param $params i32)
    (param $dead i32) (param $ones i32) (param $rc1 f64) (param $rc2 f64) (param $levels i32) (param $dc i32) (param $out i32)
    (param $rc0 f64) (param $rc3 f64) (param $rates i32) (result i32)
    (local $j i32) (local $c i32) (local $k i32) (local $p i32) (local $L i32) (local $trBase i32) (local $trStep i32) (local $fc f64) (local $R f64)
    (block $done (loop $blocks
      (br_if $done (i32.ge_u (local.get $j) (local.get $n)))
      (local.set $p (i32.add (local.get $params) (i32.shl (local.get $j) (i32.const 5))))
      (local.set $c (i32.const 0))
      (if (local.get $W)
        (then
          (loop $dcts
            (call $vbDct (i32.add (i32.add (local.get $pix) (i32.mul (local.get $c) (local.get $plane))) (i32.shl (local.get $j) (i32.const 6)))
              (local.get $W) (i32.const 8) (i32.const 8) (local.get $bt) (local.get $bb) (local.get $tmp)
              (i32.add (local.get $tr) (i32.shl (local.get $c) (i32.const 13))))
            (local.set $c (i32.add (local.get $c) (i32.const 1)))
            (br_if $dcts (i32.lt_u (local.get $c) (i32.const 3))))
          (local.set $trBase (local.get $tr))
          (local.set $trStep (i32.const 8192)))
        (else
          (local.set $trBase (i32.add (local.get $pix) (i32.shl (local.get $j) (i32.const 9))))
          (local.set $trStep (local.get $plane))))
      ;; Channels Y, X, B: c = 1, 0, 2.
      (local.set $k (i32.const 0))
      (local.set $R (f64.const 0))
      (loop $channels
        (local.set $c (select (i32.const 1) (select (i32.const 0) (i32.const 2) (i32.eq (local.get $k) (i32.const 1))) (i32.eqz (local.get $k))))
        (f64.store (i32.add (local.get $dc) (i32.add (i32.mul (local.get $j) (i32.const 24)) (i32.shl (local.get $c) (i32.const 3))))
          (f64.load (i32.add (local.get $trBase) (i32.mul (local.get $c) (local.get $trStep)))))
        (local.set $L (i32.add (local.get $levels) (i32.add (i32.mul (local.get $j) (i32.const 768)) (i32.shl (local.get $c) (i32.const 8)))))
        (i32.store (i32.add (local.get $L) (i32.shl (i32.load (local.get $order)) (i32.const 2))) (i32.const 0))
        (local.set $fc (if (result f64) (i32.eq (local.get $c) (i32.const 1)) (then (f64.const 0))
          (else (f64.load (i32.add (local.get $p) (i32.shl (i32.shr_u (local.get $c) (i32.const 1)) (i32.const 3)))))))
        (if (local.get $rates)
          (then
            (if (call $vbQuant (i32.add (local.get $trBase) (i32.mul (local.get $c) (local.get $trStep)))
                  (select (i32.const 0) (i32.add (local.get $trBase) (local.get $trStep)) (i32.eq (local.get $c) (i32.const 1)))
                  (local.get $order) (i32.add (local.get $steps) (i32.shl (local.get $c) (i32.const 9))) (local.get $high)
                  (i32.const 1) (i32.const 64) (local.get $L) (local.get $log2) (local.get $fc)
                  (f64.load (i32.add (local.get $dead) (i32.shl (local.get $c) (i32.const 4))))
                  (f64.load offset=8 (i32.add (local.get $dead) (i32.shl (local.get $c) (i32.const 4))))
                  (f64.load offset=16 (local.get $p)) (f64.load offset=24 (local.get $p))
                  (f64.load (i32.add (local.get $ones) (i32.shl (local.get $c) (i32.const 3))))
                  (f64.const 1) (local.get $rc1) (local.get $rc2) (local.get $R) (local.get $out))
              (then (return (local.get $j))))
            (local.set $R (f64.add (f64.load offset=8 (local.get $out))
              (f64.add (local.get $rc0) (f64.mul (local.get $rc3) (f64.convert_i32_s (i32.load offset=16 (local.get $out))))))))
          (else
            (if (call $vbQuantPlain (i32.add (local.get $trBase) (i32.mul (local.get $c) (local.get $trStep)))
                  (select (i32.const 0) (i32.add (local.get $trBase) (local.get $trStep)) (i32.eq (local.get $c) (i32.const 1)))
                  (local.get $order) (i32.add (local.get $steps) (i32.shl (local.get $c) (i32.const 9))) (local.get $high)
                  (i32.const 1) (i32.const 64) (local.get $L) (local.get $fc)
                  (f64.load (i32.add (local.get $dead) (i32.shl (local.get $c) (i32.const 4))))
                  (f64.load offset=8 (i32.add (local.get $dead) (i32.shl (local.get $c) (i32.const 4))))
                  (f64.load offset=16 (local.get $p)) (i32.const 0))
              (then (return (local.get $j))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br_if $channels (i32.lt_u (local.get $k) (i32.const 3))))
      (if (local.get $rates) (then (f64.store (i32.add (local.get $rates) (i32.shl (local.get $j) (i32.const 3))) (local.get $R))))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $blocks)))
    (local.get $n))
;; A block row's blocks of a fixed layout in one call (varblock-core.mjs compactRow, kernels.mjs band): `n` jobs of
  ;; 192 bytes from `jobs`, each a run of DCT8 blocks ($vbRow8) or one block ($vbDct of its three channels from the
  ;; strip, then in the order Y, X, B its DC and its levels, $vbQuantPlain extended: area, size, no mask weight, the
  ;; low-frequency positions zero), as compactRun8 and compactBlock make them. The DC is JavaScript's
  ;; Math.round(coefficient x 8 / step) ($round), each of a block's low frequencies as lowFrequencies makes it (scales,
  ;; then inverseScaledDCT, in its order). Levels to `levels` from each job's level offset (i32), the DC to `dcs` (i32,
  ;; at level offset / 64 + channel x area + k). A job: i32 kind (0 run, 1 block), n or id, x, w, h, bw, bh, order,
  ;; steps, high, size, level offset, low table (bytes from `jobs`: x scales, y scales, basis(bw), basis(bh)), run
  ;; params (bytes from `jobs`), run dead zones (bytes from `jobs`), bt; f64 from 64: X and B factors, field, bb (i32 at 88), then
  ;; each channel's low and high dead zones (96), then each channel's DC step (144). `ones`: each channel's one.
  ;; Returns the jobs made: n, or the run whose block reached 4096 (its blocks made before it at `stop`).
  (func (export "vbBand") (param $jobs i32) (param $n i32) (param $pix i32) (param $plane i32) (param $W i32)
    (param $tmp i32) (param $tr i32) (param $log2 i32) (param $ones i32) (param $rc1 f64) (param $rc2 f64)
    (param $levels i32) (param $dcs i32) (param $dcTmp i32) (param $low i32) (param $out i32) (param $stop i32) (result i32)
    (local $j i32) (local $job i32) (local $c i32) (local $k i32) (local $i i32) (local $m i32) (local $done i32)
    (local $size i32) (local $area i32) (local $bw i32) (local $bh i32) (local $w i32) (local $h i32) (local $x i32) (local $y i32)
    (local $u i32) (local $v i32) (local $order i32) (local $L i32) (local $D i32) (local $T i32) (local $t i32) (local $src i32)
    (local $sum f64) (local $step f64) (local $fc f64) (local $sx i32) (local $sy i32) (local $bxp i32) (local $byp i32) (local $tmpL i32)
    (block $end (loop $each
      (br_if $end (i32.ge_u (local.get $j) (local.get $n)))
      (local.set $job (i32.add (local.get $jobs) (i32.mul (local.get $j) (i32.const 192))))
      (local.set $D (i32.add (local.get $dcs) (i32.shl (i32.shr_u (i32.load offset=44 (local.get $job)) (i32.const 6)) (i32.const 2))))
      (if (i32.eqz (i32.load (local.get $job)))
        (then
          ;; A run: its blocks, then each block's DC rounded (f64 three a block at dcTmp).
          (local.set $m (i32.load offset=4 (local.get $job)))
          (local.set $done (call $vbRow8 (i32.add (local.get $pix) (i32.shl (i32.load offset=8 (local.get $job)) (i32.const 3)))
            (local.get $plane) (local.get $W) (local.get $m) (i32.load offset=60 (local.get $job)) (i32.load offset=88 (local.get $job))
            (local.get $tmp) (local.get $tr) (i32.load offset=28 (local.get $job)) (i32.load offset=32 (local.get $job))
            (i32.load offset=36 (local.get $job)) (local.get $log2) (i32.add (local.get $jobs) (i32.load offset=52 (local.get $job)))
            (i32.add (local.get $jobs) (i32.load offset=56 (local.get $job))) (local.get $ones) (local.get $rc1) (local.get $rc2)
