    (v128.store offset=64 (local.get $p) (f32x4.add (local.get $a3) (local.get $z1)))
    (v128.store offset=192 (local.get $p) (f32x4.sub (local.get $a3) (local.get $z1)))
    (local.set $b0 (f32x4.add (local.get $t4) (local.get $t5)))
    (local.set $b1 (f32x4.add (local.get $t5) (local.get $t6)))
    (local.set $b2 (f32x4.add (local.get $t6) (local.get $t7)))
    (local.set $z5 (f32x4.mul (f32x4.sub (local.get $b0) (local.get $b2)) (v128.const f32x4 0.3826834333650898 0.3826834333650898 0.3826834333650898 0.3826834333650898)))
    (local.set $z2 (f32x4.add (f32x4.mul (v128.const f32x4 0.5411961001461969 0.5411961001461969 0.5411961001461969 0.5411961001461969) (local.get $b0)) (local.get $z5)))
    (local.set $z4 (f32x4.add (f32x4.mul (v128.const f32x4 1.3065629648763766 1.3065629648763766 1.3065629648763766 1.3065629648763766) (local.get $b2)) (local.get $z5)))
    (local.set $z3 (f32x4.mul (local.get $b1) (v128.const f32x4 0.7071067811865476 0.7071067811865476 0.7071067811865476 0.7071067811865476)))
    (local.set $z11 (f32x4.add (local.get $t7) (local.get $z3)))
