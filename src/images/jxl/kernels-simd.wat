      (else
        (memory.fill (local.get $start) (i32.const 0) (i32.shl (i32.add (local.get $activeBins) (i32.const 1)) (i32.const 2)))
        (local.set $i (i32.const 0))
        (loop $countBins
          (local.set $relB (i32.sub (i32.load8_u (i32.add (local.get $indices) (local.get $i))) (local.get $minB)))
          (local.set $p (i32.add (local.get $start) (i32.shl (i32.add (local.get $relB) (i32.const 1)) (i32.const 2))))
          (i32.store (local.get $p) (i32.add (i32.load (local.get $p)) (i32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $countBins (i32.lt_u (local.get $i) (local.get $total))))
        (local.set $relB (i32.const 0))
        (local.set $j (i32.const 0))
        (loop $prefixBins
          (local.set $p (i32.add (local.get $start) (i32.shl (local.get $relB) (i32.const 2))))
          (local.set $l (i32.load (local.get $p)))
          (local.set $h (i32.load offset=4 (local.get $p)))
          (local.set $v (i32.add (local.get $l) (local.get $h)))
          (i32.store offset=4 (local.get $p) (local.get $v))
          (i32.store (i32.add (local.get $next) (i32.shl (local.get $relB) (i32.const 2))) (local.get $l))
          (if (i32.and (i32.gt_u (local.get $h) (i32.const 0))
                (i32.and (i32.lt_u (i32.add (local.get $minB) (local.get $relB)) (local.get $sweepEnd))
                  (i32.and (i32.ge_u (local.get $v) (i32.const 24))
                    (i32.ge_u (i32.sub (local.get $total) (local.get $v)) (i32.const 24)))))
            (then (local.set $j (i32.const 1))))
          (local.set $relB (i32.add (local.get $relB) (i32.const 1)))
          (br_if $prefixBins (i32.lt_u (local.get $relB) (local.get $activeBins))))
        (if (i32.eqz (local.get $j)) (then (return (i32.const -1))))
        (local.set $i (i32.const 0))
        (loop $orderSamples
          (local.set $relB (i32.sub (i32.load8_u (i32.add (local.get $indices) (local.get $i))) (local.get $minB)))
          (local.set $p (i32.add (local.get $next) (i32.shl (local.get $relB) (i32.const 2))))
          (local.set $v (i32.load (local.get $p)))
          (v128.store (i32.add (local.get $workDense) (i32.shl (local.get $v) (i32.const 4)))
            (v128.load (i32.add (local.get $symbols) (i32.shl (local.get $i) (i32.const 4)))))
          (i32.store (local.get $p) (i32.add (local.get $v) (i32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $orderSamples (i32.lt_u (local.get $i) (local.get $total))))))
    (memory.copy (local.get $scratch) (local.get $initStats) (i32.shl (local.get $kinds) (i32.const 5)))
    (memory.fill (local.get $low) (i32.const 0) (i32.shl (local.get $cells) (i32.const 2)))
    (local.set $b (local.get $minB))
    (block $sweepDone
      (loop $sweepBins
        (local.set $moved (i32.const 0))
        (block $emptyBin
          (if (local.get $useDense)
            (then
              (local.set $relB (i32.sub (local.get $b) (local.get $baseB)))
              (local.set $row (i32.add (local.get $dense) (i32.mul (local.get $relB) (local.get $binStrideBytes))))
              (local.set $c (i32.const 0))
              (loop $denseCandidates
                (local.set $p (i32.shl (i32.mul (local.get $c) (local.get $alphabet)) (i32.const 2)))
                (local.set $lo (i32.add (local.get $low) (local.get $p)))
                (local.set $hi (i32.add (local.get $hist) (local.get $p)))
                (local.set $delta (v128.const f64x2 0 0)) (local.set $r (f64.const 0))
                (local.set $s (i32.const 0))
                (local.set $end (i32.load (i32.add (local.get $limits) (i32.shl (local.get $c) (i32.const 2)))))
                (block $denseDone
                  (br_if $denseDone (i32.eqz (local.get $end)))
                  (block $quadSweepDone
                    (loop $quadSweep
                      (br_if $quadSweepDone (i32.gt_u (i32.add (local.get $s) (i32.const 4)) (local.get $end)))
                      (local.set $mask (i32x4.bitmask (i32x4.ne
                        (v128.load (i32.add (local.get $row) (i32.shl (local.get $s) (i32.const 2))))
                        (v128.const i32x4 0 0 0 0))))
                      (if (local.get $mask)
