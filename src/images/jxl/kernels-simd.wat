              (call $vbSubDct
                (i32.add (local.get $pix) (i32.shl (i32.mul (i32.shl (local.get $half) (i32.const 2)) (local.get $stride)) (i32.const 3)))
                (local.get $stride) (i32.const 8) (i32.const 4) (local.get $b8t) (local.get $b4) (local.get $tmp) (local.get $sub)))
