    (local.set $wf (f64.convert_i32_u (local.get $w)))
    (local.set $hf (f64.convert_i32_u (local.get $h)))
    (local.set $v (i32.const 0))
    (loop $vL
      (local.set $x (i32.const 0))
      (loop $xL
        (local.set $sum (f64.const 0))
        (local.set $u (i32.const 0))
        (loop $uL
          (local.set $idx (select (i32.add (i32.mul (local.get $u) (local.get $h)) (local.get $v))
            (i32.add (i32.mul (local.get $v) (local.get $w)) (local.get $u)) (local.get $tall)))
          (local.set $sum (f64.add (local.get $sum) (f64.mul (f64.mul
            (f64.load (i32.add (local.get $coeff) (i32.shl (local.get $idx) (i32.const 3))))
            (f64.load (i32.add (local.get $bx) (i32.shl (i32.add (i32.mul (local.get $u) (local.get $w)) (local.get $x)) (i32.const 3)))))
            (local.get $wf))))
          (local.set $u (i32.add (local.get $u) (i32.const 1)))
          (br_if $uL (i32.lt_u (local.get $u) (local.get $w))))
        (f64.store (i32.add (local.get $tmp) (i32.shl (i32.add (i32.mul (local.get $v) (local.get $w)) (local.get $x)) (i32.const 3))) (local.get $sum))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $xL (i32.lt_u (local.get $x) (local.get $w))))
      (local.set $v (i32.add (local.get $v) (i32.const 1)))
      (br_if $vL (i32.lt_u (local.get $v) (local.get $h))))
    (local.set $y (i32.const 0))
    (loop $yL
      (local.set $x (i32.const 0))
      (loop $xL2
        (local.set $sum (f64.const 0))
        (local.set $v (i32.const 0))
        (loop $vL2
          (local.set $sum (f64.add (local.get $sum) (f64.mul (f64.mul
            (f64.load (i32.add (local.get $tmp) (i32.shl (i32.add (i32.mul (local.get $v) (local.get $w)) (local.get $x)) (i32.const 3))))
            (f64.load (i32.add (local.get $by) (i32.shl (i32.add (i32.mul (local.get $v) (local.get $h)) (local.get $y)) (i32.const 3)))))
            (local.get $hf))))
          (local.set $v (i32.add (local.get $v) (i32.const 1)))
          (br_if $vL2 (i32.lt_u (local.get $v) (local.get $h))))
