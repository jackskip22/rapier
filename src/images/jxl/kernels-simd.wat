      (then (f64.store (local.get $p) (f64.add (f64.load (local.get $orig))
        (f64.mul (local.get $boost) (f64.sub (f64.load (local.get $p)) (f64.load (local.get $orig)))))))))
  ;; photo-output.mjs's native RGB8 writer (libjxl 0.12.0's stage_write.cc output of linear sRGB: the transfer
  ;; EncodedFromDisplay, the channel-shifted ordered dither, float32 scale and add, nearest-even), every operation the
  ;; JavaScript's in its order: binary64 arithmetic rounded to binary32 where it rounds (Math.fround), its fused
  ;; multiply-add model and Math.round (ties up). At $t: P0..P4, Q0..Q4, LOW and SLOPE as f64, the 32x32 dither (f32),
  ;; then the fast transfer's knots V, R and S (f64, $k each, every 2^13th binary32 from bits $low). Planes: three f32
  ;; planes of $w x $h at $in (X, Y, B, one after another); RGBA8 to $out, alpha 255. ($ox, $oy): the dither's phase.
  (func $nRound (param $x f64) (result f64) (local $r f64)
    (local.set $r (f64.floor (local.get $x)))
    (select (f64.add (local.get $r) (f64.const 1)) (local.get $r) (f64.ge (f64.sub (local.get $x) (local.get $r)) (f64.const 0.5))))
  (func $nClamp (param $x f64) (result f64)
    (f64.max (f64.const 0) (f64.min (f64.const 255) (local.get $x))))
  ;; One float32 step from a binary32 value: the next one up or down (photo-output.mjs adjacent).
  (func $nAdjacent (param $v f64) (param $up i32) (result f64)
    (if (f64.eq (local.get $v) (f64.const 0))
      (then (return (select (f64.const 0x1p-149) (f64.const -0x1p-149) (local.get $up)))))
    (f64.promote_f32 (f32.reinterpret_i32 (i32.add (i32.reinterpret_f32 (f32.demote_f64 (local.get $v)))
      (select (i32.const 1) (i32.const -1) (i32.eq (f64.gt (local.get $v) (f64.const 0)) (local.get $up)))))))
  (func $nFma (param $a f64) (param $b f64) (param $c f64) (result f64)
    (local $product f64) (local $sum f64) (local $rounded f64) (local $z f64) (local $residual f64) (local $other f64)
    (local.set $product (f64.mul (local.get $a) (local.get $b)))
    (local.set $sum (f64.add (local.get $product) (local.get $c)))
    (local.set $rounded (f64.promote_f32 (f32.demote_f64 (local.get $sum))))
    (if (i64.ne (i64.and (i64.reinterpret_f64 (local.get $sum)) (i64.const 0x1fffffff)) (i64.const 0x10000000))
      (then (return (local.get $rounded))))
