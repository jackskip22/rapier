  ;; gab32: one step of the Gaborish inverse (gab) in f32 over a plane of W x H f32 samples, every sum in gab's order:
  ;; (mc + w1 * (((uc + dc) + ml) + mr) + w2 * (((ul + ur) + dl) + dr)) * norm, then row y - 1 += orig - G. Four
  ;; samples a lane quad inside the row, a scalar tail, the first and last samples alone. W is at least 4.
  (func $g32 (param $u i32) (param $m i32) (param $d i32) (param $l i32) (param $c i32) (param $r i32)
    (param $w1 f32) (param $w2 f32) (param $norm f32) (result f32)
    (f32.mul (f32.add (f32.add (f32.load (i32.add (local.get $m) (local.get $c)))
      (f32.mul (local.get $w1) (f32.add (f32.add (f32.add (f32.load (i32.add (local.get $u) (local.get $c))) (f32.load (i32.add (local.get $d) (local.get $c))))
        (f32.load (i32.add (local.get $m) (local.get $l)))) (f32.load (i32.add (local.get $m) (local.get $r))))))
      (f32.mul (local.get $w2) (f32.add (f32.add (f32.add (f32.load (i32.add (local.get $u) (local.get $l))) (f32.load (i32.add (local.get $u) (local.get $r))))
        (f32.load (i32.add (local.get $d) (local.get $l)))) (f32.load (i32.add (local.get $d) (local.get $r))))))
      (local.get $norm)))
  (func (export "gab32") (param $p i32) (param $orig i32) (param $ring i32) (param $W i32) (param $H i32)
    (param $w1 f32) (param $w2 f32) (param $norm f32)
    (local $y i32) (local $row i32) (local $u i32) (local $m i32) (local $d i32) (local $o i32) (local $x i32)
    (local $src i32) (local $r i32) (local $last i32) (local $quads i32)
    (local $v1 v128) (local $v2 v128) (local $vn v128)
    (local.set $row (i32.shl (local.get $W) (i32.const 2)))
    (local.set $last (i32.sub (local.get $row) (i32.const 4)))
    ;; Interior samples 1 .. W - 2: whole quads from sample 1, then one at a time.
    (local.set $quads (i32.add (i32.const 4) (i32.shl (i32.shr_u (i32.sub (local.get $W) (i32.const 2)) (i32.const 2)) (i32.const 4))))
    (local.set $v1 (f32x4.splat (local.get $w1)))
    (local.set $v2 (f32x4.splat (local.get $w2)))
    (local.set $vn (f32x4.splat (local.get $norm)))
    (local.set $y (i32.const 0))
    (loop $rows
      (local.set $m (i32.add (local.get $p) (i32.mul (local.get $y) (local.get $row))))
      (local.set $u (select (i32.sub (local.get $m) (local.get $row)) (local.get $m) (local.get $y)))
      (local.set $d (select (i32.add (local.get $m) (local.get $row)) (local.get $m)
        (i32.lt_u (local.get $y) (i32.sub (local.get $H) (i32.const 1)))))
      (local.set $o (i32.add (local.get $ring) (i32.mul (i32.and (local.get $y) (i32.const 1)) (local.get $row))))
      ;; x = 0: left is the sample itself.
      (f32.store (local.get $o) (call $g32 (local.get $u) (local.get $m) (local.get $d) (i32.const 0) (i32.const 0) (i32.const 4)
        (local.get $w1) (local.get $w2) (local.get $norm)))
      (local.set $x (i32.const 4))
      (block $quadsDone (loop $xs
        (br_if $quadsDone (i32.ge_u (local.get $x) (local.get $quads)))
        (v128.store (i32.add (local.get $o) (local.get $x)) (f32x4.mul (f32x4.add (f32x4.add
          (v128.load (i32.add (local.get $m) (local.get $x)))
          (f32x4.mul (local.get $v1) (f32x4.add (f32x4.add (f32x4.add
            (v128.load (i32.add (local.get $u) (local.get $x))) (v128.load (i32.add (local.get $d) (local.get $x))))
            (v128.load (i32.sub (i32.add (local.get $m) (local.get $x)) (i32.const 4))))
            (v128.load offset=4 (i32.add (local.get $m) (local.get $x))))))
          (f32x4.mul (local.get $v2) (f32x4.add (f32x4.add (f32x4.add
            (v128.load (i32.sub (i32.add (local.get $u) (local.get $x)) (i32.const 4))) (v128.load offset=4 (i32.add (local.get $u) (local.get $x))))
            (v128.load (i32.sub (i32.add (local.get $d) (local.get $x)) (i32.const 4))))
            (v128.load offset=4 (i32.add (local.get $d) (local.get $x))))))
          (local.get $vn)))
        (local.set $x (i32.add (local.get $x) (i32.const 16)))
        (br $xs)))
      (block $tailDone (loop $tail
        (br_if $tailDone (i32.ge_u (local.get $x) (local.get $last)))
        (f32.store (i32.add (local.get $o) (local.get $x)) (call $g32 (local.get $u) (local.get $m) (local.get $d)
          (i32.sub (local.get $x) (i32.const 4)) (local.get $x) (i32.add (local.get $x) (i32.const 4)) (local.get $w1) (local.get $w2) (local.get $norm)))
        (local.set $x (i32.add (local.get $x) (i32.const 4)))
        (br $tail)))
      ;; x = W - 1: right is the sample itself.
      (f32.store (i32.add (local.get $o) (local.get $last)) (call $g32 (local.get $u) (local.get $m) (local.get $d)
        (i32.sub (local.get $last) (i32.const 4)) (local.get $last) (local.get $last) (local.get $w1) (local.get $w2) (local.get $norm)))
      ;; Row y - 1 (u) is no longer read: p += orig - G p, from the other half of the ring.
      (if (local.get $y) (then
        (local.set $src (i32.add (local.get $orig) (i32.sub (local.get $u) (local.get $p))))
        (local.set $r (i32.sub (i32.add (local.get $ring) (local.get $row)) (i32.sub (local.get $o) (local.get $ring))))
        (call $gabUpdate32 (local.get $u) (local.get $src) (local.get $r) (local.get $row))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (local.get $H))))
    ;; The last row.
    (local.set $m (i32.add (local.get $p) (i32.mul (i32.sub (local.get $H) (i32.const 1)) (local.get $row))))
    (call $gabUpdate32 (local.get $m) (i32.add (local.get $orig) (i32.sub (local.get $m) (local.get $p)))
      (i32.add (local.get $ring) (i32.mul (i32.and (i32.sub (local.get $H) (i32.const 1)) (i32.const 1)) (local.get $row))) (local.get $row)))
  ;; t += orig - g over `bytes` of f32 (whole quads, then one at a time).
  (func $gabUpdate32 (param $t i32) (param $orig i32) (param $g i32) (param $bytes i32)
    (local $x i32) (local $quads i32)
    (local.set $quads (i32.and (local.get $bytes) (i32.const -16)))
    (local.set $x (i32.const 0))
    (block $qd (loop $q
      (br_if $qd (i32.ge_u (local.get $x) (local.get $quads)))
      (v128.store (i32.add (local.get $t) (local.get $x)) (f32x4.add (v128.load (i32.add (local.get $t) (local.get $x)))
        (f32x4.sub (v128.load (i32.add (local.get $orig) (local.get $x))) (v128.load (i32.add (local.get $g) (local.get $x))))))
      (local.set $x (i32.add (local.get $x) (i32.const 16)))
      (br $q)))
    (block $sd (loop $s
      (br_if $sd (i32.ge_u (local.get $x) (local.get $bytes)))
      (f32.store (i32.add (local.get $t) (local.get $x)) (f32.add (f32.load (i32.add (local.get $t) (local.get $x)))
        (f32.sub (f32.load (i32.add (local.get $orig) (local.get $x))) (f32.load (i32.add (local.get $g) (local.get $x))))))
      (local.set $x (i32.add (local.get $x) (i32.const 4)))
      (br $s))))

;; gab32From: gab32's first step out of place, from a plane never changed: $dst = $src + ($src - G $src), every sum in
  ;; gab32's order (its in-place step from a copy of $src gives the same samples). W is at least 4.
  (func (export "gab32From") (param $src i32) (param $dst i32) (param $W i32) (param $H i32) (param $w1 f32) (param $w2 f32) (param $norm f32)
    (local $y i32) (local $row i32) (local $u i32) (local $m i32) (local $d i32) (local $o i32) (local $x i32) (local $last i32) (local $quads i32)
    (local $v1 v128) (local $v2 v128) (local $vn v128) (local $g f32) (local $gv v128) (local $mv v128)
    (local.set $row (i32.shl (local.get $W) (i32.const 2)))
    (local.set $last (i32.sub (local.get $row) (i32.const 4)))
    (local.set $quads (i32.add (i32.const 4) (i32.shl (i32.shr_u (i32.sub (local.get $W) (i32.const 2)) (i32.const 2)) (i32.const 4))))
    (local.set $v1 (f32x4.splat (local.get $w1)))
    (local.set $v2 (f32x4.splat (local.get $w2)))
    (local.set $vn (f32x4.splat (local.get $norm)))
    (local.set $y (i32.const 0))
    (loop $rows
      (local.set $m (i32.add (local.get $src) (i32.mul (local.get $y) (local.get $row))))
      (local.set $u (select (i32.sub (local.get $m) (local.get $row)) (local.get $m) (local.get $y)))
      (local.set $d (select (i32.add (local.get $m) (local.get $row)) (local.get $m)
        (i32.lt_u (local.get $y) (i32.sub (local.get $H) (i32.const 1)))))
      (local.set $o (i32.add (local.get $dst) (i32.mul (local.get $y) (local.get $row))))
      (local.set $g (call $g32 (local.get $u) (local.get $m) (local.get $d) (i32.const 0) (i32.const 0) (i32.const 4)
        (local.get $w1) (local.get $w2) (local.get $norm)))
      (f32.store (local.get $o) (f32.add (f32.load (local.get $m)) (f32.sub (f32.load (local.get $m)) (local.get $g))))
      (local.set $x (i32.const 4))
      (block $quadsDone (loop $xs
        (br_if $quadsDone (i32.ge_u (local.get $x) (local.get $quads)))
        (local.set $mv (v128.load (i32.add (local.get $m) (local.get $x))))
        (local.set $gv (f32x4.mul (f32x4.add (f32x4.add
          (local.get $mv)
          (f32x4.mul (local.get $v1) (f32x4.add (f32x4.add (f32x4.add
            (v128.load (i32.add (local.get $u) (local.get $x))) (v128.load (i32.add (local.get $d) (local.get $x))))
            (v128.load (i32.sub (i32.add (local.get $m) (local.get $x)) (i32.const 4))))
            (v128.load offset=4 (i32.add (local.get $m) (local.get $x))))))
          (f32x4.mul (local.get $v2) (f32x4.add (f32x4.add (f32x4.add
            (v128.load (i32.sub (i32.add (local.get $u) (local.get $x)) (i32.const 4))) (v128.load offset=4 (i32.add (local.get $u) (local.get $x))))
            (v128.load (i32.sub (i32.add (local.get $d) (local.get $x)) (i32.const 4))))
            (v128.load offset=4 (i32.add (local.get $d) (local.get $x))))))
          (local.get $vn)))
        (v128.store (i32.add (local.get $o) (local.get $x)) (f32x4.add (local.get $mv) (f32x4.sub (local.get $mv) (local.get $gv))))
        (local.set $x (i32.add (local.get $x) (i32.const 16)))
        (br $xs)))
      (block $tailDone (loop $tail
        (br_if $tailDone (i32.ge_u (local.get $x) (local.get $last)))
        (local.set $g (call $g32 (local.get $u) (local.get $m) (local.get $d)
          (i32.sub (local.get $x) (i32.const 4)) (local.get $x) (i32.add (local.get $x) (i32.const 4)) (local.get $w1) (local.get $w2) (local.get $norm)))
        (f32.store (i32.add (local.get $o) (local.get $x)) (f32.add (f32.load (i32.add (local.get $m) (local.get $x))) (f32.sub (f32.load (i32.add (local.get $m) (local.get $x))) (local.get $g))))
        (local.set $x (i32.add (local.get $x) (i32.const 4)))
        (br $tail)))
      (local.set $g (call $g32 (local.get $u) (local.get $m) (local.get $d)
        (i32.sub (local.get $last) (i32.const 4)) (local.get $last) (local.get $last) (local.get $w1) (local.get $w2) (local.get $norm)))
