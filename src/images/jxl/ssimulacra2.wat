  ;; Zero-spill contiguous 9-row vertical 3-line FIR + SSIM/edge row sums (<= 11 GPRs, <= 9 live XMMs).
  ;; Running f64 accumulators stay in L1 cache at sums[0..40] so 0 XMM registers are stolen from the SIMD FIR & SSIM body.
  (func $s2_full_col (param $p1 i32) (param $p2 i32) (param $mean i32) (param $var i32)
                     (param $base i32) (param $p_stride i32) (param $w i32) (param $wb i32) (param $g i32)
                     (param $sums i32) (param $y_sparse i32) (param $terms_row i32) (param $edge_row i32)
    (local $x i32) (local $x4 i32) (local $wb8 i32) (local $p2_stride i32) (local $q i32) (local $r i32) (local $k i32)
    (local $de f64) (local $ddv f64) (local $da f64) (local $dl f64) (local $d2 f64)
    (local $acc_s1 f64) (local $acc_s4 f64) (local $acc_a1 f64) (local $acc_a4 f64) (local $acc_l1 f64) (local $acc_l4 f64)
    (local $fm1 f32) (local $fv11 f32) (local $fq1 f32) (local $fr1 f32) (local $fa f32) (local $fm1h f32)
