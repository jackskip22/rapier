        (if (result v128) (i32.ge_s (local.get $ro) (i32.const 0)) (then (v128.load (i32.add (local.get $src) (i32.add (local.get $ro) (local.get $xb))))) (else (v128.const f32x4 0 0 0 0)))))
      (local.set $a0 (v128.load (i32.add (local.get $st) (local.get $xb))))
      (local.set $a2 (v128.load (i32.add (local.get $st) (i32.add (i32.shl (local.get $wb) (i32.const 1)) (local.get $xb)))))
      (local.set $a4 (v128.load (i32.add (local.get $st) (i32.add (i32.shl (local.get $wb) (i32.const 2)) (local.get $xb)))))
      (local.set $o1 (call $s2_fma4c (v128.load (i32.const 4384)) (v128.load (i32.const 3712)) (local.get $sum)
