      (local.set $t (f64x2.mul (local.get $s3) (local.get $s3))) (local.set $t (f64x2.mul (local.get $t) (local.get $t)))
      (local.set $acc_s4 (f64.add (f64.add (local.get $acc_s4) (f64x2.extract_lane 0 (local.get $t))) (f64x2.extract_lane 1 (local.get $t))))

      (local.set $t (f64x2.mul (local.get $vr1) (local.get $vr1))) (local.set $t (f64x2.mul (local.get $t) (local.get $t)))
      (local.set $acc_l4 (f64.add (f64.add (local.get $acc_l4) (f64x2.extract_lane 0 (local.get $t))) (f64x2.extract_lane 1 (local.get $t))))
      (local.set $t (f64x2.mul (local.get $va) (local.get $va))) (local.set $t (f64x2.mul (local.get $t) (local.get $t)))
      (local.set $acc_l4 (f64.add (f64.add (local.get $acc_l4) (f64x2.extract_lane 0 (local.get $t))) (f64x2.extract_lane 1 (local.get $t))))

      (if (i32.eqz (local.get $y_sparse))
        (then
          (if (local.get $terms_row)
            (then
              (local.set $q (i32.shl (local.get $x) (i32.const 3)))
              (v128.store (i32.add (local.get $terms_row) (local.get $q)) (local.get $s1))
              (v128.store offset=16 (i32.add (local.get $terms_row) (local.get $q)) (local.get $s3))
              (v128.store (i32.add (local.get $edge_row) (local.get $q)) (local.get $s4))
              (v128.store offset=16 (i32.add (local.get $edge_row) (local.get $q)) (local.get $q1))))
          (local.set $acc_s1 (f64.add (f64.add (f64.add (f64.add (local.get $acc_s1) (f64x2.extract_lane 0 (local.get $s1))) (f64x2.extract_lane 1 (local.get $s1))) (f64x2.extract_lane 0 (local.get $s3))) (f64x2.extract_lane 1 (local.get $s3))))
          (local.set $acc_l1 (f64.add (f64.add (f64.add (f64.add (local.get $acc_l1) (f64x2.extract_lane 0 (local.get $vr1))) (f64x2.extract_lane 1 (local.get $vr1))) (f64x2.extract_lane 0 (local.get $va))) (f64x2.extract_lane 1 (local.get $va))))
          (local.set $s4 (v128.andnot (local.get $s4) (f64x2.le (local.get $s4) (v128.const i32x4 0 0 0 0))))
          (local.set $q1 (v128.andnot (local.get $q1) (f64x2.le (local.get $q1) (v128.const i32x4 0 0 0 0))))
          (local.set $acc_a1 (f64.add (f64.add (f64.add (f64.add (local.get $acc_a1) (f64x2.extract_lane 0 (local.get $s4))) (f64x2.extract_lane 1 (local.get $s4))) (f64x2.extract_lane 0 (local.get $q1))) (f64x2.extract_lane 1 (local.get $q1))))
          (local.set $t (f64x2.mul (local.get $s4) (local.get $s4))) (local.set $t (f64x2.mul (local.get $t) (local.get $t)))
          (local.set $acc_a4 (f64.add (f64.add (local.get $acc_a4) (f64x2.extract_lane 0 (local.get $t))) (f64x2.extract_lane 1 (local.get $t))))
          (local.set $t (f64x2.mul (local.get $q1) (local.get $q1))) (local.set $t (f64x2.mul (local.get $t) (local.get $t)))
          (local.set $acc_a4 (f64.add (f64.add (local.get $acc_a4) (f64x2.extract_lane 0 (local.get $t))) (f64x2.extract_lane 1 (local.get $t))))))
      (local.set $x (i32.add (local.get $x) (i32.const 4)))
      (br $vec)))

    (block $tailDone (loop $tail
      (br_if $tailDone (i32.ge_s (local.get $x) (local.get $w)))
      (local.set $x4 (i32.shl (local.get $x) (i32.const 2)))
      (local.set $fq1 (f32.load (i32.add (local.get $p1) (local.get $x4))))
      (local.set $fm1 (f32.load (i32.add (local.get $mean) (local.get $x4))))
      (local.set $fv11 (f32.load (i32.add (local.get $var) (local.get $x4))))
      (local.set $fm1h (f32.sub (local.get $fm1) (f32.const 0.5)))
      (local.set $fr1 (f32.sub (local.get $fq1) (local.get $fm1)))
      (local.set $fa (f32.abs (local.get $fr1)))
      (local.set $q (i32.add (local.get $base) (local.get $x4)))
      (local.set $r (i32.add (local.get $q) (local.get $wb8)))
      (local.set $gt (f32.load (local.get $g)))
      (local.set $fdel (f32.mul (local.get $gt) (f32.add (f32.load (local.get $q)) (f32.load (local.get $r)))))
      (local.set $fd2 (f32.mul (local.get $gt) (f32.add (f32.load (i32.add (local.get $q) (local.get $p_stride))) (f32.load (i32.add (local.get $r) (local.get $p_stride))))))
      (local.set $fxd (f32.mul (local.get $gt) (f32.add (f32.load (i32.add (local.get $q) (local.get $p2_stride))) (f32.load (i32.add (local.get $r) (local.get $p2_stride))))))
      (local.set $k (i32.const 1))
      (loop $tk
        (local.set $q (i32.add (local.get $q) (local.get $wb))) (local.set $r (i32.sub (local.get $r) (local.get $wb)))
        (local.set $gt (f32.load (i32.add (local.get $g) (i32.shl (local.get $k) (i32.const 2)))))
        (local.set $fdel (f32.add (local.get $fdel) (f32.mul (local.get $gt) (f32.add (f32.load (local.get $q)) (f32.load (local.get $r))))))
        (local.set $fd2 (f32.add (local.get $fd2) (f32.mul (local.get $gt) (f32.add (f32.load (i32.add (local.get $q) (local.get $p_stride))) (f32.load (i32.add (local.get $r) (local.get $p_stride)))))))
        (local.set $fxd (f32.add (local.get $fxd) (f32.mul (local.get $gt) (f32.add (f32.load (i32.add (local.get $q) (local.get $p2_stride))) (f32.load (i32.add (local.get $r) (local.get $p2_stride)))))))
        (br_if $tk (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 4))))
      (local.set $q (i32.add (local.get $q) (local.get $wb)))
      (local.set $gt (f32.load offset=16 (local.get $g)))
      (local.set $fdel (f32.add (local.get $fdel) (f32.mul (local.get $gt) (f32.load (local.get $q)))))
      (local.set $fd2 (f32.add (local.get $fd2) (f32.mul (local.get $gt) (f32.load (i32.add (local.get $q) (local.get $p_stride))))))
      (local.set $fxd (f32.add (local.get $fxd) (f32.mul (local.get $gt) (f32.load (i32.add (local.get $q) (local.get $p2_stride))))))
      (local.set $fdd (f32.mul (local.get $fdel) (local.get $fdel)))
      (local.set $fvd (f32.sub (local.get $fd2) (local.get $fdd)))
      (local.set $fvd (select (f32.const 0) (local.get $fvd) (f32.le (local.get $fvd) (f32.const 0))))
      (local.set $fn (f32.add (f32.mul (f32.const 2) (f32.sub (local.get $fv11) (f32.sub (local.get $fxd) (f32.mul (local.get $fm1h) (local.get $fdel))))) (f32.const 0.0009)))
      (local.set $ferr (f32.div (f32.add (local.get $fvd) (f32.mul (local.get $fdd) (local.get $fn))) (f32.add (local.get $fvd) (local.get $fn))))
      (local.set $ferr (select (f32.const 0) (local.get $ferr) (f32.le (local.get $ferr) (f32.const 0))))
      (local.set $fed (f32.div (f32.sub (f32.abs (f32.sub (local.get $fr1) (f32.sub (f32.sub (local.get $fq1) (f32.load (i32.add (local.get $p2) (local.get $x4)))) (local.get $fdel)))) (local.get $fa)) (f32.add (f32.const 1) (local.get $fa))))
      (local.set $de (f64.promote_f32 (local.get $ferr)))
      (local.set $ddv (f64.promote_f32 (local.get $fed)))
      (local.set $dl (select (f64.const 0) (f64.neg (local.get $ddv)) (f64.ge (local.get $ddv) (f64.const 0))))
      (local.set $d2 (f64.mul (local.get $de) (local.get $de)))
      (local.set $acc_s4 (f64.add (local.get $acc_s4) (f64.mul (local.get $d2) (local.get $d2))))
      (local.set $d2 (f64.mul (local.get $dl) (local.get $dl)))
      (local.set $acc_l4 (f64.add (local.get $acc_l4) (f64.mul (local.get $d2) (local.get $d2))))
      (if (i32.eqz (local.get $y_sparse))
        (then
          (if (local.get $terms_row)
            (then
              (f64.store (i32.add (local.get $terms_row) (i32.shl (local.get $x) (i32.const 3))) (local.get $de))
              (f64.store (i32.add (local.get $edge_row) (i32.shl (local.get $x) (i32.const 3))) (local.get $ddv))))
          (local.set $da (select (f64.const 0) (local.get $ddv) (f64.le (local.get $ddv) (f64.const 0))))
          (local.set $acc_s1 (f64.add (local.get $acc_s1) (local.get $de)))
          (local.set $acc_a1 (f64.add (local.get $acc_a1) (local.get $da)))
          (local.set $d2 (f64.mul (local.get $da) (local.get $da)))
          (local.set $acc_a4 (f64.add (local.get $acc_a4) (f64.mul (local.get $d2) (local.get $d2))))
          (local.set $acc_l1 (f64.add (local.get $acc_l1) (local.get $dl)))))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br $tail)))
    (f64.store offset=0 (local.get $sums) (local.get $acc_s1))
    (f64.store offset=8 (local.get $sums) (local.get $acc_s4))
    (f64.store offset=16 (local.get $sums) (local.get $acc_a1))
    (f64.store offset=24 (local.get $sums) (local.get $acc_a4))
    (f64.store offset=32 (local.get $sums) (local.get $acc_l1))
    (f64.store offset=40 (local.get $sums) (local.get $acc_l4)))

  ;; Copy precomputed positive-XYB planes (kind = 3 + mask) into the 16-row ring.
  (func $s2_copy_xyb_row
    (param $input i32) (param $mask i32) (param $k i32) (param $w i32) (param $in_h i32) (param $out i32) (param $at i32)
    (local $c i32) (local $wb i32) (local $pb i32) (local $src i32) (local $atb i32)
    (local.set $wb (i32.shl (local.get $w) (i32.const 2)))
    (local.set $pb (i32.mul (local.get $wb) (local.get $in_h)))
    (local.set $src (i32.add (local.get $input) (i32.mul (local.get $k) (local.get $wb))))
    (local.set $atb (i32.shl (local.get $at) (i32.const 2)))
    (loop $Lc
      (if (i32.and (i32.shr_u (local.get $mask) (local.get $c)) (i32.const 1))
        (then
          (memory.copy
            (i32.add (i32.load (i32.add (local.get $out) (i32.shl (local.get $c) (i32.const 2)))) (local.get $atb))
            (local.get $src)
            (local.get $wb))
          (local.set $src (i32.add (local.get $src) (local.get $pb)))))
      (br_if $Lc (i32.lt_u (local.tee $c (i32.add (local.get $c) (i32.const 1))) (i32.const 3)))))

  ;; Streaming SIMD128 meter driver over row bands with 24-slot mirrored rings (1 or 2 distorted outputs).
  (func $s2_fast_scale_rows
    (param $w i32) (param $h i32) (param $mask i32)
    (param $reference i32) (param $reference_kind i32)
    (param $distorted i32) (param $distorted_kind i32)
    (param $linear i32) (param $g i32)
    (param $cache0 i32) (param $cache1 i32) (param $cache2 i32) (param $cached_mask i32)
    (param $scratch i32) (param $terms i32) (param $edge_terms i32) (param $sums i32)
    (param $first i32) (param $end i32) (param $input_y i32) (param $input_h i32) (param $made i32)
    (param $distorted1 i32) (param $distorted1_kind i32) (param $scratch1 i32) (param $sums1 i32)
    (result i32)
    (local $sp i32) (local $t i32) (local $bound_d i32) (local $scale0_sparse i32)
    (local $p1_only_mask i32) (local $held_ms_mask i32) (local $held_p1_mask i32)
    (local $ring16 i32) (local $ring24 i32) (local $ring9 i32) (local $w_bytes i32) (local $pixels_bytes i32)
    (local $make_reference i32) (local $outputs i32) (local $o i32) (local $c i32) (local $k i32)
    (local $cursor i32) (local $y i32) (local $rows i32) (local $r i32) (local $slot i32)
    (local $at i32) (local $at_bytes i32) (local $mir_off i32) (local $held i32) (local $held_ms i32) (local $p1_only i32)
    (local $cache_c i32) (local $a_row i32) (local $b0_row i32) (local $b1_row i32)
    (local $mean_row i32) (local $var_row i32) (local $border_buf i32) (local $border_buf1 i32)
    (local $ref_base i32) (local $has_v i32) (local $d0_base i32) (local $d1_base i32) (local $interior i32) (local $x i32)
    (local $acc1 v128) (local $acc4 v128) (local $df v128) (local $dl v128) (local $dh v128)
    (local $s1d f64) (local $s4d f64) (local $dd f64)

    (local.set $sp (i32.const 3296))
    (local.set $t (i32.add (local.get $g) (i32.const 256)))
    (v128.store (i32.const 512) (v128.load32_splat offset=0 (local.get $t)))
    (v128.store (i32.const 528) (v128.load32_splat offset=4 (local.get $t)))
    (v128.store (i32.const 544) (v128.load32_splat offset=8 (local.get $t)))
    (v128.store (i32.const 560) (v128.load32_splat offset=12 (local.get $t)))
    (v128.store (i32.const 576) (v128.load32_splat offset=16 (local.get $t)))

    (local.set $bound_d (i32.ne (i32.and (local.get $cached_mask) (i32.const 8192)) (i32.const 0)))
    (local.set $scale0_sparse (i32.and (i32.ne (i32.and (local.get $cached_mask) (i32.const 16384)) (i32.const 0)) (i32.eqz (local.get $terms))))
    (local.set $k (i32.and (i32.shr_u (local.get $cached_mask) (i32.const 7)) (i32.const 7)))
    (local.set $p1_only_mask (select (select (local.get $k) (i32.const 7) (local.get $k)) (i32.const 0) (i32.and (local.get $cached_mask) (i32.const 64))))
    (local.set $held_ms_mask (i32.and (local.get $cached_mask) (i32.const 7)))
    (local.set $held_p1_mask (i32.or (local.get $held_ms_mask) (i32.and (i32.shr_u (local.get $cached_mask) (i32.const 3)) (i32.const 7))))
    (local.set $w_bytes (i32.shl (local.get $w) (i32.const 2)))
    (local.set $ring16 (i32.shl (local.get $w_bytes) (i32.const 4)))
    (local.set $ring24 (i32.mul (local.get $w_bytes) (i32.const 24)))
    (local.set $ring9 (i32.mul (local.get $w_bytes) (i32.const 9)))
    (local.set $mir_off (local.get $ring16))
    (local.set $pixels_bytes (i32.mul (local.get $w_bytes) (local.get $h)))
    (local.set $make_reference (i32.ne (i32.and (i32.or (local.get $mask) (select (i32.const 7) (i32.const 0) (local.get $bound_d))) (i32.xor (local.get $held_p1_mask) (i32.const -1))) (i32.const 0)))
    (local.set $outputs (select (i32.const 2) (i32.const 1) (local.get $distorted1)))

    (i32.store offset=36 (local.get $sp) (local.get $cache0))
    (i32.store offset=40 (local.get $sp) (local.get $cache1))
    (i32.store offset=44 (local.get $sp) (local.get $cache2))

    ;; Partition scratch0 (and scratch1 when outputs == 2) deterministically across band calls.
    (local.set $o (i32.const 0))
    (loop $initO
      (local.set $cursor (select (local.get $scratch1) (local.get $scratch) (local.get $o)))
      (local.set $c (i32.const 0))
      (loop $initP1
        (if (i32.eqz (local.get $o))
          (then (i32.store (i32.add (local.get $sp) (i32.shl (local.get $c) (i32.const 2)))
            (select (local.get $cursor) (i32.const 0) (local.get $make_reference)))))
        (if (local.get $make_reference) (then (local.set $cursor (i32.add (local.get $cursor) (local.get $ring16)))))
        (br_if $initP1 (i32.lt_u (local.tee $c (i32.add (local.get $c) (i32.const 1))) (i32.const 3))))
      (local.set $c (i32.const 0))
      (loop $initP2
        (i32.store (i32.add (local.get $sp) (i32.add (i32.const 12) (i32.shl (i32.add (i32.mul (local.get $o) (i32.const 3)) (local.get $c)) (i32.const 2)))) (local.get $cursor))
        (local.set $cursor (i32.add (local.get $cursor) (local.get $ring16)))
        (br_if $initP2 (i32.lt_u (local.tee $c (i32.add (local.get $c) (i32.const 1))) (i32.const 3))))
      (if (i32.eqz (local.get $o))
        (then
          (local.set $border_buf (local.get $cursor))
          (local.set $cursor (i32.add (local.get $cursor) (i32.mul (local.get $w_bytes) (i32.const 27))))
          (i32.store offset=56 (local.get $sp) (local.get $cursor))
          (local.set $cursor (i32.add (local.get $cursor) (local.get $w_bytes)))
          (i32.store offset=60 (local.get $sp) (local.get $cursor))
          (local.set $cursor (i32.add (local.get $cursor) (local.get $w_bytes))))
        (else
          (local.set $border_buf1 (local.get $cursor))
          (local.set $cursor (i32.add (local.get $cursor) (i32.mul (local.get $w_bytes) (i32.const 29))))))
      (local.set $c (i32.const 0))
      (loop $initC
        (if (i32.and (i32.shr_u (local.get $mask) (local.get $c)) (i32.const 1))
          (then
            (local.set $has_v (i32.or (i32.eqz (local.get $scale0_sparse)) (i32.eq (local.get $c) (i32.const 1))))
            (if (i32.eqz (i32.and (i32.shr_u (local.get $held_ms_mask) (local.get $c)) (i32.const 1)))
              (then
                (if (i32.eqz (local.get $o))
                  (then
                    (i32.store (i32.add (local.get $sp) (i32.add (i32.const 64) (i32.shl (local.get $c) (i32.const 3)))) (local.get $cursor))
                    (i32.store (i32.add (local.get $sp) (i32.add (i32.const 68) (i32.shl (local.get $c) (i32.const 3)))) (local.get $has_v))))
                (local.set $cursor (i32.add (local.get $cursor) (select (i32.shl (local.get $ring24) (i32.const 1)) (local.get $ring24) (local.get $has_v)))))
              (else
                (if (i32.eqz (local.get $o))
                  (then
                    (i32.store (i32.add (local.get $sp) (i32.add (i32.const 64) (i32.shl (local.get $c) (i32.const 3)))) (i32.const 0))
                    (i32.store (i32.add (local.get $sp) (i32.add (i32.const 68) (i32.shl (local.get $c) (i32.const 3)))) (i32.const 0))))))
            (i32.store (i32.add (local.get $sp) (i32.add (select (i32.const 100) (i32.const 88) (local.get $o)) (i32.shl (local.get $c) (i32.const 2)))) (local.get $cursor))
            (local.set $cursor (i32.add (local.get $cursor) (select (i32.mul (local.get $ring24) (i32.const 3)) (local.get $ring24) (local.get $has_v)))))
          (else
            (if (i32.eqz (local.get $o))
              (then
                (i32.store (i32.add (local.get $sp) (i32.add (i32.const 64) (i32.shl (local.get $c) (i32.const 3)))) (i32.const 0))
                (i32.store (i32.add (local.get $sp) (i32.add (i32.const 68) (i32.shl (local.get $c) (i32.const 3)))) (i32.const 0))))
            (i32.store (i32.add (local.get $sp) (i32.add (select (i32.const 100) (i32.const 88) (local.get $o)) (i32.shl (local.get $c) (i32.const 2)))) (i32.const 0))))
        (br_if $initC (i32.lt_u (local.tee $c (i32.add (local.get $c) (i32.const 1))) (i32.const 3))))
      (if (i32.eq (local.get $first) (i32.const -4))
        (then (memory.fill (select (local.get $sums1) (local.get $sums) (local.get $o)) (i32.const 0) (i32.const 144))))
      (br_if $initO (i32.lt_s (local.tee $o (i32.add (local.get $o) (i32.const 1))) (local.get $outputs))))

    (local.set $y (local.get $first))
    (block $yDone (loop $yLoop
      (br_if $yDone (i32.ge_s (local.get $y) (local.get $end)))

      (block $madeDone (loop $madeLoop
        (br_if $madeDone (i32.or (i32.ge_s (local.get $made) (local.get $h)) (i32.gt_s (local.get $made) (i32.add (local.get $y) (i32.const 4)))))
        (local.set $rows (i32.sub (local.get $h) (local.get $made)))
        (if (i32.gt_s (local.get $rows) (i32.const 4)) (then (local.set $rows (i32.const 4))))
        (local.set $r (i32.const 0))
        (loop $posLoop
          (local.set $at (i32.mul (i32.and (i32.add (local.get $made) (local.get $r)) (i32.const 15)) (local.get $w)))
          (local.set $k (i32.sub (i32.add (local.get $made) (local.get $r)) (local.get $input_y)))
          (if (local.get $make_reference)
            (then (call $s2_xyb_meter (local.get $reference) (local.get $reference_kind) (local.get $k) (local.get $w) (local.get $input_h)
