  ;; Vertical recursive Gaussian row using pre-splatted f32x4 (3712..3808) & f64x2 (4384..4480) coefficients.
  (func $s2_vert_row (param $src i32) (param $st i32) (param $out i32) (param $w i32)
                     (param $lo i32) (param $ro i32) (param $emit i32) (param $g i32)
    (local $wb i32) (local $x i32) (local $xb i32) (local $c i32)
