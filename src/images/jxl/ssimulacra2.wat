  ;; ==========================================================================
  ;; METER PATH (binary32 mul/add XYB + 9-tap FIR + binary64 SSIM/edge sums)
  ;; Completely self-contained so rapier-jxl/upload prunes 100% of libjxl & s2c.
  ;; ==========================================================================

  (func $s2_pos_val (param $x f32) (result f32)
    (select (f32.const 0) (local.get $x) (f32.le (local.get $x) (f32.const 0))))

  (func $s2_cbrt_plain (param $x f32) (result f32)
    (local $u i32) (local $r f32) (local $x3 f32) (local $r2 f32) (local $i i32)
    (local.set $u (i32.reinterpret_f32 (local.get $x)))
    (local.set $r (f32.reinterpret_i32 (select (i32.const 0)
      (i32.sub (i32.const 0x54800000) (i32.mul (i32.shr_u (local.get $u) (i32.const 23)) (i32.const 0x002aaaaa)))
      (i32.eqz (local.get $u)))))
    (local.set $x3 (f32.neg (f32.mul (f32.reinterpret_i32 (i32.const 0x3eaaaaab)) (local.get $x))))
    (loop $L
      (local.set $r2 (f32.mul (local.get $r) (local.get $r)))
      (local.set $r (f32.add (f32.mul (local.get $x3) (f32.mul (local.get $r2) (local.get $r2))) (f32.mul (f32.reinterpret_i32 (i32.const 0x3faaaaab)) (local.get $r))))
      (br_if $L (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 3))))
    (local.set $r2 (f32.mul (local.get $r) (local.get $r)))
    (local.set $r (f32.add (f32.mul (f32.reinterpret_i32 (i32.const 0x3eaaaaab))
      (f32.add (f32.mul (f32.neg (local.get $x)) (f32.mul (local.get $r2) (local.get $r2))) (local.get $r))) (local.get $r)))
    (f32.add (f32.mul (f32.mul (local.get $r) (local.get $r)) (local.get $x)) (f32.reinterpret_i32 (i32.const 0xbe1fb275))))

  (func $positive_plain (param $r f32) (param $g f32) (param $b f32) (param $out i32)
    (local $l f32) (local $m f32) (local $s f32) (local $y f32) (local $gb f32)
    (local.set $gb (f32.add (f32.mul (f32.reinterpret_i32 (i32.const 0x3d9fbe77)) (local.get $b)) (f32.reinterpret_i32 (i32.const 0x3b789536))))
    (local.set $l (call $s2_cbrt_plain (call $s2_pos_val
      (f32.add (f32.mul (f32.reinterpret_i32 (i32.const 0x3e99999a)) (local.get $r)) (f32.add (f32.mul (f32.reinterpret_i32 (i32.const 0x3f1f3b64)) (local.get $g)) (local.get $gb))))))
    (local.set $m (call $s2_cbrt_plain (call $s2_pos_val
      (f32.add (f32.mul (f32.reinterpret_i32 (i32.const 0x3e6b851f)) (local.get $r)) (f32.add (f32.mul (f32.reinterpret_i32 (i32.const 0x3f3126e9)) (local.get $g)) (local.get $gb))))))
    (local.set $y (f32.mul (f32.reinterpret_i32 (i32.const 0x3f000000)) (f32.add (local.get $l) (local.get $m))))
    (local.set $s (call $s2_cbrt_plain (call $s2_pos_val
      (f32.add (f32.mul (f32.reinterpret_i32 (i32.const 0x3e7943cc)) (local.get $r)) (f32.add (f32.mul (f32.reinterpret_i32 (i32.const 0x3e51ae8f)) (local.get $g))
        (f32.add (f32.mul (f32.reinterpret_i32 (i32.const 0x3f0d4369)) (local.get $b)) (f32.reinterpret_i32 (i32.const 0x3b789536))))))))
    (f32.store (local.get $out) (f32.add (f32.mul (f32.mul (f32.reinterpret_i32 (i32.const 0x3f000000)) (f32.sub (local.get $l) (local.get $m))) (f32.reinterpret_i32 (i32.const 0x41600000))) (f32.reinterpret_i32 (i32.const 0x3ed70a3d))))
    (f32.store offset=4 (local.get $out) (f32.add (local.get $y) (f32.reinterpret_i32 (i32.const 0x3c23d70a))))
    (f32.store offset=8 (local.get $out) (f32.add (f32.sub (local.get $s) (local.get $y)) (f32.reinterpret_i32 (i32.const 0x3f0ccccd)))))

  ;; Zero-spill 4-pixel SIMD128 XYB conversion for the meter (<= 11 live XMMs, zero stack spills).
  (func $s2_xyb_meter
    (param $input i32) (param $kind i32) (param $y i32) (param $w i32) (param $h i32)
    (param $out i32) (param $at i32) (param $linear i32)
    (local $x i32) (local $i i32) (local $pixels i32) (local $tr i32)
    (local $out0 i32) (local $out1 i32) (local $out2 i32) (local $p i32) (local $x4 i32)
    (local $w0 i32) (local $w1 i32) (local $w2 i32) (local $w3 i32)
    (local $j i32) (local $a0 i32) (local $a1 i32) (local $a2 i32)
    (local $vr v128) (local $vg v128) (local $vb v128) (local $t0 v128)
    (local $vl v128) (local $vm v128) (local $vs v128)
    (local $rl v128) (local $rm v128) (local $rs v128)
    (local $nl v128) (local $nm v128) (local $ns v128) (local $q v128)
    (if (i32.gt_s (local.get $kind) (i32.const 2))
      (then (call $s2_copy_xyb_row (local.get $input) (i32.sub (local.get $kind) (i32.const 3)) (local.get $y) (local.get $w) (local.get $h) (local.get $out) (local.get $at)) (return)))
    (local.set $pixels (i32.mul (local.get $w) (local.get $h)))
    (local.set $tr (i32.sub (local.get $linear) (i32.const 24576)))
    (local.set $x4 (i32.shl (local.get $at) (i32.const 2)))
    (local.set $out0 (i32.add (i32.load (local.get $out)) (local.get $x4)))
    (local.set $out1 (i32.add (i32.load offset=4 (local.get $out)) (local.get $x4)))
    (local.set $out2 (i32.add (i32.load offset=8 (local.get $out)) (local.get $x4)))
    (local.set $i (i32.mul (local.get $y) (local.get $w)))
    (block $done4 (loop $loop4
      (br_if $done4 (i32.gt_s (i32.add (local.get $x) (i32.const 4)) (local.get $w)))
      (local.set $x4 (i32.shl (local.get $x) (i32.const 2)))
      (local.set $p (i32.add (local.get $input) (i32.shl (i32.add (local.get $i) (local.get $x)) (i32.const 2))))
      (if (i32.eqz (local.get $kind))
        (then
          (local.set $w0 (i32.load offset=0 (local.get $p)))
          (local.set $w1 (i32.load offset=4 (local.get $p)))
          (local.set $w2 (i32.load offset=8 (local.get $p)))
          (local.set $w3 (i32.load offset=12 (local.get $p)))
