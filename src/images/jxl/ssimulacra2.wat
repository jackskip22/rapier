                                 (i32.load (i32.add (i32.const 2416) (local.get $base0))) (local.get $wb))
                    (if (i32.load (i32.add (i32.const 2424) (local.get $base0)))
                      (then (memory.copy (i32.add (local.get $cc) (i32.add (i32.shl (local.get $pxb) (i32.const 1)) (i32.mul (local.get $y) (local.get $wb))))
                                         (i32.load (i32.add (i32.const 2424) (local.get $base0))) (local.get $wb))))))
                (local.set $p1_row (if (result i32) (local.get $held)
                  (then (i32.add (local.get $cc) (i32.mul (local.get $y) (local.get $wb))))
                  (else (i32.add (i32.load (i32.add (i32.const 2096) (i32.shl (local.get $c) (i32.const 2)))) (local.get $atb)))))
                (local.set $p2_row (i32.add (i32.load (i32.add (i32.const 2112) (i32.shl (i32.add (i32.mul (local.get $o) (i32.const 3)) (local.get $c)) (i32.const 2)))) (local.get $atb)))
                (if (i32.and (local.get $scale0_sparse) (i32.ne (local.get $c) (i32.const 1)))
