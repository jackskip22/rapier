                (local.set $held_ms (i32.and (local.get $held_ms_mask) (i32.shl (i32.const 1) (local.get $c))))
                (local.set $p1_only (i32.and (local.get $p1_only_mask) (i32.shl (i32.const 1) (local.get $c))))
                (local.set $atb (i32.mul (i32.and (local.get $y) (i32.const 15)) (local.get $wb)))
                (local.set $cc (i32.load (i32.add (i32.const 2080) (i32.shl (local.get $c) (i32.const 2)))))
                (if (i32.and (i32.and (i32.eqz (local.get $o)) (i32.eqz (local.get $held)))
                             (i32.and (i32.eqz (local.get $p1_only)) (i32.ne (local.get $cc) (i32.const 0))))
                  (then
