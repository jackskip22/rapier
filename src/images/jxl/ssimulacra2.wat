      (local.set $err (v128.andnot (local.get $err) (f32x4.le (local.get $err) (v128.const i32x4 0 0 0 0))))
      (local.set $ed (f32x4.div
        (f32x4.sub (f32x4.abs (f32x4.sub (local.get $vr1) (f32x4.sub (f32x4.sub (local.get $q1) (v128.load (i32.add (local.get $p2) (local.get $x4)))) (local.get $s1)))) (local.get $va))
        (f32x4.add (v128.const i32x4 0x3f800000 0x3f800000 0x3f800000 0x3f800000) (local.get $va))))

