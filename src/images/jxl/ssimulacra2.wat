        (block $xd (loop $xy
          (br_if $xd (i32.ge_s (local.get $y) (local.get $h)))
          (if (local.get $m)
            (then (call $s2_xyb_libjxl (local.get $ref) (local.get $ref_kind) (local.get $y) (local.get $w) (local.get $h) (i32.const 2096) (local.get $at) (local.get $lin)))
            (else (call $s2_xyb_meter (local.get $ref) (local.get $ref_kind) (local.get $y) (local.get $w) (local.get $h) (i32.const 2096) (local.get $at) (local.get $lin))))
          (local.set $at (i32.add (local.get $at) (local.get $w)))
          (local.set $y (i32.add (local.get $y) (i32.const 1)))
          (br $xy)))
        (return (i32.const 0))))
    (local.set $m (i32.and (i32.shr_u (local.get $cmask) (i32.const 10)) (i32.const 7)))
    (call $s2_scale_rows_dispatch (local.get $w) (local.get $h) (select (local.get $m) (i32.const 7) (local.get $m))
      (local.get $ref) (local.get $ref_kind) (local.get $dist) (local.get $dist_kind) (local.get $lin) (local.get $g)
      (local.get $c0) (local.get $c1) (local.get $c2) (local.get $cmask) (local.get $scratch)
      (i32.const 0) (i32.const 0) (local.get $sums)
      (local.get $first) (local.get $end) (local.get $in_y) (local.get $in_h) (local.get $in_y)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))

  (func (export "s2MetricBand2") (param $w i32) (param $h i32) (param $first i32) (param $end i32) (param $in_y i32) (param $in_h i32)
    (param $ref i32) (param $ref_kind i32) (param $dist i32) (param $dist_kind i32) (param $dist1 i32) (param $dist1_kind i32)
    (param $lin i32) (param $g i32) (param $scratch i32) (param $sums i32) (param $scratch1 i32) (param $sums1 i32)
    (param $c0 i32) (param $c1 i32) (param $c2 i32) (param $cmask i32) (result i32)
    (local $m i32)
    (local.set $m (i32.and (i32.shr_u (local.get $cmask) (i32.const 10)) (i32.const 7)))
    (call $s2_scale_rows_dispatch (local.get $w) (local.get $h) (select (local.get $m) (i32.const 7) (local.get $m))
      (local.get $ref) (local.get $ref_kind) (local.get $dist) (local.get $dist_kind) (local.get $lin) (local.get $g)
      (local.get $c0) (local.get $c1) (local.get $c2) (local.get $cmask) (local.get $scratch)
      (i32.const 0) (i32.const 0) (local.get $sums)
      (local.get $first) (local.get $end) (local.get $in_y) (local.get $in_h) (local.get $in_y)
      (local.get $dist1) (local.get $dist1_kind) (local.get $scratch1) (local.get $sums1)))

  ;; Both arithmetic readings of one input band. Keep independent XYB, Gaussian state and ordered sums: even the
  ;; sRGB tables differ in their multiply-add rounding. The caller shares only the byte input and identical planes.
  (func (export "s2MetricBandDual")
    (param $w i32) (param $h i32) (param $first i32) (param $end i32) (param $in_y i32) (param $in_h i32)
    (param $ref i32) (param $dist i32) (param $ref_lib i32) (param $dist_lib i32) (param $ref_kind i32) (param $dist_kind i32)
    (param $lin i32) (param $lin_lib i32) (param $g i32)
    (param $scratch i32) (param $sums i32) (param $scratch_lib i32) (param $sums_lib i32) (result i32)
    (local $made i32)
    (local.set $made (call $s2_fast_scale_rows
      (local.get $w) (local.get $h) (i32.const 7) (local.get $ref) (local.get $ref_kind)
      (local.get $dist) (local.get $dist_kind) (local.get $lin) (local.get $g)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (local.get $scratch)
      (i32.const 0) (i32.const 0) (local.get $sums)
      (local.get $first) (local.get $end) (local.get $in_y) (local.get $in_h) (local.get $in_y)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
    (if (i32.ne (local.get $made) (call $s2_scale_rows_libjxl
      (local.get $w) (local.get $h) (i32.const 7) (local.get $ref_lib) (local.get $ref_kind)
      (local.get $dist_lib) (local.get $dist_kind) (local.get $lin_lib) (local.get $g)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (local.get $scratch_lib)
      (i32.const 0) (i32.const 0) (local.get $sums_lib)
      (local.get $first) (local.get $end) (local.get $in_y) (local.get $in_h) (local.get $in_y)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))) (then (return (i32.const -1))))
    (local.get $made))

  ;; Meter-only band export for rapier-jxl/upload: calls $s2_fast_scale_rows directly so libjxl is pruned.
  (func (export "s2MetricScaleMeter") (param $w i32) (param $h i32) (param $first i32) (param $end i32) (param $in_y i32) (param $in_h i32)
    (param $ref i32) (param $ref_kind i32) (param $dist i32) (param $dist_kind i32) (param $lin i32) (param $g i32)
    (param $scratch i32) (param $sums i32) (param $c0 i32) (param $c1 i32) (param $c2 i32) (param $cmask i32) (result i32)
    (local $m i32)
    (local.set $m (i32.and (i32.shr_u (local.get $cmask) (i32.const 10)) (i32.const 7)))
    (call $s2_fast_scale_rows (local.get $w) (local.get $h) (select (local.get $m) (i32.const 7) (local.get $m))
      (local.get $ref) (local.get $ref_kind) (local.get $dist) (local.get $dist_kind) (local.get $lin) (local.get $g)
      (local.get $c0) (local.get $c1) (local.get $c2) (local.get $cmask) (local.get $scratch)
      (i32.const 0) (i32.const 0) (local.get $sums)
      (local.get $first) (local.get $end) (local.get $in_y) (local.get $in_h) (local.get $in_y)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))

  ;; ==========================================================================
  ;; INTEGER CELL SUMS (s2-cells.mjs s2cChannel & s2cPrep, consolidated here)
  ;; Vectorized s2cPrep (rgba3, rgba1, lin3, down4) + symmetric vertical folding.
  ;; ==========================================================================

  (func $s2cAdd4_1 (param $at i32) (param $v v128) (local $s v128)
    (if (i32.eqz (v128.any_true (local.get $v))) (then (return)))
    (local.set $s (i32x4.add (local.get $v) (i8x16.shuffle 8 9 10 11 12 13 14 15 0 1 2 3 4 5 6 7 (local.get $v) (local.get $v))))
    (i32.store (local.get $at) (i32.add (i32.load (local.get $at))
      (i32.add (i32x4.extract_lane 0 (local.get $s)) (i32x4.extract_lane 1 (local.get $s))))))

  (func $s2cAdd4_4 (param $at i32) (param $v v128) (local $lo v128) (local $hi v128) (local $u v128)
    (if (i32.eqz (v128.any_true (local.get $v))) (then (return)))
    (local.set $lo (i64x2.shr_u (i64x2.add (i64x2.extmul_low_i32x4_u (local.get $v) (local.get $v)) (i64x2.splat (i64.const 128))) (i32.const 8)))
    (local.set $hi (i64x2.shr_u (i64x2.add (i64x2.extmul_high_i32x4_u (local.get $v) (local.get $v)) (i64x2.splat (i64.const 128))) (i32.const 8)))
    (local.set $u (i8x16.shuffle 0 1 2 3 8 9 10 11 16 17 18 19 24 25 26 27 (local.get $lo) (local.get $hi)))
    (local.set $lo (i64x2.add (i64x2.extmul_low_i32x4_u (local.get $u) (local.get $u)) (i64x2.extmul_high_i32x4_u (local.get $u) (local.get $u))))
    (i64.store (local.get $at) (i64.add (i64.load (local.get $at))
      (i64.add (i64x2.extract_lane 0 (local.get $lo)) (i64x2.extract_lane 1 (local.get $lo))))))

  (func $s2cRow (param $P1 i32) (param $P2 i32) (param $w i32) (param $row i32) (param $o i32) (param $taps i32) (param $ring i32) (param $q i32) (param $edgeOnly i32)
    (local $x i32) (local $k i32) (local $k0 i32) (local $k1 i32) (local $xx i32) (local $t i64) (local $p i64) (local $v i64) (local $at i32)
    (local $m1 i64) (local $m2 i64) (local $s11 i64) (local $s22 i64) (local $s12 i64) (local $ring4 i32)
    (local $tv v128) (local $vm1 v128) (local $vm2 v128) (local $vH0 v128) (local $vL0 v128) (local $vH1 v128) (local $vL1 v128) (local $vH2 v128) (local $vL2 v128)
    (local $b1 i32) (local $b2 i32) (local $qb i32) (local $u v128) (local $u2 v128)
    (local.set $ring4 (i32.mul (i32.mul (local.get $w) (i32.const 9)) (i32.const 4)))
    (if (i32.eqz (local.get $edgeOnly))
      (then
        (local.set $x (i32.const 0))
        (block $vpDone (loop $vpLoop
          (br_if $vpDone (i32.gt_s (i32.add (local.get $x) (i32.const 4)) (local.get $w)))
          (local.set $b1 (i32.shl (i32.add (local.get $row) (local.get $x)) (i32.const 1)))
          (local.set $u (v128.load16x4_s (i32.add (local.get $P1) (local.get $b1))))
          (local.set $u2 (v128.load16x4_s (i32.add (local.get $P2) (local.get $b1))))
          (local.set $at (i32.add (local.get $q) (i32.shl (local.get $x) (i32.const 2))))
          (v128.store (local.get $at) (i32x4.mul (local.get $u) (local.get $u)))
          (v128.store (i32.add (local.get $at) (i32.shl (local.get $w) (i32.const 2))) (i32x4.mul (local.get $u2) (local.get $u2)))
          (v128.store (i32.add (local.get $at) (i32.shl (local.get $w) (i32.const 3))) (i32x4.mul (local.get $u) (local.get $u2)))
          (local.set $x (i32.add (local.get $x) (i32.const 4)))
          (br $vpLoop)))
        (block $done (loop $products
          (br_if $done (i32.ge_s (local.get $x) (local.get $w)))
          (local.set $p (i64.extend_i32_s (i32.load16_s (i32.add (local.get $P1) (i32.shl (i32.add (local.get $row) (local.get $x)) (i32.const 1))))))
          (local.set $v (i64.extend_i32_s (i32.load16_s (i32.add (local.get $P2) (i32.shl (i32.add (local.get $row) (local.get $x)) (i32.const 1))))))
          (local.set $at (i32.add (local.get $q) (i32.shl (local.get $x) (i32.const 2))))
          (i32.store (local.get $at) (i32.wrap_i64 (i64.mul (local.get $p) (local.get $p))))
          (i32.store (i32.add (local.get $at) (i32.shl (local.get $w) (i32.const 2))) (i32.wrap_i64 (i64.mul (local.get $v) (local.get $v))))
          (i32.store (i32.add (local.get $at) (i32.shl (local.get $w) (i32.const 3))) (i32.wrap_i64 (i64.mul (local.get $p) (local.get $v))))
          (local.set $x (i32.add (local.get $x) (i32.const 1)))
          (br $products)))))
    (local.set $x (i32.const 0))
    (block $done2 (loop $cols
      (br_if $done2 (i32.ge_s (local.get $x) (local.get $w)))
      (if (i32.and (i32.eq (local.get $x) (i32.const 4)) (i32.le_s (i32.add (local.get $x) (i32.const 8)) (local.get $w)))
        (then
          (if (local.get $edgeOnly)
            (then
              (loop $vecEdge
                (local.set $b1 (i32.add (local.get $P1) (i32.shl (i32.sub (i32.add (local.get $row) (local.get $x)) (i32.const 4)) (i32.const 1))))
                (local.set $b2 (i32.add (local.get $P2) (i32.shl (i32.sub (i32.add (local.get $row) (local.get $x)) (i32.const 4)) (i32.const 1))))
                (local.set $tv (v128.load32_splat offset=16 (local.get $taps)))
                (local.set $vm1 (i32x4.mul (local.get $tv) (v128.load16x4_s offset=8 (local.get $b1))))
                (local.set $vm2 (i32x4.mul (local.get $tv) (v128.load16x4_s offset=8 (local.get $b2))))
                (local.set $tv (v128.load32_splat offset=0 (local.get $taps)))
                (local.set $vm1 (i32x4.add (local.get $vm1) (i32x4.mul (local.get $tv) (i32x4.add (v128.load16x4_s offset=0 (local.get $b1)) (v128.load16x4_s offset=16 (local.get $b1))))))
                (local.set $vm2 (i32x4.add (local.get $vm2) (i32x4.mul (local.get $tv) (i32x4.add (v128.load16x4_s offset=0 (local.get $b2)) (v128.load16x4_s offset=16 (local.get $b2))))))
                (local.set $tv (v128.load32_splat offset=4 (local.get $taps)))
                (local.set $vm1 (i32x4.add (local.get $vm1) (i32x4.mul (local.get $tv) (i32x4.add (v128.load16x4_s offset=2 (local.get $b1)) (v128.load16x4_s offset=14 (local.get $b1))))))
                (local.set $vm2 (i32x4.add (local.get $vm2) (i32x4.mul (local.get $tv) (i32x4.add (v128.load16x4_s offset=2 (local.get $b2)) (v128.load16x4_s offset=14 (local.get $b2))))))
                (local.set $tv (v128.load32_splat offset=8 (local.get $taps)))
                (local.set $vm1 (i32x4.add (local.get $vm1) (i32x4.mul (local.get $tv) (i32x4.add (v128.load16x4_s offset=4 (local.get $b1)) (v128.load16x4_s offset=12 (local.get $b1))))))
                (local.set $vm2 (i32x4.add (local.get $vm2) (i32x4.mul (local.get $tv) (i32x4.add (v128.load16x4_s offset=4 (local.get $b2)) (v128.load16x4_s offset=12 (local.get $b2))))))
                (local.set $tv (v128.load32_splat offset=12 (local.get $taps)))
                (local.set $vm1 (i32x4.add (local.get $vm1) (i32x4.mul (local.get $tv) (i32x4.add (v128.load16x4_s offset=6 (local.get $b1)) (v128.load16x4_s offset=10 (local.get $b1))))))
                (local.set $vm2 (i32x4.add (local.get $vm2) (i32x4.mul (local.get $tv) (i32x4.add (v128.load16x4_s offset=6 (local.get $b2)) (v128.load16x4_s offset=10 (local.get $b2))))))
                (local.set $at (i32.add (local.get $ring) (i32.shl (i32.add (local.get $o) (local.get $x)) (i32.const 2))))
                (v128.store (local.get $at) (i32x4.shr_s (i32x4.add (local.get $vm1) (i32x4.splat (i32.const 32768))) (i32.const 16)))
                (v128.store (i32.add (local.get $at) (local.get $ring4)) (i32x4.shr_s (i32x4.add (local.get $vm2) (i32x4.splat (i32.const 32768))) (i32.const 16)))
                (local.set $x (i32.add (local.get $x) (i32.const 4)))
                (br_if $vecEdge (i32.le_s (i32.add (local.get $x) (i32.const 8)) (local.get $w)))))
            (else
              (loop $vec
                (local.set $b1 (i32.add (local.get $P1) (i32.shl (i32.sub (i32.add (local.get $row) (local.get $x)) (i32.const 4)) (i32.const 1))))
                (local.set $b2 (i32.add (local.get $P2) (i32.shl (i32.sub (i32.add (local.get $row) (local.get $x)) (i32.const 4)) (i32.const 1))))
                (local.set $qb (i32.add (local.get $q) (i32.shl (i32.sub (local.get $x) (i32.const 4)) (i32.const 2))))
                (local.set $tv (v128.load32_splat offset=16 (local.get $taps)))
                (local.set $vm1 (i32x4.mul (local.get $tv) (v128.load16x4_s offset=8 (local.get $b1))))
                (local.set $vm2 (i32x4.mul (local.get $tv) (v128.load16x4_s offset=8 (local.get $b2))))
                (local.set $u (v128.load offset=16 (local.get $qb)))
                (local.set $vH0 (i32x4.mul (local.get $tv) (i32x4.shr_s (local.get $u) (i32.const 13))))
                (local.set $vL0 (i32x4.mul (local.get $tv) (v128.and (local.get $u) (i32x4.splat (i32.const 8191)))))
                (local.set $u (v128.load offset=16 (i32.add (local.get $qb) (i32.shl (local.get $w) (i32.const 2)))))
                (local.set $vH1 (i32x4.mul (local.get $tv) (i32x4.shr_s (local.get $u) (i32.const 13))))
                (local.set $vL1 (i32x4.mul (local.get $tv) (v128.and (local.get $u) (i32x4.splat (i32.const 8191)))))
                (local.set $u (v128.load offset=16 (i32.add (local.get $qb) (i32.shl (local.get $w) (i32.const 3)))))
                (local.set $vH2 (i32x4.mul (local.get $tv) (i32x4.shr_s (local.get $u) (i32.const 13))))
                (local.set $vL2 (i32x4.mul (local.get $tv) (v128.and (local.get $u) (i32x4.splat (i32.const 8191)))))
                (local.set $k (i32.const 0))
                (loop $tap
                  (local.set $tv (v128.load32_splat (i32.add (local.get $taps) (i32.shl (local.get $k) (i32.const 2)))))
                  (local.set $vm1 (i32x4.add (local.get $vm1) (i32x4.mul (local.get $tv) (i32x4.add
                    (v128.load16x4_s (i32.add (local.get $b1) (i32.shl (local.get $k) (i32.const 1))))
                    (v128.load16x4_s (i32.add (local.get $b1) (i32.shl (i32.sub (i32.const 8) (local.get $k)) (i32.const 1))))))))
                  (local.set $vm2 (i32x4.add (local.get $vm2) (i32x4.mul (local.get $tv) (i32x4.add
                    (v128.load16x4_s (i32.add (local.get $b2) (i32.shl (local.get $k) (i32.const 1))))
                    (v128.load16x4_s (i32.add (local.get $b2) (i32.shl (i32.sub (i32.const 8) (local.get $k)) (i32.const 1))))))))
                  (local.set $at (i32.add (local.get $qb) (i32.shl (local.get $k) (i32.const 2))))
                  (local.set $xx (i32.add (local.get $qb) (i32.shl (i32.sub (i32.const 8) (local.get $k)) (i32.const 2))))
                  (local.set $u (v128.load (local.get $at))) (local.set $u2 (v128.load (local.get $xx)))
                  (local.set $vH0 (i32x4.add (local.get $vH0) (i32x4.mul (local.get $tv) (i32x4.add (i32x4.shr_s (local.get $u) (i32.const 13)) (i32x4.shr_s (local.get $u2) (i32.const 13))))))
                  (local.set $vL0 (i32x4.add (local.get $vL0) (i32x4.mul (local.get $tv) (i32x4.add (v128.and (local.get $u) (i32x4.splat (i32.const 8191))) (v128.and (local.get $u2) (i32x4.splat (i32.const 8191)))))))
                  (local.set $u (v128.load (i32.add (local.get $at) (i32.shl (local.get $w) (i32.const 2)))))
                  (local.set $u2 (v128.load (i32.add (local.get $xx) (i32.shl (local.get $w) (i32.const 2)))))
                  (local.set $vH1 (i32x4.add (local.get $vH1) (i32x4.mul (local.get $tv) (i32x4.add (i32x4.shr_s (local.get $u) (i32.const 13)) (i32x4.shr_s (local.get $u2) (i32.const 13))))))
                  (local.set $vL1 (i32x4.add (local.get $vL1) (i32x4.mul (local.get $tv) (i32x4.add (v128.and (local.get $u) (i32x4.splat (i32.const 8191))) (v128.and (local.get $u2) (i32x4.splat (i32.const 8191)))))))
                  (local.set $u (v128.load (i32.add (local.get $at) (i32.shl (local.get $w) (i32.const 3)))))
                  (local.set $u2 (v128.load (i32.add (local.get $xx) (i32.shl (local.get $w) (i32.const 3)))))
                  (local.set $vH2 (i32x4.add (local.get $vH2) (i32x4.mul (local.get $tv) (i32x4.add (i32x4.shr_s (local.get $u) (i32.const 13)) (i32x4.shr_s (local.get $u2) (i32.const 13))))))
                  (local.set $vL2 (i32x4.add (local.get $vL2) (i32x4.mul (local.get $tv) (i32x4.add (v128.and (local.get $u) (i32x4.splat (i32.const 8191))) (v128.and (local.get $u2) (i32x4.splat (i32.const 8191)))))))
                  (local.set $k (i32.add (local.get $k) (i32.const 1)))
                  (br_if $tap (i32.lt_u (local.get $k) (i32.const 4))))
                (local.set $at (i32.add (local.get $ring) (i32.shl (i32.add (local.get $o) (local.get $x)) (i32.const 2))))
                (v128.store (local.get $at) (i32x4.shr_s (i32x4.add (local.get $vm1) (i32x4.splat (i32.const 32768))) (i32.const 16)))
                (v128.store (i32.add (local.get $at) (local.get $ring4)) (i32x4.shr_s (i32x4.add (local.get $vm2) (i32x4.splat (i32.const 32768))) (i32.const 16)))
                (v128.store (i32.add (local.get $at) (i32.mul (local.get $ring4) (i32.const 2))) (i32x4.add (i32x4.shr_s (local.get $vH0) (i32.const 3)) (i32x4.shr_s (i32x4.add (i32x4.add (i32x4.shl (v128.and (local.get $vH0) (i32x4.splat (i32.const 7))) (i32.const 13)) (local.get $vL0)) (i32x4.splat (i32.const 32768))) (i32.const 16))))
                (v128.store (i32.add (local.get $at) (i32.mul (local.get $ring4) (i32.const 3))) (i32x4.add (i32x4.shr_s (local.get $vH1) (i32.const 3)) (i32x4.shr_s (i32x4.add (i32x4.add (i32x4.shl (v128.and (local.get $vH1) (i32x4.splat (i32.const 7))) (i32.const 13)) (local.get $vL1)) (i32x4.splat (i32.const 32768))) (i32.const 16))))
