              (local.set $x1 (select (i32.add (local.get $x0) (i32.const 1)) (i32.sub (local.get $width) (i32.const 1))
                (i32.lt_s (i32.add (local.get $x0) (i32.const 1)) (local.get $width))))
              (f32.store (i32.add (local.get $d0) (i32.shl (local.get $x) (i32.const 2)))
                (f32.mul (f32.add (f32.add
                  (f32.add (f32.load (i32.add (local.get $r0) (i32.shl (local.get $x0) (i32.const 2))))
                           (f32.load (i32.add (local.get $r0) (i32.shl (local.get $x1) (i32.const 2)))))
                  (f32.load (i32.add (local.get $r1) (i32.shl (local.get $x0) (i32.const 2)))))
                  (f32.load (i32.add (local.get $r1) (i32.shl (local.get $x1) (i32.const 2))))) (f32.const 0.25)))
              (local.set $x (i32.add (local.get $x) (i32.const 1)))
              (br $k1Tail)))
            (local.set $y (i32.add (local.get $y) (i32.const 1)))
            (br $k1Y)))
          (br_if $k1C (i32.lt_u (local.tee $c (i32.add (local.get $c) (i32.const 1))) (i32.const 3))))
        (return)))
    (local.set $tr (i32.sub (local.get $linear) (i32.const 24576)))
    (block $k2YDone (loop $k2Y
      (br_if $k2YDone (i32.ge_s (local.get $y) (local.get $h)))
      (local.set $r0 (i32.add (local.get $input) (i32.shl (i32.mul (i32.shl (local.get $y) (i32.const 1)) (local.get $width)) (i32.const 2))))
      (local.set $x0 (i32.add (i32.shl (local.get $y) (i32.const 1)) (i32.const 1)))
      (local.set $r1 (i32.add (local.get $input) (i32.shl (i32.mul
        (select (local.get $x0) (i32.sub (local.get $height) (i32.const 1)) (i32.lt_s (local.get $x0) (local.get $height)))
        (local.get $width)) (i32.const 2))))
      (local.set $d0 (i32.add (local.get $output) (i32.shl (i32.mul (local.get $y) (local.get $w)) (i32.const 2))))
      (local.set $d1 (i32.add (local.get $d0) (i32.shl (local.get $m) (i32.const 2))))
      (local.set $d2 (i32.add (local.get $d1) (i32.shl (local.get $m) (i32.const 2))))
      (local.set $x (i32.const 0))
      (block $k2TailDone (loop $k2Tail
        (br_if $k2TailDone (i32.ge_s (local.get $x) (local.get $w)))
        (local.set $x0 (i32.shl (local.get $x) (i32.const 1)))
        (local.set $x1 (select (i32.add (local.get $x0) (i32.const 1)) (i32.sub (local.get $width) (i32.const 1))
          (i32.lt_s (i32.add (local.get $x0) (i32.const 1)) (local.get $width))))
