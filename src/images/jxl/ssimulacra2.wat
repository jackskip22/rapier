  (func $s2_vert_libjxl (param $y i32) (param $w i32) (param $h i32) (param $mask i32) (param $held_ms_mask i32)
                        (param $held_p1_mask i32) (param $p1_only_mask i32) (param $scale0_sparse i32)
                        (param $outputs i32) (param $terms i32) (param $edge_terms i32) (param $g i32)
    (local $wb i32) (local $pxb i32) (local $lo i32) (local $ro i32) (local $c i32) (local $o i32)
    (local $base i32) (local $base0 i32) (local $k i32) (local $ac i32) (local $held i32) (local $held_ms i32) (local $p1_only i32)
    (local $atb i32) (local $cc i32) (local $p1_row i32) (local $p2_row i32)
    (local.set $wb (i32.shl (local.get $w) (i32.const 2)))
    (local.set $pxb (i32.mul (local.get $wb) (local.get $h)))
    (local.set $lo (if (result i32) (i32.ge_s (i32.sub (local.get $y) (i32.const 6)) (i32.const 0))
      (then (i32.mul (i32.and (i32.sub (local.get $y) (i32.const 6)) (i32.const 15)) (local.get $wb)))
      (else (i32.const -1))))
    (local.set $ro (if (result i32) (i32.lt_s (i32.add (local.get $y) (i32.const 4)) (local.get $h))
      (then (i32.mul (i32.and (i32.add (local.get $y) (i32.const 4)) (i32.const 15)) (local.get $wb)))
      (else (i32.const -1))))
    (loop $Lc
      (if (i32.and (local.get $mask) (i32.shl (i32.const 1) (local.get $c)))
        (then
          (local.set $base0 (i32.mul (local.get $c) (i32.const 20)))
          (local.set $o (i32.const 0))
          (loop $Lo
            (local.set $base (i32.mul (i32.add (i32.mul (local.get $o) (i32.const 3)) (local.get $c)) (i32.const 20)))
            (local.set $k (i32.const 0))
            (loop $Lk
              (local.set $ac (i32.load (i32.add (i32.const 2176) (i32.add (local.get $base) (i32.shl (local.get $k) (i32.const 2))))))
              (if (i32.and (i32.ne (local.get $ac) (i32.const 0)) (i32.or (i32.eqz (local.get $o)) (i32.and (i32.ne (local.get $k) (i32.const 0)) (i32.ne (local.get $k) (i32.const 2)))))
                (then (call $s2_vert_row (local.get $ac)
                  (i32.load (i32.add (i32.const 2296) (i32.add (local.get $base) (i32.shl (local.get $k) (i32.const 2)))))
                  (i32.load (i32.add (i32.const 2416) (i32.add (local.get $base) (i32.shl (local.get $k) (i32.const 2)))))
                  (local.get $w) (local.get $lo) (local.get $ro) (i32.ge_s (local.get $y) (i32.const 0)) (local.get $g))))
              (br_if $Lk (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 5))))
            (if (i32.ge_s (local.get $y) (i32.const 0))
              (then
