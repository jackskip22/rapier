  ;; 4-row SIMD128 horizontal recursive Gaussian using pre-splatted f32x4 (3808..4384) & f64x2 (4480..5056) coefficients.
  (func $s2_blur4 (param $in i32) (param $out i32) (param $count i32) (param $g i32)
