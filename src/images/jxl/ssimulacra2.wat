            (local.set $a0 (i32.add (local.get $r0) (i32.shl (local.get $x1) (i32.const 2))))
            (local.set $p1 (i32.add (local.get $r1) (i32.shl (local.get $x0) (i32.const 2))))
            (local.set $a1 (i32.add (local.get $r1) (i32.shl (local.get $x1) (i32.const 2))))
            (local.set $a2 (i32.shl (local.get $x) (i32.const 2)))
            (f32.store (i32.add (local.get $d0) (local.get $a2)) (f32.mul (f32.add (f32.add (f32.add
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=0 (local.get $p0)) (i32.const 2))))
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=0 (local.get $a0)) (i32.const 2)))))
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=0 (local.get $p1)) (i32.const 2)))))
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=0 (local.get $a1)) (i32.const 2))))) (f32.const 0.25)))
            (f32.store (i32.add (local.get $d1) (local.get $a2)) (f32.mul (f32.add (f32.add (f32.add
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=1 (local.get $p0)) (i32.const 2))))
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=1 (local.get $a0)) (i32.const 2)))))
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=1 (local.get $p1)) (i32.const 2)))))
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=1 (local.get $a1)) (i32.const 2))))) (f32.const 0.25)))
            (f32.store (i32.add (local.get $d2) (local.get $a2)) (f32.mul (f32.add (f32.add (f32.add
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=2 (local.get $p0)) (i32.const 2))))
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=2 (local.get $a0)) (i32.const 2)))))
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=2 (local.get $p1)) (i32.const 2)))))
              (f32.load (i32.add (local.get $linear) (i32.shl (i32.load8_u offset=2 (local.get $a1)) (i32.const 2))))) (f32.const 0.25)))
            (local.set $x (i32.add (local.get $x) (i32.const 1)))
            (br $k0Tail)))
          (local.set $y (i32.add (local.get $y) (i32.const 1)))
          (br $k0Y)))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const 1))
      (then
        (loop $k1C
          (local.set $y (i32.const 0))
          (block $k1YDone (loop $k1Y
            (br_if $k1YDone (i32.ge_s (local.get $y) (local.get $h)))
            (local.set $p0 (i32.add (local.get $input) (i32.shl (i32.mul (local.get $c) (local.get $pixels)) (i32.const 2))))
            (local.set $r0 (i32.add (local.get $p0) (i32.shl (i32.mul (i32.shl (local.get $y) (i32.const 1)) (local.get $width)) (i32.const 2))))
            (local.set $x0 (i32.add (i32.shl (local.get $y) (i32.const 1)) (i32.const 1)))
            (local.set $r1 (i32.add (local.get $p0) (i32.shl (i32.mul
              (select (local.get $x0) (i32.sub (local.get $height) (i32.const 1)) (i32.lt_s (local.get $x0) (local.get $height)))
              (local.get $width)) (i32.const 2))))
            (local.set $d0 (i32.add (local.get $output) (i32.shl (i32.mul (i32.add (i32.mul (local.get $c) (local.get $h)) (local.get $y)) (local.get $w)) (i32.const 2))))
            (local.set $x (i32.const 0))
            (block $k1VecDone (loop $k1Vec
              (br_if $k1VecDone (i32.gt_s (i32.add (local.get $x) (i32.const 4)) (local.get $halfW)))
