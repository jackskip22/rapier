    (local.set $p2_stride (i32.shl (local.get $p_stride) (i32.const 1)))
    (local.set $acc_s1 (f64.load offset=0 (local.get $sums)))
    (local.set $acc_s4 (f64.load offset=8 (local.get $sums)))
    (local.set $acc_a1 (f64.load offset=16 (local.get $sums)))
    (local.set $acc_a4 (f64.load offset=24 (local.get $sums)))
    (local.set $acc_l1 (f64.load offset=32 (local.get $sums)))
    (local.set $acc_l4 (f64.load offset=40 (local.get $sums)))
    (block $vecDone (loop $vec
      (br_if $vecDone (i32.gt_s (i32.add (local.get $x) (i32.const 4)) (local.get $w)))
