      (local.set $s4 (f32x4.mul (local.get $t) (f32x4.add (v128.load (i32.add (local.get $q) (local.get $p2_stride))) (v128.load (i32.add (local.get $r) (local.get $p2_stride))))))
      (local.set $q (i32.add (local.get $q) (local.get $wb))) (local.set $r (i32.sub (local.get $r) (local.get $wb)))
      (local.set $t (v128.load (i32.const 528)))
      (local.set $s1 (f32x4.add (local.get $s1) (f32x4.mul (local.get $t) (f32x4.add (v128.load (local.get $q)) (v128.load (local.get $r))))))
