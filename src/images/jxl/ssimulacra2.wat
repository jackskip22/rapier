  ;; Contiguous 9-row vertical edge FIR + row sums (Scale 0 sparse X and B), 1 or 2 outputs sharing p1 & mean.
  (func $s2_edge_col (param $p1 i32) (param $p2 i32) (param $mean i32) (param $base0 i32)
                     (param $p2_1 i32) (param $base1 i32) (param $w i32) (param $wb i32) (param $g i32)
                     (param $sums0 i32) (param $sums1 i32) (param $need_a4 i32)
    (local $x i32) (local $x4 i32) (local $wb8 i32) (local $q i32) (local $r i32) (local $k i32)
    (local $a1_0 f64) (local $a4_0 f64) (local $a1_1 f64) (local $a4_1 f64) (local $dvf f64) (local $avf f64)
    (local $fq1 f32) (local $fr1 f32) (local $fa f32) (local $fdel f32)
    (local $q1 v128) (local $vr1 v128) (local $va v128) (local $den v128)
    (local $del v128) (local $ed v128) (local $dv v128) (local $av v128) (local $a2v v128)
    (local.set $wb8 (i32.shl (local.get $wb) (i32.const 3)))
    (local.set $a1_0 (f64.load offset=16 (local.get $sums0)))
    (local.set $a4_0 (f64.load offset=24 (local.get $sums0)))
    (if (local.get $p2_1)
      (then
        (local.set $a1_1 (f64.load offset=16 (local.get $sums1)))
        (local.set $a4_1 (f64.load offset=24 (local.get $sums1)))))
    (block $vecDone (loop $vec
      (br_if $vecDone (i32.gt_s (i32.add (local.get $x) (i32.const 4)) (local.get $w)))
      (local.set $x4 (i32.shl (local.get $x) (i32.const 2)))
      (local.set $q1 (v128.load (i32.add (local.get $p1) (local.get $x4))))
      (local.set $vr1 (f32x4.sub (local.get $q1) (v128.load (i32.add (local.get $mean) (local.get $x4)))))
      (local.set $va (f32x4.abs (local.get $vr1)))
      (local.set $den (f32x4.add (v128.const i32x4 0x3f800000 0x3f800000 0x3f800000 0x3f800000) (local.get $va)))
      (local.set $q (i32.add (local.get $base0) (local.get $x4)))
      (local.set $r (i32.add (local.get $q) (local.get $wb8)))
