  (func $s2_scale_rows_libjxl (param $w i32) (param $h i32) (param $mask i32) (param $ref i32) (param $ref_kind i32)
                              (param $dist i32) (param $dist_kind i32) (param $lin i32) (param $g i32)
                              (param $c0 i32) (param $c1 i32) (param $c2 i32) (param $cmask i32) (param $scratch i32)
                              (param $terms i32) (param $edge_terms i32) (param $sums i32)
                              (param $first i32) (param $end i32) (param $in_y i32) (param $in_h i32) (param $made i32)
                              (param $dist1 i32) (param $dist1_kind i32) (param $scratch1 i32) (param $sums1 i32) (result i32)
    (local $bound_d i32) (local $scale0_sparse i32) (local $p1_only_mask i32) (local $held_ms_mask i32) (local $held_p1_mask i32)
    (local $outputs i32) (local $make_ref i32) (local $y i32) (local $rows i32) (local $i i32) (local $v v128)
    ;; Pre-splat all 42 libjxl Gaussian coefficients once per call (0..5: vertical n2 & -d1, 6..41: horizontal 3x12).
    (loop $Lw
      (local.set $v (v128.load32_splat (i32.add (local.get $g) (i32.shl (local.get $i) (i32.const 2)))))
      (if (i32.and (i32.ge_u (local.get $i) (i32.const 3)) (i32.lt_u (local.get $i) (i32.const 6)))
        (then (local.set $v (f32x4.neg (local.get $v)))))
      (v128.store (i32.add (i32.const 3712) (i32.shl (local.get $i) (i32.const 4))) (local.get $v))
      (v128.store (i32.add (i32.const 4384) (i32.shl (local.get $i) (i32.const 4))) (f64x2.promote_low_f32x4 (local.get $v)))
      (br_if $Lw (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 42))))

    (local.set $bound_d (i32.ne (i32.and (local.get $cmask) (i32.const 8192)) (i32.const 0)))
    (local.set $scale0_sparse (i32.and (i32.ne (i32.and (local.get $cmask) (i32.const 16384)) (i32.const 0)) (i32.eqz (local.get $terms))))
    (local.set $y (i32.and (i32.shr_u (local.get $cmask) (i32.const 7)) (i32.const 7)))
    (local.set $p1_only_mask (select (select (local.get $y) (i32.const 7) (local.get $y)) (i32.const 0) (i32.and (local.get $cmask) (i32.const 64))))
    (local.set $held_ms_mask (i32.and (local.get $cmask) (i32.const 7)))
    (local.set $held_p1_mask (i32.or (local.get $held_ms_mask) (i32.and (i32.shr_u (local.get $cmask) (i32.const 3)) (i32.const 7))))
    (local.set $outputs (select (i32.const 2) (i32.const 1) (local.get $dist1)))
    (i32.store (i32.const 2136) (local.get $dist)) (i32.store (i32.const 2140) (local.get $dist1))
    (i32.store (i32.const 2144) (local.get $dist_kind)) (i32.store (i32.const 2148) (local.get $dist1_kind))
    (local.set $make_ref (call $s2_setup_ptrs (local.get $w) (local.get $mask) (local.get $c0) (local.get $c1) (local.get $c2) (local.get $cmask)
      (local.get $scratch) (local.get $sums) (local.get $first) (local.get $outputs) (local.get $scratch1) (local.get $sums1) (local.get $scale0_sparse)))
    (local.set $y (local.get $first))
    (block $dy (loop $Ly
      (br_if $dy (i32.ge_s (local.get $y) (local.get $end)))
      (block $dm (loop $Lm
        (br_if $dm (i32.or (i32.ge_s (local.get $made) (local.get $h)) (i32.gt_s (local.get $made) (i32.add (local.get $y) (i32.const 4)))))
        (local.set $rows (select (i32.sub (local.get $h) (local.get $made)) (i32.const 4) (i32.lt_s (i32.sub (local.get $h) (local.get $made)) (i32.const 4))))
        (call $s2_make_batch (local.get $make_ref) (local.get $bound_d) (local.get $mask) (local.get $held_p1_mask)
          (local.get $w) (local.get $in_y) (local.get $in_h) (local.get $ref) (local.get $ref_kind)
          (local.get $outputs) (local.get $made) (local.get $rows) (local.get $lin))
        (call $s2_horiz_libjxl (local.get $w) (local.get $mask) (local.get $held_p1_mask) (local.get $outputs) (local.get $made) (local.get $rows) (local.get $g))
        (local.set $made (i32.add (local.get $made) (local.get $rows)))
        (br $Lm)))
      (call $s2_vert_libjxl (local.get $y) (local.get $w) (local.get $h) (local.get $mask) (local.get $held_ms_mask)
        (local.get $held_p1_mask) (local.get $p1_only_mask) (local.get $scale0_sparse)
        (local.get $outputs) (local.get $terms) (local.get $edge_terms) (local.get $g))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $Ly)))
    (local.get $made))

  (func $s2_scale_rows_dispatch (param $w i32) (param $h i32) (param $mask i32) (param $ref i32) (param $ref_kind i32)
                                (param $dist i32) (param $dist_kind i32) (param $lin i32) (param $g i32)
                                (param $c0 i32) (param $c1 i32) (param $c2 i32) (param $cmask i32) (param $scratch i32)
                                (param $terms i32) (param $edge_terms i32) (param $sums i32)
                                (param $first i32) (param $end i32) (param $in_y i32) (param $in_h i32) (param $made i32)
                                (param $dist1 i32) (param $dist1_kind i32) (param $scratch1 i32) (param $sums1 i32) (result i32)
