            (local.set $cov (i64.sub (i64.shr_s (i64.add (call $s2cColumn (i32.add (local.get $at) (i32.mul (local.get $ring4) (i32.const 4))) (local.get $acc)) (i64.const 32768)) (i64.const 16)) (i64.mul (local.get $mu1) (local.get $mu2))))
            (local.set $sv (i64.add (local.get $v1) (local.get $v2)))
            (local.set $lift (select (i64.sub (i64.const 0) (local.get $sv)) (i64.const 0) (i64.lt_s (local.get $sv) (i64.const 0))))
            (local.set $numS (i64.add (i64.add (i64.add (local.get $cov) (local.get $cov)) (i64.const 15099)) (local.get $lift)))
            (local.set $denS (i64.add (i64.add (local.get $sv) (local.get $lift)) (i64.const 15099)))
            (local.set $ratio (i64.div_u (i64.add (i64.shl (select (i64.sub (i64.const 0) (local.get $numS)) (local.get $numS) (i64.lt_s (local.get $numS) (i64.const 0))) (i64.const 16))
              (i64.extend_i32_s (i32.shr_s (i32.wrap_i64 (local.get $denS)) (i32.const 1)))) (local.get $denS)))
            (local.set $ratio (select (i64.const 65536) (local.get $ratio) (i64.gt_s (local.get $ratio) (i64.const 65536))))
            (local.set $r (select (i64.sub (i64.const 0) (local.get $ratio)) (local.get $ratio) (i64.lt_s (local.get $numS) (i64.const 0))))
