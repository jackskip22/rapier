              (local.set $v3 (v128.load offset=16 (i32.add (local.get $r1) (local.get $x0))))
              (local.set $va (i8x16.shuffle 0 1 2 3 8 9 10 11 16 17 18 19 24 25 26 27 (local.get $v0) (local.get $v1)))
              (local.set $vb (i8x16.shuffle 4 5 6 7 12 13 14 15 20 21 22 23 28 29 30 31 (local.get $v0) (local.get $v1)))
              (local.set $vc (i8x16.shuffle 0 1 2 3 8 9 10 11 16 17 18 19 24 25 26 27 (local.get $v2) (local.get $v3)))
              (local.set $ve (i8x16.shuffle 4 5 6 7 12 13 14 15 20 21 22 23 28 29 30 31 (local.get $v2) (local.get $v3)))
              (v128.store (i32.add (local.get $d0) (i32.shl (local.get $x) (i32.const 2)))
                (f32x4.mul (f32x4.add (f32x4.add (f32x4.add (local.get $va) (local.get $vb)) (local.get $vc)) (local.get $ve)) (local.get $qtr)))
              (local.set $x (i32.add (local.get $x) (i32.const 4)))
