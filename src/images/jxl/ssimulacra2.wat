          (f32x4.add (f32x4.neg (local.get $p2)) (f32x4.mul (local.get $sum) (v128.load (local.get $pf))))))
        (local.set $y0 (if (result v128) (i32.eq (local.get $i) (i32.const 2)) (then (local.get $n2)) (else (f32x4.add (local.get $n2) (local.get $y0)))))
