        (local.set $a0 (i32.add (local.get $tr) (i32.shl (i32.load8_u (local.get $p0)) (i32.const 5))))
        (local.set $a1 (i32.add (local.get $tr) (i32.shl (i32.add (i32.const 256) (i32.load8_u offset=1 (local.get $p0))) (i32.const 5))))
        (local.set $a2 (i32.add (local.get $tr) (i32.shl (i32.add (i32.const 512) (i32.load8_u offset=2 (local.get $p0))) (i32.const 5))))
