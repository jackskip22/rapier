      (then (call $s2_scale_rows_libjxl
        (local.get $w) (local.get $h) (local.get $mask) (local.get $ref) (local.get $ref_kind)
        (local.get $dist) (local.get $dist_kind) (local.get $lin) (local.get $g)
        (local.get $c0) (local.get $c1) (local.get $c2) (local.get $cmask) (local.get $scratch)
        (local.get $terms) (local.get $edge_terms) (local.get $sums)
        (local.get $first) (local.get $end) (local.get $in_y) (local.get $in_h) (local.get $made)
        (local.get $dist1) (local.get $dist1_kind) (local.get $scratch1) (local.get $sums1)))
      (else (call $s2_fast_scale_rows
        (local.get $w) (local.get $h) (local.get $mask) (local.get $ref) (local.get $ref_kind)
        (local.get $dist) (local.get $dist_kind) (local.get $lin) (local.get $g)
        (local.get $c0) (local.get $c1) (local.get $c2) (local.get $cmask) (local.get $scratch)
        (local.get $terms) (local.get $edge_terms) (local.get $sums)
        (local.get $first) (local.get $end) (local.get $in_y) (local.get $in_h) (local.get $made)
        (local.get $dist1) (local.get $dist1_kind) (local.get $scratch1) (local.get $sums1)))))

  (func (export "s2MetricScale") (param $w i32) (param $h i32) (param $mask i32) (param $ref i32) (param $ref_kind i32)
    (param $dist i32) (param $dist_kind i32) (param $lin i32) (param $g i32) (param $c0 i32) (param $c1 i32) (param $c2 i32)
    (param $cmask i32) (param $scratch i32) (param $terms i32) (param $edge_terms i32) (param $sums i32)
    (drop (call $s2_scale_rows_dispatch (local.get $w) (local.get $h) (local.get $mask) (local.get $ref) (local.get $ref_kind)
      (local.get $dist) (local.get $dist_kind) (local.get $lin) (local.get $g) (local.get $c0) (local.get $c1) (local.get $c2)
      (local.get $cmask) (local.get $scratch) (local.get $terms) (local.get $edge_terms) (local.get $sums)
      (i32.const -4) (local.get $h) (i32.const 0) (local.get $h) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))))

  (func (export "s2MetricBand") (param $w i32) (param $h i32) (param $first i32) (param $end i32) (param $in_y i32) (param $in_h i32)
    (param $ref i32) (param $ref_kind i32) (param $dist i32) (param $dist_kind i32) (param $lin i32) (param $g i32)
    (param $scratch i32) (param $sums i32) (param $c0 i32) (param $c1 i32) (param $c2 i32) (param $cmask i32) (result i32)
    (local $m i32) (local $y i32) (local $at i32)
    (if (i32.eq (local.get $first) (i32.const -99))
      (then
        (i32.store (i32.const 2096) (local.get $c0))
        (i32.store (i32.const 2100) (local.get $c1))
        (i32.store (i32.const 2104) (local.get $c2))
