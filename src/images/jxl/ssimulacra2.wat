        (i32.store (i32.add (i32.add (local.get $q) (local.get $w4)) (i32.shl (local.get $x) (i32.const 2))) (i32.wrap_i64 (local.get $art)))
        (i32.store (i32.add (i32.add (local.get $q) (i32.shl (local.get $w4) (i32.const 1))) (i32.shl (local.get $x) (i32.const 2))) (i32.wrap_i64 (local.get $lost)))
