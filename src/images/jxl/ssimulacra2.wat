            (local.set $numM (i64.sub (i64.const 16777216) (i64.mul (local.get $d) (local.get $d))))
            (local.set $e (i64.sub (i64.const 65536) (i64.shr_s (i64.add (i64.mul (local.get $numM) (local.get $r)) (i64.const 8388608)) (i64.const 24))))
            (local.set $e (select (i64.const 0) (local.get $e) (i64.lt_s (local.get $e) (i64.const 0))))
            (local.set $e (select (i64.const 131071) (local.get $e) (i64.gt_s (local.get $e) (i64.const 131071))))))
        (local.set $num (i64.sub (i64.extend_i32_s (i32.load16_s (i32.add (local.get $P2) (i32.shl (i32.add (local.get $row) (local.get $x)) (i32.const 1))))) (local.get $mu2)))
        (local.set $num (i64.add (i64.const 4096) (select (i64.sub (i64.const 0) (local.get $num)) (local.get $num) (i64.lt_s (local.get $num) (i64.const 0)))))
        (local.set $den (i64.sub (i64.extend_i32_s (i32.load16_s (i32.add (local.get $P1) (i32.shl (i32.add (local.get $row) (local.get $x)) (i32.const 1))))) (local.get $mu1)))
        (local.set $den (i64.add (i64.const 4096) (select (i64.sub (i64.const 0) (local.get $den)) (local.get $den) (i64.lt_s (local.get $den) (i64.const 0)))))
        (local.set $dd (i64.sub (i64.div_u (i64.add (i64.shl (local.get $num) (i64.const 16)) (i64.shr_s (local.get $den) (i64.const 1))) (local.get $den)) (i64.const 65536)))
        (local.set $art (select (i64.const 0) (local.get $dd) (i64.lt_s (local.get $dd) (i64.const 0))))
        (local.set $art (select (i64.const 131071) (local.get $art) (i64.gt_s (local.get $art) (i64.const 131071))))
        (local.set $lost (select (i64.sub (i64.const 0) (local.get $dd)) (i64.const 0) (i64.lt_s (local.get $dd) (i64.const 0))))
