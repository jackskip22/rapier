      (local.set $fs0 (f32.mul (local.get $gt) (f32.add (f32.load (i32.add (i32.const 656) (i32.shl (i32.sub (local.get $k) (i32.const 4)) (i32.const 2)))) (f32.load (i32.add (i32.const 656) (i32.shl (i32.add (local.get $k) (i32.const 4)) (i32.const 2)))))))
      (if (local.get $o1)
