                    (local.get $p1_row) (local.get $p2_row)
                    (i32.load (i32.add (i32.const 2416) (local.get $base0)))
                    (i32.load (i32.add (i32.const 2420) (local.get $base)))
                    (i32.load (i32.add (i32.const 2424) (local.get $base0)))
                    (i32.load (i32.add (i32.const 2428) (local.get $base)))
                    (i32.load (i32.add (i32.const 2432) (local.get $base)))
