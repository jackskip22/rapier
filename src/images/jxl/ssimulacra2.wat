            (local.set $fl (f32.sub (f32.load (local.get $q)) (local.get $fb)))
            (local.set $fr (f32.sub (f32.load (local.get $r)) (local.get $fb)))
            (local.set $fs1 (f32.add (local.get $fs1) (f32.mul (f32.load (i32.add (local.get $g) (i32.shl (local.get $k) (i32.const 2)))) (f32.add (local.get $fl) (local.get $fr)))))
            (local.set $fs2 (f32.add (local.get $fs2) (f32.mul (f32.load (i32.add (local.get $g) (i32.shl (local.get $k) (i32.const 2)))) (f32.add (f32.mul (local.get $fl) (local.get $fl)) (f32.mul (local.get $fr) (local.get $fr))))))
