          (f32x4.neg (v128.load (i32.add (local.get $st) (i32.add (i32.mul (local.get $wb) (i32.const 3)) (local.get $xb))))))))
      (local.set $o5 (call $s2_fma4c (v128.load (i32.const 4416)) (v128.load (i32.const 3744)) (local.get $sum)
        (call $s2_fma4c (v128.load (i32.const 4464)) (v128.load (i32.const 3792)) (local.get $a4)
          (f32x4.neg (v128.load (i32.add (local.get $st) (i32.add (i32.mul (local.get $wb) (i32.const 5)) (local.get $xb))))))))
