              (if (i32.and (i32.eqz (local.get $o)) (i32.and (i32.eqz (local.get $held)) (i32.ne (local.get $cc) (i32.const 0))))
                (then (memory.copy (i32.add (local.get $cc) (i32.mul (i32.add (local.get $made) (local.get $r)) (local.get $wb)))
                                   (i32.load (i32.add (i32.const 2536) (i32.shl (local.get $r) (i32.const 2)))) (local.get $wb))))
