            (memory.fill (i32.add (local.get $dst) (i32.add (i32.mul (local.get $p) (local.get $d_stride)) (local.get $d_off))) (i32.const 0) (local.get $wb))
            (br_if $Lz (i32.lt_s (local.tee $p (i32.add (local.get $p) (i32.const 1))) (local.get $planes)))))
