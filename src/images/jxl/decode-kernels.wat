        (local.set $m0 (call $fr (f64.sub (call $fr (f64.sub (call $V (i32.const 1)) (call $V (i32.const 0)))) (f64.load offset=32 (local.get $ptr)))))
        (local.set $s (call $fr (f64.sub (call $V (i32.const 2)) (f64.load offset=40 (local.get $ptr)))))
        (local.set $ca (call $fr (f64.add (f64.mul (call $fr (f64.mul (local.get $l) (local.get $l))) (local.get $l)) (f64.load (local.get $ptr)))))
        (local.set $cb (call $fr (f64.add (f64.mul (call $fr (f64.mul (local.get $m0) (local.get $m0))) (local.get $m0)) (f64.load offset=8 (local.get $ptr)))))
        (local.set $cc (call $fr (f64.add (f64.mul (call $fr (f64.mul (local.get $s) (local.get $s))) (local.get $s)) (f64.load offset=16 (local.get $ptr)))))
        (local.set $y (i32.const 0))
