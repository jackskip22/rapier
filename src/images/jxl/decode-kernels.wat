    (local $at i32) (local $to i32) (local $s f64) (local $factor f64) (local $ws f64) (local $v0 f64) (local $v1 f64) (local $v2 f64)
    (local $a0 i32) (local $a1 i32) (local $a3 i32) (local $a4 i32) (local $k i32) (local $count i32) (local $table i32) (local $dx i32) (local $dy i32)
