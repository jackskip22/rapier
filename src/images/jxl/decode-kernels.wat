      (local.set $m (i32.load offset=12 (i32.add (local.get $args) (i32.shl (local.get $c) (i32.const 2)))))
      (local.set $o (i32.load offset=24 (i32.add (local.get $args) (i32.shl (local.get $c) (i32.const 2)))))
      (local.set $w (i32.load offset=36 (i32.add (local.get $args) (i32.shl (local.get $c) (i32.const 2)))))
      (local.set $h (i32.load offset=48 (i32.add (local.get $args) (i32.shl (local.get $c) (i32.const 2)))))
