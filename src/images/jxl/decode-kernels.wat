            (local.set $v2 (v128.bitselect (local.get $v2) (f64x2.sub (local.get $x2) (f64x2.div (local.get $nv) (local.get $x2))) (local.get $small)))))
          (local.set $v2 (f64x2.mul (f64x2.mul (local.get $v2)
            (f64x2.promote_low_f32x4 (v128.load64_zero (i32.add (local.get $quant) (i32.shl (local.get $i) (i32.const 2)))))) (local.get $fv)))
