        (if (i32.eqz (local.get $a)) (then
          (local.set $x (i32.const 0))
          (loop $xyz (call $setV (local.get $x) (f64.div (call $V (local.get $x)) (f64.div (f64.const 65535) (f64.const 32768))))
            (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $xyz (i32.lt_u (local.get $x) (i32.const 3))))
          (br $next)))
        (call $xyzLab)
        (local.set $scale (select (f64.div (f64.const 65535) (f64.const 65280)) (f64.const 1) (local.get $b)))
        (call $setV (i32.const 0) (f64.div (call $V (i32.const 0)) (f64.mul (f64.const 100) (local.get $scale))))
        (call $setV (i32.const 1) (f64.div (f64.add (call $V (i32.const 1)) (f64.const 128)) (f64.mul (f64.const 255) (local.get $scale))))
        (call $setV (i32.const 2) (f64.div (f64.add (call $V (i32.const 2)) (f64.const 128)) (f64.mul (f64.const 255) (local.get $scale))))
