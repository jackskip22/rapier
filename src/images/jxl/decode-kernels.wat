      (i32.store offset=32768 (i32.add (local.get $t) (i32.shl (local.get $k) (i32.const 2))) (local.get $low))
      (local.set $prev (local.get $low))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br_if $levels (i32.lt_s (local.get $k) (i32.const 256))))
    (local.set $k (i32.const 0))
    (loop $steps
