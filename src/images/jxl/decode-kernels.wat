        (if (f64.ne (local.get $y) (f64.const 0)) (then
          (local.set $a (i32.load (i32.add (local.get $tu) (i32.shl (local.get $u) (i32.const 2)))))
          (local.set $b (i32.load (i32.add (local.get $tv) (i32.shl (local.get $v) (i32.const 2)))))
          (local.set $ci (select (i32.add (i32.mul (local.get $a) (local.get $gw)) (local.get $b)) (i32.add (i32.mul (local.get $b) (local.get $gw)) (local.get $a)) (local.get $transpose)))
          (f64.store (i32.add (local.get $values) (i32.shl (local.get $i) (i32.const 3))) (f64.add (f64.load (i32.add (local.get $values) (i32.shl (local.get $i) (i32.const 3))))
            (f64.mul (f64.add (local.get $base) (f64.div (f64.convert_i32_s (i32.load (i32.add (local.get $map) (i32.shl (local.get $ci) (i32.const 2))))) (local.get $factor))) (local.get $y))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (local.set $u (i32.add (local.get $u) (i32.const 1)))
        (br_if $cols (i32.lt_u (local.get $u) (local.get $wide))))
      (local.set $v (i32.add (local.get $v) (i32.const 1)))
      (br $rows))))
  ;; llf(args): renderBlock's low frequencies for a block of bw x bh 8x8 cells from the LF image (rcLlfFromDC: the
  ;; cells' means, their scaled DCT, divided). args (i32): values, plane (f32), stride, bx, by, bw, bh, basisT(bw),
  ;; basis(bh), divisors, canonical width, scratch (means, then the DCT's rows, then its output).
  (func (export "llf") (param $g i32)
    (local $values i32) (local $plane i32) (local $stride i32) (local $bx i32) (local $by i32) (local $bw i32) (local $bh i32) (local $bt i32) (local $bb i32)
    (local $div i32) (local $canon i32) (local $m i32) (local $tmp i32) (local $low i32) (local $area i32) (local $i i32) (local $x i32) (local $y i32) (local $k i32) (local $v i32)
    (local $sum f64) (local $w i32) (local $tall i32)
    (local.set $values (i32.load (local.get $g))) (local.set $plane (i32.load offset=4 (local.get $g))) (local.set $stride (i32.load offset=8 (local.get $g)))
    (local.set $bx (i32.load offset=12 (local.get $g))) (local.set $by (i32.load offset=16 (local.get $g))) (local.set $bw (i32.load offset=20 (local.get $g)))
    (local.set $bh (i32.load offset=24 (local.get $g))) (local.set $bt (i32.load offset=28 (local.get $g))) (local.set $bb (i32.load offset=32 (local.get $g)))
    (local.set $div (i32.load offset=36 (local.get $g))) (local.set $canon (i32.load offset=40 (local.get $g))) (local.set $m (i32.load offset=44 (local.get $g)))
    (local.set $area (i32.mul (local.get $bw) (local.get $bh)))
    (local.set $tmp (i32.add (local.get $m) (i32.shl (local.get $area) (i32.const 3)))) (local.set $low (i32.add (local.get $tmp) (i32.shl (local.get $area) (i32.const 3))))
    (local.set $w (select (local.get $bw) (local.get $bh) (i32.gt_u (local.get $bw) (local.get $bh)))) (local.set $tall (i32.ge_u (local.get $bh) (local.get $bw)))
    (loop $means
      (f64.store (i32.add (local.get $m) (i32.shl (local.get $i) (i32.const 3))) (f64.promote_f32 (f32.load (i32.add (local.get $plane) (i32.shl (i32.add
        (i32.mul (i32.add (local.get $by) (i32.div_u (local.get $i) (local.get $bw))) (local.get $stride)) (i32.add (local.get $bx) (i32.rem_u (local.get $i) (local.get $bw)))) (i32.const 2))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $means (i32.lt_u (local.get $i) (local.get $area))))
    ;; Rows: tmp[y, k] = sum over x of m[y, x] basisT[x, k].
    (local.set $y (i32.const 0))
    (loop $rows
      (local.set $k (i32.const 0))
      (loop $ks
        (local.set $sum (f64.const 0)) (local.set $x (i32.const 0))
        (loop $xs
          (local.set $sum (f64.add (local.get $sum) (f64.mul (f64.load (i32.add (local.get $m) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $bw)) (local.get $x)) (i32.const 3))))
            (f64.load (i32.add (local.get $bt) (i32.shl (i32.add (i32.mul (local.get $x) (local.get $bw)) (local.get $k)) (i32.const 3)))))))
          (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $xs (i32.lt_u (local.get $x) (local.get $bw))))
        (f64.store (i32.add (local.get $tmp) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $bw)) (local.get $k)) (i32.const 3))) (local.get $sum))
        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br_if $ks (i32.lt_u (local.get $k) (local.get $bw))))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $y) (local.get $bh))))
    ;; Columns: low[v, u] = sum over y of tmp[y, u] basis[v, y], stored transposed when the block is tall.
    (local.set $v (i32.const 0))
    (loop $vs
      (local.set $k (i32.const 0))
      (loop $us
        (local.set $sum (f64.const 0)) (local.set $y (i32.const 0))
        (loop $ys
          (local.set $sum (f64.add (local.get $sum) (f64.mul (f64.load (i32.add (local.get $tmp) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $bw)) (local.get $k)) (i32.const 3))))
            (f64.load (i32.add (local.get $bb) (i32.shl (i32.add (i32.mul (local.get $v) (local.get $bh)) (local.get $y)) (i32.const 3)))))))
          (local.set $y (i32.add (local.get $y) (i32.const 1))) (br_if $ys (i32.lt_u (local.get $y) (local.get $bh))))
        (f64.store (i32.add (local.get $low) (i32.shl (select (i32.add (i32.mul (local.get $k) (local.get $bh)) (local.get $v)) (i32.add (i32.mul (local.get $v) (local.get $bw)) (local.get $k)) (local.get $tall)) (i32.const 3)))
          (local.get $sum))
        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br_if $us (i32.lt_u (local.get $k) (local.get $bw))))
      (local.set $v (i32.add (local.get $v) (i32.const 1))) (br_if $vs (i32.lt_u (local.get $v) (local.get $bh))))
    ;; values[(i / w) * canon + i % w] = low[i] / divisors[i].
    (local.set $i (i32.const 0))
    (loop $place
      (f64.store (i32.add (local.get $values) (i32.shl (i32.add (i32.mul (i32.div_u (local.get $i) (local.get $w)) (local.get $canon)) (i32.rem_u (local.get $i) (local.get $w))) (i32.const 3)))
        (f64.div (f64.load (i32.add (local.get $low) (i32.shl (local.get $i) (i32.const 3)))) (f64.load (i32.add (local.get $div) (i32.shl (local.get $i) (i32.const 3))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $place (i32.lt_u (local.get $i) (local.get $area)))))

  ;; One blended sample (decode-compose.mjs blendRows): patch-blending modes 0 keep, 1 replace, 2 add, 3 multiply,
  ;; 4/5 blend above/below, 6/7 alpha-weighted add above/below; flags 1 clamp, 2 associated alpha, 4 the alpha channel.
  ;; Every step rounds to binary32, as the format's reference arithmetic does.
  (func $clamp01f (param $x f32) (result f32) (f32.max (f32.const 0) (f32.min (f32.const 1) (local.get $x))))
  (func $blendOne (param $bg f32) (param $fg f32) (param $ba f32) (param $fa f32) (param $mode i32) (param $flags i32) (result f32)
    (local $t f32) (local $alpha f32) (local $rem f32) (local $merged f32)
    (if (i32.eqz (local.get $mode)) (then (return (local.get $bg))))
    (if (i32.eq (local.get $mode) (i32.const 1)) (then (return (local.get $fg))))
    (if (i32.eq (local.get $mode) (i32.const 2)) (then (return (f32.add (local.get $bg) (local.get $fg)))))
    (if (i32.eq (local.get $mode) (i32.const 3)) (then (return (f32.mul (local.get $bg)
      (select (call $clamp01f (local.get $fg)) (local.get $fg) (i32.and (local.get $flags) (i32.const 1)))))))
    (if (i32.and (local.get $mode) (i32.const 1)) (then
      (local.set $t (local.get $bg)) (local.set $bg (local.get $fg)) (local.set $fg (local.get $t))
      (local.set $t (local.get $ba)) (local.set $ba (local.get $fa)) (local.set $fa (local.get $t))))
    (local.set $alpha (select (call $clamp01f (local.get $fa)) (local.get $fa) (i32.and (local.get $flags) (i32.const 1))))
    (if (i32.ge_u (local.get $mode) (i32.const 6)) (then
      (if (i32.and (local.get $flags) (i32.const 4)) (then (return (local.get $bg))))
      (return (f32.add (local.get $bg) (f32.mul (local.get $alpha) (local.get $fg))))))
    (local.set $rem (f32.sub (f32.const 1) (local.get $alpha)))
    (local.set $merged (f32.sub (f32.const 1) (f32.mul (local.get $rem) (f32.sub (f32.const 1) (local.get $ba)))))
    (if (i32.and (local.get $flags) (i32.const 4)) (then (return (local.get $merged))))
    (if (i32.and (local.get $flags) (i32.const 2)) (then (return (f32.add (local.get $fg) (f32.mul (local.get $bg) (local.get $rem))))))
    (f32.mul (f32.add (f32.mul (local.get $fg) (local.get $alpha)) (f32.mul (f32.mul (local.get $bg) (local.get $ba)) (local.get $rem)))
      (select (f32.div (f32.const 1) (local.get $merged)) (f32.const 0) (f32.gt (local.get $merged) (f32.const 0)))))
  ;; n samples of each of count channels; a channel's 32-byte record: out, background, foreground, background alpha,
  ;; foreground alpha (binary32 runs), mode, flags. Outputs are separate runs, so every channel reads unblended inputs.
  (func (export "blend") (param $n i32) (param $specs i32) (param $count i32)
    (local $c i32) (local $s i32) (local $i i32) (local $o i32) (local $bg i32) (local $fg i32) (local $ba i32) (local $fa i32) (local $mode i32) (local $flags i32)
    (if (i32.or (i32.eqz (local.get $n)) (i32.eqz (local.get $count))) (then (return)))
    (loop $channels
      (local.set $s (i32.add (local.get $specs) (i32.shl (local.get $c) (i32.const 5))))
      (local.set $o (i32.load (local.get $s))) (local.set $bg (i32.load offset=4 (local.get $s))) (local.set $fg (i32.load offset=8 (local.get $s)))
      (local.set $ba (i32.load offset=12 (local.get $s))) (local.set $fa (i32.load offset=16 (local.get $s)))
      (local.set $mode (i32.load offset=20 (local.get $s))) (local.set $flags (i32.load offset=24 (local.get $s)))
      (local.set $i (i32.const 0))
      (loop $samples
        (f32.store (i32.add (local.get $o) (local.get $i)) (call $blendOne (f32.load (i32.add (local.get $bg) (local.get $i))) (f32.load (i32.add (local.get $fg) (local.get $i)))
          (f32.load (i32.add (local.get $ba) (local.get $i))) (f32.load (i32.add (local.get $fa) (local.get $i))) (local.get $mode) (local.get $flags)))
        (local.set $i (i32.add (local.get $i) (i32.const 4)))
        (br_if $samples (i32.lt_u (local.get $i) (i32.shl (local.get $n) (i32.const 2)))))
      (local.set $c (i32.add (local.get $c) (i32.const 1)))
      (br_if $channels (i32.lt_u (local.get $c) (local.get $count)))))

  ;; Upsampling (decode-upsample.mjs): source rows [y0, y1) of a width x height binary32 plane at in, each sample becoming
  ;; factor x factor samples (cropped to tw x th) of out, which holds target rows from y0 * factor, tw apart. weights:
  ;; factor * factor kernels of 25 binary32 weights; scratch: 25 binary32. Each output sums its 25 products in binary64
  ;; in order and is clamped to its neighborhood's range.
  (func (export "upsample") (param $in i32) (param $width i32) (param $height i32) (param $factor i32) (param $weights i32) (param $scratch i32)
    (param $out i32) (param $tw i32) (param $th i32) (param $y0 i32) (param $y1 i32)
    (local $y i32) (local $x i32) (local $k i32) (local $py i32) (local $px i32) (local $v f32) (local $lo f32) (local $hi f32) (local $sum f64) (local $at i32) (local $row i32)
    (local.set $y (local.get $y0))
    (if (i32.ge_s (local.get $y) (local.get $y1)) (then (return)))
    (loop $rows
      (local.set $x (i32.const 0))
      (loop $columns
        (local.set $lo (f32.const inf)) (local.set $hi (f32.const -inf)) (local.set $k (i32.const 0))
        (loop $near
          (local.set $v (f32.load (i32.add (local.get $in) (i32.shl (i32.add
            (i32.mul (call $mirror (i32.sub (i32.add (local.get $y) (i32.div_u (local.get $k) (i32.const 5))) (i32.const 2)) (local.get $height)) (local.get $width))
            (call $mirror (i32.sub (i32.add (local.get $x) (i32.rem_u (local.get $k) (i32.const 5))) (i32.const 2)) (local.get $width))) (i32.const 2)))))
          (f32.store (i32.add (local.get $scratch) (i32.shl (local.get $k) (i32.const 2))) (local.get $v))
          (if (f32.lt (local.get $v) (local.get $lo)) (then (local.set $lo (local.get $v))))
          (if (f32.gt (local.get $v) (local.get $hi)) (then (local.set $hi (local.get $v))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br_if $near (i32.lt_u (local.get $k) (i32.const 25))))
        (local.set $py (i32.const 0))
        (block $doneY (loop $ys
          (br_if $doneY (i32.or (i32.ge_u (local.get $py) (local.get $factor)) (i32.ge_s (i32.add (i32.mul (local.get $y) (local.get $factor)) (local.get $py)) (local.get $th))))
          (local.set $row (i32.add (local.get $out) (i32.shl (i32.mul (i32.add (i32.mul (i32.sub (local.get $y) (local.get $y0)) (local.get $factor)) (local.get $py)) (local.get $tw)) (i32.const 2))))
          (local.set $px (i32.const 0))
          (block $doneX (loop $xs
            (br_if $doneX (i32.or (i32.ge_u (local.get $px) (local.get $factor)) (i32.ge_s (i32.add (i32.mul (local.get $x) (local.get $factor)) (local.get $px)) (local.get $tw))))
            (local.set $at (i32.add (local.get $weights) (i32.mul (i32.add (i32.mul (local.get $py) (local.get $factor)) (local.get $px)) (i32.const 100))))
            (local.set $sum (f64.const 0)) (local.set $k (i32.const 0))
            (loop $taps
              (local.set $sum (f64.add (local.get $sum) (f64.mul (f64.promote_f32 (f32.load (i32.add (local.get $at) (local.get $k))))
                (f64.promote_f32 (f32.load (i32.add (local.get $scratch) (local.get $k)))))))
              (local.set $k (i32.add (local.get $k) (i32.const 4)))
              (br_if $taps (i32.lt_u (local.get $k) (i32.const 100))))
            (f32.store (i32.add (local.get $row) (i32.shl (i32.add (i32.mul (local.get $x) (local.get $factor)) (local.get $px)) (i32.const 2)))
              (f32.demote_f64 (f64.max (f64.promote_f32 (local.get $lo)) (f64.min (f64.promote_f32 (local.get $hi)) (local.get $sum)))))
            (local.set $px (i32.add (local.get $px) (i32.const 1)))
            (br $xs)))
          (local.set $py (i32.add (local.get $py) (i32.const 1)))
          (br $ys)))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $columns (i32.lt_s (local.get $x) (local.get $width))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_s (local.get $y) (local.get $y1)))))

  ;; Orientation (decode-compose.mjs orientPlane): input rows [a, b) of a width x height plane, held at in from row a,
  ;; to their oriented places (ox, oy), stored at out + 4 * ((oy - oyMin) * stride + ox - oxMin).
  (func (export "orient") (param $in i32) (param $width i32) (param $height i32) (param $a i32) (param $b i32) (param $orientation i32)
    (param $out i32) (param $stride i32) (param $oxMin i32) (param $oyMin i32)
    (local $x i32) (local $y i32) (local $ox i32) (local $oy i32) (local $src i32)
    (if (i32.or (i32.ge_s (local.get $a) (local.get $b)) (i32.eqz (local.get $width))) (then (return)))
    (local.set $y (local.get $a))
    (loop $rows
      (local.set $x (i32.const 0))
      (loop $columns
        (local.set $ox (local.get $x)) (local.set $oy (local.get $y))
        (block $placed
          (br_if $placed (i32.eq (local.get $orientation) (i32.const 1)))
          (if (i32.eq (local.get $orientation) (i32.const 2)) (then (local.set $ox (i32.sub (i32.sub (local.get $width) (i32.const 1)) (local.get $x))) (br $placed)))
          (if (i32.eq (local.get $orientation) (i32.const 3)) (then (local.set $ox (i32.sub (i32.sub (local.get $width) (i32.const 1)) (local.get $x)))
            (local.set $oy (i32.sub (i32.sub (local.get $height) (i32.const 1)) (local.get $y))) (br $placed)))
          (if (i32.eq (local.get $orientation) (i32.const 4)) (then (local.set $oy (i32.sub (i32.sub (local.get $height) (i32.const 1)) (local.get $y))) (br $placed)))
          (if (i32.eq (local.get $orientation) (i32.const 5)) (then (local.set $ox (local.get $y)) (local.set $oy (local.get $x)) (br $placed)))
          (if (i32.eq (local.get $orientation) (i32.const 6)) (then (local.set $ox (i32.sub (i32.sub (local.get $height) (i32.const 1)) (local.get $y))) (local.set $oy (local.get $x)) (br $placed)))
          (if (i32.eq (local.get $orientation) (i32.const 7)) (then (local.set $ox (i32.sub (i32.sub (local.get $height) (i32.const 1)) (local.get $y)))
            (local.set $oy (i32.sub (i32.sub (local.get $width) (i32.const 1)) (local.get $x))) (br $placed)))
          (local.set $ox (local.get $y)) (local.set $oy (i32.sub (i32.sub (local.get $width) (i32.const 1)) (local.get $x))))
        (f32.store (i32.add (local.get $out) (i32.shl (i32.add (i32.mul (i32.sub (local.get $oy) (local.get $oyMin)) (local.get $stride)) (i32.sub (local.get $ox) (local.get $oxMin))) (i32.const 2)))
          (f32.load (i32.add (local.get $in) (i32.shl (i32.add (i32.mul (i32.sub (local.get $y) (local.get $a)) (local.get $width)) (local.get $x)) (i32.const 2)))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $columns (i32.lt_s (local.get $x) (local.get $width))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_s (local.get $y) (local.get $b)))))

  ;; Modular samples to binary32 in place over n words at at (decode-frame.mjs channelSamples): integers divide by maximum;
  ;; floats of `bits` bits with `eb` exponent bits decode exactly and round once (binary32 words keep their bits, a
  ;; signaling NaN quieted as JavaScript quiets it).
  (func (export "samples") (param $n i32) (param $at i32) (param $float i32) (param $maximum f64) (param $bits i32) (param $eb i32)
    (local $i i32) (local $p i32) (local $u i32) (local $mb i32) (local $bias i32) (local $exponent i32) (local $fraction i32) (local $top i32) (local $v f64)
    (local.set $mb (i32.sub (i32.sub (local.get $bits) (local.get $eb)) (i32.const 1)))
    (local.set $bias (i32.sub (i32.shl (i32.const 1) (i32.sub (local.get $eb) (i32.const 1))) (i32.const 1)))
    (local.set $top (i32.sub (i32.shl (i32.const 1) (local.get $eb)) (i32.const 1)))
    (if (i32.eqz (local.get $n)) (then (return)))
    (loop $words
      (local.set $p (i32.add (local.get $at) (i32.shl (local.get $i) (i32.const 2))))
      (local.set $u (i32.load (local.get $p)))
      (if (i32.eqz (local.get $float)) (then
        (f32.store (local.get $p) (f32.demote_f64 (f64.div (f64.convert_i32_s (local.get $u)) (local.get $maximum)))))
      (else (if (i32.and (i32.eq (local.get $bits) (i32.const 32)) (i32.eq (local.get $eb) (i32.const 8))) (then
        (if (i32.and (i32.eq (i32.and (local.get $u) (i32.const 0x7f800000)) (i32.const 0x7f800000)) (i32.ne (i32.and (local.get $u) (i32.const 0x7fffff)) (i32.const 0)))
          (then (i32.store (local.get $p) (i32.or (local.get $u) (i32.const 0x400000))))))
      (else
        (local.set $exponent (i32.and (i32.shr_u (local.get $u) (local.get $mb)) (local.get $top)))
        (local.set $fraction (i32.and (local.get $u) (i32.sub (i32.shl (i32.const 1) (local.get $mb)) (i32.const 1))))
