  (global $eP0 (mut i32) (i32.const 0)) (global $eP1 (mut i32) (i32.const 0)) (global $eP2 (mut i32) (i32.const 0))
  (global $eO0 (mut i32) (i32.const 0)) (global $eO1 (mut i32) (i32.const 0)) (global $eO2 (mut i32) (i32.const 0))
  (global $eSigma (mut i32) (i32.const 0)) (global $eSw (mut i32) (i32.const 0)) (global $eStep (mut i32) (i32.const 0))
  (global $eCs0 (mut f64) (f64.const 0)) (global $eCs1 (mut f64) (f64.const 0)) (global $eCs2 (mut f64) (f64.const 0))
