  ;; transform (8x8 basis at basis) stored to dst (stride bytes, xs by ys samples when both are positive): the same
  ;; kernels in the same order as the separate calls, coefficients X Y B in the three coefficient blocks.
  (func (export "block8") (param $ix i32) (param $iy i32) (param $ib i32) (param $quant i32) (param $fx f64) (param $fy f64) (param $fb f64)
    (param $bx f64) (param $by f64) (param $bb f64) (param $num f64) (param $corrx f64) (param $corrb f64) (param $dcx f64) (param $dcy f64) (param $dcb f64)
    (param $dx i32) (param $dy i32) (param $db i32) (param $stride i32) (param $xs i32) (param $ys i32) (param $basis i32)
