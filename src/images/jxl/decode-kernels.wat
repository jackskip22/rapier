  ;; residual rows; previous holds the row above the stripe's first output row (the first average row for the image's).
  (func (export "squeezeDown") (param $low i32) (param $lowRows i32) (param $high i32) (param $out i32) (param $width i32) (param $count i32) (param $previous i32)
