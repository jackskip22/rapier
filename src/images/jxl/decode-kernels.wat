        (call $setV (i32.const 0) (f64.sub (f64.div (call $V (i32.const 0)) (f64.const 22.995788804)) (f64.const 0.015386134)))
        (call $setV (i32.const 2) (f64.add (f64.sub (f64.div (call $V (i32.const 2)) (f64.const 1.502141333)) (f64.const 0.27770459)) (local.get $m0)))
        (call $setV (i32.const 1) (local.get $m0))
