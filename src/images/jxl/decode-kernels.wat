  ;; The exact sRGB curve to the encoding (transferCurve's 'srgb', curve kind 7).
  (func $srgbExact (param $x f64) (result f64) (local $a f64)
    (local.set $a (f64.abs (local.get $x)))
    (call $signed (local.get $x) (select (f64.mul (f64.const 12.92) (local.get $a))
      (f64.sub (f64.mul (f64.const 1.055) (call $xpow (local.get $a) (f64.div (f64.const 1) (f64.const 2.4)))) (f64.const 0.055))
      (f64.le (local.get $a) (f64.const 0.0031308)))))
  ;; srgbTables(t): srgb's tables at t: a^(1/2.4) over 4096 mantissas, their inverses (byte 32768), 2048 exponent powers
  ;; (byte 65536) and the cubic's three coefficients (byte 81920).
  (func (export "srgbTables") (param $t i32) (local $i i32) (local $p f64) (local $c2 f64)
    (local.set $p (f64.div (f64.const 1) (f64.const 2.4)))
    (loop $mantissas
      (f64.store (i32.add (local.get $t) (i32.shl (local.get $i) (i32.const 3)))
        (call $xpow (f64.add (f64.const 1) (f64.div (f64.convert_i32_s (local.get $i)) (f64.const 4096))) (local.get $p)))
      (f64.store offset=32768 (i32.add (local.get $t) (i32.shl (local.get $i) (i32.const 3)))
        (f64.div (f64.const 1) (f64.add (f64.const 1) (f64.div (f64.convert_i32_s (local.get $i)) (f64.const 4096)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $mantissas (i32.lt_s (local.get $i) (i32.const 4096))))
    (local.set $i (i32.const 0))
    (loop $exponents
      (f64.store offset=65536 (i32.add (local.get $t) (i32.shl (local.get $i) (i32.const 3)))
        (call $xpow (f64.const 2) (f64.mul (local.get $p) (f64.convert_i32_s (i32.sub (local.get $i) (i32.const 1023))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $exponents (i32.lt_s (local.get $i) (i32.const 2048))))
    (local.set $c2 (f64.div (f64.mul (local.get $p) (f64.sub (local.get $p) (f64.const 1))) (f64.const 2)))
    (f64.store offset=81920 (local.get $t) (local.get $p))
    (f64.store offset=81928 (local.get $t) (local.get $c2))
    (f64.store offset=81936 (local.get $t) (f64.div (f64.mul (local.get $c2) (f64.sub (local.get $p) (f64.const 2))) (f64.const 3))))
  ;; srgb8Build(t): srgb8Table at t: steps (32768 bytes), then the thresholds (257 u32). 0, or 1 when a check fails.
  (func $level8 (param $bits i32) (result i32) (local $x f64) (local $t f64)
    (local.set $x (f64.promote_f32 (f32.reinterpret_i32 (local.get $bits))))
    (local.set $t (f64.add (f64.mul (f64.promote_f32 (f32.demote_f64
      (select (f64.mul (f64.const 12.92) (local.get $x)) (call $srgbExact (local.get $x)) (f64.le (local.get $x) (f64.const 0.0031308))))) (f64.const 255)) (f64.const 0.5)))
    (if (result i32) (f64.ge (local.get $t) (f64.const 255.5)) (then (i32.const 255))
      (else (if (result i32) (f64.ge (local.get $t) (f64.const 1)) (then (i32.trunc_f64_s (local.get $t))) (else (i32.const 0))))))
  (func (export "srgb8Build") (param $t i32) (result i32) (local $k i32) (local $low i32) (local $prev i32) (local $word i32) (local $a f64) (local $b i32)
    (local.set $prev (i32.const 0))
    (i32.store offset=32768 (local.get $t) (i32.const 0))
    (i32.store offset=33792 (local.get $t) (i32.const -1))
    (local.set $k (i32.const 1))
    (loop $levels
      (local.set $a (f64.div (f64.sub (f64.convert_i32_s (local.get $k)) (f64.const 0.5)) (f64.const 255)))
      (local.set $word (i32.reinterpret_f32 (f32.demote_f64 (select (f64.div (local.get $a) (f64.const 12.92))
        (call $xpow (f64.div (f64.add (local.get $a) (f64.const 0.055)) (f64.const 1.055)) (f64.const 2.4)) (f64.le (local.get $a) (f64.const 0.04045))))))
      (local.set $low (select (local.get $prev) (i32.sub (local.get $word) (i32.const 4)) (i32.gt_s (local.get $prev) (i32.sub (local.get $word) (i32.const 4)))))
      (block $down (loop $lower
        (br_if $down (i32.le_s (local.get $low) (local.get $prev)))
        (br_if $down (i32.lt_s (call $level8 (i32.sub (local.get $low) (i32.const 1))) (local.get $k)))
