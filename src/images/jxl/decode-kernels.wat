(module
  ;; Decoder kernels. MIT (images/jxl/LICENSE). Every sample the decoder computes is computed here. Each result equals
  ;; 8.0.0's JavaScript decoder's bit for bit: the same IEEE operations in the same order, lanes only across independent
  ;; outputs, no fused multiply-add.
  (memory (export "memory") 64 65536)
  ;; idct(coeff, width, height, bx, by, out, tmp, rows): inverseDCTInto's sums in their order, two lanes per step.
  (func $idct (export "idct") (param $coeff i32) (param $w i32) (param $h i32) (param $bx i32) (param $by i32) (param $out i32) (param $tmp i32) (param $rows i32)
    (local $u i32) (local $v i32) (local $x i32) (local $y i32) (local $any i32) (local $c f64) (local $cv v128)
    (local $row i32) (local $b i32) (local $n i32) (local $tall i32) (local $t v128) (local $o i32) (local $src i32)
    (local.set $n (i32.mul (i32.mul (local.get $w) (local.get $h)) (i32.const 8)))
    (local.set $tall (i32.ge_u (local.get $h) (local.get $w)))
    (memory.fill (local.get $tmp) (i32.const 0) (local.get $n))
    (local.set $v (i32.const 0))
    (loop $vloop
      (local.set $row (i32.add (local.get $tmp) (i32.mul (i32.mul (local.get $v) (local.get $w)) (i32.const 8))))
      (local.set $any (i32.const 0))
      (local.set $u (i32.const 0))
      (loop $uloop
        (local.set $c (f64.load (i32.add (local.get $coeff) (i32.shl
          (if (result i32) (local.get $tall)
            (then (i32.add (i32.mul (local.get $u) (local.get $h)) (local.get $v)))
            (else (i32.add (i32.mul (local.get $v) (local.get $w)) (local.get $u))))
          (i32.const 3)))))
        (if (f64.ne (local.get $c) (f64.const 0))
          (then
            (local.set $any (i32.const 1))
            (local.set $cv (f64x2.splat (local.get $c)))
            (local.set $b (i32.add (local.get $bx) (i32.mul (i32.mul (local.get $u) (local.get $w)) (i32.const 8))))
            (local.set $x (i32.const 0))
            (loop $xloop
              (v128.store (i32.add (local.get $row) (local.get $x))
                (f64x2.add (v128.load (i32.add (local.get $row) (local.get $x)))
                  (f64x2.mul (local.get $cv) (v128.load (i32.add (local.get $b) (local.get $x))))))
              (local.set $x (i32.add (local.get $x) (i32.const 16)))
              (br_if $xloop (i32.lt_u (local.get $x) (i32.shl (local.get $w) (i32.const 3)))))))
        (local.set $u (i32.add (local.get $u) (i32.const 1)))
        (br_if $uloop (i32.lt_u (local.get $u) (local.get $w))))
      (i32.store8 (i32.add (local.get $rows) (local.get $v)) (local.get $any))
      (local.set $v (i32.add (local.get $v) (i32.const 1)))
      (br_if $vloop (i32.lt_u (local.get $v) (local.get $h))))
    (memory.fill (local.get $out) (i32.const 0) (local.get $n))
    (local.set $v (i32.const 0))
    (loop $v2
      (if (i32.load8_u (i32.add (local.get $rows) (local.get $v)))
        (then
          (local.set $src (i32.add (local.get $tmp) (i32.mul (i32.mul (local.get $v) (local.get $w)) (i32.const 8))))
          (local.set $y (i32.const 0))
          (loop $yloop
            (local.set $t (f64x2.splat (f64.load (i32.add (local.get $by) (i32.shl (i32.add (i32.mul (local.get $v) (local.get $h)) (local.get $y)) (i32.const 3))))))
            (local.set $o (i32.add (local.get $out) (i32.mul (i32.mul (local.get $y) (local.get $w)) (i32.const 8))))
            (local.set $x (i32.const 0))
            (loop $x2
              (v128.store (i32.add (local.get $o) (local.get $x))
                (f64x2.add (v128.load (i32.add (local.get $o) (local.get $x)))
                  (f64x2.mul (v128.load (i32.add (local.get $src) (local.get $x))) (local.get $t))))
              (local.set $x (i32.add (local.get $x) (i32.const 16)))
              (br_if $x2 (i32.lt_u (local.get $x) (i32.shl (local.get $w) (i32.const 3)))))
            (local.set $y (i32.add (local.get $y) (i32.const 1)))
            (br_if $yloop (i32.lt_u (local.get $y) (local.get $h))))))
      (local.set $v (i32.add (local.get $v) (i32.const 1)))
      (br_if $v2 (i32.lt_u (local.get $v) (local.get $h)))))

  ;; The 8x8 case unrolled across each row.
  (func $idct8 (export "idct8") (param $coeff i32) (param $b i32) (param $out i32) (param $tmp i32)
    (local $u i32) (local $v i32) (local $y i32) (local $c f64) (local $cv v128) (local $row i32) (local $bu i32)
    (local $any i32) (local $rows i32) (local $t v128) (local $o i32) (local $r0 v128) (local $r1 v128) (local $r2 v128) (local $r3 v128)
    (memory.fill (local.get $tmp) (i32.const 0) (i32.const 512))
    (memory.fill (local.get $out) (i32.const 0) (i32.const 512))
    (local.set $v (i32.const 0))
    (loop $vloop
      (local.set $row (i32.add (local.get $tmp) (i32.shl (local.get $v) (i32.const 6))))
      (local.set $any (i32.const 0))
      (local.set $u (i32.const 0))
      (loop $uloop
        (local.set $c (f64.load (i32.add (local.get $coeff) (i32.shl (i32.add (i32.shl (local.get $u) (i32.const 3)) (local.get $v)) (i32.const 3)))))
        (if (f64.ne (local.get $c) (f64.const 0))
          (then
            (local.set $any (i32.const 1))
            (local.set $cv (f64x2.splat (local.get $c)))
            (local.set $bu (i32.add (local.get $b) (i32.shl (local.get $u) (i32.const 6))))
            (v128.store offset=0 (local.get $row) (f64x2.add (v128.load offset=0 (local.get $row)) (f64x2.mul (local.get $cv) (v128.load offset=0 (local.get $bu)))))
            (v128.store offset=16 (local.get $row) (f64x2.add (v128.load offset=16 (local.get $row)) (f64x2.mul (local.get $cv) (v128.load offset=16 (local.get $bu)))))
            (v128.store offset=32 (local.get $row) (f64x2.add (v128.load offset=32 (local.get $row)) (f64x2.mul (local.get $cv) (v128.load offset=32 (local.get $bu)))))
            (v128.store offset=48 (local.get $row) (f64x2.add (v128.load offset=48 (local.get $row)) (f64x2.mul (local.get $cv) (v128.load offset=48 (local.get $bu)))))
))
        (local.set $u (i32.add (local.get $u) (i32.const 1)))
        (br_if $uloop (i32.lt_u (local.get $u) (i32.const 8))))
      (if (local.get $any) (then
        (local.set $r0 (v128.load offset=0 (local.get $row))) (local.set $r1 (v128.load offset=16 (local.get $row)))
        (local.set $r2 (v128.load offset=32 (local.get $row))) (local.set $r3 (v128.load offset=48 (local.get $row)))
        (local.set $y (i32.const 0))
        (loop $yloop
          (local.set $t (f64x2.splat (f64.load (i32.add (local.get $b) (i32.shl (i32.add (i32.shl (local.get $v) (i32.const 3)) (local.get $y)) (i32.const 3))))))
          (local.set $o (i32.add (local.get $out) (i32.shl (local.get $y) (i32.const 6))))
          (v128.store offset=0 (local.get $o) (f64x2.add (v128.load offset=0 (local.get $o)) (f64x2.mul (local.get $r0) (local.get $t))))
          (v128.store offset=16 (local.get $o) (f64x2.add (v128.load offset=16 (local.get $o)) (f64x2.mul (local.get $r1) (local.get $t))))
          (v128.store offset=32 (local.get $o) (f64x2.add (v128.load offset=32 (local.get $o)) (f64x2.mul (local.get $r2) (local.get $t))))
          (v128.store offset=48 (local.get $o) (f64x2.add (v128.load offset=48 (local.get $o)) (f64x2.mul (local.get $r3) (local.get $t))))
          (local.set $y (i32.add (local.get $y) (i32.const 1)))
          (br_if $yloop (i32.lt_u (local.get $y) (i32.const 8))))))
      (local.set $v (i32.add (local.get $v) (i32.const 1)))
      (br_if $vloop (i32.lt_u (local.get $v) (i32.const 8)))))

  ;; gab(r, rm, rp, o, count, side, diagonal, normal): Gaborish for samples 1 to count of one row (f32 rows r, rm
  ;; above, rp below; o the output row), two lanes per step.
  (func $gab (param $r i32) (param $rm i32) (param $rp i32) (param $o i32) (param $count i32) (param $side f64) (param $diag f64) (param $normal f64)
    (local $a i32) (local $end i32) (local $sv v128) (local $dv v128) (local $nv v128) (local $cross v128) (local $corners v128)
    (local.set $sv (f64x2.splat (local.get $side))) (local.set $dv (f64x2.splat (local.get $diag))) (local.set $nv (f64x2.splat (local.get $normal)))
    (local.set $a (i32.const 4))
    (local.set $end (i32.shl (i32.add (local.get $count) (i32.const 1)) (i32.const 2)))
    (block $done (loop $pairs
      (br_if $done (i32.gt_u (i32.add (local.get $a) (i32.const 8)) (local.get $end)))
      (local.set $cross (f64x2.add (f64x2.add (f64x2.add
        (f64x2.promote_low_f32x4 (v128.load64_zero (i32.sub (i32.add (local.get $r) (local.get $a)) (i32.const 4))))
        (f64x2.promote_low_f32x4 (v128.load64_zero (i32.add (i32.add (local.get $r) (local.get $a)) (i32.const 4)))))
        (f64x2.promote_low_f32x4 (v128.load64_zero (i32.add (local.get $rm) (local.get $a)))))
        (f64x2.promote_low_f32x4 (v128.load64_zero (i32.add (local.get $rp) (local.get $a))))))
      (local.set $corners (f64x2.add (f64x2.add (f64x2.add
        (f64x2.promote_low_f32x4 (v128.load64_zero (i32.sub (i32.add (local.get $rm) (local.get $a)) (i32.const 4))))
        (f64x2.promote_low_f32x4 (v128.load64_zero (i32.add (i32.add (local.get $rm) (local.get $a)) (i32.const 4)))))
        (f64x2.promote_low_f32x4 (v128.load64_zero (i32.sub (i32.add (local.get $rp) (local.get $a)) (i32.const 4)))))
        (f64x2.promote_low_f32x4 (v128.load64_zero (i32.add (i32.add (local.get $rp) (local.get $a)) (i32.const 4))))))
      (v128.store64_lane 0 (i32.add (local.get $o) (local.get $a)) (f32x4.demote_f64x2_zero
        (f64x2.mul (local.get $nv) (f64x2.add (f64x2.add
          (f64x2.promote_low_f32x4 (v128.load64_zero (i32.add (local.get $r) (local.get $a))))
          (f64x2.mul (local.get $sv) (local.get $cross))) (f64x2.mul (local.get $dv) (local.get $corners))))))
      (local.set $a (i32.add (local.get $a) (i32.const 8)))
      (br $pairs)))
    (if (i32.lt_u (local.get $a) (local.get $end)) (then
      (f32.store (i32.add (local.get $o) (local.get $a)) (f32.demote_f64
        (f64.mul (local.get $normal) (f64.add (f64.add
          (f64.promote_f32 (f32.load (i32.add (local.get $r) (local.get $a))))
          (f64.mul (local.get $side) (f64.add (f64.add (f64.add
            (f64.promote_f32 (f32.load (i32.sub (i32.add (local.get $r) (local.get $a)) (i32.const 4))))
            (f64.promote_f32 (f32.load (i32.add (i32.add (local.get $r) (local.get $a)) (i32.const 4)))))
            (f64.promote_f32 (f32.load (i32.add (local.get $rm) (local.get $a)))))
            (f64.promote_f32 (f32.load (i32.add (local.get $rp) (local.get $a)))))))
          (f64.mul (local.get $diag) (f64.add (f64.add (f64.add
            (f64.promote_f32 (f32.load (i32.sub (i32.add (local.get $rm) (local.get $a)) (i32.const 4))))
            (f64.promote_f32 (f32.load (i32.add (i32.add (local.get $rm) (local.get $a)) (i32.const 4)))))
            (f64.promote_f32 (f32.load (i32.sub (i32.add (local.get $rp) (local.get $a)) (i32.const 4)))))
            (f64.promote_f32 (f32.load (i32.add (i32.add (local.get $rp) (local.get $a)) (i32.const 4)))))))))))))

  ;; diffs(p, row, width, h, v): one source row's horizontal and vertical absolute differences, f64.
  (func $diffs (param $p i32) (param $w i32) (param $h i32) (param $v i32)
    (local $x i32) (local $a f64) (local $a2 v128)
    (local.set $x (i32.const 0))
    ;; Two columns at a time while both have a right neighbor, the same promote, subtract and absolute value each.
    (block $pairsDone (loop $pairs
      (br_if $pairsDone (i32.ge_u (i32.add (local.get $x) (i32.const 2)) (local.get $w)))
      (local.set $a2 (f64x2.promote_low_f32x4 (v128.load64_zero (i32.add (local.get $p) (i32.shl (local.get $x) (i32.const 2))))))
      (v128.store (i32.add (local.get $h) (i32.shl (local.get $x) (i32.const 3)))
        (f64x2.abs (f64x2.sub (local.get $a2) (f64x2.promote_low_f32x4 (v128.load64_zero offset=4 (i32.add (local.get $p) (i32.shl (local.get $x) (i32.const 2))))))))
      (v128.store (i32.add (local.get $v) (i32.shl (local.get $x) (i32.const 3)))
        (f64x2.abs (f64x2.sub (local.get $a2) (f64x2.promote_low_f32x4 (v128.load64_zero (i32.add (local.get $p) (i32.shl (i32.add (local.get $x) (local.get $w)) (i32.const 2))))))))
      (local.set $x (i32.add (local.get $x) (i32.const 2)))
      (br $pairs)))
    (loop $l
      (local.set $a (f64.promote_f32 (f32.load (i32.add (local.get $p) (i32.shl (local.get $x) (i32.const 2))))))
      (if (i32.lt_u (i32.add (local.get $x) (i32.const 1)) (local.get $w)) (then
        (f64.store (i32.add (local.get $h) (i32.shl (local.get $x) (i32.const 3)))
          (f64.abs (f64.sub (local.get $a) (f64.promote_f32 (f32.load offset=4 (i32.add (local.get $p) (i32.shl (local.get $x) (i32.const 2))))))))))
      (f64.store (i32.add (local.get $v) (i32.shl (local.get $x) (i32.const 3)))
        (f64.abs (f64.sub (local.get $a) (f64.promote_f32 (f32.load (i32.add (local.get $p) (i32.shl (i32.add (local.get $x) (local.get $w)) (i32.const 2))))))))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $x) (local.get $w)))))
  ;; epf1(sources, outputs, width, top, outTop, ya, yb, sigma, sw, ring, up, down, cs0, cs1, cs2, multiplier, border, flat):
  ;; edge-preserving step one over interior rows [ya, yb) and columns [3, width - 3). sources and outputs point at
  ;; three i32 plane addresses (rows from top and outTop); sigma is 0 for a flat sigma. The JavaScript kernel's sums.
  (func $epf1 (param $src i32) (param $dst i32) (param $width i32) (param $top i32) (param $outTop i32) (param $ya i32) (param $yb i32)
    (param $sigma i32) (param $sw i32) (param $ring i32) (param $up i32) (param $down i32)
    (param $cs0 f64) (param $cs1 f64) (param $cs2 f64) (param $multiplier f64) (param $border f64) (param $flat f64)
    (local $y i32) (local $x i32) (local $xb i32) (local $c i32) (local $r i32) (local $n i32) (local $swap i32)
    (local $p0 i32) (local $p1 i32) (local $p2 i32) (local $o0 i32) (local $o1 i32) (local $o2 i32) (local $at i32) (local $to i32) (local $ni i32)
    (local $rowBorder i32) (local $s f64) (local $inner f64) (local $edge f64) (local $factor f64)
    (local $left f64) (local $right f64) (local $dn f64) (local $u f64) (local $before f64)
    (local $ws f64) (local $a0 f64) (local $a1 f64) (local $a2 f64) (local $wt f64) (local $h00 i32) (local $h01 i32) (local $h02 i32) (local $h10 i32) (local $h11 i32) (local $h12 i32) (local $h20 i32) (local $h21 i32) (local $h22 i32) (local $v00 i32) (local $v01 i32) (local $v02 i32) (local $v03 i32) (local $v10 i32) (local $v11 i32) (local $v12 i32) (local $v13 i32) (local $v20 i32) (local $v21 i32) (local $v22 i32) (local $v23 i32)
    (local $limit i32) (local $phase i32) (local $c0v v128) (local $c1v v128) (local $c2v v128) (local $r2 v128) (local $d2 v128) (local $u2 v128) (local $l2 v128) (local $prev2 v128) (local $f2 v128) (local $ws2 v128) (local $a02 v128) (local $a12 v128) (local $a22 v128) (local $wt2 v128)
    (local.set $p0 (i32.load (local.get $src))) (local.set $p1 (i32.load offset=4 (local.get $src))) (local.set $p2 (i32.load offset=8 (local.get $src)))
    (local.set $o0 (i32.load (local.get $dst))) (local.set $o1 (i32.load offset=4 (local.get $dst))) (local.set $o2 (i32.load offset=8 (local.get $dst)))
    (local.set $c0v (f64x2.splat (local.get $cs0))) (local.set $c1v (f64x2.splat (local.get $cs1))) (local.set $c2v (f64x2.splat (local.get $cs2)))
    (local.set $y (local.get $ya))
    (block $rows (loop $row
      (br_if $rows (i32.ge_u (local.get $y) (local.get $yb)))
      ;; Difference rows: all of them for the first row, then the one new row of each kind.
      (local.set $r (if (result i32) (i32.eq (local.get $y) (local.get $ya)) (then (i32.sub (local.get $y) (i32.const 2))) (else (i32.add (local.get $y) (i32.const 1)))))
      (block $filled (loop $fill
        (br_if $filled (i32.gt_u (local.get $r) (i32.add (local.get $y) (i32.const 1))))
        (local.set $c (i32.const 0))
        (loop $channel
          (call $diffs
            (i32.add (i32.load (i32.add (local.get $src) (i32.shl (local.get $c) (i32.const 2)))) (i32.shl (i32.mul (i32.sub (local.get $r) (local.get $top)) (local.get $width)) (i32.const 2)))
            (local.get $width)
            (i32.add (local.get $ring) (i32.shl (i32.mul (i32.add (i32.mul (local.get $c) (i32.const 7)) (i32.rem_u (local.get $r) (i32.const 3))) (local.get $width)) (i32.const 3)))
            (i32.add (local.get $ring) (i32.shl (i32.mul (i32.add (i32.add (i32.mul (local.get $c) (i32.const 7)) (i32.const 3)) (i32.rem_u (local.get $r) (i32.const 4))) (local.get $width)) (i32.const 3))))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (br_if $channel (i32.lt_u (local.get $c) (i32.const 3))))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $fill)))
      (local.set $h00 (i32.sub (i32.add (local.get $ring) (i32.mul (i32.add (i32.mul (i32.const 0) (local.get $width)) (i32.mul (i32.rem_u (i32.sub (local.get $y) (i32.const 1)) (i32.const 3)) (local.get $width))) (i32.const 8))) (i32.const 16)))
      (local.set $h01 (i32.sub (i32.add (local.get $ring) (i32.mul (i32.add (i32.mul (i32.const 0) (local.get $width)) (i32.mul (i32.rem_u (i32.add (local.get $y) (i32.const 0)) (i32.const 3)) (local.get $width))) (i32.const 8))) (i32.const 16)))
      (local.set $h02 (i32.sub (i32.add (local.get $ring) (i32.mul (i32.add (i32.mul (i32.const 0) (local.get $width)) (i32.mul (i32.rem_u (i32.add (local.get $y) (i32.const 1)) (i32.const 3)) (local.get $width))) (i32.const 8))) (i32.const 16)))
      (local.set $v00 (i32.sub (i32.add (local.get $ring) (i32.mul (i32.add (i32.mul (i32.const 3) (local.get $width)) (i32.mul (i32.rem_u (i32.sub (local.get $y) (i32.const 2)) (i32.const 4)) (local.get $width))) (i32.const 8))) (i32.const 16)))
      (local.set $v01 (i32.sub (i32.add (local.get $ring) (i32.mul (i32.add (i32.mul (i32.const 3) (local.get $width)) (i32.mul (i32.rem_u (i32.sub (local.get $y) (i32.const 1)) (i32.const 4)) (local.get $width))) (i32.const 8))) (i32.const 16)))
