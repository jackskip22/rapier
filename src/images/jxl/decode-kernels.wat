  ;; convert's pixel(i), from an argument block of i32: n, inputCount, planes out, flags (1 input ink, 2 output ink, 4
  ;; input XYB, 8 output XYB), alpha, black, in0-in2, out0-out2, black out, the toPCS and fromPCS programs.
  (func $pixel (param $g i32) (param $i i32)
    (local $alpha i32) (local $a f64) (local $c i32) (local $v f64) (local $flags i32) (local $at i32) (local $scale f64)
    (local.set $alpha (i32.load offset=16 (local.get $g))) (local.set $flags (i32.load offset=12 (local.get $g)))
    (local.set $at (i32.shl (local.get $i) (i32.const 2)))
    (local.set $a (if (result f64) (local.get $alpha) (then (f64.promote_f32 (f32.load (i32.add (local.get $alpha) (local.get $at))))) (else (f64.const 1))))
    (if (i32.and (i32.ne (local.get $alpha) (i32.const 0)) (i32.eqz (f64.gt (local.get $a) (f64.const 0)))) (then (return)))
    (loop $inputs
      (local.set $v (f64.promote_f32 (f32.load (i32.add (local.get $at)
        (if (result i32) (i32.eq (local.get $c) (i32.const 3)) (then (i32.load offset=20 (local.get $g))) (else (i32.load offset=24 (i32.add (local.get $g) (i32.shl (local.get $c) (i32.const 2))))))))))
      (if (i32.and (i32.ne (local.get $alpha) (i32.const 0)) (i32.eqz (i32.and (local.get $flags) (i32.const 4)))) (then (local.set $v (f64.div (local.get $v) (local.get $a)))))
      (call $setV (local.get $c) (select (f64.sub (f64.const 1) (local.get $v)) (local.get $v) (i32.and (local.get $flags) (i32.const 1))))
      (local.set $c (i32.add (local.get $c) (i32.const 1)))
      (br_if $inputs (i32.lt_s (local.get $c) (i32.load offset=4 (local.get $g)))))
    (call $run (i32.load offset=52 (local.get $g)))
    (if (local.get $alpha) (then
      (if (i32.and (local.get $flags) (i32.const 4)) (then
        (call $setV (i32.const 0) (f64.div (call $V (i32.const 0)) (local.get $a))) (call $setV (i32.const 1) (f64.div (call $V (i32.const 1)) (local.get $a))) (call $setV (i32.const 2) (f64.div (call $V (i32.const 2)) (local.get $a)))))
      (if (i32.and (local.get $flags) (i32.const 8)) (then
        (call $setV (i32.const 0) (f64.mul (call $V (i32.const 0)) (local.get $a))) (call $setV (i32.const 1) (f64.mul (call $V (i32.const 1)) (local.get $a))) (call $setV (i32.const 2) (f64.mul (call $V (i32.const 2)) (local.get $a)))))))
    (call $run (i32.load offset=56 (local.get $g)))
