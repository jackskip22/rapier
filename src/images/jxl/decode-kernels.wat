      (loop $columns
        (local.set $dx (f32.sub (f32.convert_i32_s (local.get $x)) (local.get $px))) (local.set $dy (f32.sub (f32.convert_i32_s (local.get $y)) (local.get $py)))
        (local.set $d (f32.demote_f64 (f64.sqrt (f64.promote_f32 (f32.demote_f64 (f64.add (f64.mul (f64.promote_f32 (local.get $dx)) (f64.promote_f32 (local.get $dx)))
          (f64.promote_f32 (f32.mul (local.get $dy) (local.get $dy)))))))))
        (local.set $integral (f32.sub
          (f32.demote_f64 (call $splineErf (local.get $tables) (f64.promote_f32 (f32.mul (f32.demote_f64 (f64.add (f64.mul (f64.promote_f32 (local.get $d)) (f64.const 0.5)) (f64.promote_f32 (local.get $offset)))) (local.get $rs)))))
          (f32.demote_f64 (call $splineErf (local.get $tables) (f64.promote_f32 (f32.mul (f32.demote_f64 (f64.sub (f64.mul (f64.promote_f32 (local.get $d)) (f64.const 0.5)) (f64.promote_f32 (local.get $offset)))) (local.get $rs)))))))
        (local.set $value (f32.mul (local.get $amplitude) (f32.mul (local.get $integral) (local.get $integral))))
        (local.set $at (i32.shl (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 2)))
        (local.set $c (i32.const 0))
        (loop $channels
          (local.set $p (i32.add (i32.load (i32.add (local.get $planes) (i32.shl (local.get $c) (i32.const 2)))) (local.get $at)))
          (local.set $color (select (local.get $c0) (select (local.get $c1) (local.get $c2) (i32.eq (local.get $c) (i32.const 1))) (i32.eqz (local.get $c))))
          (f32.store (local.get $p) (f32.demote_f64 (f64.add (f64.mul (f64.promote_f32 (local.get $color)) (f64.promote_f32 (local.get $value))) (f64.promote_f32 (f32.load (local.get $p))))))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (br_if $channels (i32.lt_u (local.get $c) (i32.const 3))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $columns (i32.lt_s (local.get $x) (local.get $x1))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_s (local.get $y) (local.get $y1)))))

)
