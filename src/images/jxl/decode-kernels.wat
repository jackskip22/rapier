        (f32.demote_f64 (f64.mul (select (f64.sub (f64.const 1) (local.get $v)) (local.get $v) (i32.and (local.get $flags) (i32.const 2))) (local.get $scale))))
      (local.set $c (i32.add (local.get $c) (i32.const 1)))
      (br_if $outputs (i32.lt_s (local.get $c) (i32.load offset=8 (local.get $g)))))
