        (loop $scale3 (call $setV (local.get $x) (f64.mul (call $V (local.get $x)) (f64.load (i32.add (local.get $ptr) (i32.shl (local.get $x) (i32.const 3))))))
          (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $scale3 (i32.lt_u (local.get $x) (i32.const 3))))
        (br $next))
