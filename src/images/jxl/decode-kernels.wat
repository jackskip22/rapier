  ;; The 5x5 noise filter in place over a width x height plane: ring holds five original rows of width + 4 reflected
  ;; samples, slots their row numbers (five int32), refilled as the output overwrites the plane.
  (func (export "noiseConvolve") (param $data i32) (param $width i32) (param $height i32) (param $ring i32) (param $slots i32)
