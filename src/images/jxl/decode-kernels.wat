      (then (call $store (i32.const 1572864) (i32.const 8) (local.get $dx) (local.get $stride) (local.get $xs) (local.get $ys))))
    (call $idct8 (i32.const 524288) (local.get $basis) (i32.const 1572864) (i32.const 2097152))
    (if (i32.and (i32.gt_s (local.get $xs) (i32.const 0)) (i32.gt_s (local.get $ys) (i32.const 0)))
      (then (call $store (i32.const 1572864) (i32.const 8) (local.get $dy) (local.get $stride) (local.get $xs) (local.get $ys))))
    (call $idct8 (i32.const 1048576) (local.get $basis) (i32.const 1572864) (i32.const 2097152))
    (if (i32.and (i32.gt_s (local.get $xs) (i32.const 0)) (i32.gt_s (local.get $ys) (i32.const 0)))
      (then (call $store (i32.const 1572864) (i32.const 8) (local.get $db) (local.get $stride) (local.get $xs) (local.get $ys)))))

  ;; dequant(ints, n, quant, factor, bias, numerator, out): a block channel's coefficients as renderBlock dequantizes
  ;; them, ((q is 0 ? 0 * bias : |q| <= 1 ? q * bias : q - numerator / q) * quant) * factor, f32 weights.
  (func $dequant (export "dequant") (param $ints i32) (param $n i32) (param $quant i32) (param $factor f64) (param $b f64) (param $num f64) (param $out i32)
    (local $i i32) (local $q i32) (local $v f64) (local $x f64)
    (local $x2 v128) (local $v2 v128) (local $zero v128) (local $small v128) (local $zv v128) (local $bv v128) (local $nv v128) (local $fv v128)
    ;; Two independent coefficients, with the scalar operation order and zero's signed result retained.
