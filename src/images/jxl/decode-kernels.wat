          (f64.store (i32.add (i32.const 3531392) (i32.shl (local.get $y) (i32.const 3))) (f64.add (call $xcbrt (f64.sub (f64.mul (f64.add (f64.add
            (f64.mul (f64.load (local.get $x)) (call $V (i32.const 0))) (f64.mul (f64.load offset=8 (local.get $x)) (call $V (i32.const 1)))) (f64.mul (f64.load offset=16 (local.get $x)) (call $V (i32.const 2))))
            (f64.load offset=120 (local.get $ptr))) (f64.load (i32.add (i32.add (local.get $ptr) (i32.const 72)) (i32.shl (local.get $y) (i32.const 3))))))
            (f64.load (i32.add (i32.add (local.get $ptr) (i32.const 96)) (i32.shl (local.get $y) (i32.const 3))))))
          (local.set $y (i32.add (local.get $y) (i32.const 1)))
          (br_if $rows (i32.lt_u (local.get $y) (i32.const 3))))
        (local.set $ca (f64.load (i32.const 3531392))) (local.set $cb (f64.load (i32.const 3531400))) (local.set $cc (f64.load (i32.const 3531408)))
        (local.set $l (f64.div (f64.sub (local.get $ca) (local.get $cb)) (f64.const 2))) (local.set $m0 (f64.div (f64.add (local.get $ca) (local.get $cb)) (f64.const 2)))
        (call $setV (i32.const 0) (f64.mul (f64.add (local.get $l) (f64.const 0.015386134)) (f64.const 22.995788804)))
