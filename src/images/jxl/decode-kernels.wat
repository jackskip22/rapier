          (local.set $x (i32.const 0))
          (loop $xyz (call $setV (local.get $x) (f64.mul (call $V (local.get $x)) (f64.div (f64.const 65535) (f64.const 32768))))
            (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $xyz (i32.lt_u (local.get $x) (i32.const 3))))
          (br $next)))
        (local.set $scale (select (f64.div (f64.const 65535) (f64.const 65280)) (f64.const 1) (local.get $b)))
        (call $setV (i32.const 0) (f64.mul (f64.mul (call $V (i32.const 0)) (local.get $scale)) (f64.const 100)))
        (call $setV (i32.const 1) (f64.sub (f64.mul (f64.mul (call $V (i32.const 1)) (local.get $scale)) (f64.const 255)) (f64.const 128)))
        (call $setV (i32.const 2) (f64.sub (f64.mul (f64.mul (call $V (i32.const 2)) (local.get $scale)) (f64.const 255)) (f64.const 128)))
        (call $labXYZ)
