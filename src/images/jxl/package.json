{
  "name": "rapier-jxl",
  "version": "3.4.0",
  "description": "JPEG XL encoder in JavaScript, with optional WebAssembly. Lossless and lossy, exact alpha, HDR and JPEG transcoding, offline in browsers, Node or one HTML file. Built for photography tools and single-file apps. MIT, no dependencies.",
  "keywords": ["jpeg-xl", "jpegxl", "jxl", "javascript", "encoder", "image-compression", "lossless", "lossy", "hdr", "offline", "single-file-html", "webassembly", "photography", "exif", "xmp", "browser", "zero-dependency", "agent-skills"],
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {"types": "./index.d.mts", "default": "./index.mjs"},
    "./core": {"types": "./index.d.mts", "default": "./index.mjs"},
    "./min": {"types": "./index.d.mts", "default": "./rapier-jxl.min.mjs"},
    "./core/min": {"types": "./index.d.mts", "default": "./rapier-jxl.min.mjs"},
    "./jpeg": {"types": "./jpeg.d.mts", "default": "./jpeg.mjs"},
    "./jpeg/min": {"types": "./jpeg.d.mts", "default": "./jpeg.min.mjs"},
    "./photo": {"types": "./photo.d.mts", "default": "./photo.mjs"},
    "./photo/min": {"types": "./photo.d.mts", "default": "./photo.min.mjs"},
    "./jpeg-ans": {"types": "./jpeg-ans.d.mts", "default": "./jpeg-ans.mjs"},
    "./jpeg-ans/min": {"types": "./jpeg-ans.d.mts", "default": "./jpeg-ans.min.mjs"},
    "./photo-ans": {"types": "./photo-ans.d.mts", "default": "./photo-ans.mjs"},
    "./photo-ans/min": {"types": "./photo-ans.d.mts", "default": "./photo-ans.min.mjs"},
    "./effort": {"types": "./effort.d.mts", "default": "./effort.mjs"},
    "./effort/min": {"types": "./effort.d.mts", "default": "./effort.min.mjs"},
    "./writer": {"types": "./writer.d.mts", "default": "./writer.mjs"},
    "./source": {"types": "./source.d.mts", "default": "./source.mjs"},
    "./metadata": {"types": "./metadata.d.mts", "default": "./metadata.mjs"},
    "./metadata/min": {"types": "./metadata.d.mts", "default": "./metadata.min.mjs"},
    "./package.json": "./package.json",
    "./kernels": {"types": "./kernels.d.mts", "default": "./kernels.mjs"},
    "./wasm": {"types": "./wasm.d.mts", "default": "./wasm.mjs"},
    "./wasm/min": {"types": "./wasm.d.mts", "default": "./wasm.min.mjs"},
    "./rapier": {"types": "./rapier.d.mts", "default": "./rapier.mjs"},
    "./rapier/min": {"types": "./rapier.d.mts", "default": "./rapier.min.mjs"},
    "./rapier/worker": {"types": "./rapier-worker.d.mts", "default": "./dist/rapier-worker.js"}
  },
  "sideEffects": ["./wasm.mjs", "./wasm.min.mjs", "./dist/rapier-worker.js"],
  "engines": {"node": ">=18"},
  "repository": {"type": "git", "url": "git+https://github.com/jackskip22/rapier-jxl.git"},
  "bugs": {"url": "https://github.com/jackskip22/rapier-jxl/issues"},
  "homepage": "https://github.com/jackskip22/rapier-jxl#readme"
}
