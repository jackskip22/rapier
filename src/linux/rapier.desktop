[Desktop Entry]
Type=Application
Name=Rapier
GenericName=Markdown editor
Comment=Write Markdown offline, in one file
Exec=rapier %F
Icon=rapier
Terminal=false
Categories=Utility;TextEditor;
Keywords=markdown;notes;writing;
MimeType=text/markdown;text/x-markdown;application/x-rapier-html;
StartupWMClass=rapier
Actions=new-document;

[Desktop Action new-document]
Name=New document
Exec=rapier --new
