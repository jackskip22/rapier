      "id": "toast-container",
      "selector": ".toast-container",
      "rule": {
        "file": "editor/styles/rapier-app.css",
        "origin": "stylesheet",
        "at": [],
        "occurrence": 1,
        "declarations": [
          {
            "property": "position",
            "value": "fixed",
            "important": false
          },
          {
            "property": "bottom",
            "value": "calc(var(--native-inset-bottom, env(safe-area-inset-bottom, 0px)) + var(--rapier-toast-lift, 0px))",
            "important": false
          },
          {
            "property": "left",
            "value": "0",
            "important": false
          },
          {
            "property": "right",
            "value": "0",
            "important": false
          }
        ]
      },
      "basis": "production CSS; synthetic component content, not an app-opening receipt",
      "component": {
        "kind": "existing-toast",
        "classes": "toast-container",
        "controlClass": "toast__action",
        "attributes": {
          "aria-hidden": "false"
        }
      }
    },
